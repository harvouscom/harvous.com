{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harvous-com",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",

  // No nodejs_compat: the Worker and src/lib/church-search.ts use only
  // fetch/URL/URLSearchParams/Response. Keep it that way — the whole point of
  // this Worker is that it is nearly empty.

  // Production serves on harvous.com and nowhere else. Left at their defaults
  // both of these are ON, which puts the whole marketing site on a public
  // workers.dev URL and gives every future version its own public preview URL
  // — duplicates of a site whose canonical is https://harvous.com/.
  // Staging re-enables workers_dev below; it is the only way to reach it.
  "workers_dev": false,
  "preview_urls": false,

  // The live site. Declared here rather than left in the dashboard so it is
  // reviewable, reproducible, and deployed by CI along with everything else.
  //
  // The pattern is exact for a reason: `*.harvous.com/*` — the obvious-looking
  // wildcard — matches every SUBDOMAIN and NOT the apex, so it takes over
  // app.harvous.com while leaving harvous.com untouched. It did exactly that,
  // briefly, during the cutover.
  "routes": [{ "pattern": "harvous.com/*", "zone_name": "harvous.com" }],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Astro builds directory-style (`/about/index.html`), and the site's own
    // links are trailing-slash. This serves both spellings, as Netlify did.
    "html_handling": "auto-trailing-slash",

    // dist/404.html, from src/pages/404.astro.
    "not_found_handling": "404-page",

    // /api/* : the typeahead has no asset behind it, so the Worker would be
    // reached anyway — this states it, and keeps a future `public/api/`
    // directory from quietly shadowing the endpoint.
    //
    // /for/churches/ : the interest form POSTs to its own page, and without
    // this the asset router would answer that POST with the page itself, 200,
    // and the submission would vanish with the visitor none the wiser. The
    // cost is one Worker invocation per view of that single page.
    //
    // The two videos: these lines are what make serveMedia reachable at all.
    // They matter twice over. `not_found_handling` means the asset router
    // answers an unmatched path with the 404 page rather than falling through,
    // so "not an asset" was never enough; and the files are currently IN
    // dist/ for Netlify's sake, so without these the asset router would serve
    // them itself — 200, no ranges, the exact bug R2 is here to fix.
    "run_worker_first": [
      "/api/*",
      "/for/churches",
      "/for/churches/",
      "/touring-harvous-short.mp4",
      "/harvous-3-walkthrough.mp4"
    ]
  },

  // Church interest submissions (replaces Netlify Forms).
  // Schema lives in cloudflare/migrations/; CI applies pending ones before
  // each deploy. To apply by hand:
  //   npx wrangler d1 migrations apply harvous-com --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harvous-com",
      "database_id": "e8ec3027-a343-465d-8a14-0660d3d02c17",
      "migrations_dir": "cloudflare/migrations"
    }
  ],

  // Video. Static assets cannot do byte ranges, so these two files are served
  // from R2 by the Worker instead — see serveMedia in cloudflare/worker.ts.
  // Unlike D1 this bucket IS shared with staging: it holds read-only published
  // media, so there is nothing for staging to pollute and no reason to upload
  // the same files twice.
  //   npx wrangler r2 bucket create harvous-com-media
  //   npm run media:upload
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "harvous-com-media"
    }
  ],

  "observability": {
    "enabled": true
  },

  "env": {
    // Manual preview deploys (see .github/workflows/cloudflare-deploy.yml).
    // Keeps the draft pages; the build stamps them noindex via dist/_headers.
    "staging": {
      "name": "harvous-com-staging",

      // The whole point of staging is a URL to look at. Safe here in a way it
      // is not in production: every staging response carries X-Robots-Tag
      // noindex, stamped into dist/_headers by the build.
      "workers_dev": true,

      // Emphatically empty. `routes` is an inheritable key, like workers_dev
      // above — without this line staging would inherit `harvous.com/*` and a
      // staging deploy would take the live site, serving it noindexed and with
      // the unreleased draft pages. Never give this environment a route.
      "routes": [],

      // Bindings are not inherited by named environments the way `assets` is,
      // so this has to be restated — without it staging answers every
      // submission 503. Its own database, not production's: test submissions
      // do not belong in the table someone reads for real leads.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "harvous-com-staging",
          "database_id": "3da3247a-6189-4be7-b5f6-854e771d33d3",
          "migrations_dir": "cloudflare/migrations"
        }
      ],

      // Same bucket as production, for the reason given above.
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "harvous-com-media"
        }
      ]
    }
  }

  // Secrets (wrangler secret put, never committed — same values as .env):
  //   HERESMYCHURCH_API_BASE
  //   HERESMYCHURCH_ANON_KEY
  //   HERESMYCHURCH_PARTNER_API_KEY
}
