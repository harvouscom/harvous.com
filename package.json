{
  "name": "harvous.com",
  "type": "module",
  "version": "0.1.0",
  "license": "CC-BY-4.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:deploy:staging": "KEEP_DRAFT_PAGES=1 npm run build && wrangler deploy --env staging",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "images:compress": "bash scripts/compress-images.sh",
    "media:upload": "bash scripts/upload-media.sh",
    "blog:thumbs": "node scripts/generate-blog-thumbs.mjs",
    "og:pages": "node scripts/generate-page-og-images.mjs",
    "og:compare": "node scripts/generate-compare-og-images.mjs",
    "tour:studio": "npm --prefix video run dev",
    "tour:render": "npm --prefix video run render:site"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.2.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.5.1",
    "@tailwindcss/vite": "^4.1.5",
    "astro": "^5.6.1",
    "astro-icon": "^1.1.5",
    "fuse.js": "^7.5.0",
    "plyr": "^3.8.4",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@iconify-json/fa7-brands": "^1.2.4",
    "@iconify-json/fa7-regular": "^1.2.3",
    "@iconify-json/fa7-solid": "^1.2.5",
    "sharp": "^0.35.3",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
