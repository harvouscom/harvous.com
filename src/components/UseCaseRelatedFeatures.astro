---
/**
 * Use-case feature list — same content as featureIds → MDX, styled like WhatsIncluded grid.
 * featureIds may also reference coming-soon-grid ids (e.g. shared-spaces), rendered inline
 * with a Coming soon chip.
 */
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Container from "./layout/Container.astro";
import { FEATURE_ICONS } from "../lib/feature-icons.ts";
import { hasDetailContent } from "../lib/product-page-data.ts";
import { draftPageIsReachable } from "../lib/draft-pages.ts";
import type { RelatedFeatureCard } from "../lib/coming-soon-grid.ts";

interface Props {
  featuresHeading: string;
  featuresLead: string;
  cards: RelatedFeatureCard[];
}

const { featuresHeading, featuresLead, cards: allCards } = Astro.props;

/*
  Every featureIds grid on the site renders through here, so the draft filter
  lives here too rather than in the four near-identical resolvers that build
  these cards. A feature whose page is stripped from the production build has no
  card at all — a tile that silently loses its link reads as an oversight.
*/
const cards = allCards.filter(
  (card) => card.kind !== "feature" || draftPageIsReachable(`features/${card.feature.id}`)
);

const allFeatures = await getCollection("features");
const publishedSlugs = new Set(
  allFeatures.filter((f) => !f.data.draft && hasDetailContent(f.data)).map((f) => f.id)
);
---

{
  cards.length > 0 && (
    <section class="use-case-features frame-divider">
      <Container size="xl">
        <div class="use-case-features__head section-head" data-reveal>
          <span class="eyebrow-pill">Features</span>
          <h2 class="section-title">{featuresHeading}</h2>
          <p class="lead use-case-features__lead">{featuresLead}</p>
        </div>

        <ul class="use-case-features__grid" data-reveal="stagger" style="--reveal-delay: 100ms;" role="list">
          {cards.map((card) => {
            if (card.kind === "comingSoon") {
              const { item } = card;
              const Tag = item.href ? "a" : "div";
              return (
                <li>
                  <Tag
                    class:list={[
                      "use-case-features__card",
                      item.href && "use-case-features__card--link",
                    ]}
                    href={item.href}
                  >
                    <span class="use-case-features__icon">
                      <Icon name={item.icon ?? item.icons?.[0] ?? "fa7-solid:note-sticky"} />
                    </span>
                    <span
                      class:list={[
                        "use-case-features__title",
                        item.comingSoon !== false && "use-case-features__title--with-chip",
                      ]}
                    >
                      <span>{item.title}</span>
                      {item.comingSoon !== false && (
                        <span class="use-case-features__soon-chip">Coming soon</span>
                      )}
                    </span>
                    <p class="use-case-features__desc">{item.desc}</p>
                    {item.href && <span class="use-case-features__more">Learn more →</span>}
                  </Tag>
                </li>
              );
            }

            const f = card.feature;
            const href = publishedSlugs.has(f.id) ? `/features/${f.id}/` : undefined;
            const Tag = href ? "a" : "div";
            return (
              <li>
                <Tag
                  class:list={["use-case-features__card", href && "use-case-features__card--link"]}
                  href={href}
                >
                  <span class="use-case-features__icon">
                    <Icon name={FEATURE_ICONS[f.id] ?? "fa7-solid:note-sticky"} />
                  </span>
                  <span class="use-case-features__title">{f.data.tagline}</span>
                  <p class="use-case-features__desc">{f.data.title}</p>
                  {href && <span class="use-case-features__more">Learn more →</span>}
                </Tag>
              </li>
            );
          })}
        </ul>
      </Container>
    </section>
  )
}

<style>
  .use-case-features {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }
  .use-case-features__head .section-title {
    max-width: 18ch;
    margin-inline: auto;
    text-wrap: balance;
  }
  .use-case-features__lead {
    max-width: 38rem;
    margin-inline: auto;
    text-wrap: pretty;
  }
  /*
    Flex-wrap, not grid. A fixed repeat(4, 1fr) reserves four tracks whether or
    not four cards exist — a category with two housed features left two empty
    columns as dead space at the row's end. Flex items keep the same per-card
    width at each breakpoint (flex-basis matches the old column math) but only
    take up as much row as there are actual cards; grow/shrink are both off so a
    short row stays its natural width instead of stretching to fill it.
  */
  .use-case-features__grid {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    display: flex;
    flex-wrap: wrap;
    /*
      Centered, not left-start. Flush-left with card widths unchanged looked
      identical to the grid it replaced — both left an under-filled row pinned to
      the left edge with the trailing space implying a card that never arrives.
      Centering removes that implication; a full row is unaffected either way.
    */
    justify-content: center;
    gap: 2rem 1.5rem;
    list-style: none;
    padding: 0;
    margin-bottom: 0;
  }
  .use-case-features__grid > li {
    flex: 0 0 calc((100% - 1.5rem) / 2);
  }
  @media (min-width: 720px) {
    .use-case-features__grid > li {
      flex-basis: calc((100% - 2 * 1.5rem) / 3);
    }
  }
  @media (min-width: 1024px) {
    .use-case-features__grid > li {
      flex-basis: calc((100% - 3 * 1.5rem) / 4);
    }
    /*
      Five cards drop to three columns, so they land 3 + 2 rather than 4 + 1.
      Centering (above) is enough for a row missing two or three cards — it reads
      as a short row. A single centered card under a full four does not: it reads
      as one that failed to load. Three of the eight pages here carried five
      before Reminders existed, and every one of them had this shape.

      Exactly five, hence :nth-child(5):last-child. Four and six are already
      whole at this width, and where :has() is unsupported the rule is skipped
      and the layout is what it is today.
    */
    .use-case-features__grid:has(> li:nth-child(5):last-child) > li {
      flex-basis: calc((100% - 2 * 1.5rem) / 3);
    }
  }
  .use-case-features__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .use-case-features__card--link {
    transition: transform 200ms ease;
  }
  .use-case-features__card--link:hover {
    transform: translateY(-2px);
  }
  .use-case-features__card--link:hover .use-case-features__title {
    color: var(--color-accent);
  }
  .use-case-features__soon-chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.42rem;
    border-radius: 999px;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    background: color-mix(in oklab, var(--color-card) 88%, transparent);
    border: 1px solid var(--color-rule);
  }
  .use-case-features__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .use-case-features__icon :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .use-case-features__title {
    display: block;
    margin-top: 0.85rem;
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--color-ink);
    transition: color 200ms ease;
  }
  .use-case-features__title--with-chip {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .use-case-features__desc {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .use-case-features__more {
    display: inline-block;
    margin-top: 0.65rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-accent);
  }
</style>
