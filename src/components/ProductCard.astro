---
/**
 * ProductCard — a card from the Figma "Home" frame's feature carousel: white
 * card, one or two content pills, a title, a body line, then a screenshot in a
 * bottom panel (bleeds, clipped). Screenshots live at /app-*.png.
 *
 * The screenshot is optional. Without one the bottom panel shows the card's
 * pills at display size on the warm ground — so a card whose close-up isn't
 * taken yet (or would show a surface the release removed) still looks
 * finished rather than pending.
 */
import ContentPill from "./ContentPill.astro";
import OptimizedImage from "./OptimizedImage.astro";

type PillType = "note" | "scripture" | "highlight" | "folder" | "thread";

interface Props {
  pills: PillType[];
  title: string;
  body: string;
  image?: string;
  imageAlt?: string;
}

const { pills, title, body, image, imageAlt = "" } = Astro.props;
---

<article class="pcard">
  <div class="pcard__body">
    <div class="pcard__head">
      <div class="pcard__pills">
        {pills.map((p) => <ContentPill type={p} />)}
      </div>
      <h3 class="pcard__title">{title}</h3>
    </div>
    <p class="pcard__text">{body}</p>
  </div>
  {
    image ? (
      <div class="pcard__shot">
        <OptimizedImage src={image} alt={imageAlt} width={1054} height={480} loading="lazy" />
      </div>
    ) : (
      <div class="pcard__shot pcard__shot--pills" aria-hidden="true">
        {pills.map((p) => <ContentPill type={p} />)}
      </div>
    )
  }
</article>

<style>
  /*
    Type and padding scale with the card's own width (cqi), not the viewport —
    the same card sits at ~500px in the homepage slider and ~256px on a phone.
    Caps are the original fixed sizes; floors keep a phone card readable.
  */
  .pcard {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-card);
    border: 1px solid var(--color-rule);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: clamp(0.5rem, 2cqi, 0.75rem);
    padding: clamp(1rem, 4.5cqi, 1.5rem);
  }
  .pcard__head { display: flex; flex-direction: column; gap: clamp(0.65rem, 2.6cqi, 1rem); }
  .pcard__pills { display: flex; flex-wrap: wrap; gap: 0.56rem; font-size: clamp(0.8125rem, 3.4cqi, 1rem); }
  .pcard__pills :global(.cpill) {
    padding: 0.28em 0.55em;
  }
  .pcard__pills :global(.cpill__icon) {
    font-size: 0.625em;
  }
  .pcard__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: "wdth" 100, "ROND" 0;
    font-size: clamp(1.0625rem, 4.4cqi, 1.375rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-ink);
  }
  .pcard__text {
    font-family: var(--font-sans);
    font-size: clamp(0.8125rem, 3.2cqi, 1rem);
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  /* Screenshot panel — height follows the image. */
  .pcard__shot {
    flex-shrink: 0;
    border-top: 1px solid var(--color-rule);
    overflow: hidden;
    background: var(--color-warm);
    line-height: 0;
  }
  .pcard__shot picture,
  .pcard__shot img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* No screenshot: the pills, large, at the same 1054:480 ratio the shot
     would have held, so the row's cards stay level. */
  .pcard__shot--pills {
    aspect-ratio: 1054 / 480;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5em;
    padding: 1rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1;
  }
</style>
