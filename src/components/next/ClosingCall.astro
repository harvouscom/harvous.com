---
/**
 * ClosingCall — the last thing on a page: one line, one button, on the same
 * sky the hero opened with. Hides the sticky pill while it's on screen so
 * there's only ever one "Try Harvous free" in view.
 *
 * Defaults are the generic try-it-free handoff. A page with its own CTA (an
 * add-on selling Plus, say) overrides `href`/`label`/`external`, and can add
 * a second, quieter link beside it (`secondaryHref`/`secondaryLabel`).
 */
import { buildTryUrl } from "../../lib/signup-url.ts";
import { fathomTry } from "../../lib/fathom-events.ts";
import { backdropSrc } from "../../lib/next/content.ts";

interface Props {
  title?: string;
  lead?: string;
  href?: string;
  label?: string;
  /** True for a link that leaves harvous.com (upgrade, sign-up elsewhere). */
  external?: boolean;
  fathomTrack?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title = "Start with today's passage.",
  lead = "No account needed. Sign up when you want to keep what you wrote. Harvous is on the web today; Mac, iPad, and iPhone apps are coming later.",
  href = buildTryUrl({ source: "next_closing" }),
  label = "Try Harvous free",
  external = false,
  fathomTrack = fathomTry.nextClosing,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="close" data-hides-sticky>
  <div class="nx-wrap">
    <div class="close__card" data-reveal="scale">
      <img class="close__sky" src={backdropSrc("077")} alt="" loading="lazy" />
      <h2 class="nx-display close__title">{title}</h2>
      <p class="nx-lead close__lead">{lead}</p>
      <div class="close__acts">
        <a
          class="nx-btn nx-btn--accent close__btn"
          href={href}
          {...external ? { target: "_blank", rel: "noopener" } : { "data-try-cta": true }}
          data-fathom-track={fathomTrack}
        >
          {label}
        </a>
        {secondaryHref && secondaryLabel && (
          <a class="nx-btn nx-btn--ghost close__btn" href={secondaryHref}>{secondaryLabel}</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .close { padding-block: clamp(2rem, 6vw, 4rem) clamp(4rem, 10vw, 7rem); }
  .close__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3.5rem, 10vw, 7rem) clamp(1.25rem, 5vw, 4rem);
    border-radius: var(--nx-radius-scene);
    text-align: center;
  }
  .close__sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  .close__card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(70% 70% at 50% 45%, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.15));
  }
  /* Wide enough that a long title stays at three lines, at most. */
  .close__title { margin: 0 auto; max-width: 20ch; font-size: clamp(2.5rem, 6.5vw, 5rem); }
  /* Two lines at most: wider than the usual lead, balanced so they break evenly. */
  .close__lead { max-width: 46rem; margin: 1.25rem auto 0; color: var(--color-ink-soft); text-wrap: balance; }
  .close__acts { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 2rem; }
  .close__btn { min-height: 3.4rem; padding-inline: 2rem; font-size: 1.0625rem; margin-top: 0; }
</style>
