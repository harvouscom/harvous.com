---
/**
 * FeatureCarousel — the features a category page houses, as a row of cards you
 * swipe (or step with the arrows): each card shows the feature at work (its
 * ShowcaseVisual, scaled down on a tinted stage), then its name and one line.
 * The row starts on the page's content column and runs off the right edge so
 * the next card peeks in, the same mechanics as the homepage UseCaseRow.
 */
import ShowcaseVisual from "./ShowcaseVisual.astro";
import { SOON_LABEL } from "../../lib/coming-soon-grid.ts";

export type FeatureCarouselItem = {
  title: string;
  desc: string;
  href?: string;
  soon: boolean;
  visual?: string;
  label?: string;
};

interface Props {
  heading: string;
  lead?: string;
  items: FeatureCarouselItem[];
}
const { heading, lead, items } = Astro.props;

const washes = ["sky", "amber", "mint", "violet", "coral"];
const id = `fcar-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="fcar" aria-labelledby={id} data-fcar>
  <div class="nx-wrap fcar__head">
    <div>
      <h2 id={id} class="fcar__h2">{heading}</h2>
      {lead && <p class="fcar__lead">{lead}</p>}
    </div>
    <div class="fcar__nav" aria-hidden="true">
      <button type="button" class="fcar__btn" data-fcar-prev tabindex="-1">
        <svg viewBox="0 0 16 16"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
      </button>
      <button type="button" class="fcar__btn" data-fcar-next tabindex="-1">
        <svg viewBox="0 0 16 16"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
      </button>
    </div>
  </div>

  <ul class="fcar__track" role="list" data-fcar-track>
    {items.map((f, i) => {
      const Tag = f.href ? "a" : "div";
      return (
        <li class="fcar__item">
          <Tag class:list={["fcar__card", f.href && "fcar__card--link"]} href={f.href}>
            <span class="fcar__stage" style={`--wash: var(--tint-${washes[i % washes.length]});`} aria-hidden="true">
              {f.visual && <span class="fcar__visual"><ShowcaseVisual name={f.visual} label={f.label ?? f.title} /></span>}
            </span>
            <span class="fcar__words">
              <span class="fcar__title">
                {f.title}
                {f.soon && <span class="fcar__soon">{SOON_LABEL}</span>}
              </span>
              <span class="fcar__desc">{f.desc}</span>
              {f.href && <span class="fcar__go">Explore →</span>}
            </span>
          </Tag>
        </li>
      );
    })}
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-fcar]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-fcar-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-fcar-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-fcar-next]");
    if (!track || !prev || !next) return;
    const step = () => {
      const card = track.querySelector<HTMLElement>(".fcar__item");
      return card ? card.getBoundingClientRect().width + 16 : 320;
    };
    const sync = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const go = (dir: number) => track.scrollBy({ left: dir * step(), behavior: reduce ? "auto" : "smooth" });
    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
  });
</script>

<style>
  .fcar { padding-top: clamp(4rem, 9vw, 6rem); }
  .fcar__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; margin-bottom: clamp(1.5rem, 4vw, 2rem); }
  .fcar__h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; text-wrap: balance; }
  .fcar__lead { max-width: 40rem; margin: 0.6rem 0 0; color: var(--color-ink-soft); text-wrap: pretty; }

  .fcar__nav { display: none; gap: 0.5rem; flex-shrink: 0; }
  @media (min-width: 48rem) { .fcar__nav { display: flex; } }
  .fcar__btn { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 0; border-radius: 999px; color: var(--color-ink); background: var(--color-warm); cursor: pointer; transition: background-color 150ms ease, opacity 150ms ease; }
  .fcar__btn:hover { background: color-mix(in srgb, var(--color-ink) 8%, transparent); }
  .fcar__btn:disabled { opacity: 0.35; cursor: default; }
  .fcar__btn svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .fcar__track {
    --edge: max(var(--nx-gutter), calc((100vw - var(--nx-wide)) / 2));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82vw, 22rem);
    gap: 1rem;
    margin: 0;
    padding: 0.25rem var(--edge) 0.75rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
  }
  .fcar__track::-webkit-scrollbar { display: none; }
  .fcar__item { scroll-snap-align: start; }

  .fcar__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: 1.5rem;
    color: inherit;
    text-decoration: none;
    background: var(--color-paper);
    transition: border-color 150ms ease, transform 200ms var(--nx-ease, ease);
  }
  .fcar__card--link:hover { border-color: color-mix(in srgb, var(--color-ink) 18%, var(--color-rule)); transform: translateY(-2px); }
  .fcar__card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* The feature at work, scaled to fit a 13rem stage and cropped at the bottom. */
  .fcar__stage { position: relative; display: block; height: 13rem; overflow: hidden; background: var(--wash); }
  .fcar__visual { position: absolute; left: 50%; top: 1.25rem; width: 26rem; transform: translateX(-50%); zoom: 0.72; pointer-events: none; }

  .fcar__words { display: flex; flex: 1; flex-direction: column; gap: 0.35rem; padding: 1.1rem 1.25rem 1.25rem; }
  .fcar__title { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.5rem; font-weight: 600; font-size: 1.0625rem; color: var(--color-ink); }
  .fcar__soon { padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.6875rem; font-weight: 600; color: var(--color-ink-soft); background: var(--color-warm); }
  .fcar__desc { font-size: 0.9375rem; line-height: 1.5; color: var(--color-ink-soft); text-wrap: pretty; }
  .fcar__go { margin-top: auto; padding-top: 0.6rem; font-size: 0.875rem; font-weight: 500; color: var(--color-accent); }
</style>
