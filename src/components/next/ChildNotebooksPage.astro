---
/**
 * ChildNotebooksPage — /add-ons/family/child-notebooks/. Its own design
 * rather than the shared add-on template: this is the one page for kids, so
 * it shows the notebook the way a child meets it. A cover they decorate, the
 * die-cut stickers from the app, a peek inside, then the parent's side.
 *
 * The cover, colors, patterns and stickers mirror the app's cover studio
 * (shared/child-notebook.ts and child-notebook-preview.css in the app): the
 * same thread colors, mixed 65% toward text for the cover, and the same
 * dots / stripes / gingham at low opacity. Headings are sentence case, and
 * Caveat is used a line at a time, the way the rest of the site uses it.
 *
 * Page data (SEO, FAQ, closing) is CHILD_NOTEBOOKS_PAGE in lib/addons-data.ts.
 */
import NextLayout from "../../layouts/NextLayout.astro";
import ClosingCall from "./ClosingCall.astro";
import ShowcaseVisual from "./ShowcaseVisual.astro";
import FaqItem from "../FaqItem.astro";
import AppIcon from "./app/AppIcon.astro";
import AskHarvous from "./AskHarvous.astro";
import { ogCard } from "../../lib/og-card.ts";
import { isDraftPageSlug } from "../../lib/draft-pages.ts";
import { buildAddonJsonLd, type ProductPage } from "../../lib/product-page-data.ts";

interface Props {
  page: ProductPage;
}
const { page } = Astro.props;
const isDraft = isDraftPageSlug(page.href.replace(/^\/|\/$/g, ""));

/* The app's cover studio, in the order it offers them. */
const COLORS = [
  { id: "blue", label: "Sky" },
  { id: "green", label: "Leaf" },
  { id: "purple", label: "Lilac" },
  { id: "pink", label: "Rose" },
  { id: "orange", label: "Peach" },
  { id: "yellow", label: "Sun" },
] as const;
const PATTERNS = [
  { id: "plain", label: "Simple" },
  { id: "dots", label: "Dots" },
  { id: "stripes", label: "Stripes" },
  { id: "gingham", label: "Checks" },
] as const;
/* The cover studio's own sticker set (offeredSymbols in the app), in its
   order; "initial" is the child's first letter. Verse stickers in My Bible
   have a few more (sun, sailboat…), but those aren't cover choices. */
const STICKERS = [
  { id: "initial", label: "My initial" },
  { id: "cross", label: "Cross" },
  { id: "heart", label: "Heart" },
  { id: "star", label: "Star" },
  { id: "rainbow", label: "Rainbow" },
  { id: "fish", label: "Fish" },
  { id: "dove", label: "Dove" },
  { id: "crown", label: "Crown" },
] as const;
const FIRST = "star";

/* Stickers scattered around the hero's notebook: [icon, color, top, left, tilt]. */
const SCATTER: [string, string, string, string, number][] = [
  ["rainbow", "pink", "12%", "16%", -10],
  ["fish", "blue", "62%", "9%", 8],
  ["sun", "yellow", "8%", "78%", 12],
  ["dove", "purple", "58%", "84%", -7],
  ["heart", "orange", "80%", "26%", 6],
  ["crown", "green", "82%", "70%", -12],
];

const NEVER = ["Ads", "Messages", "Public sharing", "Purchases", "AI", "Tracking", "Finding other kids"];

const faqId = (q: string) => `faq-${q.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").split("-").slice(0, 6).join("-")}`;
const faqs = page.faqs ?? [];
---

<NextLayout
  title={page.seoTitle}
  description={page.seoDescription}
  ogImage={ogCard(`addon-${page.slug}`)}
  noindex={isDraft}
  jsonLd={buildAddonJsonLd(page)}
>
  <article class="cn">
    {/* ── Hero ─────────────────────────────────────────────────────────── */}
    <header class="nx-wrap cn-hero">
      <nav class="cn-crumb" aria-label="Breadcrumb">
        <a class="cn-crumb__back" href="/add-ons/family/">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
          Family
        </a>
        <span class="cn-crumb__here" aria-current="page"><AppIcon name="book-open-reader" /> Child notebooks</span>
        {page.comingSoon && <span class="cn-crumb__soon">{page.comingSoonLine}</span>}
      </nav>
      <h1 class="nx-display cn-hero__title">{page.heroTitle}</h1>
      <p class="nx-lead cn-hero__lead">{page.heroLead}</p>
      <p class="cn-hero__acts">
        {/* Nothing to start yet: setup opens when child notebooks launch. */}
        <a class="nx-btn nx-btn--ghost" href="#make-it-theirs">Decorate one</a>
      </p>

      <div class="cn-desk" role="img" aria-label="A blue notebook with a checked pattern with a star sticker in the middle of the cover, surrounded by die-cut stickers: a rainbow, a fish, a sun, a dove, a heart and a crown">
        {SCATTER.map(([icon, color, top, left, tilt]) => (
          <span class="cn-sticker cn-sticker--float" data-color={color} style={`top:${top};left:${left};--tilt:${tilt}deg`}>
            <AppIcon name={icon} />
          </span>
        ))}
        <div class="cn-cover cn-cover--hero" data-color="blue" data-pattern="gingham">
          <span class="cn-cover__emblem"><AppIcon name="star" /></span>
        </div>
        <p class="cn-hand cn-desk__note nx-hand">Ellie picked every sticker</p>
      </div>
    </header>

    {/* ── Cover studio ─────────────────────────────────────────────────── */}
    <section id="make-it-theirs" class="nx-wrap cn-studio" data-color="green" aria-labelledby="cn-studio-title">
      <div class="cn-studio__stage">
        <div class="cn-cover" data-color="green" data-pattern="dots" data-cn-cover>
          <span class="cn-cover__emblem">
            {STICKERS.map((s) => (
              <span data-cn-emblem={s.id} hidden={s.id !== FIRST}>{s.id === "initial" ? <b class="cn-initial">E</b> : <AppIcon name={s.id} />}</span>
            ))}
          </span>
        </div>
      </div>
      <div class="cn-studio__text">
        <h2 id="cn-studio-title" class="nx-title">Make it theirs.</h2>
        <p class="cn-p">
          The first thing your child does is decorate the cover. Try it: these are the same colors,
          patterns and stickers they'll find in Harvous.
        </p>

        <fieldset class="cn-pick">
          <legend>Color</legend>
          <div class="cn-pick__row">
            {COLORS.map((c, i) => (
              <button type="button" class="cn-swatch" data-cn-set="color" data-value={c.id} data-color={c.id} aria-pressed={i === 1 ? "true" : "false"} aria-label={c.label} title={c.label}></button>
            ))}
          </div>
        </fieldset>
        <fieldset class="cn-pick">
          <legend>Pattern</legend>
          <div class="cn-pick__row">
            {PATTERNS.map((p, i) => (
              <button type="button" class="cn-chip" data-cn-set="pattern" data-value={p.id} aria-pressed={i === 1 ? "true" : "false"}>
                <span class="cn-chip__sample" data-pattern={p.id}></span>{p.label}
              </button>
            ))}
          </div>
        </fieldset>
        <fieldset class="cn-pick">
          <legend>Sticker</legend>
          <div class="cn-pick__row cn-pick__row--stickers">
            {STICKERS.map((s) => (
              <button type="button" class="cn-sticker cn-sticker--pick" data-cn-set="sticker" data-value={s.id} aria-pressed={s.id === FIRST ? "true" : "false"} aria-label={s.label} title={s.label}>
                {s.id === "initial" ? <b class="cn-initial">E</b> : <AppIcon name={s.id} />}
              </button>
            ))}
          </div>
        </fieldset>
        <p class="cn-hand nx-hand">They can change it any time.</p>
      </div>
    </section>

    {/* ── Inside ───────────────────────────────────────────────────────── */}
    <section id="inside" class="nx-wrap cn-inside" aria-labelledby="cn-inside-title">
      <div class="cn-head">
        <h2 id="cn-inside-title" class="nx-title">A peek inside.</h2>
        <p class="nx-lead">Real notes and real Scripture, sized for a younger reader. Every tap is a big one.</p>
      </div>
      <ul class="cn-grid" role="list">
        <li class="cn-card" data-tone="green" data-reveal>
          <div class="cn-card__stage"><ShowcaseVisual name="child-notebook-home" label="Ellie's notebook with three notes: What I want to remember, A little kindness, and A question for Sunday" /></div>
          <div class="cn-card__text">
            <h3>A place that's theirs</h3>
            <p>Notes with folders, tags and Threads, and Scripture they can tap to read.</p>
          </div>
        </li>
        <li class="cn-card cn-card--wide" data-tone="blue" data-reveal>
          <div class="cn-card__stage"><ShowcaseVisual name="child-family-bible" label="Psalm 23 shared in Family Bible, with a thought from Ellie on verse 1 and a reply from Mom" /></div>
          <div class="cn-card__text">
            <h3>Read a chapter together</h3>
            <p>You share it in Family Bible. They say what they think about a verse, and you answer right there.</p>
          </div>
        </li>
        <li class="cn-card cn-card--wide" data-tone="purple" data-reveal>
          <div class="cn-card__stage"><ShowcaseVisual name="child-verse-sticker" label="Psalm 23 in My Bible with a heart sticker beside verse 1 and a seedling beside verse 2" /></div>
          <div class="cn-card__text">
            <h3>Stickers on the verses they love</h3>
            <p>In My Bible they can highlight a verse and stick something next to it. Those stay theirs.</p>
          </div>
        </li>
        <li class="cn-card" data-tone="yellow" data-reveal>
          <div class="cn-card__stage"><ShowcaseVisual name="child-look-back" label="A Look back question: fill in the missing word in Psalm 23:3 from three word tiles" /></div>
          <div class="cn-card__text">
            <h3>What they marked comes back</h3>
            <p>Look back brings back a few notes and verses a day. Pick the missing word, put verses in order, find what changed. All taps, no typing, no score.</p>
          </div>
        </li>
      </ul>
    </section>

    {/* ── Parents ──────────────────────────────────────────────────────── */}
    <section class="nx-wrap cn-parents" aria-labelledby="cn-parents-title">
      <div class="cn-parents__text">
        <h2 id="cn-parents-title" class="nx-title">You're in charge.</h2>
        <p class="cn-p">You'll set it up from Settings › My Family, and it stays yours to manage.</p>
        <ol class="cn-steps">
          <li><b>Confirm you're an adult.</b> <button type="button" class="cn-kws-open" data-cn-kws-open aria-haspopup="dialog">Kids Web Services <AppIcon name="circle-info" /></button> checks this for us.</li>
          <li><b>See how we protect them.</b> One short page, before anything is saved.</li>
          <li><b>Give permission and name it.</b> A first name or nickname is all we ask for.</li>
        </ol>
        <p class="cn-p">
          Then choose the translations and chapters they read, approve your church's kids ministry
          reading, read and download their notes, and end sessions or delete the notebook whenever
          you want.
        </p>
      </div>
      <div class="cn-parents__stage nx-mesh nx-mesh--violet" data-reveal="scale">
        <ShowcaseVisual name="child-parent-manage" label="Manage Ellie's notebook: Family Bible, Ministry, Notes, and Privacy and sessions, with End all sessions" />
      </div>
    </section>

    {/* ── Never ────────────────────────────────────────────────────────── */}
    <section class="nx-wrap cn-never" aria-labelledby="cn-never-title">
      <div class="cn-head">
        <h2 id="cn-never-title" class="nx-title">What's never in a child notebook.</h2>
        <p class="nx-lead">
          Nothing in it is public, and ministry leaders can't see your child's notes or profile.
          The details are in our <a href="/privacy/children/">children's privacy policy</a>.
        </p>
      </div>
      <ul class="cn-never__list" role="list" data-reveal="stagger">
        {NEVER.map((n) => (
          <li><AppIcon name="ban" /> {n}</li>
        ))}
      </ul>
    </section>

    {/* ── Good to know ─────────────────────────────────────────────────── */}
    <section class="nx-wrap cn-facts" aria-label="Good to know">
      <div class="cn-fact" data-tone="pink">
        <span class="cn-fact__icon"><AppIcon name="tablet-screen-button" /></span>
        <h3>Shared devices work too</h3>
        <p>Hand over your device in child mode. When they tap “I'm all done”, it comes back to you.</p>
      </div>
      <div class="cn-fact" data-tone="green">
        <span class="cn-fact__icon"><AppIcon name="book-bible" /></span>
        <h3>Bibles for young readers</h3>
        <p>ERV, CEV and NLV to start, plus any other translation you add.</p>
      </div>
      <div class="cn-fact" data-tone="blue">
        <span class="cn-fact__icon"><AppIcon name="globe" /></span>
        <h3>On the web, in the US</h3>
        <p>Included with Harvous Plus, for families in the United States for now.</p>
      </div>
    </section>

    {faqs.length > 0 && (
      <section class="nx-wrap cn-faq" aria-labelledby="cn-faq-title">
        <div class="cn-faq__side">
          <h2 id="cn-faq-title" class="nx-title cn-faq__title">Questions parents ask</h2>
          <p class="cn-faq__lead">The common ones are here. Ask anything else below.</p>
          <AskHarvous class="cn-faq__ask" placeholder="Ask about child notebooks" />
        </div>
        <div class="cn-faq__list">
          {faqs.map((f) => (
            <FaqItem id={faqId(f.question)} question={f.question}>
              <p>{f.answer}</p>
            </FaqItem>
          ))}
        </div>
      </section>
    )}
  </article>

  <dialog class="cn-kws" data-cn-kws aria-labelledby="cn-kws-title">
    <div class="cn-kws__head">
      <span class="cn-kws__icon" aria-hidden="true"><AppIcon name="shield-halved" /></span>
      <h2 id="cn-kws-title">What is Kids Web Services?</h2>
      <button type="button" class="cn-kws__close" data-cn-kws-close aria-label="Close"><AppIcon name="xmark" /></button>
    </div>
    <p>
      Kids Web Services (KWS) is a service from Epic Games that checks a parent is an adult before a
      child's account is set up. Harvous uses it so we don't have to collect those details ourselves.
    </p>
    <ul class="cn-kws__list">
      <li><AppIcon name="envelope" /><span><b>A link by email.</b> When you start a notebook, KWS emails the address on your Harvous account.</span></li>
      <li><AppIcon name="id-card" /><span><b>You pick how to verify.</b> Depending on the method, KWS may ask for a payment card or identifying details, such as a Social Security number.</span></li>
      <li><AppIcon name="eye-slash" /><span><b>We only get the answer.</b> Harvous never sees those details, just whether you're verified.</span></li>
      <li><AppIcon name="hand"/><span><b>Verifying isn't permission.</b> Afterward you still read how we protect your child, and agree yourself.</span></li>
    </ul>
    <p class="cn-kws__fine">
      KWS may remember that you're verified, so it's quicker next time, under its own privacy policy.
      More in our <a href="/privacy/children/">children's privacy policy</a>.
    </p>
  </dialog>

  <ClosingCall
    title={page.closingHeading}
    lead={page.closingLead}
    href={page.closingHref}
    label={page.closingLabel}
  />
</NextLayout>

<script>
  /* Kids Web Services: a short explainer in a dialog. */
  const kws = document.querySelector<HTMLDialogElement>("[data-cn-kws]");
  document.querySelector("[data-cn-kws-open]")?.addEventListener("click", () => kws?.showModal());
  kws?.querySelector("[data-cn-kws-close]")?.addEventListener("click", () => kws.close());
  /* A click on the backdrop (outside the box) closes it too. */
  kws?.addEventListener("click", (event) => {
    if (event.target === kws) kws.close();
  });

  /* The cover studio: each button sets one thing on the cover. */
  for (const studio of document.querySelectorAll<HTMLElement>(".cn-studio")) {
    const cover = studio.querySelector<HTMLElement>("[data-cn-cover]");
    if (!cover) continue;
    studio.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-cn-set]");
      if (!button) return;
      const what = button.dataset.cnSet!;
      const value = button.dataset.value!;
      for (const b of studio.querySelectorAll<HTMLButtonElement>(`[data-cn-set="${what}"]`)) {
        b.setAttribute("aria-pressed", String(b === button));
      }
      if (what === "sticker") {
        for (const e of cover.querySelectorAll<HTMLElement>("[data-cn-emblem]")) e.hidden = e.dataset.cnEmblem !== value;
        cover.classList.remove("is-stuck");
        void cover.offsetWidth;
        cover.classList.add("is-stuck");
      } else {
        cover.dataset[what] = value;
        /* The sticker sheet and pattern samples follow the chosen color. */
        if (what === "color") studio.dataset.color = value;
      }
    });
  }
</script>

<style>
  /* ── Colors: the app's thread hues. A notebook and its stickers are things
     on a desk, so they keep one bright, saturated version of each hue in both
     themes (relative color: fixed lightness, chroma lifted), where the app's
     pastel would read dusty at this size. ── */
  [data-color="blue"], [data-tone="blue"] { --c: var(--pds-thread-blue); }
  [data-color="green"], [data-tone="green"] { --c: var(--pds-thread-green); }
  [data-color="purple"], [data-tone="purple"] { --c: var(--pds-thread-purple); }
  [data-color="pink"], [data-tone="pink"] { --c: var(--pds-thread-pink); }
  [data-color="orange"], [data-tone="orange"] { --c: var(--pds-thread-orange); }
  [data-color="yellow"], [data-tone="yellow"] { --c: var(--pds-thread-yellow); }
  /* Warm hues go muddy at the shared lightness; they sit higher, like a real yellow notebook. */
  [data-color="blue"], [data-color="green"], [data-color="purple"], [data-color="pink"] { --cover-l: 0.66; }
  [data-color="yellow"] { --cover-l: 0.8; }
  [data-color="orange"] { --cover-l: 0.74; }

  .cn { --c: var(--pds-thread-blue); }
  .cn-hand { margin: 0; font-size: 1.5rem; line-height: 1.2; color: var(--color-ink-soft); }

  /* ── Hero ── */
  .cn-hero { padding-top: clamp(7.5rem, 15vw, 10rem); text-align: center; }
  .cn-crumb {
    display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.25rem;
    padding: 0.25rem; border-radius: 999px; background: var(--color-warm); font-size: 0.875rem; font-weight: 500;
  }
  .cn-crumb__back {
    display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.75rem 0.35rem 0.55rem;
    border-radius: 999px; color: var(--color-ink-soft); text-decoration: none;
  }
  .cn-crumb__back:hover { color: var(--color-ink); background: color-mix(in srgb, var(--color-ink) 7%, transparent); }
  .cn-crumb__back svg { width: 0.85rem; height: 0.85rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .cn-crumb__here {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.85rem 0.35rem 0.7rem; border-radius: 999px;
    font-weight: 600; color: color-mix(in oklab, var(--study-dock-accent-mintGreen) var(--ink-on-tint, 50%), var(--color-ink));
    background: color-mix(in oklab, var(--study-dock-accent-mintGreen) 16%, var(--color-paper));
  }
  .cn-crumb__here :global(svg) { width: 0.95rem; height: 0.95rem; }
  /* The site's quiet "not yet" label (as on add-on pages): neutral, no dot. */
  .cn-crumb__soon { padding: 0.35rem 0.85rem 0.35rem 0.4rem; border-radius: 999px; font-size: 0.875rem; color: var(--color-ink-soft); }
  .cn-hero__title { margin: 1.5rem auto 0; max-width: 14ch; }
  .cn-hero__lead { margin: 1.25rem auto 0; max-width: 34rem; }
  .cn-hero__acts { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin: 2rem 0 0; }

  /* The desk: a soft stage with the notebook in the middle and stickers around it. */
  .cn-desk {
    position: relative;
    max-width: 60rem;
    height: clamp(22rem, 46vw, 32rem);
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    border-radius: var(--nx-radius-scene);
    background:
      radial-gradient(60% 70% at 50% 45%, color-mix(in oklab, var(--pds-thread-green) 40%, transparent), transparent 70%),
      radial-gradient(40% 50% at 10% 10%, color-mix(in oklab, var(--pds-thread-pink) 45%, transparent), transparent 70%),
      radial-gradient(40% 50% at 92% 88%, color-mix(in oklab, var(--pds-thread-yellow) 50%, transparent), transparent 70%),
      color-mix(in oklab, var(--pds-thread-blue) 22%, var(--color-paper));
    overflow: hidden;
  }
  .cn-desk__note { position: absolute; right: 7%; top: 40%; transform: rotate(-6deg); }
  @media (max-width: 40rem) { .cn-desk__note { display: none; } }

  /* ── The notebook cover ── */
  .cn, .cn-cover, .cn-sticker, .cn-swatch {
    --cover: oklch(from var(--c) var(--cover-l, 0.66) calc(c * 1.7) h);
    --sticker: oklch(from var(--c) 0.9 calc(c * 1.3) h);
    --sticker-ink: oklch(from var(--c) 0.48 calc(c * 2) h);
  }
  .cn-cover {
    --ink: var(--cover);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: clamp(13rem, 26vw, 17rem);
    aspect-ratio: 4 / 5;
    padding: 0; /* the sticker sits dead center on the face (the spine is the border) */
    border-left: 14px solid oklch(from var(--cover) calc(l - 0.12) c h);
    border-radius: 5px 18px 18px 5px;
    background: var(--ink);
    color: var(--pds-on-accent);
    box-shadow:
      6px 6px 0 -1px var(--pds-bg-page),
      6px 6px 0 0 var(--pds-border),
      0 30px 60px -24px rgba(15, 23, 42, 0.5);
  }
  .cn-cover::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0.14;
    pointer-events: none;
  }
  .cn-cover[data-pattern="dots"]::before { background-image: radial-gradient(var(--pds-on-accent) 1.5px, transparent 1.5px); background-size: 12px 12px; }
  .cn-cover[data-pattern="stripes"]::before { background-image: repeating-linear-gradient(135deg, var(--pds-on-accent) 0 2px, transparent 2px 12px); }
  .cn-cover[data-pattern="gingham"]::before { background-image: repeating-linear-gradient(90deg, var(--pds-on-accent) 0 6px, transparent 6px 12px), repeating-linear-gradient(0deg, var(--pds-on-accent) 0 6px, transparent 6px 12px); }
  .cn-cover--hero { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(-4deg); }
  @media (max-width: 40rem) {
    .cn-cover--hero { width: 10.5rem; border-left-width: 10px; }
    .cn-cover--hero .cn-cover__emblem { width: 4.25rem; border-width: 3px; border-radius: 1rem; }
  }

  .cn-cover__emblem {
    display: grid; place-items: center;
    width: clamp(5rem, 9vw, 6.25rem); aspect-ratio: 1;
    border: 4px solid #fff;
    border-radius: 1.4rem;
    color: var(--sticker-ink);
    background: var(--sticker);
    box-shadow: 0 6px 14px -4px rgba(15, 23, 42, 0.4);
    transform: rotate(6deg);
  }
  .cn-cover__emblem > span { display: grid; place-items: center; width: 100%; height: 100%; }
  /* "My initial": the child's first letter, set like the app's cover emblem. */
