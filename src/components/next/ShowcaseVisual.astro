  .sv__swatches .is-on { box-shadow: 0 0 0 2px var(--pds-bg-main), 0 0 0 3.5px var(--pds-text-primary); }
  .is-neutral { background: var(--pds-highlight-neutral); } .is-amber { background: var(--pds-highlight-warm-amber); } .is-sky { background: var(--pds-highlight-sky-blue); } .is-violet { background: var(--pds-highlight-violet); } .is-mint { background: var(--pds-highlight-mint-green); } .is-coral { background: var(--pds-highlight-coral-rose); }
