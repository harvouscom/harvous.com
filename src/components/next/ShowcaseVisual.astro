  .sv__link span:not(.sv__btn) { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sv__link :global(svg), .sv__row :global(svg) { width: 12px; height: 12px; color: var(--pds-text-secondary); }
  .sv__row { display: flex; align-items: center; gap: 8px; margin-top: 12px !important; font-size: 13px; color: var(--pds-text-primary); }
  .sv__row--soft { color: var(--pds-text-secondary); }
  .sv__switch { position: relative; width: 34px; height: 20px; margin-left: auto; border-radius: 999px; background: var(--pds-bg-track); }
  .sv__switch i { position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: var(--pds-shadow-track-knob); }
  .sv__switch.is-on { background: var(--pds-accent); }
  .sv__switch.is-on i { transform: translateX(14px); }

  /* Scripture pill, opened */
  .sv__pill-on { box-shadow: 0 0 0 2px color-mix(in srgb, var(--pds-accent) 45%, transparent) !important; }
  .sv__verse-pop { width: 90%; margin: -16px 0 0 auto; position: relative; }
  .sv__vhead { display: flex; align-items: center; justify-content: space-between; }
  .sv__vhead b { font-size: 14px; font-weight: 600; color: var(--pds-text-primary); }
  .sv__tr { display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 8px; font-size: 11.5px; font-weight: 600; background: var(--pds-bg-chip); }
  .sv__tr :global(svg) { width: 8px; height: 8px; }
  .sv__trs { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px !important; }
  .sv__trs span { padding: 3px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; color: var(--pds-text-secondary); background: var(--pds-bg-chip); }
  .sv__trs .is-on { color: var(--pds-on-accent); background: var(--pds-accent); }

