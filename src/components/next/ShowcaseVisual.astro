  .sv__hl { padding: 0 2px; border-radius: 3px; color: var(--pds-text-primary); background: color-mix(in srgb, var(--pds-highlight-warm-amber) 38%, transparent); box-shadow: inset 0 -2px 0 var(--pds-highlight-warm-amber); }
  .sv__note { display: grid; gap: 8px; justify-items: end; margin-top: -4px; }
