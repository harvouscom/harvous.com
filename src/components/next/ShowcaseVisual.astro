  .sv__head small { display: block; font-size: 12px; color: var(--pds-text-secondary); }

  /* Threads: connected notes in order, on a line. */
  .sv__thread { position: relative; margin: 12px 0 0; padding: 0; list-style: none; }
  .sv__thread::before { content: ""; position: absolute; left: 6px; top: 10px; bottom: 10px; width: 2px; border-radius: 2px; background: color-mix(in srgb, var(--pds-text-primary) 16%, transparent); }
  .sv__thread li { position: relative; display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 12px; align-items: center; padding: 6px 8px 6px 0; border-radius: 10px; }
  .sv__thread li.is-on { background: var(--pds-bg-row-selected); }
