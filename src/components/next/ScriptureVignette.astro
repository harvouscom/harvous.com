---
/**
 * ScriptureVignette — a corner of a real note: the breadcrumb, a title, a
 * highlighted line, and a reference being typed that turns into a scripture
 * pill the way it does in the editor (neutral chip, small translation label —
 * see next-app-ui.css and tour-write).
 *
 * Starts when scrolled into view, loops while visible, and holds on the pill
 * for reduced motion.
 */
import AppIcon from "./app/AppIcon.astro";

interface Props {
  reference?: string;
  translation?: string;
  class?: string;
  style?: string;
}

const { reference = "John 3:16", translation = "NLT", class: className, style } = Astro.props;
---

<div class:list={["aui aui-paper svig", className]} style={style} data-svig data-ref={reference} aria-hidden="true">
  <p class="aui-crumb"><AppIcon name="house" /> In My Home</p>
  <p class="aui-h">Love goes first</p>
  <p><span class="aui-hl">God didn't wait for us to come around.</span></p>
  <p class="svig__line">
    He gave first.
    <span class="svig__typed" data-svig-typed></span><span class="svig__caret"></span>
    <span class="aui-pill svig__pill">{reference} <span class="aui-tr">{translation}</span></span>
  </p>
</div>

<style>
  .svig {
    width: min(21rem, 88%);
  }
  .svig__line { min-height: 1.6em; }
  .svig__typed { color: var(--pds-text-primary); }
  .svig__caret {
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 1px;
    vertical-align: -0.15em;
    background: var(--pds-text-primary);
    animation: svig-blink 1s steps(1) infinite;
  }
  .svig__pill { display: none; }

  .svig.is-pill .svig__typed,
  .svig.is-pill .svig__caret { display: none; }
  .svig.is-pill .svig__pill {
    display: inline-flex;
    animation: svig-pop 360ms var(--nx-ease, ease);
  }

  @keyframes svig-blink { 50% { opacity: 0; } }
  @keyframes svig-pop {
    from { transform: scale(0.9); opacity: 0.3; }
    to { transform: none; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .svig__caret { animation: none; }
    .svig.is-pill .svig__pill { animation: none; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  document.querySelectorAll<HTMLElement>("[data-svig]").forEach((root) => {
    const typed = root.querySelector<HTMLElement>("[data-svig-typed]")!;
    const ref = root.dataset.ref ?? "";
    if (reduce || !("IntersectionObserver" in window)) {
      root.classList.add("is-pill");
      return;
    }

    let visible = false;
    let running = false;
    const loop = async () => {
      if (running) return;
      running = true;
      while (visible) {
        root.classList.remove("is-pill");
        typed.textContent = "";
        await wait(800);
        for (const ch of ref) {
          typed.textContent += ch;
          await wait(80 + Math.random() * 60);
        }
        await wait(500);
        root.classList.add("is-pill");
        await wait(3800);
      }
      running = false;
    };

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible) loop();
      },
      { threshold: 0.4 }
    ).observe(root);
  });
</script>
