---
/**
 * AppWindow — the Harvous shell, rebuilt in HTML from the live app: the three
 * view toggles top left (Activity · Bible · Write), Search in the middle, the
 * avatar top right, and the view in the slot. Real sizes from the app's own
 * --pds-* tokens (next-app-ui.css), so every view drawn inside it reads as the
 * app, not an illustration of it. Content comes from Derek's own account
 * (read from app.harvous.com, September 2026).
 */
import AppIcon from "./AppIcon.astro";

interface Props {
  view?: "activity" | "bible" | "write";
  /** Show the right-side toolbar icons the note view has (share, more…). */
  noteTools?: boolean;
  class?: string;
}

const { view = "activity", noteTools = false, class: className } = Astro.props;
const TABS = [
  { key: "activity", icon: "fa7-solid:house" },
  { key: "bible", icon: "fa7-solid:book-open" },
  { key: "write", icon: "fa7-solid:pen-to-square" },
];
---

<div class:list={["aui aw", className]}>
  <div class="aw__bar">
    <span class="aw__tabs">
      {TABS.map((t) => (
        <span class:list={["aw__tab", t.key === view && "is-on"]}><AppIcon name={t.icon} /></span>
      ))}
    </span>
    <span class="aw__search"><AppIcon name="magnifying-glass" /> Search</span>
    <span class="aw__right">
      {noteTools && (
        <>
          <span class="aw__tool"><AppIcon name="magnifying-glass" /></span>
          <span class="aw__tool"><AppIcon name="share" /></span>
          <span class="aw__tool"><AppIcon name="ellipsis-vertical" /></span>
        </>
      )}
      <span class="aw__tool"><AppIcon name="table-columns" /></span>
      <img class="aw__avatar" src="/derek-avatar.webp" alt="" width="64" height="64" loading="lazy" />
    </span>
  </div>
  <div class="aw__body"><slot /></div>
</div>

<style>
  .aw {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--pds-canvas-default);
    font-size: 14px;
  }
  .aw__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 10px 12px;
    flex-shrink: 0;
  }
  .aw__tabs {
    justify-self: start;
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 11px;
    background: var(--pds-bg-chip);
  }
  .aw__tab {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 10px;
    color: var(--pds-text-primary);
  }
  .aw__tab.is-on { background: var(--pds-bg-main); box-shadow: var(--pds-shadow-card); }
  .aw__tab :global(svg) { width: 17px; height: 17px; }
  .aw__tab:first-child :global(svg) { width: 16px; height: 16px; }
  .aw__search {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 13px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--pds-text-primary);
    background: var(--pds-bg-main);
    box-shadow: 0 0 0 0.5px var(--pds-border);
  }
  .aw__search :global(svg) { width: 15px; height: 15px; }
  .aw__right { justify-self: end; display: inline-flex; align-items: center; gap: 10px; }
  .aw__tool { display: grid; place-items: center; color: var(--pds-text-primary); }
  .aw__tool :global(svg) { width: 17px; height: 17px; }
  .aw__avatar { width: 28px; height: 28px; border-radius: 999px; object-fit: cover; }
  .aw__body { position: relative; flex: 1; min-height: 0; overflow: hidden; }
</style>
