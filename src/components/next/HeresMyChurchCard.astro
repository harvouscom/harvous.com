---
/**
 * HeresMyChurchCard — a way out to Here's My Church (heresmychurch.com), the
 * open-source, crowd-sourced church map we make alongside Harvous. It wears
 * HMC's colours (the night-purple ground, the lilac "h" app icon) in Harvous's
 * type, with a quiet tile map of the states and one
 * pin that drops in. Kept deliberately spare: one line of brand, a headline,
 * a sentence, one button.
 *
 * Colours are fixed (not theme tokens), so it reads the same in dark mode.
 * Used on /for/churches/. (On /about/, Here's My Church sits inside the
 * open-source card instead, as our other open project.)
 */

const HMC_URL = "https://heresmychurch.com";

const copy = {
  kicker: "Our other project, also open source",
  title: "A crowd-sourced map of churches.",
  body: "Here's My Church is free to browse, with no account needed, and anyone can add or correct a church. Check that yours is on it.",
  cta: "Find your church",
};

/* A tile-grid cartogram of the states (+ DC): [row, col]. */
const STATES: [string, number, number][] = [
  ["AK", 0, 0], ["ME", 0, 10],
  ["WI", 1, 5], ["VT", 1, 9], ["NH", 1, 10],
  ["WA", 2, 0], ["ID", 2, 1], ["MT", 2, 2], ["ND", 2, 3], ["MN", 2, 4], ["IL", 2, 5], ["MI", 2, 6], ["NY", 2, 8], ["MA", 2, 9],
  ["OR", 3, 0], ["NV", 3, 1], ["WY", 3, 2], ["SD", 3, 3], ["IA", 3, 4], ["IN", 3, 5], ["OH", 3, 6], ["PA", 3, 7], ["NJ", 3, 8], ["CT", 3, 9], ["RI", 3, 10],
  ["CA", 4, 0], ["UT", 4, 1], ["CO", 4, 2], ["NE", 4, 3], ["MO", 4, 4], ["KY", 4, 5], ["WV", 4, 6], ["VA", 4, 7], ["MD", 4, 8], ["DE", 4, 9],
  ["AZ", 5, 1], ["NM", 5, 2], ["KS", 5, 3], ["AR", 5, 4], ["TN", 5, 5], ["NC", 5, 6], ["SC", 5, 7], ["DC", 5, 8],
  ["OK", 6, 3], ["LA", 6, 4], ["MS", 6, 5], ["AL", 6, 6], ["GA", 6, 7],
  ["HI", 7, 0], ["TX", 7, 3], ["FL", 7, 8],
];
const CELL = 30;
const GAP = 4;
const step = CELL + GAP;
/* The pin lands on Missouri, near the middle; tiles glow brighter the closer
   they sit to it, so the map reads as one shape lit from the pin. */
const PIN: [number, number] = [4, 4];
const tiles = STATES.map(([id, r, c]) => {
  const d = Math.hypot(r - PIN[0], c - PIN[1]);
  return {
    id,
    x: c * step,
    y: r * step,
    glow: Math.max(0, 1 - d / 6),
  };
}).filter((t) => t.id !== "MO");
const W = 11 * step - GAP;
const H = 8 * step - GAP;
const homeX = PIN[1] * step;
const homeY = PIN[0] * step;
const pinX = homeX + CELL / 2;
const pinY = homeY + CELL / 2;
const uid = "hmc";
---

<aside class="hmc" aria-labelledby="hmc-title" data-reveal>
  <div class="hmc__text">
    <p class="hmc__brand">
      <img class="hmc__icon" src="/images/heresmychurch-icon.webp" alt="" width="36" height="36" loading="lazy" />
      <span class="hmc__brand-text">
        <span class="hmc__name">Here's My Church</span>
        <span class="hmc__kicker">{copy.kicker}</span>
      </span>
    </p>
    <h2 id="hmc-title" class="hmc__title">{copy.title}</h2>
    <p class="hmc__body">{copy.body}</p>
    <p class="hmc__actions">
      <a class="hmc__btn" href={HMC_URL} target="_blank" rel="noopener">
        {copy.cta}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" /></svg>
      </a>
    </p>
  </div>

  <div class="hmc__map" aria-hidden="true">
    <svg class="hmc__svg" viewBox={`-4 -26 ${W + 8} ${H + 30}`}>
      <defs>
        <linearGradient id={`${uid}-tile`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#d8b4fe" />
          <stop offset="1" stop-color="#a855f7" />
        </linearGradient>
        <linearGradient id={`${uid}-home`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#c084fc" />
          <stop offset="1" stop-color="#7e22ce" />
        </linearGradient>
        <linearGradient id={`${uid}-pin`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="1" stop-color="#e9d5ff" />
        </linearGradient>
        <radialGradient id={`${uid}-halo`}>
          <stop offset="0" stop-color="#a855f7" stop-opacity="0.55" />
          <stop offset="1" stop-color="#a855f7" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx={pinX} cy={pinY} r="70" fill={`url(#${uid}-halo)`} />
      {tiles.map((t, i) => (
        <rect
          class="hmc__tile"
          style={`--i: ${i};`}
          x={t.x + 0.5}
          y={t.y + 0.5}
          width={CELL - 1}
          height={CELL - 1}
          rx="7"
          fill={`url(#${uid}-tile)`}
          fill-opacity={(0.2 + 0.4 * t.glow).toFixed(2)}
        />
      ))}
      <rect class="hmc__home" x={homeX} y={homeY} width={CELL} height={CELL} rx="7" fill={`url(#${uid}-home)`} />
      <ellipse class="hmc__shadow" cx={pinX} cy={pinY + 2} rx="9" ry="3" />
      <g class="hmc__pin">
        <path
          transform={`translate(${pinX - 15} ${pinY - 38}) scale(1.15)`}
          d="M13 0C5.8 0 0 5.7 0 12.8 0 22.4 13 34 13 34s13-11.6 13-21.2C26 5.7 20.2 0 13 0z"
          fill={`url(#${uid}-pin)`}
        />
        <circle cx={pinX} cy={pinY - 23.3} r="5.2" class="hmc__pin-eye" />
      </g>
    </svg>
  </div>
</aside>

<style>
  .hmc {
    --hmc-ink: #1e1040;
    --hmc-lilac: #c9a0dc;
    --hmc-bright: #a855f7;
    --hmc-cream: #f5f0e8;
    display: grid;
    gap: 2rem;
    overflow: hidden;
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.75rem;
    color: var(--hmc-cream);
    background: radial-gradient(70% 90% at 80% 50%, #2c1660, transparent 70%), var(--hmc-ink);
  }
  @media (min-width: 48rem) {
    .hmc { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: center; gap: 3rem; }
  }

  .hmc__brand { display: flex; align-items: center; gap: 0.7rem; margin: 0; }
  .hmc__icon { width: 36px; height: 36px; border-radius: 9px; box-shadow: 0 0 0 1px rgba(201, 160, 220, 0.18); }
  .hmc__brand-text { display: grid; gap: 0.05rem; line-height: 1.25; }
  .hmc__name { font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; color: var(--hmc-cream); }
  .hmc__kicker { font-size: 0.8125rem; color: color-mix(in srgb, var(--hmc-cream) 58%, transparent); }
  .hmc__title {
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--hmc-cream);
    text-wrap: balance;
  }
  .hmc__body {
    max-width: 24rem;
    margin: 0.6rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--hmc-cream) 70%, transparent);
    text-wrap: pretty;
  }
  .hmc__actions { margin: 1.5rem 0 0; }
  .hmc__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.05rem 0.6rem 1.15rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    color: #fff;
    background: linear-gradient(135deg, #b46cf8 0%, #8b3fd9 55%, #6b21a8 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 8px 20px -8px rgba(168, 85, 247, 0.75);
    text-decoration: none;
    transition: filter 200ms ease, box-shadow 200ms ease;
  }
  .hmc__btn:hover { filter: brightness(1.08); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 10px 24px -8px rgba(168, 85, 247, 0.9); }
  .hmc__btn:focus-visible { outline: 2px solid var(--hmc-cream); outline-offset: 3px; }
  .hmc__btn svg { width: 0.8rem; height: 0.8rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 200ms ease; }
  .hmc__btn:hover svg { transform: translate(1px, -1px); }

  /* ── The map: one quiet shape, one pin ───────────────────────────────── */
  .hmc__map { order: -1; }
  @media (min-width: 48rem) { .hmc__map { order: 0; } }
  .hmc__svg { display: block; width: 100%; max-height: 16rem; overflow: visible; }
  .hmc__tile { stroke: rgba(255, 255, 255, 0.08); stroke-width: 1; }
  .hmc__home { filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.7)); }
  .hmc__shadow { fill: rgba(10, 4, 30, 0.55); }
  .hmc__pin path { filter: drop-shadow(0 4px 6px rgba(20, 8, 50, 0.5)); }
  .hmc__pin-eye { fill: #7e22ce; }

  /* Tiles settle in, then the pin drops — once. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hmc .hmc__tile { opacity: 0; transition: opacity 600ms ease; transition-delay: calc(var(--i) * 10ms); }
    :global(html.js) .hmc.revealed .hmc__tile { opacity: 1; }
    :global(html.js) .hmc .hmc__pin { opacity: 0; transform: translateY(-40px); }
    :global(html.js) .hmc.revealed .hmc__pin { animation: hmc-drop 600ms cubic-bezier(0.3, 1.3, 0.5, 1) 700ms forwards; }
    :global(html.js) .hmc .hmc__shadow { opacity: 0; transition: opacity 400ms ease 1000ms; }
    :global(html.js) .hmc.revealed .hmc__shadow { opacity: 1; }
  }
  @keyframes hmc-drop {
    0% { opacity: 0; transform: translateY(-40px); }
    50% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }
</style>
