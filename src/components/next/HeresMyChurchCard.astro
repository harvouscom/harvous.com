---
/**
 * HeresMyChurchCard — a way out to Here's My Church (heresmychurch.com), the
 * open-source, crowd-sourced church map we make alongside Harvous. A slim
 * callout on a violet mesh: the tile map with its pin, one question, one
 * sentence, one button. It sits among the church scenes, right after
 * "Invite with a link", where finding your church is already the subject.
 *
 * Used on /for/churches/. (On /about/, Here's My Church sits inside the
 * open-source card instead, as our other open project.)
 */
import HmcMap from "./HmcMap.astro";

const HMC_URL = "https://heresmychurch.com";

const copy = {
  kicker: "Here's My Church · our other project",
  title: "Is your church on the map?",
  body: "A free, open-source, crowd-sourced map of churches. No account needed to browse, and anyone can add or correct one.",
  cta: "Find your church",
};
---

<aside class="hmc nx-mesh nx-mesh--violet" aria-labelledby="hmc-title" data-reveal>
  <div class="hmc__map" aria-hidden="true">
    <HmcMap uid="hmc" />
  </div>

  <div class="hmc__text">
    <p class="hmc__brand">
      <img class="hmc__icon" src="/images/heresmychurch-icon.webp" alt="" width="20" height="20" loading="lazy" />
      {copy.kicker}
    </p>
    <h2 id="hmc-title" class="hmc__title">{copy.title}</h2>
    <p class="hmc__body">{copy.body}</p>
  </div>

  <a class="hmc__btn" href={HMC_URL} target="_blank" rel="noopener">
    {copy.cta}
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" /></svg>
  </a>
</aside>

<style>
  .hmc {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.9rem 1.25rem;
    align-items: center;
    max-width: 46rem;
    margin-inline: auto;
    padding: 1rem 1.25rem;
    border-radius: 1.25rem;
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 6%, transparent);
  }
  @media (min-width: 40rem) {
    .hmc { grid-template-columns: 7rem minmax(0, 1fr) auto; padding: 1.1rem 1.5rem 1.1rem 1.25rem; gap: 1.5rem; }
  }

  .hmc__brand {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .hmc__icon { width: 20px; height: 20px; border-radius: 5px; }
  .hmc__title {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .hmc__body {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }
  .hmc__btn {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.95rem 0.55rem 1.05rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: #fff;
    background: linear-gradient(135deg, #b46cf8 0%, #8b3fd9 55%, #6b21a8 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 8px 18px -10px rgba(126, 34, 206, 0.6);
    text-decoration: none;
    transition: filter 200ms ease, box-shadow 200ms ease;
  }
  @media (min-width: 40rem) { .hmc__btn { grid-column: auto; } }
  .hmc__btn:hover { filter: brightness(1.08); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 10px 22px -10px rgba(126, 34, 206, 0.75); }
  .hmc__btn:focus-visible { outline: 2px solid #8b3fd9; outline-offset: 3px; }
  .hmc__btn svg { width: 0.75rem; height: 0.75rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 200ms ease; }
  .hmc__btn:hover svg { transform: translate(1px, -1px); }
</style>
