---
/**
 * NextFooter — where everything the pill nav left out still lives: the use-case
 * and audience hubs, compare, the blog, release notes. Small uppercase column
 * labels, and a maker line instead of a company line.
 */
import OptimizedImage from "../OptimizedImage.astro";

const year = new Date().getFullYear();

const groups = [
  {
    label: "Product",
    links: [
      { label: "Tour", href: "/tour/" },
      { label: "Discover", href: "/discover/" },
      { label: "Pricing", href: "/pricing/" },
      { label: "Release notes", href: "/release-notes/" },
      { label: "What's new in 3", href: "/3/" },
    ],
  },
  {
    label: "Use it for",
    links: [
      { label: "Use cases", href: "/use-cases/" },
      { label: "Who it's for", href: "/for/" },
      { label: "Churches", href: "/for/churches/" },
      { label: "Compare", href: "/compare/" },
    ],
  },
  {
    label: "Company",
    links: [
      { label: "About", href: "/about/" },
      { label: "Now", href: "/now/" },
      { label: "Blog", href: "/blog/" },
      { label: "Email Derek", href: "mailto:derek@harvous.com" },
    ],
  },
  {
    label: "Help",
    links: [
      { label: "Support", href: "/support/" },
      { label: "Status", href: "https://status.harvous.com/" },
      { label: "Privacy", href: "/privacy/" },
      { label: "Terms", href: "/terms/" },
    ],
  },
];
---

<footer class="nxf" data-hides-sticky>
  <div class="nx-wrap">
    <div class="nxf__top">
      <div class="nxf__maker">
        <span class="nxf__face">
          <OptimizedImage src="/derek-avatar.jpeg" alt="Derek as a kid" width={96} height={96} class="nxf__avatar" />
          {/* A pen note in the margin, like the ones on the home page's scenes. */}
          <span class="nxf__kid nx-hand" aria-hidden="true">
            <svg viewBox="-30 -30 60 60" class="nxf__kid-arrow">
              <g transform="scale(-1,1)">
                <path d="M-18 -20 C -14 2, 0 12, 16 16" />
                <path d="M6 19 L16 16 L12 7" />
              </g>
            </svg>
            this is me as a kid :)
          </span>
        </span>
        <p>
          Made by <a href="/about/">Derek Castelli</a>, one person with a Bible and too many
          notes. <a href="mailto:derek@harvous.com">I read every email.</a>
        </p>
      </div>
      <nav class="nxf__cols" aria-label="Footer">
        {groups.map((g) => (
          <div>
            <p class="nx-kicker">{g.label}</p>
            <ul>
              {g.links.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="nxf__legal">
      <p>
        © {year} <a href="https://testamentmade.com">Testament Made LLC</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/harvouscom/harvous.com/blob/main/LICENSE" rel="license">CC BY 4.0</a>
      </p>
      <p>Named for Proverbs 25:2</p>
    </div>
  </div>
</footer>

<style>
  .nxf {
    padding: clamp(4rem, 8vw, 6rem) 0 calc(2.5rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-rule);
    background: var(--color-paper);
  }
  .nxf__top {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 56rem) {
    .nxf__top { grid-template-columns: minmax(14rem, 1fr) 2.4fr; gap: 4rem; }
  }
  .nxf__maker {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    max-width: 20rem;
  }
  .nxf__maker p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .nxf__maker a { color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: 0.2em; }
  .nxf__maker a:hover { text-decoration-color: currentColor; }
  .nxf__maker > :global(picture) { flex-shrink: 0; }
  .nxf__face { position: relative; flex-shrink: 0; }
  .nxf__maker {
    /* Room above the photo for the note. */
    padding-top: 1.75rem;
  }
  .nxf__kid {
    position: absolute;
    left: 2.1rem;
    bottom: calc(100% + 0.1rem);
    display: flex;
    align-items: flex-end;
    gap: 0.1rem;
    white-space: nowrap;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--color-ink-soft);
    transform: rotate(-3deg);
    transform-origin: left bottom;
    pointer-events: none;
  }
  .nxf__kid-arrow {
    width: 1.9rem;
    height: 1.9rem;
    margin-bottom: -0.55rem;
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-ink-soft);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nxf__maker :global(.nxf__avatar) {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .nxf__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .nxf__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .nxf__cols ul {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }
  .nxf__cols a {
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .nxf__cols a:hover { color: var(--color-ink); }

  .nxf__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }
  .nxf__legal p { margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .nxf__legal a { color: inherit; text-decoration: none; }
  .nxf__legal a:hover { color: var(--color-ink); }

</style>
