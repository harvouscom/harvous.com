---
/**
 * NextHeader — one small floating pill, always. The live header is a full bar
 * that becomes a pill on scroll and carries a mega-menu; this one only ever
 * holds five places to go (the blog is Bright Enough) and a way back into the
 * app. Everything else lives
 * in the footer. Trying Harvous is the sticky pill's job, not this one's.
 *
 * Under 40rem the links fold into a menu button, and the panel drops out of
 * the pill in the same glass, with two more places (use cases, compare) that
 * the desktop pill leaves to the footer.
 */
import OptimizedImage from "../OptimizedImage.astro";
import { fathomSignin } from "../../lib/fathom-events.ts";

const links = [
  { href: "/tour/", label: "Tour" },
  { href: "/discover/", label: "Discover" },
  { href: "/blog/", label: "Blog" },
  { href: "/pricing/", label: "Pricing" },
  { href: "/now/", label: "Now" },
];

/* Phone-only extras, for places a phone reader can't reach from the pill. */
const more = [
  { href: "/use-cases/", label: "Use cases" },
  { href: "/compare/", label: "Compare" },
];

const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="nxh">
  <nav class="nxh__pill" aria-label="Primary">
    <a href="/" class="nxh__logo" aria-label="Harvous — Home">
      <OptimizedImage src="/images/harvous-2-icon-sm.png" alt="" width={28} height={28} loading="eager" />
    </a>
    <ul class="nxh__links">
      {links.map((l) => (
        <li>
          <a href={l.href} class="nxh__link" aria-current={path.startsWith(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="https://app.harvous.com/sign-in"
      class="nxh__signin"
      data-fathom-track={fathomSignin.header}
    >
      Sign in
    </a>
    <button
      type="button"
      class="nxh__menu"
      aria-expanded="false"
      aria-controls="nxh-panel"
      aria-label="Open menu"
      data-nxh-toggle
    >
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path class="nxh__bar nxh__bar--a" d="M3.5 5.5h13" />
        <path class="nxh__bar nxh__bar--b" d="M3.5 10h13" />
        <path class="nxh__bar nxh__bar--c" d="M3.5 14.5h13" />
      </svg>
    </button>
  </nav>

  <div id="nxh-panel" class="nxh__panel" hidden data-nxh-panel>
    <ul class="nxh__plist">
      {links.map((l) => (
        <li>
          <a href={l.href} class="nxh__plink" aria-current={path.startsWith(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <ul class="nxh__pmore">
      {more.map((l) => (
        <li>
          <a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .nxh {
    position: fixed;
    inset: 0.75rem 0 auto;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 0.75rem;
    pointer-events: none;
  }
  .nxh__pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    /* More on the left than the top: the pill's round end eats into the
       space beside the square-ish icon, so equal padding looks cramped. */
    padding: 0.35rem 0.35rem 0.35rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-paper) 78%, transparent);
    backdrop-filter: saturate(1.6) blur(18px);
    -webkit-backdrop-filter: saturate(1.6) blur(18px);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-ink) 7%, transparent),
      0 8px 28px -12px rgba(15, 23, 42, 0.22);
  }
  .nxh__logo {
    display: flex;
    flex-shrink: 0;
    margin-right: 0.4rem;
    border-radius: 0.55rem;
    overflow: hidden;
  }
  .nxh__logo :global(img) { width: 28px; height: 28px; display: block; }
  .nxh__links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nxh__link,
  .nxh__signin {
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .nxh__link:hover,
  .nxh__link[aria-current="page"] {
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
  }
  .nxh__signin {
    margin-left: 0.15rem;
    color: var(--color-ink);
    background: var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-rule);
  }
  .nxh__signin:hover { background: var(--color-warm); }

  /* The menu button and its panel: phones only. */
  .nxh__menu {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: 0.15rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }
  .nxh__menu:hover { background: color-mix(in srgb, var(--color-ink) 6%, transparent); }
  .nxh__menu svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  /* Three lines, the middle one fading as the outer two cross into an ×. */
  .nxh__bar { transform-origin: 10px 10px; transition: transform 200ms ease, opacity 150ms ease; }
  .nxh__menu[aria-expanded="true"] .nxh__bar--a { transform: rotate(45deg) translateY(4.5px); }
  .nxh__menu[aria-expanded="true"] .nxh__bar--b { opacity: 0; }
  .nxh__menu[aria-expanded="true"] .nxh__bar--c { transform: rotate(-45deg) translateY(-4.5px); }
  /* A ring for keyboard focus only, in the site's own blue, never after a tap. */
  .nxh__menu:focus { outline: none; }
  .nxh__menu:focus-visible { outline: 2px solid var(--color-accent, #1f6fdb); outline-offset: 2px; }

  .nxh__panel {
    pointer-events: auto;
    width: min(100%, 22rem);
    padding: 0.5rem;
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--color-paper) 90%, transparent);
    backdrop-filter: saturate(1.6) blur(18px);
    -webkit-backdrop-filter: saturate(1.6) blur(18px);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-ink) 7%, transparent),
      0 18px 40px -16px rgba(15, 23, 42, 0.3);
    transform-origin: top center;
    animation: nxh-drop 180ms ease;
  }
  .nxh__panel[hidden] { display: none; }
  @keyframes nxh-drop {
    from { opacity: 0; transform: translateY(-6px) scale(0.98); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nxh__panel { animation: none; }
    .nxh__bar { transition: none; }
  }
  .nxh__plist,
  .nxh__pmore { margin: 0; padding: 0; list-style: none; }
  .nxh__plink {
    display: block;
    padding: 0.8rem 1rem;
    border-radius: 1rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--nx-heading-weight, 560);
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-decoration: none;
  }
  .nxh__plink:hover,
  .nxh__plink[aria-current="page"] { background: color-mix(in srgb, var(--color-ink) 5%, transparent); }
  .nxh__pmore {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.35rem;
    padding: 0.85rem 1rem 0.6rem;
    border-top: 1px solid var(--color-rule);
  }
  .nxh__pmore a { font-size: 0.9375rem; color: var(--color-ink-soft); text-decoration: none; }
  .nxh__pmore a:hover,
  .nxh__pmore a[aria-current="page"] { color: var(--color-ink); }

  /* Phones: the links fold into the menu. */
  @media (max-width: 40rem) {
    /* Wider margins than the page gutter, so the pill floats rather than
       spanning edge to edge. */
    .nxh { padding-inline: 1.5rem; }
    .nxh__links { display: none; }
    .nxh__menu { display: inline-flex; }
    .nxh__logo { margin-right: auto; }
    .nxh__pill { width: min(100%, 22rem); }
  }
  @media (min-width: 40.0625rem) {
    .nxh__panel { display: none !important; }
  }
</style>

<script>
  function initNextHeaderMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-nxh-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-nxh-panel]");
    if (!toggle || !panel || toggle.dataset.ready) return;
    toggle.dataset.ready = "1";

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    toggle.addEventListener("click", () => setOpen(panel.hidden));
    panel.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (!panel.hidden && !panel.contains(t) && !toggle.contains(t)) setOpen(false);
    });
    window.matchMedia("(min-width: 40.0625rem)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  initNextHeaderMenu();
  document.addEventListener("astro:page-load", initNextHeaderMenu);
</script>
