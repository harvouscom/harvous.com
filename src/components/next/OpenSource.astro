---
/**
 * OpenSource — "the code is public," on the home page and About. One short card
 * laid out like a blueprint sheet on the release notes' square grid: ruler ticks
 * along the top and left, with
 * one line of copy and the button beside it.
 *
 * Every mark sits on a grid line. The grid's square is the card's width divided
 * into a whole number of ~24px columns (the formula in .release-notes-frame__grid);
 * the marks use the same formula, and a small script pads the card's height to
 * a whole number of squares so the bottom corners land on lines too.
 *
 * The marks draw in when the card scrolls into view (the shared data-reveal
 * observer adds `.revealed`), the way the /3/ numeral traces in, rather than on
 * load. Without JS, or with reduced motion, they arrive drawn.
 *
 * The licence is O'Saasy (MIT plus a no-hosted-competitor clause), so the copy
 * says what it allows rather than leaning on "open source" alone.
 */
import { fathomAbout, fathomHome } from "../../lib/fathom-events.ts";
import { formatStars, getRepoStars } from "../../lib/github-stars.ts";

interface Props {
  /** Which page it's on, so the clicks are counted there. */
  page?: "home" | "about";
}
const { page = "home" } = Astro.props;
const track = page === "about" ? fathomAbout : fathomHome;
/* Read at build time; null (no network, rate limit) just leaves the count off. */
const stars = await getRepoStars();

const repo = "https://github.com/harvouscom/harvous";
const license = `${repo}/blob/main/LICENSE`;
---

<section class="oss nx-section" id="open-source" aria-labelledby="oss-title">
  <div class="nx-wrap">
    <div class="oss__frame" data-reveal>
      <div class="release-notes-frame__grid oss__grid" aria-hidden="true"></div>

      <div class="oss__sheet" aria-hidden="true">
        <span class="oss__ruler oss__ruler--top"></span>
        <span class="oss__ruler oss__ruler--left"></span>


      </div>

      <div class="oss__body">
        <div class="oss__words">
          <h2 id="oss-title" class="nx-title oss__title">Harvous is open source.</h2>
          <p class="nx-lead oss__lead">
            The whole app is public on GitHub under the O'Saasy License: read it, learn from it,
            run it yourself.
          </p>
        </div>
        <div class="oss__ctas">
          <a class="nx-btn nx-btn--accent" href={repo} data-fathom-track={track.github}>
            <svg class="oss__gh-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            View on GitHub
            {stars !== null && (
              <span class="oss__stars" aria-label={`${stars} stars on GitHub`}>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" /></svg>
                {formatStars(stars)}
              </span>
            )}
          </a>
          <a class="nx-link" href={license} data-fathom-track={track.license}>Read the license →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Pad the card to a whole number of grid squares so its bottom edge, and the
  // marks measured from it, fall on grid lines. The square matches the grid's
  // CSS: the padding-box width split into the nearest whole number of 24px columns.
  document.querySelectorAll<HTMLElement>(".oss__frame").forEach((frame) => {
    const snap = () => {
      // Fractional sizes (clientWidth/Height round to whole pixels); the border is 1px a side.
      const rect = frame.getBoundingClientRect();
      const w = rect.width - 2;
      if (w <= 0) return;
      const g = w / Math.max(1, Math.round(w / 24));
      const fix = parseFloat(frame.style.getPropertyValue("--snap")) || 0;
      const natural = rect.height - 2 - fix;
      const next = Math.ceil(natural / g - 0.01) * g - natural;
      if (Math.abs(next - fix) > 0.05) frame.style.setProperty("--snap", `${next}px`);
    };
    new ResizeObserver(snap).observe(frame);
    snap();
  });
</script>

<style>
  .oss.nx-section { padding-block: clamp(3rem, 7vw, 5rem); }

  .oss__frame {
    /* A square and a half in from every edge: clear of the half-square ruler ticks. */
    --oss-pad: 2.25rem;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--oss-pad) clamp(1.5rem, 6vw, 5rem);
    padding-bottom: calc(var(--oss-pad) + var(--snap, 0px));
    border: 1px solid var(--color-rule);
    border-radius: var(--nx-radius-scene);
    background: var(--color-paper);
  }

  /* The release notes' grid, spread edge to edge and dissolving outward like /3/'s hero. */
  .oss__grid {
    inset-inline: 0;
    -webkit-mask-image: radial-gradient(75% 85% at 35% 45%, #000 30%, transparent 100%);
    mask-image: radial-gradient(75% 85% at 35% 45%, #000 30%, transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  /* A touch darker than on release notes: here the grid is the sheet itself. */
  .oss__grid::before {
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--color-rule) 85%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-rule) 85%, transparent) 1px, transparent 1px);
  }

  .oss__body { position: relative; max-width: 46rem; }

  /* A short sheet: the words and the button side by side. */
  .oss .oss__title { font-size: clamp(1.6rem, 3vw, 2.25rem); }
  .oss .oss__lead { margin-top: 0.75rem; max-width: 32rem; font-size: 1.0625rem; }
  @media (min-width: 48rem) {
    .oss .oss__body { display: flex; align-items: center; justify-content: space-between; gap: 2.5rem; max-width: none; }
    .oss .oss__ctas { flex-direction: column; align-items: flex-end; gap: 0.75rem; margin-top: 0; flex-shrink: 0; }
  }
  .oss__title { margin: 0; }
  .oss__lead { margin: 1.25rem 0 0; }

  .oss__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }
  .oss__gh-icon { width: 1.1rem; height: 1.1rem; }
  /* The star count, as a quiet pill inside the button (GitHub's own pairing). */
  .oss__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.35rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    background: rgba(255, 255, 255, 0.2);
  }
  .oss__stars svg { width: 0.8rem; height: 0.8rem; }

  /* ── Blueprint sheet ───────────────────────────────────────────────────── */

  .oss__sheet {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    container-type: size;
    --ink: #1a8dff;
    --tick: color-mix(in oklab, #006eff 42%, transparent);
  }
  /* One grid square, by the grid's own formula; a line n squares in occupies [n·g, n·g + 1px]. */
  .oss__sheet > * {
    --g: calc(100cqw / round(nearest, 100cqw / 24px, 1));
    position: absolute;
  }

  /* Ruler ticks: a short one every square, a long one every fourth. */
  .oss__ruler--top {
    top: 0;
    left: 0;
    right: 0;
    height: 12px;
    background:
      linear-gradient(to right, var(--tick) 1px, transparent 1px) 0 0 / var(--g) 5px repeat-x,
      linear-gradient(to right, var(--tick) 1px, transparent 1px) 0 0 / calc(var(--g) * 4) 12px repeat-x;
  }
  .oss__ruler--left {
    top: 0;
    left: 0;
    bottom: 0;
    width: 12px;
    background:
      linear-gradient(to bottom, var(--tick) 1px, transparent 1px) 0 0 / 5px var(--g) repeat-y,
      linear-gradient(to bottom, var(--tick) 1px, transparent 1px) 0 0 / 12px calc(var(--g) * 4) repeat-y;
  }

  /* Crop marks: one square long, half a square clear of the edge and of the trim corner. */

  /* ── Motion: the sheet draws itself in, rulers first, then the marks ───── */

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .oss__grid { opacity: 0; }
    :global(html.js) .oss__ruler--top { clip-path: inset(0 100% 0 0); }
    :global(html.js) .oss__ruler--left { clip-path: inset(0 0 100% 0); }

    :global(html.js) .oss__frame:global(.revealed) .oss__grid {
      animation:
        oss-fade 1800ms ease-out 200ms both,
        oss-grid-drift 14000ms ease-in-out 2400ms infinite;
    }
    :global(html.js) .oss__frame:global(.revealed) .oss__ruler {
      animation: oss-rule 1400ms cubic-bezier(0.65, 0, 0.35, 1) 200ms both;
    }
  }

  @keyframes oss-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes oss-rule {
    to { clip-path: inset(0); }
  }
  @keyframes oss-grid-drift {
    0%, 100% { -webkit-mask-position: -14px 10px; mask-position: -14px 10px; }
    50% { -webkit-mask-position: 14px -10px; mask-position: 14px -10px; }
  }
</style>
