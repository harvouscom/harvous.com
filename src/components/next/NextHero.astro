---
/**
 * NextHero — one plain sentence set large, with the missing word written back
 * in. "actually" sits in a proofreader's caret between "that" and "remembers",
 * in the same hand as the margin notes. The picture is the app itself, rebuilt
 * from Derek's account in the app's own components: the reader with its notes
 * rail, the note that rail points to, and a Suggestion — see the comment on
 * the stage below.
 */
import AppIcon from "./app/AppIcon.astro";
import AppWindow from "./app/AppWindow.astro";
import AppReader from "./app/AppReader.astro";
import AppNote from "./app/AppNote.astro";
import HeroVideoLightbox from "../HeroVideoLightbox.astro";
import { backdropSrc } from "../../lib/next/content.ts";
---

<section class="hero">
  {/* 053, the pale "breeze" streaks — light enough that ink reads on it without a scrim. */}
  <img class="hero__sky" src={backdropSrc("053")} alt="" fetchpriority="high" />

  <div class="nx-wrap hero__head on-light">
    <h1 class="hero__title">
      <span class="hero__line">Make a study Bible</span>
      <span class="hero__line">
        that<span class="hero__insert">
          <span class="hero__insert-word nx-hand">actually</span>
          <svg class="hero__caret" viewBox="0 0 24 16" aria-hidden="true">
            <path d="M3 13 L12 3 L21 13" />
          </svg>
        </span>
        remembers
      </span>
    </h1>
    {/* The Harvous 3 walkthrough (R2, via the Worker — see wrangler.jsonc). */}
    <div class="hero__watch">
      <HeroVideoLightbox
        src="/harvous-3-walkthrough.mp4"
        label="Watch the 4-minute walkthrough"
        variant="inline"
      />
    </div>
  </div>

  <div class="nx-wrap hero__stage">
    {/*
      All three rebuilt from Derek's own account (app.harvous.com), in the
      app's own components: the reader on Exodus 5 with its notes rail lit and
      "In 2 of your notes" open; the note that popover names, "The cost of
      obedience", lifted off the left; and one Suggestion from Activity —
      writing, reading, and remembering in one glance, and all about the same
      passage.
    */}
    <div class="hero__window" data-reveal="scale" style="--reveal-delay: 150ms;">
      <AppWindow view="bible"><AppReader select /></AppWindow>
    </div>

    <div
      class="hero__note"
      data-reveal="scale"
      style="--reveal-delay: 350ms;"
      role="img"
      aria-label="Derek's note The cost of obedience, with Exodus 5:1–5 and Luke 14:27–28 as scripture pills."
    >
      <AppNote compact note="faithful" />
    </div>

    <div class="aui hero__suggest" data-reveal="scale" style="--reveal-delay: 550ms;" aria-hidden="true">
      <p class="aui-label">Suggested</p>
      <div class="aui-card aui-card--float">
        <div class="aui-row">
          <span class="aui-tile"><AppIcon name="magnifying-glass" /></span>
          <span><span class="aui-title">God's timing</span><span class="aui-sub">Seems to be on your mind<i>·</i>Returning to this since June</span></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(6rem, 11vw, 8.5rem);
    overflow: hidden;
  }
  /* Everything in the stage — sky, window, note and their shadows — dissolves
     into the page before the section ends, so there is no seam where the hero
     stops and the next section's white begins. */
  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: clamp(9rem, 22vw, 16rem);
    z-index: 5;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper) 0%, transparent),
      color-mix(in srgb, var(--color-paper) 70%, transparent) 55%,
      var(--color-paper)
    );
  }
  .hero__sky {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 92%;
    object-fit: cover;
    z-index: -2;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  .hero__head {
    position: relative;
    /* Above the stage, so the walkthrough pill can straddle the window's top edge. */
    z-index: 2;
    text-align: center;
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    /* The site's own heading voice (600, gently tightened), just larger — not
       a heavier cut that only this page would use. */
    font-size: clamp(2.6rem, 4.2vw, 5.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }
  .hero__line { display: block; }
  /* A pocket between the lines, so the inserted word has somewhere to sit
     without colliding with "Bible". */
  .hero__line + .hero__line { margin-top: 0.1em; }
  /* Zero-width anchor on the space between "that" and "remembers": the
     annotation floats above the line and never takes part in line layout. */
  .hero__insert {
    position: relative;
    display: inline-block;
    width: 0;
    height: 0;
    vertical-align: baseline;
    pointer-events: none;
  }
  .hero__insert-word {
    position: absolute;
    left: 0.28em;
    top: 0.58em;
    transform: translateX(-50%) rotate(-4deg);
    transform-origin: 50% 0;
    font-size: 0.5em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-ink);
  }
  .hero__caret {
    position: absolute;
    left: 0.28em;
    top: 0.2em;
    width: 0.3em;
    height: 0.2em;
    transform: translateX(-50%);
    overflow: visible;
  }
  .hero__caret path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 32;
    stroke-dashoffset: 32;
    animation: hero-caret 0.7s 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes hero-caret {
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__caret path { animation: none; stroke-dashoffset: 0; }
  }
  .hero__watch { margin-top: 1.9rem }
  .hero__watch :global(.hero-video-inline) {
    padding: 0.45rem 1rem 0.45rem 0.55rem;
    font-size: 0.9375rem;
    background: color-mix(in srgb, var(--color-card) 72%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-color: color-mix(in srgb, var(--color-ink) 8%, transparent);
    box-shadow: 0 8px 24px -14px rgba(15, 23, 42, 0.35);
  }
  @media (min-width: 40rem) {
    .hero__line { white-space: nowrap; }
  }

  .hero__stage {
    position: relative;
    z-index: 1;
    margin-top: -1.26rem;
  }
  /* The walkthrough pill sits where the window's Search pill would, so hide the latter
     rather than let it peek out from behind. */
  .hero__window :global(.aw__search) { visibility: hidden; }
  .hero__window {
    position: relative;
    max-width: 64rem;
    height: clamp(20rem, 52vw, 40rem);
    margin-inline: auto;
    overflow: hidden;
    border-radius: clamp(0.8rem, 1.6vw, 1.4rem) clamp(0.8rem, 1.6vw, 1.4rem) 0 0;
    background: #fcfcfb;
    box-shadow:
      0 0 0 1px rgba(15, 23, 42, 0.07),
      0 -10px 60px -20px rgba(15, 23, 42, 0.25),
      0 40px 90px -30px rgba(15, 23, 42, 0.45);
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent);
    mask-image: linear-gradient(to bottom, #000 78%, transparent);
  }

  /* The note, lifted off the reader's left side and past the window's edge. */
  .hero__window :global(.aw) { height: 100%; }
  .hero__note {
    position: absolute;
    z-index: 2;
    left: max(0.5rem, calc(50% - 32rem - 3rem));
    top: 20%;
    width: min(42%, 24rem);
    border-radius: 16px;
    box-shadow:
      0 0 0 1px rgba(15, 23, 42, 0.08),
      0 24px 40px -16px rgba(15, 23, 42, 0.35),
      0 60px 110px -30px rgba(15, 23, 42, 0.4);
  }
  .hero__suggest {
    position: absolute;
    z-index: 3;
    right: max(0.5rem, calc(50% - 32rem - 2rem));
    top: 52%;
    width: min(40%, 21rem);
  }
  /* It sits over the sky, so the label gets a ground of its own to be read on. */
  .hero__suggest :global(.aui-label) {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--pds-bg-main) 88%, transparent);
    box-shadow: 0 0 0 0.5px var(--pds-border), 0 6px 14px -8px rgba(15, 23, 42, 0.3);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--pds-text-primary);
    font-weight: 600;
  }

  /* Phones: the window at full app size only fits its toolbar, and the note
     would cover the verses. Shrink the whole scene instead, so the reader,
     its highlights and the selection bar all show, and drop the note low
     enough to leave them clear. */
  @media (max-width: 56rem) {
    .hero__window { height: clamp(26rem, 68vw, 34rem); }
    .hero__window :global(.aw) { zoom: 0.8; height: calc(100% / 0.8); }
    .hero__note { top: 40%; width: 44%; zoom: 0.8; }
    .hero__suggest { top: 68%; width: 40%; zoom: 0.8; }
  }
  @media (max-width: 48rem) {
    .hero__suggest { display: none; }
  }
  @media (max-width: 40rem) {
    .hero__window { height: clamp(22rem, 108vw, 30rem); }
    .hero__window :global(.aw) { zoom: 0.72; height: calc(100% / 0.72); }
    .hero__note { left: 0.5rem; top: 44%; width: 58%; zoom: 0.68; }
    .hero__suggest { display: none; }
  }
  @media (max-width: 30rem) {
    .hero__window :global(.aw) { zoom: 0.56; height: calc(100% / 0.56); }
    .hero__note { top: 46%; width: 62%; zoom: 0.56; }
  }
</style>
