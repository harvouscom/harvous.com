---
/**
 * ConnectorThinking — the beat on the Connector page where the AI app is working:
 * its own mark, doing what that app does while it thinks, beside the Harvous
 * icon, with a few dots running from Harvous to the app as it reads your study.
 *
 *   Claude  — the spark turns and breathes, as Claude's does while it works
 *   ChatGPT — the pulsing dot ChatGPT shows instead of its logo
 *   Grok    — the mark rocks on its axis
 *   Muse    — the "M" bobs, like Muse's mascot
 *
 * Which app is chosen once for the whole page (`.cs[data-app]`, set by the
 * switcher in the first scene), so every scene's thinking row follows it.
 * With reduced motion the mark sits still and the dots don't run.
 */
import claudeLogo from "../../assets/ai-logos/claude.svg?raw";
import grokLogo from "../../assets/ai-logos/grok.svg?raw";
import museIcon from "../../assets/ai-logos/muse.webp";

interface Props {
  /** What it's doing, e.g. "Reading your notes in Harvous". */
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
---

<div class:list={["think", className]} aria-hidden="true">
  <span class="think__mark">
    <span class="think__m think__m--claude" set:html={claudeLogo} />
    <span class="think__m think__m--chatgpt"><i class="think__dot"></i></span>
    <span class="think__m think__m--grok" set:html={grokLogo} />
    <span class="think__m think__m--muse"><img src={museIcon.src} alt="" width="128" height="128" loading="lazy" decoding="async" /></span>
  </span>
  <span class="think__flow"><i></i><i></i><i></i></span>
  <img class="think__harvous" src="/images/harvous-icon-sm.png" alt="" width="22" height="22" loading="lazy" />
  <span class="think__text">{text}<span class="think__ellipsis">…</span></span>
</div>

<style>
  .think {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 4px;
    font-size: 13px;
    color: var(--pds-text-secondary);
  }

  /* The app's mark: one shown, chosen by the page's app. */
  .think__mark { position: relative; display: grid; place-items: center; width: 22px; height: 22px; flex: none; }
  .think__m { display: none; place-items: center; width: 100%; height: 100%; }
  .think__m :global(svg), .think__m img { display: block; width: 100%; height: 100%; }
  :global(.cs[data-app="claude"]) .think__m--claude,
  :global(.cs[data-app="chatgpt"]) .think__m--chatgpt,
  :global(.cs[data-app="grok"]) .think__m--grok,
  :global(.cs[data-app="muse"]) .think__m--muse { display: grid; }

  .think__dot { display: block; width: 12px; height: 12px; border-radius: 50%; background: var(--pds-text-primary); }

  /* Harvous → app: three dots running toward the mark, the app reading your study. */
  .think__flow { display: inline-flex; flex-direction: row-reverse; gap: 3px; }
  .think__flow i { width: 3px; height: 3px; border-radius: 50%; background: var(--pds-text-tertiary); }
  .think__harvous { width: 22px; height: 22px; border-radius: 6px; flex: none; }

  .think__text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  @media (prefers-reduced-motion: no-preference) {
    .think__m--claude :global(svg) { animation: think-claude 1.6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .think__dot { animation: think-chatgpt 1.1s ease-in-out infinite; }
    .think__m--grok :global(svg) { animation: think-grok 1.4s ease-in-out infinite; }
    .think__m--muse img { animation: think-muse 1.2s ease-in-out infinite; transform-origin: 50% 90%; }
    .think__flow i { animation: think-flow 1.2s ease-in-out infinite; }
    .think__flow i:nth-child(2) { animation-delay: 0.15s; }
    .think__flow i:nth-child(3) { animation-delay: 0.3s; }
    .think__text {
      background: linear-gradient(90deg, var(--pds-text-secondary) 35%, var(--pds-text-primary) 50%, var(--pds-text-secondary) 65%);
      background-size: 300% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: think-shimmer 2.2s linear infinite;
    }
  }

  @keyframes think-claude {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(0.82); }
    100% { transform: rotate(360deg) scale(1); }
  }
  @keyframes think-chatgpt {
    0%, 100% { transform: scale(0.72); opacity: 0.7; }
    50% { transform: scale(1); opacity: 1; }
  }
  @keyframes think-grok {
    0%, 100% { transform: rotate(-18deg); }
    50% { transform: rotate(18deg); }
  }
  @keyframes think-muse {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    30% { transform: translateY(-3px) rotate(-6deg); }
    60% { transform: translateY(0) rotate(5deg); }
  }
  @keyframes think-flow {
    0%, 100% { opacity: 0.25; transform: translateX(0); }
    50% { opacity: 1; transform: translateX(-2px); }
  }
  @keyframes think-shimmer {
    from { background-position: 100% 0; }
    to { background-position: 0% 0; }
  }
</style>
