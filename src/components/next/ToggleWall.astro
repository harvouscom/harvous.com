---
/**
 * ToggleWall — "Yours, quietly." Rows of settings-style switches drifting past
 * in alternate directions, between the two halves of the heading, like Dia's
 * privacy wall. The switches are the claim, so every one is sourced — see
 * PRIVACY_TOGGLES in lib/next/content.ts.
 *
 * Decorative motion only: the same list is given once, plainly, to screen
 * readers, and reduced motion gets a still, wrapped wall.
 */
import { PRIVACY_TOGGLES } from "../../lib/next/content.ts";

/* Three rows, each a rotation of the same list so no two rows line up. */
const rows = [0, 3, 6].map((shift) => [
  ...PRIVACY_TOGGLES.slice(shift),
  ...PRIVACY_TOGGLES.slice(0, shift),
]);
---

<section class="tw nx-section" aria-labelledby="tw-title">
  <div class="nx-wrap nx-center">
    <p class="nx-kicker">Privacy</p>
    <h2 id="tw-title" class="nx-display tw__word">Yours,</h2>
  </div>

  <ul class="sr-only">
    {PRIVACY_TOGGLES.map((t) => <li>{t.label}: {t.value}</li>)}
  </ul>

  <div class="tw__rows" aria-hidden="true">
    {rows.map((row, r) => (
      <div class:list={["tw__row", r % 2 === 1 && "tw__row--rev"]} style={`--dur:${56 + r * 9}s`}>
        <div class="tw__track">
          {[...row, ...row].map((t) => (
            <div class="tw__item">
              <span class="tw__label">{t.label}</span>
              <span class="tw__value">{t.value}</span>
              <span class:list={["tw__switch", t.on && "is-on"]}><i></i></span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="nx-wrap nx-center">
    <p class="nx-display tw__word" aria-hidden="true">quietly.</p>
    <p class="nx-lead tw__lead">
      Your notes are yours. Nobody sees them unless you share a link, I don't sell what you
      write, and you can export all of it whenever you like.
    </p>
    <a class="nx-link" href="/privacy/">Read the privacy policy →</a>
  </div>
</section>

<style>
  .tw { overflow: hidden; }
  .tw__word { margin: 0.5rem 0 0; }
  .tw__lead { margin: 1.5rem auto 1rem; }

  .tw__rows {
    display: grid;
    gap: 0.75rem;
    margin-block: clamp(1.5rem, 4vw, 2.5rem);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .tw__row { overflow: hidden; }
  .tw__track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    animation: tw-slide var(--dur) linear infinite;
  }
  .tw__row--rev .tw__track { animation-direction: reverse; }
  @keyframes tw-slide {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 0.375rem)); }
  }

  .tw__item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0.95rem 0.85rem 1.2rem;
    border-radius: 1rem;
    background: var(--color-warm);
    white-space: nowrap;
  }
  .tw__label { font-weight: 500; color: var(--color-ink); }
  .tw__value { font-size: 0.875rem; color: var(--color-ink-faint); margin-left: 0.5rem; }
  .tw__switch {
    position: relative;
    width: 2.6rem;
    height: 1.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 14%, transparent);
  }
  .tw__switch i {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);
  }
  .tw__switch.is-on { background: var(--accent-btn-bg); }
  .tw__switch.is-on i { left: auto; right: 0.15rem; }


  @media (prefers-reduced-motion: reduce) {
    .tw__track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
    .tw__row:not(:first-child) { display: none; }
    .tw__rows { mask-image: none; -webkit-mask-image: none; padding-inline: 1rem; }
    /* One copy of the list: hide the duplicate half (PRIVACY_TOGGLES has 10). */
    .tw__item:nth-child(n + 11) { display: none; }
  }
</style>
