---
/**
 * QuickAnswers — the homepage's "before you start" questions, answered in a
 * line each, right before the closing call. No card: a heading and two links
 * on the left, three ruled rows on the right, on the page's own ground.
 *
 * The questions and their one-line answers come from the FAQ collection
 * (question + short), so they can't drift from /faq/; each row links to its
 * full answer there.
 */
import { getFaqEntries, faqAnchorId, SUPPORT_EMAIL } from "../../lib/faq";

/** What people ask before they start: cost, privacy, and whether they have to sign up. */
const IDS = ["pricing", "privacy", "try-without-account"];

const all = await getFaqEntries("home");
const rows = IDS.map((id) => all.find((e) => e.id === id)).filter((e) => e !== undefined);
const mailto = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent("A question about Harvous")}`;
---

{rows.length > 0 && (
  <section class="nx-wrap qa" aria-labelledby="qa-title">
    <div class="qa__head" data-reveal>
      <h2 id="qa-title" class="qa__title">Questions before you start?</h2>
      <p class="qa__links">
        <a class="nx-link" href="/faq/">All the FAQs →</a>
        <a class="qa__mail" href={mailto}>or email Derek</a>
      </p>
    </div>
    <ul class="qa__list" role="list" data-reveal="stagger">
      {rows.map((e) => (
        <li>
          <a class="qa__row" href={`/faq/#${faqAnchorId(e)}`}>
            <span class="qa__q">{e.data.question}</span>
            <span class="qa__a">{e.data.short}</span>
            <svg class="qa__chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .qa {
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(3.5rem, 8vw, 5.5rem) clamp(1rem, 3vw, 2rem);
  }
  @media (min-width: 56rem) {
    .qa { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(3rem, 6vw, 5rem); align-items: start; }
  }

  .qa__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .qa__links { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; margin: 1rem 0 0; }
  .qa__mail { font-size: 0.9375rem; color: var(--color-ink-soft); text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: 3px; }
  .qa__mail:hover { color: var(--color-ink); text-decoration-color: currentColor; }

  .qa__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-rule); }
  .qa__list li { border-bottom: 1px solid var(--color-rule); }
  .qa__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: center;
    padding: 1.1rem 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .qa__q { font-weight: 600; color: var(--color-ink); }
  .qa__a { grid-row: 2; color: var(--color-ink-soft); text-wrap: pretty; }
  .qa__chev {
    grid-row: 1 / span 2;
    grid-column: 2;
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: var(--color-ink-faint);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms ease, stroke 200ms ease;
  }
  .qa__row:hover .qa__chev { transform: translateX(2px); stroke: var(--color-ink); }
  .qa__row:hover .qa__q { color: var(--color-accent); }
  @media (min-width: 40rem) {
    .qa__row { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) auto; }
    .qa__a { grid-row: auto; }
    .qa__chev { grid-row: auto; grid-column: auto; }
  }
</style>
