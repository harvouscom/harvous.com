---
/**
 * ChurchScenes — the churches page's story, one row per section: short words on
 * one side and, on the other, a small example of the church side working, drawn
 * with the app UI recipes (next-app-ui.css) the way the Connector page is.
 *
 * Each section names its example with `visual`:
 *   feed    — "New from your church" → Home's "From your church" → This Sunday's note
 *   planner — each ministry's teaching plan (pick a ministry), scheduled and approval states
 *   roles   — the staff roster, a volunteer's one room (switch), approval for teachers' posts
 *   join    — a printed join code being scanned, and the person connected
 *   review  — a question from a ministry (answer it), and the count staff see
 *   sees    — the counts a church gets, and what it never sees
 * A section without one is a full-width line of text.
 *
 * Only what has shipped, and the app's own limits: counts never names, nothing
 * shown below five, no attendance, no bulletin. Names and numbers are made up.
 */
import AppIcon from "./app/AppIcon.astro";
import FeatureChip from "./FeatureChip.astro";
import { inlineMdLinksToHtml } from "../../lib/inline-md-links.ts";
import type { ForAudienceFeatureLink, ForAudienceSection } from "../../lib/for-audiences-data.ts";
import { stageMesh } from "../../lib/next/content.ts";

interface Props {
  sections: ForAudienceSection[];
  /** Each section's `feature`, resolved by the page, shown as a chip under its words. */
  features?: Record<string, ForAudienceFeatureLink>;
}
const { sections, features = {} } = Astro.props;

const washes = ["coral", "sky", "amber", "mint", "violet", "blue"];

/*
 * An illustrative QR code: the three finder squares plus a seeded scatter of
 * modules, so it reads as a QR at a glance without encoding anything.
 */
const QR = 25;
const qrPath = (seed: number) => {
  let x = seed;
  const rand = () => ((x = (x * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
  const finder = (r: number, c: number) =>
    [[0, 0], [0, QR - 7], [QR - 7, 0]].some(([fr, fc]) => r >= fr && r < fr + 7 && c >= fc && c < fc + 7);
  const inFinder = (r: number, c: number) => {
    for (const [fr, fc] of [[0, 0], [0, QR - 7], [QR - 7, 0]]) {
      const dr = r - fr, dc = c - fc;
      if (dr >= 0 && dr < 7 && dc >= 0 && dc < 7) {
        const ring = Math.min(dr, dc, 6 - dr, 6 - dc);
        return ring === 0 || ring >= 2;
      }
    }
    return false;
  };
  let d = "";
  for (let r = 0; r < QR; r++) {
    for (let c = 0; c < QR; c++) {
      const on = finder(r, c) ? inFinder(r, c) : (r === 7 || c === 7 || (r < 8 && c > QR - 9) || (c < 8 && r > QR - 9)) ? false : rand() > 0.52;
      if (on) d += `M${c} ${r}h1v1h-1z`;
    }
  }
  return d;
};
const qrA = qrPath(7);

const plans = {
  church: [
    { date: "Sun · Oct 5", title: "The church is born", series: "Acts · week 3", ref: "Acts 2", status: "Published", tone: "ok" },
    { date: "Sun · Oct 12", title: "Devoted to the teaching", series: "Acts · week 4", ref: "Acts 2:42–47", status: "Scheduled · Sun 9:00", tone: "time" },
    { date: "Sun · Oct 19", title: "Silver and gold have I none", series: "Acts · week 5", ref: "Acts 3", status: "Draft", tone: "draft" },
  ],
  youth: [
    { date: "Wed · Oct 8", title: "Who do you say I am?", series: "Who is Jesus? · week 2", ref: "Mark 8:27–30", status: "Published", tone: "ok" },
    { date: "Wed · Oct 15", title: "The one who calms the storm", series: "Who is Jesus? · week 3", ref: "Mark 4:35–41", status: "Waiting for approval", tone: "wait" },
    { date: "Wed · Oct 22", title: "Bread for thousands", series: "Who is Jesus? · week 4", ref: "Mark 6:30–44", status: "Draft", tone: "draft" },
  ],
  women: [
    { date: "Tue · Oct 7", title: "Where you go, I will go", series: "Ruth · week 2", ref: "Ruth 1", status: "Published", tone: "ok" },
    { date: "Tue · Oct 14", title: "Gleaning in Boaz's field", series: "Ruth · week 3", ref: "Ruth 2", status: "Scheduled · Tue 6:30", tone: "time" },
    { date: "Tue · Oct 21", title: "The redeemer", series: "Ruth · week 4", ref: "Ruth 3–4", status: "Draft", tone: "draft" },
  ],
};
---

<section class="nx-wrap chs" aria-label="How Harvous works for a church">
  {sections.map((section, i) => {
    const flip = sections.slice(0, i).filter((s) => s.visual).length % 2 === 1;
    return section.visual ? (
      <div class:list={["chs__row", flip && "is-flip"]}>
        <div class="chs__text" data-reveal>
          <p class="chs__num">{String(i + 1).padStart(2, "0")}</p>
          <h2 class="chs__h">{section.heading}</h2>
          {section.paragraphs.map((p) => <p set:html={inlineMdLinksToHtml(p)} />)}
          {section.feature && features[section.feature] && <FeatureChip feature={features[section.feature]} />}
          {section.ctaHref && section.ctaLabel && (
            <p class="chs__cta"><a class="nx-btn nx-btn--accent" href={section.ctaHref}>{section.ctaLabel}</a></p>
          )}
        </div>

        <div class="chs__stage nx-mesh" style={`${stageMesh(washes[i % washes.length])} --reveal-delay: 120ms;`} data-reveal>
          {section.visual === "feed" && (
            <div class="aui feed" data-scene="feed" data-state="push" role="group" aria-label="Example: a congregant's Home after their church publishes">
              <button type="button" class="feed__push" data-go="feed">
                <img src="/images/harvous-2-icon-sm.png" alt="" width="30" height="30" loading="lazy" />
                <span class="feed__push-text">
                  <span class="feed__push-top"><b>Harvous</b><span>now</span></span>
                  <span class="aui-title">New from your church</span>
                  <span class="aui-sub">3 new in Youth · 1 new in Women's</span>
                </span>
              </button>

              <div class="aui-card feed__home">
                <p class="feed__label"><AppIcon name="church" /> From your church <span>Grace Church</span></p>
                <button type="button" class="aui-row feed__row feed__row--sunday" data-go="sunday">
                  <span class="aui-tile feed__tile--sun"><AppIcon name="sun" /></span>
                  <span><span class="aui-title">This Sunday · The church is born</span><span class="aui-sub">Acts 2 · Sunday service</span></span>
                  <span class="feed__new">New</span>
                </button>
                <div class="aui-row feed__row">
                  <span class="aui-tile"><AppIcon name="note-sticky" /></span>
                  <span><span class="aui-title">Who do you say I am?</span><span class="aui-sub">Youth · Wednesday</span></span>
                  <span class="feed__new">New</span>
                </div>
                <div class="aui-row feed__row">
                  <span class="aui-tile"><AppIcon name="list-check" /></span>
                  <span><span class="aui-title">Study plan: Ruth</span><span class="aui-sub">Women's · week 3 of 4</span></span>
                  <span class="feed__new">New</span>
                </div>
              </div>

              <div class="aui-paper feed__note">
                <p class="feed__crumb"><AppIcon name="church" /> From Grace Church · This Sunday</p>
                <p class="feed__title">The church is born</p>
                <p class="feed__sec">Scripture</p>
                <p><span class="aui-pill">Acts 2:1–13 <span class="aui-tr">NLT</span></span></p>
                <p class="feed__sec">What I noticed</p>
                <p class="feed__caret"><span aria-hidden="true"></span></p>
                <p class="feed__sec">Prayer</p>
                <p class="feed__foot"><AppIcon name="lock" /> Your note. The church never sees it.</p>
              </div>
              <button type="button" class="chs__replay" data-replay><AppIcon name="arrow-rotate-left" /> Replay</button>
            </div>
          )}

          {section.visual === "planner" && (
            <div class="aui aui-card plan" data-scene="planner" role="group" aria-label="Example: each ministry's teaching plan">
              <div class="plan__bar">
                <p class="plan__h"><AppIcon name="calendar-days" /> Teaching plan</p>
                <span class="chs__seg" role="group" aria-label="Ministry">
                  <button type="button" data-plan="church" aria-pressed="true">Church</button>
                  <button type="button" data-plan="youth" aria-pressed="false">Youth</button>
                  <button type="button" data-plan="women" aria-pressed="false">Women's</button>
                </span>
              </div>
              {Object.entries(plans).map(([key, rows]) => (
                <div class="plan__list" data-plan-list={key} hidden={key !== "church"}>
                  {rows.map((r) => (
                    <div class="plan__row">
                      <span class="plan__date">{r.date}</span>
                      <span class="plan__main">
                        <span class="aui-title">{r.title}</span>
                        <span class="plan__meta"><span class="plan__series"><AppIcon name="layer-group" />{r.series}</span><span class="aui-pill">{r.ref}</span></span>
                      </span>
                      <span class:list={["plan__status", `is-${r.tone}`]}>{r.tone === "ok" && <AppIcon name="check" />}{r.tone === "time" && <AppIcon name="clock" />}{r.status}</span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          )}

          {section.visual === "roles" && (
            <div class="aui aui-card roles" data-scene="roles" role="group" aria-label="Example: a church's staff and roles">
              <p class="roles__crumb">Grace Church <AppIcon name="chevron-right" /> <strong>Staff</strong></p>
              <div class="aui-card roles__group">
                {[
                  ["D", "Pastor Dana", "Decides what the church teaches", "Pastor"],
                  ["M", "Marcus", "Keeps the plan and settings tidy", "Coordinator"],
                  ["P", "Priya", "Publishes to Youth", "Teacher · Youth only"],
                ].map(([i, name, sub, role]) => (
                  <div class="aui-row">
                    <span class="roles__face">{i}</span>
                    <span><span class="aui-title">{name}</span><span class="aui-sub">{sub}</span></span>
                    <span class="roles__chip">{role}</span>
                  </div>
                ))}
              </div>
              <p class="aui-label roles__label">Group leaders</p>
              <div class="aui-card roles__group">
                <div class="aui-row roles__lead" data-lead-row>
                  <span class="roles__face">J</span>
                  <span><span class="aui-title">Jordan</span><span class="aui-sub" data-lead-sub data-on="Leads Thursday Youth group, nothing else" data-off="No longer leads a group">Leads Thursday Youth group, nothing else</span></span>
                  <button type="button" class="chs__switch" role="switch" aria-checked="true" aria-label="Jordan leads Thursday Youth group" data-lead-switch><span></span></button>
                </div>
              </div>
              <div class="aui-card roles__group roles__approve">
                <div class="aui-row">
                  <span class="aui-tile"><AppIcon name="circle-check" /></span>
                  <span><span class="aui-title">Pastors approve teachers' posts</span><span class="aui-sub">Before anything goes out</span></span>
                  <button type="button" class="chs__switch" role="switch" aria-checked="false" aria-label="Pastors approve teachers' posts" data-switch><span></span></button>
                </div>
              </div>
            </div>
          )}

          {section.visual === "join" && (
            <div class="aui join" data-scene="join" role="group" aria-label="Example: a printed join code, scanned, and the person connected">
              <div class="join__poster">
                <p class="join__church"><AppIcon name="church" /> Grace Church</p>
                <p class="join__title">Study with us on Harvous</p>
                <div class="join__qr" aria-hidden="true">
                  <svg viewBox={`-2 -2 ${QR + 4} ${QR + 4}`} class="join__code"><rect x="-2" y="-2" width={QR + 4} height={QR + 4} rx="2" class="join__qr-bg" /><path d={qrA} /></svg>
                  <img src="/images/harvous-2-icon-sm.png" alt="" width="40" height="40" loading="lazy" class="join__qr-logo" />
                  <span class="join__scan"></span>
                </div>
                <p class="join__hint">Scan to connect</p>
              </div>

              <div class="join__phone">
                <p class="join__done"><AppIcon name="circle-check" /> You're connected to Grace Church</p>
                <p class="join__pick">Follow what you'd like</p>
                <p class="join__chips"><span class="is-on"><AppIcon name="check" /> Sunday service</span><span>Youth</span><span class="is-on"><AppIcon name="check" /> Women's</span></p>
              </div>

              <p class="join__stat"><b>38</b> joined via link</p>
            </div>
          )}

          {section.visual === "review" && (
            <div class="aui rev" data-scene="review" role="group" aria-label="Example: a review question from a ministry">
              <div class="aui-card rev__card">
                <p class="rev__from">From Youth.</p>
                <p class="rev__q">In Acts 2, what did the first believers devote themselves to?</p>
                <div class="rev__opts">
                  <button type="button" class="rev__opt" data-right="true">The apostles' teaching and prayer</button>
                  <button type="button" class="rev__opt">Building a new temple</button>
                  <button type="button" class="rev__opt">Choosing a king</button>
                </div>
                <p class="rev__done" data-rev-done><AppIcon name="check" /> That's it. Acts 2:42.</p>
              </div>
              <div class="aui-card rev__staff">
                <p class="rev__staff-h">What staff see</p>
                <span class="chs__seg" role="group" aria-label="Channel">
                  <button type="button" data-count="youth" aria-pressed="true">Youth</button>
                  <button type="button" data-count="men" aria-pressed="false">Men's breakfast</button>
                </span>
                <p class="rev__count" data-count-of="youth"><b>Answered by 23</b> · no names, no scores</p>
                <p class="rev__count" data-count-of="men" hidden><b>Fewer than 5 answered</b> · counts show from five</p>
              </div>
            </div>
          )}

          {section.visual === "sees" && (
            <div class="aui aui-card sees" data-scene="sees" role="group" aria-label="What a church can and can't see">
              <p class="sees__h">Grace Church <span>this month</span></p>
              <p class="sees__big"><b>214</b> connected</p>
              {[
                ["Sunday service", 168],
                ["Youth", 46],
                ["Women's", 31],
              ].map(([name, n]) => (
                <div class="sees__bar" style={`--w: ${(Number(n) / 214) * 100}%;`}>
                  <span class="sees__name">{name}</span>
                  <span class="sees__track"><i></i></span>
                  <span class="sees__n">{n} follow</span>
                </div>
              ))}
              <p class="aui-label sees__label">Never shown</p>
              {["Who wrote notes", "What anyone wrote", "Who came on Sunday"].map((t) => (
                <div class="aui-row sees__no">
                  <span class="aui-tile"><AppIcon name="eye-slash" /></span>
                  <span><span class="aui-title">{t}</span></span>
                  <span class="sees__mark"><AppIcon name="xmark" /></span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="chs__note" data-reveal>
        <h2 class="chs__h">{section.heading}</h2>
        {section.paragraphs.map((p) => <p set:html={inlineMdLinksToHtml(p)} />)}
      </div>
    );
  })}
</section>

<script>
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Runs `play` once, when `el` first scrolls into view (or straight away without IO). */
  const onFirstView = (el: Element, play: () => void) => {
    if (!("IntersectionObserver" in window)) return play();
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        play();
      },
      { threshold: 0.35 }
    );
    io.observe(el);
  };

  /** A segmented control: each button shows its own panel. */
  const segmented = (scene: Element, btnAttr: string, panelAttr: string) => {
    const btns = scene.querySelectorAll<HTMLButtonElement>(`[${btnAttr}]`);
    btns.forEach((btn) =>
      btn.addEventListener("click", () => {
        btns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        scene.querySelectorAll<HTMLElement>(`[${panelAttr}]`).forEach((p) => {
          p.hidden = p.getAttribute(panelAttr) !== btn.getAttribute(btnAttr);
        });
      })
    );
  };

  // Feed: the push arrives, opens Home's "From your church", then This Sunday's note.
  document.querySelectorAll<HTMLElement>('[data-scene="feed"]').forEach((scene) => {
    let timers: ReturnType<typeof setTimeout>[] = [];
    const go = (state: string) => (scene.dataset.state = state);
    const play = () => {
      timers.forEach(clearTimeout);
      go("push");
      if (still) return go("sunday");
      timers = [setTimeout(() => go("feed"), 2200), setTimeout(() => go("sunday"), 4600)];
    };
    scene.querySelectorAll<HTMLElement>("[data-go]").forEach((el) =>
      el.addEventListener("click", () => {
        timers.forEach(clearTimeout);
        go(el.dataset.go ?? "feed");
      })
    );
    scene.querySelector("[data-replay]")?.addEventListener("click", play);
    if (still) return go("sunday");
    onFirstView(scene, play);
  });

  // Planner: each ministry's plan.
  document.querySelectorAll('[data-scene="planner"]').forEach((scene) => segmented(scene, "data-plan", "data-plan-list"));

  // Roles: a volunteer's one room, granted and taken back; the approval switch.
  document.querySelectorAll<HTMLElement>('[data-scene="roles"]').forEach((scene) => {
    const lead = scene.querySelector<HTMLButtonElement>("[data-lead-switch]");
    const row = scene.querySelector<HTMLElement>("[data-lead-row]");
    const sub = scene.querySelector<HTMLElement>("[data-lead-sub]");
    lead?.addEventListener("click", () => {
      const on = lead.getAttribute("aria-checked") !== "true";
      lead.setAttribute("aria-checked", String(on));
      row?.classList.toggle("is-off", !on);
      if (sub) sub.textContent = (on ? sub.dataset.on : sub.dataset.off) ?? "";
    });
    scene.querySelectorAll<HTMLButtonElement>("[data-switch]").forEach((sw) =>
      sw.addEventListener("click", () => sw.setAttribute("aria-checked", String(sw.getAttribute("aria-checked") !== "true")))
    );
  });

  // Join: the code is scanned, then the phone shows the person connected. Loops gently.
  document.querySelectorAll<HTMLElement>('[data-scene="join"]').forEach((scene) => {
    if (still) return void scene.classList.add("is-joined");
    onFirstView(scene, () => {
      const cycle = () => {
        scene.classList.remove("is-joined");
        setTimeout(() => scene.classList.add("is-joined"), 1800);
      };
      cycle();
      setInterval(cycle, 7000);
    });
  });

  // Review: answer the question; switch which channel's count staff see.
  document.querySelectorAll<HTMLElement>('[data-scene="review"]').forEach((scene) => {
    scene.querySelectorAll<HTMLButtonElement>(".rev__opt").forEach((opt) =>
      opt.addEventListener("click", () => {
        scene.querySelectorAll(".rev__opt").forEach((o) => o.classList.remove("is-right", "is-wrong"));
        opt.classList.add(opt.dataset.right ? "is-right" : "is-wrong");
        scene.classList.toggle("is-answered", Boolean(opt.dataset.right));
      })
    );
    segmented(scene, "data-count", "data-count-of");
  });
</script>

<style>
  .chs {
    max-width: calc(68rem + 2 * var(--nx-gutter));
    padding-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: clamp(4rem, 9vw, 7rem);
  }

  .chs__row { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) {
    .chs__row { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(3rem, 6vw, 5rem); }
    .chs__row.is-flip { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
    .chs__row.is-flip .chs__stage { order: -1; }
  }
  .chs__num {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--aud-ink, var(--color-ink-faint));
  }
  .chs__h {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.8vw, 2.25rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .chs__text > p:not(.chs__num, .chs__cta), .chs__note p {
    margin: 0.9rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }
  .chs__cta { margin: 1.5rem 0 0; }
  .chs__note { max-width: 40rem; margin-inline: auto; text-align: center; }

  .chs__stage {
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3.5vw, 2.75rem);
    border-radius: var(--nx-radius-scene);
    min-height: 22rem;
  }
  .chs__stage > * { width: 100%; max-width: 30rem; }
  .chs button { font: inherit; cursor: pointer; border: 0; }
  .chs button:focus-visible { outline: 2px solid var(--pds-accent); outline-offset: 2px; }
  .chs :global(svg) { flex: none; }
  .chs :global(.aui-sub) { display: block; font-size: 12px; color: var(--pds-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chs :global(.aui-row) { padding: 9px 13px 9px 11px; }

  /* Shared controls */
  .chs__seg { display: inline-flex; gap: 2px; padding: 2px; border-radius: 999px; background: var(--pds-bg-chip); }
  .chs__seg button { padding: 4px 10px; border-radius: 999px; font-size: 12px; color: var(--pds-text-secondary); background: none; }
  .chs__seg button[aria-pressed="true"] { color: var(--pds-text-primary); background: var(--pds-bg-main); box-shadow: var(--pds-shadow-chip-selected); }
  .chs__switch { position: relative; width: 40px; height: 24px; padding: 0; border-radius: 999px; background: var(--pds-bg-track); transition: background-color 200ms ease; }
  .chs__switch span { position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: var(--pds-shadow-track-knob); transition: transform 200ms var(--nx-ease); }
  .chs__switch[aria-checked="true"] { background: var(--pds-accent); }
  .chs__switch[aria-checked="true"] span { transform: translateX(16px); }
  .chs__replay { display: inline-flex; align-items: center; gap: 5px; margin: 10px 0 0 auto; padding: 4px 10px; border-radius: 999px; font-size: 12px; color: var(--pds-text-secondary); background: color-mix(in srgb, var(--pds-bg-main) 70%, transparent); }
  .chs__replay :global(svg) { width: 10px; height: 10px; }

  /* ── Feed: push → From your church → This Sunday ──────────────────────── */
  .feed { position: relative; display: grid; font-size: 14px; }
  .feed > .feed__push, .feed > .feed__home, .feed > .feed__note { grid-area: 1 / 1; align-self: start; }
  .feed > .chs__replay { grid-area: 2 / 1; }
  .feed__push {
    display: flex; align-items: flex-start; gap: 10px; width: 100%; padding: 11px 13px; border-radius: 16px; text-align: left;
    background: color-mix(in srgb, var(--pds-bg-main) 88%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: var(--pds-shadow-popover), 0 20px 40px -24px rgba(15, 23, 42, 0.35);
    z-index: 2; transition: transform 500ms var(--nx-ease), opacity 400ms ease;
  }
  .feed__push img { width: 30px; height: 30px; border-radius: 8px; }
