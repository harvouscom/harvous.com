---
/**
 * One listing, as an indexed page — with a treatment per kind.
 *
 * It used to be one treatment for all four: the app's shared-note paper stack,
 * applied to Threads and links as well. That was wrong for the reason the app
 * itself already writes down, on the shared thread's plan-step:
 *
 *   "Deliberately a flat row rather than a note card — a step here is a plan
 *    row, not a note. Borrowing the note card would promise content the preview
 *    does not (and must not) show."
 *
 * The app speaks two dialects and each kind already belongs to one. **Paper** —
 * sharp corners, a hair of rotation, dot grain, a folded corner — says *a
 * document someone wrote*. **Card** — rounded, colour stripe, header rule — says
 * *a container of things*. So:
 *
 *   note      paper, tilted, body faded         ← .public-note-card
 *   template  the same — a template is a note template, and drawing it as a
 *             ruled form put it in a dialect of its own that nothing in the
 *             app speaks. Its body is the scaffold, which reads fine as a page.
 *   pack      card, icon tile, spine            ← .proto-collection-card, which
 *                                                 is how the app draws a Thread
 *   resource  link card, image and domain bar   ← .card-image-link
 *
 * Not built on `ProductDetailPage.astro`: its type is `kind: "feature" |
 * "addon"` and its body reaches into eight feature-specific helpers across 300
 * lines that all market a product.
 */
import { Icon } from "astro-icon/components";
import { ogCard } from "../lib/og-card.ts";
import { sanitizeListingHtml } from "../lib/sanitize-listing-html.ts";
import NextLayout from "../layouts/NextLayout.astro";
import ClosingCall from "./next/ClosingCall.astro";
import DiscoverTile from "./next/DiscoverTile.astro";
import { toDiscoverCard } from "../lib/next/discover-card.ts";
import DiscoverVideoEmbed from "./DiscoverVideoEmbed.astro";
import { breadcrumbJsonLd } from "../lib/breadcrumb-jsonld.ts";
import { fathomDiscover } from "../lib/fathom-events.ts";
import { isDraftPageSlug } from "../lib/draft-pages.ts";
import { withHarvousRef } from "../lib/outbound.ts";
import {
  DISCOVER_KIND_NOUN,
  DISCOVER_RESOURCE_TYPE_NOUN,
  discoverCategoryLabel,
  discoverListingCta,
  discoverSourceSlug,
  discoverListingInk,
  discoverListingIcon,
  type DiscoverListing,
} from "../lib/discover-data.ts";

interface Props {
  listing: DiscoverListing;
  related: DiscoverListing[];
}

const { listing, related } = Astro.props;

const kindNoun = DISCOVER_KIND_NOUN[listing.kind] ?? "Item";
const categoryLabel = listing.category ? discoverCategoryLabel(listing.category) : null;
const preview = listing.preview ?? {};

/* A curated reference points at somebody else's page, so it has its own head
   (the publisher, not a kind pill) and its own body (their picture or their
   video). Once the app seeds it, it also gains an install — which is why the
   CTA below is a pair rather than the single button this used to render. */
const source = listing.source ?? null;
const video = listing.video ?? null;
const typeNoun = listing.resourceType ? DISCOVER_RESOURCE_TYPE_NOUN[listing.resourceType] : kindNoun;

/* The CTA stories live in one function rather than in this file's markup — see
   `discoverListingCta`. `secondary` is the publisher link once the install
   takes the lead; `note` is one line for the pair, never one per button. */
const { primary: cta, secondary: ctaSecondary, note: ctaNote } = discoverListingCta(listing);

/**
 * The credit line, with the publisher named once.
 *
 * Their attribution sentence usually ends by naming them ("…visit
 * bibleproject.com."), and appending a separate "bibleproject.com ↗" after it
 * printed the domain twice in one breath. Link the mention already in the
 * sentence instead; only append one where the sentence never names them, which
 * is what keeps BibleProject's required link present either way.
 */
const credit = source
  ? (() => {
      const at = source.attribution.lastIndexOf(source.domain);
      if (at === -1) return { before: `${source.attribution} `, after: "" };
      return {
        before: source.attribution.slice(0, at),
        after: source.attribution.slice(at + source.domain.length),
      };
    })()
  : null;

/* Sanitized twice server-side — once at snapshot, once in `serializePublic` —
   so this repo renders it directly and takes no sanitizer dependency of its own.
   Absent on rows written before bodies were carried, and on links, which have
   none; those fall back to the outline. */
/* Sanitized here, and only here — see `sanitize-listing-html.ts` for why the
   API cannot do it. Both `set:html` sites below read this variable. */
const bodyHtml = sanitizeListingHtml(preview.bodyHtml ?? "");
/* Only fade a body long enough to actually be cut. Below this the whole thing
   fits, and a gradient over it hides writing for no reason — the fade is there
   to make a truncation invisible, not to withhold. */
const bodyIsLong = bodyHtml.length > 420;
const outline = preview.headings ?? preview.titles ?? [];
const noteCount = preview.noteCount ?? null;

/* Everything after the first note of a Thread, by title — so the page stays a
   page whether the Thread holds four notes or a hundred. */
const spine = (preview.titles ?? []).slice(1);
const spineMore = (noteCount ?? 0) - (preview.titles ?? []).length;

/* noindex whenever `discover` is a draft slug — including staging, which is the
   one environment that actually builds and serves these pages. */
const isDraft = isDraftPageSlug("discover");

const description =
  listing.description ??
  `${kindNoun} shared on Harvous${
    !preview.official && listing.authorDisplayName ? ` by ${listing.authorDisplayName}` : ""
  }.`;

const siteOrigin = Astro.site ?? "https://harvous.com";
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();

/* Generated by `npm run og:cards`: a sky, the listing's own title and the kind's
   icon — never the publisher's poster, which would put their frame on our URL
   in somebody else's feed. */
const ogImage = ogCard(`discover-${listing.slug}`);

/**
 * What this page is, to a crawler.
 *
 * A curated reference is somebody else's work that we are pointing at, so its
 * `author` and `publisher` are the source and its `mainEntityOfPage` is *their*
 * URL — the structured-data half of the same promise the credit line makes on
 * screen. Only what we actually wrote (the description and the note) is ours.
 *
 * `VideoObject` where there is an embed, which is what `video.duration` has
 * been carried in ISO 8601 for all along. Everything else is a `CreativeWork`
 * published by Harvous — a template is a thing you can take, not an article.
 */
const sourceOrganization = source
  ? { "@type": "Organization", name: source.name, url: source.homeUrl }
  : null;

/* Harvous wrote this content, but did not invent the shape — `official`
   would claim we did, and `authorDisplayName` means specifically "a Harvous
   account submitted this," which is also untrue here. Neither field fits, so
   this is its own case rather than a repurposing of either. Declared before
   `listingJsonLd` below, which reads it for `isBasedOn`. */
const sourceCredit =
  !source && preview.sourceName && preview.sourceUrl
    ? { name: preview.sourceName, url: preview.sourceUrl }
    : null;

const harvousPublisher = {
  "@type": "Organization",
  name: "Harvous",
  url: siteOrigin.toString(),
  logo: {
    "@type": "ImageObject",
    url: new URL("/images/harvous-2-icon-512.png", siteOrigin).toString(),
  },
};

const listingJsonLd: Record<string, unknown> =
  source && video
    ? {
        "@context": "https://schema.org",
        "@type": "VideoObject",
        name: listing.title,
        description,
        thumbnailUrl: preview.sourceImage
          ? [new URL(preview.sourceImage, siteOrigin).toString()]
          : undefined,
        /* Theirs, not ours. `listedAt` here would date a 2015 video to the day
           we happened to add it. */
        uploadDate: video.publishedAt ?? undefined,
        duration: video.duration ?? undefined,
        embedUrl: `https://www.youtube-nocookie.com/embed/${video.id}`,
        contentUrl: `https://www.youtube.com/watch?v=${video.id}`,
        author: sourceOrganization,
        publisher: sourceOrganization,
        isFamilyFriendly: true,
        mainEntityOfPage: { "@type": "WebPage", "@id": source.url },
      }
    : source
      ? {
          "@context": "https://schema.org",
          "@type": "CreativeWork",
          name: listing.title,
          description,
          url: pageUrl,
          author: sourceOrganization,
          publisher: sourceOrganization,
          isAccessibleForFree: true,
          mainEntityOfPage: { "@type": "WebPage", "@id": source.url },
        }
      : {
          "@context": "https://schema.org",
          "@type": "CreativeWork",
          name: listing.title,
          description,
          url: pageUrl,
          image: [new URL(ogImage, siteOrigin).toString()],
          datePublished: listing.listedAt ?? undefined,
          isAccessibleForFree: true,
          /* An official template is the product's; a shared one keeps the
             byline the submitter's account carried at the time; a
             source-credited one is still ours to write, so Harvous stays the
             author — `isBasedOn` is schema.org's own word for the relationship
             to the outside structure, which is a truer fit than crediting the
             source as author of content it did not write. */
          author: preview.official
            ? harvousPublisher
            : listing.authorDisplayName
              ? { "@type": "Person", name: listing.authorDisplayName }
              : harvousPublisher,
          publisher: harvousPublisher,
          isBasedOn: sourceCredit?.url,
          mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
        };

const jsonLd = [
  listingJsonLd,
  breadcrumbJsonLd(
    [
      { name: "Harvous", path: "/" },
      { name: "Discover", path: "/discover/" },
      ...(categoryLabel && listing.category
        ? [{ name: categoryLabel, path: `/discover/?use=${listing.category}` }]
        : []),
      { name: listing.title, path: `/discover/${listing.slug}/` },
    ],
    siteOrigin,
  ),
];

/* The stage's ground, decided exactly as the grid card decides its tone
   (`toDiscoverCard`): the publisher's colour, else the author's thread colour,
   else the topic's — so a listing keeps its colour when you click through. */
const stageTone = listing.plateTone ?? discoverListingInk(listing);
const leaves = (href: string) => /^https?:/.test(href);

---

<NextLayout
  title={`${listing.title} — Discover — Harvous`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  noindex={isDraft}
>
  <article class="dl" style={`--tone: ${stageTone};`}>
    <div class="nx-wrap dl-grid">
      {/* ── The thing itself, on its stage ─────────────────────────────── */}
      <div class:list={["dl-stage", `dl-stage--${listing.kind}`, source && "dl-stage--source"]}>
        {(listing.kind === "note" || listing.kind === "template") && (
          <div class="aui aui-paper dl-paper">
            <p class="aui-h">{listing.title}</p>
            {bodyHtml ? (
              <div class="dl-body">
                <div class="dl-body__html" set:html={bodyHtml} />
                {bodyIsLong && <div class="dl-body__fade" aria-hidden="true" />}
              </div>
            ) : (
              <ul class="dl-outline">{outline.map((line) => <li>{line}</li>)}</ul>
            )}
          </div>
        )}

        {listing.kind === "pack" && (
          <div class="aui dl-thread">
            <p class="aui-label dl-thread__label"><Icon name="fa7-solid:arrow-right-arrow-left" /> {listing.title}</p>
            <div class="aui-card dl-thread__card">
              {preview.titles?.[0] && (
                <div class="dl-thread__first">
                  <p class="aui-h">{preview.titles[0]}</p>
                  {bodyHtml && (
                    <div class="dl-body">
                      <div class="dl-body__html" set:html={bodyHtml} />
                      {bodyIsLong && <div class="dl-body__fade" aria-hidden="true" />}
                    </div>
                  )}
                </div>
              )}
              {spine.map((title, i) => (
                <div class="aui-row dl-thread__row">
                  <span class="aui-tile"><Icon name="fa7-solid:pen-to-square" /></span>
                  <span><span class="aui-title">{title}</span><span class="aui-sub">Note {i + 2}</span></span>
                  <span />
                </div>
              ))}
              {spineMore > 0 && (
                <div class="aui-row dl-thread__row">
                  <span class="aui-tile"><Icon name="fa7-solid:ellipsis" /></span>
                  <span><span class="aui-sub">and {spineMore} more</span></span>
                  <span />
                </div>
              )}
            </div>
          </div>
        )}

        {listing.kind === "resource" && source && (
          <div class="dl-ref">
            <p class="dl-ref__mast">
              {source.logo ? <img src={source.logo} alt="" width="32" height="32" /> : <span class="dl-ref__letter">{source.name.slice(0, 1)}</span>}
              <span><b>{source.name}</b><small>{typeNoun}</small></span>
            </p>
            {video ? (
              <DiscoverVideoEmbed video={video} source={source} title={listing.title} poster={preview.sourceImage ?? null} />
            ) : preview.sourceImage ? (
              <img class="dl-ref__image" src={preview.sourceImage} alt="" width="1280" height="720" loading="eager" decoding="async" />
            ) : (
              <div class="dl-ref__doc"><span class="dl-ref__tile"><Icon name={discoverListingIcon(listing)} /></span></div>
            )}
          </div>
        )}

        {listing.kind === "resource" && !source && (
          <div class="dl-link">
            {preview.sourceImage && <div class="dl-link__image" style={`background-image: url("${preview.sourceImage}");`} aria-hidden="true" />}
            <div class="dl-link__body">
              <p class="dl-link__title">{listing.title}</p>
              {preview.sourceDomain && <p class="dl-link__domain">{preview.sourceDomain} <span aria-hidden="true">↗</span></p>}
            </div>
          </div>
        )}
      </div>

      {/* ── What it is, and the way to take it ─────────────────────────── */}
      <div class="dl-info">
        <a class="dl-back" href="/discover/">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
          Discover
        </a>
        <h1 class="dl-title">{listing.title}</h1>
        {/* One quiet line for what it is, whose it is, and where it's filed. */}
        <p class="dl-meta">
          <span>{source ? typeNoun : kindNoun}</span>
          {source ? (
            <span>from {source.name}</span>
          ) : sourceCredit ? (
            <span>based on <a href={withHarvousRef(sourceCredit.url)} target="_blank" rel="noopener">{sourceCredit.name}</a></span>
          ) : preview.official ? (
            <span>included with Harvous</span>
          ) : listing.authorDisplayName ? (
            <span>from {listing.authorDisplayName}</span>
          ) : null}
          {categoryLabel && <a href={`/discover/?use=${listing.category}`}>{categoryLabel}</a>}
          {listing.kind === "pack" && noteCount && <span>{noteCount} notes</span>}
          {listing.installCount > 1 && <span>saved by {listing.installCount}</span>}
        </p>
        {listing.description && <p class="dl-lead">{listing.description}</p>}
        {listing.note && <p class="dl-note">{listing.note}</p>}

        <div class="dl-cta">
          <a
            class="nx-btn nx-btn--accent"
            href={withHarvousRef(cta.href)}
            {...(cta.external || leaves(cta.href) ? { target: "_blank", rel: "noopener" } : {})}
            data-fathom-track={ctaSecondary || !source ? fathomDiscover.install(listing.slug) : fathomDiscover.sourceOut(listing.slug)}
          >
            {cta.label}
          </a>
          {ctaSecondary && (
            <a
              class="nx-btn nx-btn--ghost"
              href={withHarvousRef(ctaSecondary.href)}
              {...(ctaSecondary.external ? { target: "_blank", rel: "noopener" } : {})}
              data-fathom-track={fathomDiscover.sourceOut(listing.slug)}
            >
              {ctaSecondary.label}{ctaSecondary.external && <span aria-hidden="true"> ↗</span>}
            </a>
          )}
        </div>
        {ctaNote && <p class="dl-ctanote">{ctaNote}</p>}

        {source && (
          <p class="dl-credit">
            {source.logo && <img src={source.logo} alt="" width="18" height="18" loading="lazy" decoding="async" />}
            <span>{credit?.before}<a href={withHarvousRef(source.homeUrl)} target="_blank" rel="noopener">{source.domain} <span aria-hidden="true">↗</span></a>{credit?.after}</span>
          </p>
        )}
        {source && (
          <a class="dl-more" href={`/discover/?from=${discoverSourceSlug(source)}`}>More from {source.name} →</a>
        )}
      </div>
    </div>

    {preview.official && (listing.kind === "template" || listing.kind === "note") && (
      <section class="nx-wrap dl-included">
        <p class="nx-kicker">Included with every plan</p>
        <h2>Templates like this come with Harvous</h2>
        <p>
          Pick one when you start a note, fill in what helps, and leave the rest — the note is still
          yours to write however you like. Change the headings until the shape fits how you actually
          study, save it as a template, and share it here so someone else can start from it.
        </p>
        <a class="dl-included__link" href="/features/note-templates/" data-fathom-track={fathomDiscover.makeYourOwn}>How note templates work →</a>
      </section>
    )}

    {related.length > 0 && (
      <section class="nx-wrap dl-related" aria-labelledby="dl-related-title">
        <div class="dl-related__head">
          <h2 id="dl-related-title">More like this</h2>
          <a href={listing.category ? `/discover/?use=${listing.category}` : "/discover/"}>See all →</a>
        </div>
        <ul class="dl-related__grid" role="list">
          {related.map((other) => <DiscoverTile card={toDiscoverCard(other)} heading="h3" />)}
        </ul>
      </section>
    )}
  </article>

  <ClosingCall
    title="Somewhere for your own study to live."
    lead="Take a copy, then make it yours. Harvous keeps what you write where you can find it again."
  />
</NextLayout>

<style>
  .dl-grid {
    display: grid;
    gap: 2rem;
    padding-top: clamp(6.5rem, 12vw, 8rem);
  }
  /* Narrow: what it is first, then the thing. */
  .dl-info { order: -1; }
  @media (min-width: 60rem) {
    .dl-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 4rem); align-items: start; }
    .dl-info { position: sticky; top: 6rem; order: 2; }
    .dl-stage { order: 1; }
  }

  /* The stage: the listing's colour, the thing on it at reading size. */
  .dl-stage {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 26rem;
    padding: clamp(1.75rem, 4vw, 3rem) clamp(1.25rem, 4vw, 3rem) 0;
    border-radius: var(--nx-radius-scene, 1.5rem);
    background:
      radial-gradient(120% 80% at 50% 0%, color-mix(in srgb, #fff 55%, transparent), transparent 70%),
      color-mix(in srgb, var(--tone) 30%, var(--color-paper));
  }
  .dl-stage--resource { align-items: center; padding-bottom: clamp(1.75rem, 4vw, 3rem); }

  .dl-paper {
    width: 100%;
    max-width: 34rem;
    max-height: 40rem;
    overflow: hidden;
    padding: 24px 28px 32px;
    font-size: 14px;
    line-height: 1.6;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 30px 60px -30px rgba(15, 23, 42, 0.45);
  }
  .dl-paper .aui-h { font-size: 20px; margin-bottom: 12px; }
  .dl-body { position: relative; }
  .dl-body__html { color: var(--pds-text-secondary); }
  .dl-body__html :global(h1), .dl-body__html :global(h2), .dl-body__html :global(h3) {
    margin: 1em 0 0.25em;
    font-size: 14px;
    font-weight: 600;
    color: var(--pds-text-primary);
  }
  .dl-body__html :global(:is(h1, h2, h3):first-child) { margin-top: 0; }
  .dl-body__html :global(p) { margin: 0 0 0.5em; }
  .dl-body__html :global(ul), .dl-body__html :global(ol) { margin: 0 0 0.5em; padding-left: 1.2em; }
  .dl-body__html :global(img), .dl-body__html :global(figure) { display: none; }
  .dl-body__fade { position: absolute; left: 0; right: 0; bottom: 0; height: 6rem; background: linear-gradient(to bottom, transparent, var(--pds-bg-main)); }
  .dl-outline { margin: 0; padding-left: 1.2em; color: var(--pds-text-secondary); }

  .dl-thread { width: 100%; max-width: 30rem; font-size: 14px; }
  .dl-thread__label { display: flex; align-items: center; gap: 6px; }
  .dl-thread__label :global(svg) { width: 11px; height: 11px; color: var(--pds-text-secondary); }
  .dl-thread__card {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 30px 60px -30px rgba(15, 23, 42, 0.45);
  }
  .dl-thread__first { padding: 18px 20px; max-height: 18rem; overflow: hidden; }
  .dl-thread__first .aui-h { font-size: 17px; margin-bottom: 8px; }
  .dl-thread__row { box-shadow: inset 0 0.5px 0 var(--pds-border); }

  .dl-ref { width: 100%; max-width: 40rem; display: grid; gap: 0.85rem; padding: 0.85rem; border-radius: 1.2rem; background: var(--color-card, #fff); box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 30px 60px -30px rgba(15, 23, 42, 0.45); }
  .dl-ref__mast { display: flex; align-items: center; gap: 0.65rem; margin: 0; }
  .dl-ref__mast img, .dl-ref__letter { width: 2rem; height: 2rem; border-radius: 0.55rem; object-fit: contain; box-shadow: 0 0 0 1px var(--color-rule); }
  .dl-ref__letter { display: grid; place-items: center; font-weight: 600; background: var(--color-warm); }
  .dl-ref__mast span { display: grid; }
  .dl-ref__mast b { font-family: var(--font-display); font-weight: 600; color: var(--color-ink); }
  .dl-ref__mast small { font-size: 0.65rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-faint); }
  .dl-ref__image { width: 100%; height: auto; border-radius: 0.75rem; }
  /* No picture of its own: the publisher's colour, with the kind's tile. */
  .dl-ref__doc {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    background: linear-gradient(142deg, color-mix(in oklab, var(--tone) 52%, var(--color-paper)), color-mix(in oklab, var(--tone) 26%, var(--color-paper)));
  }
  .dl-ref__tile {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 1rem;
    background: var(--color-card, #fff);
    color: var(--color-ink-soft);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08), 0 14px 28px -14px rgba(15, 23, 42, 0.35);
  }
  .dl-ref__tile :global(svg) { width: 1.5rem; height: 1.5rem; }

  .dl-link { width: 100%; max-width: 32rem; overflow: hidden; border-radius: 1.2rem; background: var(--color-card, #fff); box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 30px 60px -30px rgba(15, 23, 42, 0.45); }
  .dl-link__image { aspect-ratio: 16 / 9; background-size: cover; background-position: center; }
  .dl-link__body { padding: 1rem 1.25rem; }
  .dl-link__title { margin: 0; font-weight: 600; color: var(--color-ink); }
  .dl-link__domain { margin: 0.25rem 0 0; font-size: 0.8125rem; color: var(--color-ink-faint); }

  /* The info column. */
  .dl-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem 0.4rem 0.6rem;
    border-radius: 999px;
    background: var(--color-warm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
  }
  .dl-back:hover { background: color-mix(in srgb, var(--color-ink) 8%, transparent); }
  .dl-back svg { width: 0.9rem; height: 0.9rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
