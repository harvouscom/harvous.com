---
/**
 * One listing, as an indexed page — with a treatment per kind.
 *
 * It used to be one treatment for all four: the app's shared-note paper stack,
 * applied to Threads and links as well. That was wrong for the reason the app
 * itself already writes down, on the shared thread's plan-step:
 *
 *   "Deliberately a flat row rather than a note card — a step here is a plan
 *    row, not a note. Borrowing the note card would promise content the preview
 *    does not (and must not) show."
 *
 * The app speaks two dialects and each kind already belongs to one. **Paper** —
 * sharp corners, a hair of rotation, dot grain, a folded corner — says *a
 * document someone wrote*. **Card** — rounded, colour stripe, header rule — says
 * *a container of things*. So:
 *
 *   note      paper, tilted, body faded         ← .public-note-card
 *   template  the same — a template is a note template, and drawing it as a
 *             ruled form put it in a dialect of its own that nothing in the
 *             app speaks. Its body is the scaffold, which reads fine as a page.
 *   pack      card, icon tile, spine            ← .proto-collection-card, which
 *                                                 is how the app draws a Thread
 *   resource  link card, image and domain bar   ← .card-image-link
 *
 * Not built on `ProductDetailPage.astro`: its type is `kind: "feature" |
 * "addon"` and its body reaches into eight feature-specific helpers across 300
 * lines that all market a product.
 */
import { Icon } from "astro-icon/components";
import { sanitizeListingHtml } from "../lib/sanitize-listing-html.ts";
import DiscoverCard from "./DiscoverCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageClosingCTA from "./PageClosingCTA.astro";
import CTAButton from "./CTAButton.astro";
import DiscoverVideoEmbed from "./DiscoverVideoEmbed.astro";
import { breadcrumbJsonLd } from "../lib/breadcrumb-jsonld.ts";
import { fathomDiscover } from "../lib/fathom-events.ts";
import { isDraftPageSlug } from "../lib/draft-pages.ts";
import {
  DISCOVER_KIND_NOUN,
  DISCOVER_RESOURCE_TYPE_NOUN,
  discoverCategoryLabel,
  discoverListingCta,
  discoverSourceSlug,
  discoverTopicInk,
  type DiscoverListing,
} from "../lib/discover-data.ts";

interface Props {
  listing: DiscoverListing;
  related: DiscoverListing[];
}

const { listing, related } = Astro.props;

const kindNoun = DISCOVER_KIND_NOUN[listing.kind] ?? "Item";
const categoryLabel = listing.category ? discoverCategoryLabel(listing.category) : null;
const preview = listing.preview ?? {};

/* A curated reference points at somebody else's page, so it has its own head
   (the publisher, not a kind pill) and its own body (their picture or their
   video). Once the app seeds it, it also gains an install — which is why the
   CTA below is a pair rather than the single button this used to render. */
const source = listing.source ?? null;
const video = listing.video ?? null;
const typeNoun = listing.resourceType ? DISCOVER_RESOURCE_TYPE_NOUN[listing.resourceType] : kindNoun;

/* The CTA stories live in one function rather than in this file's markup — see
   `discoverListingCta`. `secondary` is the publisher link once the install
   takes the lead; `note` is one line for the pair, never one per button. */
const { primary: cta, secondary: ctaSecondary, note: ctaNote } = discoverListingCta(listing);

/**
 * The credit line, with the publisher named once.
 *
 * Their attribution sentence usually ends by naming them ("…visit
 * bibleproject.com."), and appending a separate "bibleproject.com ↗" after it
 * printed the domain twice in one breath. Link the mention already in the
 * sentence instead; only append one where the sentence never names them, which
 * is what keeps BibleProject's required link present either way.
 */
const credit = source
  ? (() => {
      const at = source.attribution.lastIndexOf(source.domain);
      if (at === -1) return { before: `${source.attribution} `, after: "" };
      return {
        before: source.attribution.slice(0, at),
        after: source.attribution.slice(at + source.domain.length),
      };
    })()
  : null;

/* Sanitized twice server-side — once at snapshot, once in `serializePublic` —
   so this repo renders it directly and takes no sanitizer dependency of its own.
   Absent on rows written before bodies were carried, and on links, which have
   none; those fall back to the outline. */
/* The topic's ink, the same one its chip wears on the hub and its use-case page
   wears elsewhere. */
const ink = listing.category ? discoverTopicInk(listing.category) : null;

/* Sanitized here, and only here — see `sanitize-listing-html.ts` for why the
   API cannot do it. Both `set:html` sites below read this variable. */
const bodyHtml = sanitizeListingHtml(preview.bodyHtml ?? "");
/* Only fade a body long enough to actually be cut. Below this the whole thing
   fits, and a gradient over it hides writing for no reason — the fade is there
   to make a truncation invisible, not to withhold. */
const bodyIsLong = bodyHtml.length > 420;
const outline = preview.headings ?? preview.titles ?? [];
const noteCount = preview.noteCount ?? null;

/* Everything after the first note of a Thread, by title — so the page stays a
   page whether the Thread holds four notes or a hundred. */
const spine = (preview.titles ?? []).slice(1);
const spineMore = (noteCount ?? 0) - (preview.titles ?? []).length;

/* noindex whenever `discover` is a draft slug — including staging, which is the
   one environment that actually builds and serves these pages. */
const isDraft = isDraftPageSlug("discover");

const description =
  listing.description ??
  `${kindNoun} shared on Harvous${
    !preview.official && listing.authorDisplayName ? ` by ${listing.authorDisplayName}` : ""
  }.`;

const siteOrigin = Astro.site ?? "https://harvous.com";
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();

/* Generated by `npm run og:pages`. Topic art plus the kind's badge — never the
   publisher's poster, which would put their frame on our URL in somebody
   else's feed. Falls back to the site card if the generator has not run. */
const ogImage = `/images/discover/og/${listing.slug}.webp`;

/**
 * What this page is, to a crawler.
 *
 * A curated reference is somebody else's work that we are pointing at, so its
 * `author` and `publisher` are the source and its `mainEntityOfPage` is *their*
 * URL — the structured-data half of the same promise the credit line makes on
 * screen. Only what we actually wrote (the description and the note) is ours.
 *
 * `VideoObject` where there is an embed, which is what `video.duration` has
 * been carried in ISO 8601 for all along. Everything else is a `CreativeWork`
 * published by Harvous — a template is a thing you can take, not an article.
 */
const sourceOrganization = source
  ? { "@type": "Organization", name: source.name, url: source.homeUrl }
  : null;

/* Harvous wrote this content, but did not invent the shape — `official`
   would claim we did, and `authorDisplayName` means specifically "a Harvous
   account submitted this," which is also untrue here. Neither field fits, so
   this is its own case rather than a repurposing of either. Declared before
   `listingJsonLd` below, which reads it for `isBasedOn`. */
const sourceCredit =
  !source && preview.sourceName && preview.sourceUrl
    ? { name: preview.sourceName, url: preview.sourceUrl }
    : null;

const harvousPublisher = {
  "@type": "Organization",
  name: "Harvous",
  url: siteOrigin.toString(),
  logo: {
    "@type": "ImageObject",
    url: new URL("/images/harvous-2-icon.png", siteOrigin).toString(),
  },
};

const listingJsonLd: Record<string, unknown> =
  source && video
    ? {
        "@context": "https://schema.org",
        "@type": "VideoObject",
        name: listing.title,
        description,
        thumbnailUrl: preview.sourceImage
          ? [new URL(preview.sourceImage, siteOrigin).toString()]
          : undefined,
        /* Theirs, not ours. `listedAt` here would date a 2015 video to the day
           we happened to add it. */
        uploadDate: video.publishedAt ?? undefined,
        duration: video.duration ?? undefined,
        embedUrl: `https://www.youtube-nocookie.com/embed/${video.id}`,
        contentUrl: `https://www.youtube.com/watch?v=${video.id}`,
        author: sourceOrganization,
        publisher: sourceOrganization,
        isFamilyFriendly: true,
        mainEntityOfPage: { "@type": "WebPage", "@id": source.url },
      }
    : source
      ? {
          "@context": "https://schema.org",
          "@type": "CreativeWork",
          name: listing.title,
          description,
          url: pageUrl,
          author: sourceOrganization,
          publisher: sourceOrganization,
          isAccessibleForFree: true,
          mainEntityOfPage: { "@type": "WebPage", "@id": source.url },
        }
      : {
          "@context": "https://schema.org",
          "@type": "CreativeWork",
          name: listing.title,
          description,
          url: pageUrl,
          image: [new URL(ogImage, siteOrigin).toString()],
          datePublished: listing.listedAt ?? undefined,
          isAccessibleForFree: true,
          /* An official template is the product's; a shared one keeps the
             byline the submitter's account carried at the time; a
             source-credited one is still ours to write, so Harvous stays the
             author — `isBasedOn` is schema.org's own word for the relationship
             to the outside structure, which is a truer fit than crediting the
             source as author of content it did not write. */
          author: preview.official
            ? harvousPublisher
            : listing.authorDisplayName
              ? { "@type": "Person", name: listing.authorDisplayName }
              : harvousPublisher,
          publisher: harvousPublisher,
          isBasedOn: sourceCredit?.url,
          mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
        };

const jsonLd = [
  listingJsonLd,
  breadcrumbJsonLd(
    [
      { name: "Harvous", path: "/" },
      { name: "Discover", path: "/discover/" },
      ...(categoryLabel && listing.category
        ? [{ name: categoryLabel, path: `/discover/?use=${listing.category}` }]
        : []),
      { name: listing.title, path: `/discover/${listing.slug}/` },
    ],
    siteOrigin,
  ),
];

const kicker = source
  ? `A ${typeNoun.toLowerCase()} from ${source.name}`
  : sourceCredit
    ? `A ${kindNoun.toLowerCase()} based on`
    : preview.official
      ? `A ${kindNoun.toLowerCase()} included with Harvous`
      : listing.authorDisplayName
        ? `A ${kindNoun.toLowerCase()} from ${listing.authorDisplayName}`
        : `A ${kindNoun.toLowerCase()} shared on Harvous`;
---

<BaseLayout
  title={`${listing.title} — Discover — Harvous`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  noindex={isDraft}
>
  {
    isDraft && (
      <div class="draft-page-banner" role="status">
        Draft — not indexed or deployed. Remove <code>"discover"</code> from DRAFT_PAGE_SLUGS to publish.
      </div>
    )
  }

  <section class="dlist" style={ink ? `--ink: ${ink};` : undefined}>
    <p class="dlist__kicker">
      {sourceCredit ? (
        <>
          {kicker}{" "}<a href={sourceCredit.url} target="_blank" rel="noopener">{sourceCredit.name}</a>
        </>
      ) : (
        kicker
      )}
    </p>

    {/* ── note and template: paper, tilted, faded ───────────────────── */}
    {
      (listing.kind === "note" || listing.kind === "template") && (
        <div class="dpaper">
          <div class="dpaper__leaf dpaper__leaf--back" aria-hidden="true" />
          <div class="dpaper__leaf dpaper__leaf--mid" aria-hidden="true" />
          <article class="dpaper__sheet dpaper__sheet--tilt">
            <p class="dlist__eyebrow">
              <span>{kindNoun}</span>
              {categoryLabel && (
                <>
                  <span aria-hidden="true"> · </span>
                  <a href={`/discover/?use=${listing.category}`}>{categoryLabel}</a>
                </>
              )}
            </p>
            <h1 class="dpaper__title">{listing.title}</h1>
            {listing.description && <p class="dpaper__lead">{listing.description}</p>}

            {bodyHtml ? (
              <div class="dbody">
                <div class="dbody__html" set:html={bodyHtml} />
                {bodyIsLong && <div class="dbody__fade" aria-hidden="true" />}
              </div>
            ) : (
              <ul class="dlist__outline">
                {outline.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            )}
          </article>
        </div>
      )
    }

    {/* ── pack: card, colour stripe, first note then the spine ────────── */}
    {
      listing.kind === "pack" && (
        <article class="dthread">
          <div class="dthread__head">
            {/* The neutral tile and the swap glyph, which is the whole of a
                Thread's identity in the app — `proto-collection-card` draws an
                icon, a title and a note count, and nothing else. There used to
                be a 5px stripe here in `Threads.color`; the column still exists
                and shared-space covers still read it, but a personal Thread has
                not been drawn in its own hue for a long time, and reviving it
                only in the catalog had the same Thread showing two colours. */}
            <span class="dthread__tile" aria-hidden="true">
              <Icon name="fa7-solid:arrow-right-arrow-left" />
            </span>
            <p class="dlist__eyebrow">
              <span>{kindNoun}</span>
              {categoryLabel && (
                <>
                  <span aria-hidden="true"> · </span>
                  <a href={`/discover/?use=${listing.category}`}>{categoryLabel}</a>
                </>
              )}
            </p>
            <h1 class="dthread__title">{listing.title}</h1>
            <p class="dthread__meta">
              {noteCount ? `${noteCount} notes` : ""}
              {noteCount && listing.installCount > 0 ? " · " : ""}
              {listing.installCount > 0 ? `saved by ${listing.installCount}` : ""}
            </p>
          </div>

          {bodyHtml && (
            <div class="dthread__first">
              {preview.titles?.[0] && <p class="dthread__first-title">{preview.titles[0]}</p>}
              <div class="dbody">
                <div class="dbody__html" set:html={bodyHtml} />
                {bodyIsLong && <div class="dbody__fade dbody__fade--card" aria-hidden="true" />}
              </div>
            </div>
          )}

          {spine.length > 0 && (
            <ol class="dspine">
              {spine.map((title) => (
                <li class="dspine__step">
                  <span class="dspine__orb" aria-hidden="true" />
                  <span class="dspine__title">{title}</span>
                </li>
              ))}
              {spineMore > 0 && (
                <li class="dspine__step dspine__step--more">
                  <span class="dspine__orb" aria-hidden="true" />
                  <span class="dspine__title">and {spineMore} more</span>
                </li>
              )}
            </ol>
          )}
        </article>
      )
    }

    {/* ── curated reference: the publisher's work, credited and playable ── */}
    {
      listing.kind === "resource" && source && (
        <article class="dref">
          {video ? (
            <DiscoverVideoEmbed
              video={video}
              source={source}
              title={listing.title}
              poster={preview.sourceImage ?? null}
            />
          ) : preview.sourceImage ? (
            /* A real <img> with dimensions, not a background — this is the
               page's largest element and a CSS background has no intrinsic
               size to reserve. */
            <img
              class="dref__image"
              src={preview.sourceImage}
              alt=""
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          ) : null}

          <div class="dref__body">
            <p class="dlist__eyebrow">
              <span>{typeNoun}</span>
              {categoryLabel && (
                <>
                  <span aria-hidden="true"> · </span>
                  <a href={`/discover/?use=${listing.category}`}>{categoryLabel}</a>
                </>
              )}
            </p>
            <h1 class="dref__title">{listing.title}</h1>
            {listing.description && <p class="dref__lead">{listing.description}</p>}
            {/* Ours, and required on every curated entry. Without a sentence of
                our own this page is a summary of somebody else's page carrying
                our canonical, which is thin however it is dressed. */}
            {listing.note && <p class="dref__note">{listing.note}</p>}
          </div>

          {/* One line, for video and link alike — it used to be two different
              treatments (a boxed callout under the player, a plain sentence
              here for a link), and the boxed one duplicated `source.licence`,
              which the CTA note below already states. This says who owns it
              and links to their home, once. */}
          <p class="dref__credit">
            {source.logo && (
              <img
                class="dref__credit-mark"
                src={source.logo}
                alt=""
                width="18"
                height="18"
                loading="lazy"
                decoding="async"
              />
            )}
            {/* No newline between the anchor and what follows it: Astro keeps
                that whitespace, which put a space before the sentence's own
                full stop ("bibleproject.com ↗ ."). */}
            <span
              >{credit?.before}<a href={source.homeUrl} target="_blank" rel="noopener"
                >{source.domain} <span aria-hidden="true">↗</span></a
              >{credit?.after}</span
            >
          </p>

          <a class="dref__more" href={`/discover/?from=${discoverSourceSlug(source)}`}>
            More from {source.name}
          </a>
        </article>
      )
    }

    {/* ── resource: the link card the app draws ───────────────────────── */}
    {
      listing.kind === "resource" && !source && (
        <article class="dlink">
          {preview.sourceImage && (
            <div
              class="dlink__image"
              style={`background-image: url("${preview.sourceImage}");`}
              aria-hidden="true"
            />
          )}
          <div class="dlink__body">
            <p class="dlist__eyebrow">
              <span>{kindNoun}</span>
              {categoryLabel && (
                <>
                  <span aria-hidden="true"> · </span>
                  <a href={`/discover/?use=${listing.category}`}>{categoryLabel}</a>
                </>
              )}
            </p>
            <h1 class="dlink__title">{listing.title}</h1>
            {listing.description && <p class="dlink__lead">{listing.description}</p>}
          </div>

          {/* Where it goes. Domain over site name, as the app prefers — a site
              name derived from a host mangles subdomains. */}
          {preview.sourceDomain && (
            <div class="dlink__source">
              <span class="dlink__domain">{preview.sourceDomain}</span>
              <span class="dlink__arrow" aria-hidden="true">↗</span>
            </div>
          )}
        </article>
      )
    }

    {/* The event follows the button, not the listing: once a reference is
        installable this block renders both an install and a way out, and
        branching on `source` would have filed the install as a click-away. */}
    {/* The event follows the button, not the listing: once a reference is
        installable this block renders both an install and a way out, and
        branching on `source` would have filed the install as a click-away. */}
    <div class="dlist__cta">
      <div class="dlist__cta-row">
        <CTAButton
          href={cta.href}
          variant="primary"
          size="lg"
          external={cta.external}
          fathomTrack={
            ctaSecondary || !source
              ? fathomDiscover.install(listing.slug)
              : fathomDiscover.sourceOut(listing.slug)
          }
        >
          {cta.label}
        </CTAButton>
        {
          ctaSecondary && (
            <CTAButton
              href={ctaSecondary.href}
              variant="secondary"
              size="lg"
              external={ctaSecondary.external}
              fathomTrack={fathomDiscover.sourceOut(listing.slug)}
            >
              {ctaSecondary.label}
              {/* Only when it actually leaves — one of these is our own blog. */}
              {ctaSecondary.external && <span aria-hidden="true">↗</span>}
            </CTAButton>
          )
        }
      </div>
      {ctaNote && <p class="dlist__note text-balance">{ctaNote}</p>}
    </div>

    {/* ── Included templates: the one thing the reader does not have ─────
        The kicker above already says this came with Harvous, and the button
        used to answer that by offering to add it — an invitation to acquire
        something they already own. What is actually worth saying here is that
        the templates worth sharing are the ones you build. */}
    {
      preview.official && (listing.kind === "template" || listing.kind === "note") && (
        <section class="dincluded">
          <h2 class="dincluded__title">Templates like this come with Harvous</h2>
          <p>
            Every plan has a set of them built in. Pick one when you start a note, fill in what
            helps, and leave the rest — the note is still yours to write however you like.
          </p>
          <p>
            You can make your own, too. Change the headings until the shape fits how you actually
            study, save the note as a template, and share it here so someone else can start from
            it.
          </p>
          <a
            class="dincluded__link"
            href="/features/note-templates/"
            data-fathom-track={fathomDiscover.makeYourOwn}
          >
            How note templates work
            <span aria-hidden="true">→</span>
          </a>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="dlist__related">
          <h2 class="dlist__related-title">More like this</h2>
          {/* The catalog's own cards, without their preview panels — someone at
              the foot of a page wants somewhere to go next, not another three
              artifacts to read. */}
          <ul class="dlist__related-grid">
            {related.map((other) => (
              <DiscoverCard listing={other} variant="compact" />
            ))}
          </ul>
        </section>
      )
    }
  </section>

  <PageClosingCTA
    heading="Somewhere for your own study to live"
    lead="Take a copy, then make it yours. Harvous keeps what you write where you can find it again."
  />
</BaseLayout>

<style>
  .dlist {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 0;
  }

  .dlist__kicker {
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-bottom: 1.25rem;
  }

  /* The sermon-outline credit link — the one case the kicker carries an
     anchor. Underlined rather than left to inherit the eyebrow's flat colour:
     this is the actual point of the sentence, and a caption that happens to
     be clickable should not look identical to one that is not. */
  .dlist__kicker a {
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .dlist__kicker a:hover {
    color: var(--color-ink);
  }

  /* Neutral, matching .dlist__kicker above the card — kind identity already
     has its place (the tile on the hub card, the accent on a template's own
     rules); tinting the same word a second time here just made "Note" and
     "Deep study" read as two different colours doing two different jobs when
     they are both just a caption. */
  .dlist__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  /* The site's own quiet-link recipe (discover-hub__group-title and friends):
     inherits the caption's colour, no underline at rest, underline on hover —
     not the plain default-anchor blue-and-underline this replaced. */
  .dlist__eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .dlist__eyebrow a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Paper ────────────────────────────────────────────────────────────
     The app's own recipe, in the tokens that already exist here — grain,
     fold and shadow all have --pds-paper-* values, and unlike hex they
     follow the dark palette when night mode returns. */
  .dpaper {
    position: relative;
    padding: 10px 14px;
  }

  .dpaper__leaf {
    position: absolute;
    inset: 10px 14px;
    background-color: var(--pds-paper-desk);
    border: 0.5px solid var(--pds-paper-rule);
    box-shadow: 0 8px 24px -12px rgba(20, 18, 12, 0.1);
    pointer-events: none;
    transform: rotate(1.6deg);
    z-index: 0;
  }
  .dpaper__leaf--mid {
    transform: rotate(-1.9deg);
    z-index: 1;
  }

  .dpaper__sheet {
    position: relative;
    z-index: 2;
    padding: 2rem 1.75rem 1.75rem;
    background-color: var(--color-card);
    background-image:
      radial-gradient(var(--pds-paper-grain-a) 1px, transparent 1px),
      radial-gradient(var(--pds-paper-grain-b) 1px, transparent 1px);
    background-size: 28px 28px, 17px 17px;
    background-position: 0 0, 9px 9px;
    border: 0.5px solid var(--pds-paper-rule);
    box-shadow: var(--pds-paper-shadow);
  }
  /* A note is a document, so it sits as one was set down. */
  .dpaper__sheet--tilt {
    transform: rotate(-0.6deg);
  }

  .dpaper__sheet::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 40px;
    height: 40px;
    background: linear-gradient(
      225deg,
      var(--pds-paper-fold-a) 0%,
      var(--pds-paper-fold-b) 40%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 5;
  }

  .dpaper__title {
