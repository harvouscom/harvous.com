---
/**
 * A <picture> with a WebP source over the original, when the WebP sibling
 * exists under public/ — checked on disk at build time. A <source> that 404s
 * does not fall back to the <img>; the browser shows a broken image. So a
 * raster whose WebP hasn't been generated yet (scripts/compress-images.sh)
 * renders as a plain <img> instead. Unoptimized beats broken.
 */
import { existsSync } from "node:fs";
import path from "node:path";
import { isRasterPublicImage, webpSrc } from "../lib/image-assets.ts";

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  class: className,
} = Astro.props;

const webpCandidate = isRasterPublicImage(src) ? webpSrc(src) : null;
const webp =
  webpCandidate &&
  existsSync(path.join(process.cwd(), "public", webpCandidate.replace(/^\//, "")))
    ? webpCandidate
    : null;
---

{
  webp ? (
    <picture>
      <source srcset={webp} type="image/webp" />
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
        class={className}
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      class={className}
    />
  )
}
