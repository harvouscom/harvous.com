---
/**
 * AppTourChapter — one chapter of the homepage tour: a heading, the screenshot,
 * and the two or three features that screenshot actually demonstrates.
 *
 * The items sit *under* the shot rather than beside it. Dinky's app is a
 * portrait window and reads fine in half a column; Harvous is a wide, dense
 * document app, so the shot needs the full measure or the interface in it stops
 * being legible — which would defeat the point of showing it at all.
 */
import { Icon } from "astro-icon/components";
import TourShotFrame from "./TourShotFrame.astro";
import type { TourChapter } from "../lib/app-tour-chapters.ts";

interface Props {
  chapter: TourChapter;
  /** Zero-based position, rendered as the chapter number. */
  index: number;
  /** Per-item destinations, resolved by the parent against published pages. */
  hrefs: (string | undefined)[];
  loading?: "lazy" | "eager";
}

const { chapter, index, hrefs, loading = "lazy" } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const { eyebrow, title, lead, shot, items } = chapter;
---

<article class="chapter">
  <div class="chapter__head">
    <p class="chapter__label">
      <span class="chapter__num">{num}</span>
      <span>{eyebrow}</span>
    </p>
    <h3 class="chapter__title">{title}</h3>
    <p class="lead chapter__lead">{lead}</p>
  </div>

  <TourShotFrame
    src={shot.src}
    alt={shot.alt}
    width={shot.width}
    height={shot.height}
    direction={shot.direction}
    loading={loading}
  />

  <ul class="chapter__items" role="list">
    {
      items.map((item, i) => {
        const href = hrefs[i];
        const Tag = href ? "a" : "div";
        return (
          <li>
            <Tag class:list={["chapter__item", href && "chapter__item--link"]} href={href}>
              <div class="chapter__icons">
                {item.icons.map((icon) => (
                  <span class="chapter__icon"><Icon name={icon} /></span>
                ))}
              </div>
              <span class="chapter__item-title">{item.title}</span>
              <p class="chapter__item-desc">{item.desc}</p>
              {href && <span class="chapter__more">Learn more →</span>}
            </Tag>
          </li>
        );
      })
    }
  </ul>
</article>

<style>
  .chapter {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  /*
    Left-aligned and numbered, against a centered section head. The two used to
    share one treatment — pill, centered title, centered lead — which read as the
    same header twice and left no signal for where the section stopped and the
    first chapter started. The rule and the number also make five repeats scan as
    one sequence rather than five loose blocks.
  */
  .chapter__head {
    max-width: 44rem;
    text-align: left;
  }
  .chapter__head > * + * { margin-top: 0.6rem; }

  .chapter__label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .chapter__num {
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .chapter__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: "wdth" 100, "ROND" 0;
    font-size: clamp(1.45rem, 2.8vw, 1.9rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .chapter__lead {
    max-width: 38rem;
  }

  /* Items — centered flow so a chapter with one item doesn't sit in a lopsided
     two-column grid, and a chapter with two still reads as a pair. */
  /*
    A two-column grid rather than a wrapping flex row, so the items line up with
    the screenshot's edges instead of hanging at the left with dead space beside
    them. A chapter carrying one item keeps the first column and sits half-width,
    which reads as deliberate where a stretched full-width item would not.
  */
  .chapter__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem 2.5rem;
  }
  @media (min-width: 720px) {
    .chapter__items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .chapter__item {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .chapter__item--link { transition: transform 200ms ease; }
  .chapter__item--link:hover { transform: translateY(-2px); }
  .chapter__item--link:hover .chapter__item-title { color: var(--color-accent); }

  .chapter__icons { display: flex; align-items: center; gap: 0.35rem; }
  .chapter__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.7rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .chapter__icon :global(svg) { width: 1rem; height: 1rem; }

  .chapter__item-title {
    display: block;
    margin-top: 0.7rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-ink);
  }
  .chapter__item-desc {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }
  .chapter__more {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent);
  }
</style>
