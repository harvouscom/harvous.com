---
/**
 * AppTourChapter — one card in the tour bento.
 *
 * Modelled on Notion's feature-page cards: a tinted card carrying a quiet
 * eyebrow, a headline, an arrow to the detail page, and a product visual that
 * bleeds off the bottom edge.
 *
 * The bleed is the load-bearing part, not decoration. A Harvous screenshot is
 * dense document UI, so shrinking a whole window into a half-width card makes
 * the interface unreadable — which would defeat the point of showing it. A
 * cropped detail running off the card's edge stays near 1:1 instead, and the
 * card does the cropping.
 *
 * The two features each card demonstrates sit above the visual, where there is
 * room for them, rather than below it where the bleed leaves none.
 *
 * The whole card is one link, to its category page. A single empty anchor is
 * stretched across it; the features listed above the visual are captions, not
 * destinations, which is what lets the card have exactly one.
 *
 * The arrow is decorative (aria-hidden) rather than the link itself. It has to
 * be, because it paints its hover gradient in a pseudo-element and therefore
 * needs position:relative — which would make it a containing block, and an
 * overlay anchored to the arrow would shrink the card's hit area back to a 36px
 * circle while still looking correct.
 */
import { Icon } from "astro-icon/components";
import TourShotFrame from "./TourShotFrame.astro";
import type { TourChapter } from "../lib/app-tour-chapters.ts";
import type { FeatureCategory } from "../lib/feature-categories-data.ts";

interface Props {
  chapter: TourChapter;
  /** The category this card opens — supplies its destination, icon and colour. */
  category?: FeatureCategory;
  loading?: "lazy" | "eager";
}

const { chapter, category, loading = "lazy" } = Astro.props;
const { eyebrow, title, shot, items, size } = chapter;
const href = category?.href;
---

<article class:list={["tcard", `tcard--${size}`]} style={category ? `--cat-ink: ${category.ink};` : undefined}>
  {href && <a class="tcard__link" href={href} aria-label={`More about ${eyebrow}`} />}

  <div class="tcard__body">
    <div class="tcard__head">
      <div>
        <p class="tcard__eyebrow">
          {category && (
            <span class="tcard__eyebrow-icon"><Icon name={category.icon} /></span>
          )}
          {eyebrow}
        </p>
        <h3 class="tcard__title">{title}</h3>
      </div>
      {
        href && (
          <span class="tcard__arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </span>
        )
      }
    </div>

    <ul class="tcard__items" role="list">
      {
        items.map((item) => (
          <li>
            <div class="tcard__item">
              <span class="tcard__icons">
                {item.icons.map((icon) => (
                  <span class="tcard__icon"><Icon name={icon} /></span>
                ))}
              </span>
              <span class="tcard__item-title">{item.title}</span>
              <span class="tcard__item-desc">{item.desc}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="tcard__shot">
    <TourShotFrame
      src={shot.src}
      alt={shot.alt}
      width={shot.width}
      height={shot.height}
      direction={shot.direction}
      loading={loading}
      panel
    />
  </div>
</article>

<style>
  .tcard {
    /*
      The pill palette at full strength, the way ContentPill uses it. These are
      highlighter fills, so --pill-highlight measures 1.53:1 on white — chosen for
      the colour rather than for contrast.
    */
    --cat-ink: var(--color-accent);
    --cat-glyph: var(--cat-ink);
    --cat-text: var(--cat-ink);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    /* One quiet ground for all five. The colour lives in the pill and the icons,
       which is enough to tell the cards apart without tinting the whole surface. */
    background: color-mix(in oklab, var(--color-warm) 60%, var(--color-paper));
    border-radius: clamp(20px, 2.2vw, 28px);
    /* Clips the visual's bleed — without this the shot just overhangs. */
    overflow: hidden;
  }

  /* One stretched anchor = the card's hit area. */
  .tcard__link {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .tcard:has(.tcard__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .tcard__body {
    padding: clamp(1.5rem, 2.4vw, 2rem);
    padding-bottom: 0;
  }

  .tcard__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }
  /*
    Shaped like ContentPill, the brand's content-type chip: one rounded unit,
    icon at half the word's size, tinted with its own colour. The glyph and word
    take the darkened ink rather than the raw one — ContentPill's palette is
    hand-picked to read at 10% tint, these inks are not.
  */
  /* No chip — just the icon and the word, both in the category's colour. */
  .tcard__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--cat-text);
    font-variation-settings: "wdth" 100, "ROND" 0;
  }
  .tcard__eyebrow-icon { display: inline-flex; font-size: 1em; }
  .tcard__eyebrow-icon :global(svg) { width: 1em; height: 1em; display: block; }
  .tcard__title {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: "wdth" 100, "ROND" 0;
    font-size: clamp(1.25rem, 2.1vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
    /*
      Two lines' worth of room whether or not the words need it. Headings differ
      in length, so a one-line title used to start its features higher than the
      card beside it and the row stopped lining up. Reserving the height fixes
      that at every width, where breaking the copy by hand would only fix it at
      the one width it was checked in.
    */
    min-height: 2.3em; /* 2 × the 1.15 line-height above */
  }
  /*
    The wide card leads the bento, and at the same type size as a card half its
    width it read as the smaller of the two. min-height is in em, so the reserved
    two lines scale with it.
  */
  .tcard--wide .tcard__title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    /* The card is twice as wide as its siblings, so a heading of the same length
       fits on one line and leaves the reserved second line blank. Cap the measure
       so it wraps like the others instead of stretching the copy to fill. */
    max-width: 26ch;
  }

  .tcard__arrow {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    overflow: hidden;
    transition: box-shadow 240ms ease;
  }
  /*
    The site's primary-CTA gradient, blooming out from the middle. It lives in a
    pseudo-element because background-image cannot be transitioned — fading and
    scaling a layer over the ink is what makes it an animation rather than a
    swap.
  */
  .tcard__arrow::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--accent-btn-bg);
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 220ms ease, transform 340ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .tcard__arrow svg {
    position: relative;
    z-index: 1;
    width: 0.9rem;
    height: 0.9rem;
  }

  .tcard:hover .tcard__arrow::before,
  .tcard:has(.tcard__link:focus-visible) .tcard__arrow::before {
    opacity: 1;
    transform: scale(1);
  }
  .tcard:hover .tcard__arrow,
  .tcard:has(.tcard__link:focus-visible) .tcard__arrow {
    box-shadow: var(--accent-btn-shadow-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .tcard__arrow::before { transform: none; transition: opacity 120ms ease; }
    .tcard:hover .tcard__arrow::before { transform: none; }
  }

  /*
    One column: a half card holds exactly two items, and auto-fit was flipping
    them to two narrow columns once the card's own width crossed ~408px — wider
    than the card looks at 900px viewport width, narrower than it is at 1440px,
    so the standard-desktop case wrapped worse than the narrow one it was
    supposedly sized for. Fixed to the count each card actually holds, the way
    the wide card already pins itself to four instead of trusting auto-fit.
  */
  .tcard__items {
    list-style: none;
    margin: clamp(1.25rem, 2.2vw, 1.75rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem 1.5rem;
    grid-template-columns: 1fr;
  }
  /*
    The wide card is two columns from here up: the text and a 2x2 of its four
    features on the left, the shot square on the right. It was four features in
    a single row above a full-width letterbox, which gave each feature a column
    narrower than the half cards' and left the visual with no relationship to
    the text beside it.
  */
  @media (min-width: 720px) {
    .tcard--wide {
      --tcard-pad: clamp(1.5rem, 2.4vw, 2rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      column-gap: var(--tcard-pad);
    }
    /*
      The head spans the card and the features sit beside the shot, so the two
      have to be siblings in this grid rather than nested in one column. The
      body stops being a box and lets its children through — which means its
      padding goes too, and each child carries its own share below.
    */
    .tcard--wide .tcard__body { display: contents; }
    .tcard--wide .tcard__head {
      grid-column: 1 / -1;
      padding: var(--tcard-pad) var(--tcard-pad) 0;
    }
    /* The 2x2 is set at every width above; here it just takes the left column. */
    .tcard--wide .tcard__items {
      grid-column: 1;
      padding: 0 0 var(--tcard-pad) var(--tcard-pad);
    }
    /* No bleed on this one: a square that runs off the card is not a square. */
    .tcard--wide .tcard__shot {
      grid-column: 2;
      margin-top: 0;
      margin-bottom: 0;
      padding: 0 var(--tcard-pad) var(--tcard-pad) 0;
    }
  }
  /* The wide card's four features are a 2x2 at every width — including the
     mobile slider, where a single column made the card scroll for a long way
     past a shot the eye had already finished with. */
  .tcard--wide .tcard__items { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  /*
    Stacked, the shot goes back to the shape the other cards use. The 1:1 is
    there to sit beside the features in two columns; with everything in one
    column it only makes this card ~80px taller than its neighbours, and the
    slider stretches every slide to the tallest one, so the whole row pays for
    it. The image is object-fit: cover, so this crops rather than squashes.
  */
  @media (max-width: 719px) {
    .tcard--wide .tcard__shot :global(.tourshot) { aspect-ratio: 1600 / 1150; }
    /* The display-scale title is for the card at full width; in a 330px slide
       it costs four lines. Same scale as the half cards here. */
    .tcard--wide .tcard__title { font-size: clamp(1.25rem, 2.1vw, 1.6rem); }
  }

  .tcard__item { display: block; }

  .tcard__icons { display: flex; align-items: center; gap: 0.3rem; }
  .tcard__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 0.55rem;
    background: color-mix(in oklab, var(--cat-ink) 16%, var(--color-paper));
    color: var(--cat-glyph);
  }
  .tcard__icon :global(svg) { width: 0.85rem; height: 0.85rem; }

  .tcard__item-title {
    display: block;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .tcard__item-desc {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  /*
    The visual runs to the card's side edges and past its bottom. margin-top:auto
    pins it to the bottom whatever the text above it costs, so cards sitting side
    by side in a row line their visuals up.
  */
  /*
    The bleed: the frame renders at its own aspect ratio and the wrapper is pulled
    up by a negative bottom margin, so its last stretch sits outside the card's
    box and is cut by the card's overflow. Expressed as an offset rather than a
    fixed window height so the amount cut stays the same across card widths.
  */
  .tcard__shot {
    margin-top: auto;
    padding: clamp(1.5rem, 2.4vw, 2rem) clamp(1.5rem, 2.4vw, 2rem) 0;
    margin-bottom: calc(-1 * clamp(48px, 7vw, 96px));
  }
</style>
