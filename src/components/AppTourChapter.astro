---
/**
 * AppTourChapter — one card in the tour bento.
 *
 * Modelled on Notion's feature-page cards: a tinted card carrying a quiet
 * eyebrow, a headline, an arrow to the detail page, and a product visual that
 * bleeds off the bottom edge.
 *
 * The bleed is the load-bearing part, not decoration. A Harvous screenshot is
 * dense document UI, so shrinking a whole window into a half-width card makes
 * the interface unreadable — which would defeat the point of showing it. A
 * cropped detail running off the card's edge stays near 1:1 instead, and the
 * card does the cropping.
 *
 * The two features each card demonstrates sit above the visual, where there is
 * room for them, rather than below it where the bleed leaves none.
 */
import { Icon } from "astro-icon/components";
import TourShotFrame from "./TourShotFrame.astro";
import type { TourChapter } from "../lib/app-tour-chapters.ts";

interface Props {
  chapter: TourChapter;
  /** Per-item destinations, resolved by the parent against published pages. */
  hrefs: (string | undefined)[];
  loading?: "lazy" | "eager";
}

const { chapter, hrefs, loading = "lazy" } = Astro.props;
const { eyebrow, title, shot, items, size } = chapter;

// The arrow points at the card's first real destination; a card whose features
// have no published page yet simply doesn't get one, rather than a dead control.
const primaryHref = hrefs.find(Boolean);
---

<article class:list={["tcard", `tcard--${size}`]}>
  <div class="tcard__body">
    <div class="tcard__head">
      <div>
        <p class="tcard__eyebrow">{eyebrow}</p>
        <h3 class="tcard__title">{title}</h3>
      </div>
      {
        primaryHref && (
          <a class="tcard__arrow" href={primaryHref} aria-label={`More about ${eyebrow}`}>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </a>
        )
      }
    </div>

    <ul class="tcard__items" role="list">
      {
        items.map((item, i) => {
          const href = hrefs[i];
          const Tag = href ? "a" : "div";
          return (
            <li>
              <Tag class:list={["tcard__item", href && "tcard__item--link"]} href={href}>
                <span class="tcard__icons">
                  {item.icons.map((icon) => (
                    <span class="tcard__icon"><Icon name={icon} /></span>
                  ))}
                </span>
                <span class="tcard__item-title">{item.title}</span>
                <span class="tcard__item-desc">{item.desc}</span>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="tcard__shot">
    <TourShotFrame
      src={shot.src}
      alt={shot.alt}
      width={shot.width}
      height={shot.height}
      direction={shot.direction}
      loading={loading}
      panel
    />
  </div>
</article>

<style>
  .tcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-warm);
    border-radius: clamp(20px, 2.2vw, 28px);
    /* Clips the visual's bleed — without this the shot just overhangs. */
    overflow: hidden;
  }

  .tcard__body {
    padding: clamp(1.5rem, 2.4vw, 2rem);
    padding-bottom: 0;
  }

  .tcard__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .tcard__eyebrow {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }
  .tcard__title {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: "wdth" 100, "ROND" 0;
    font-size: clamp(1.25rem, 2.1vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .tcard__arrow {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }
  .tcard__arrow svg { width: 0.9rem; height: 0.9rem; }
  .tcard__arrow:hover { transform: translateX(2px); opacity: 0.88; }

  .tcard__items {
    list-style: none;
    margin: clamp(1.25rem, 2.2vw, 1.75rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  .tcard__item {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .tcard__item--link:hover .tcard__item-title { color: var(--color-accent); }

  .tcard__icons { display: flex; align-items: center; gap: 0.3rem; }
  .tcard__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 0.55rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .tcard__icon :global(svg) { width: 0.85rem; height: 0.85rem; }

  .tcard__item-title {
    display: block;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .tcard__item-desc {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  /*
    The visual runs to the card's side edges and past its bottom. margin-top:auto
    pins it to the bottom whatever the text above it costs, so cards sitting side
    by side in a row line their visuals up.
  */
  /*
    The bleed: the frame renders at its own aspect ratio and the wrapper is pulled
    up by a negative bottom margin, so its last stretch sits outside the card's
    box and is cut by the card's overflow. Expressed as an offset rather than a
    fixed window height so the amount cut stays the same across card widths.
  */
  .tcard__shot {
    margin-top: auto;
    padding: clamp(1.5rem, 2.4vw, 2rem) clamp(1.5rem, 2.4vw, 2rem) 0;
    margin-bottom: calc(-1 * clamp(48px, 7vw, 96px));
  }
</style>
