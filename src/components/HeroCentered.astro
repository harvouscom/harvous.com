---
/**
 * HeroCentered — Mintlify-style hero: centered headline (the "note" word is
 * the fixed-shape cycling pill), a primary + secondary CTA pair, then the
 * product shot with a soft float shadow (the screenshot includes its own
 * window chrome — no outer hairline needed). The page's vertical frame lines
 */
import Container from "./layout/Container.astro";
import HeroPillCycle from "./HeroPillCycle.astro";
import HeroVideoLightbox from "./HeroVideoLightbox.astro";
import OptimizedImage from "./OptimizedImage.astro";
import Harvous3Numeral from "./Harvous3Numeral.astro";
import { fathomCta, fathomTry } from "../lib/fathom-events.ts";
import { buildTryUrl } from "../lib/signup-url.ts";
import { isDraftPageSlug } from "../lib/draft-pages.ts";
---

<section class="hero">
  <Container size="xl">
    <div class="hero__inner">
      {
        /* Points at /3/ — hidden while that page is still a draft (same guard
           AppTour's own link uses), since it's stripped from the build until then. */
        !isDraftPageSlug("3") && (
          <a class="hero__announce" href="/3/" data-reveal data-fathom-track={fathomCta.v3Announce}>
            <span class="hero__announce-grid" aria-hidden="true" />
            <span class="hero__announce-copy">
              Harvous{" "}
              <span class="hero__announce-numeral">
                {/* The exact numeral from /3/'s hero, standing in for the digit
                    itself — same glyph, same trace-in and drift, not a second
                    "3" beside a plain one. Decorative; the sr-only text carries
                    the character for anyone not seeing it drawn. */}
                {/* 0.7em of a 16px line is the same 11.2px the glyph occupied at
                    0.8em of a 14px one — the type came up to meet it, the "3"
                    did not shrink. */}
                <Harvous3Numeral size="0.7em" />
                <span class="sr-only">3</span>
              </span>{" "}
              is here. See what's new
            </span>
            <svg class="hero__announce-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
          </a>
        )
      }
      <h1 class="hero__title" data-reveal>
        <span class="hero__line">Make a study Bible</span>
        <span class="hero__line hero__line--with-pill">
          <span class="hero__one">one</span>
          <HeroPillCycle />
        </span><span class="hero__line hero__line--tail">at a time</span>
      </h1>

      <div class="hero__actions" data-reveal style="--reveal-delay: 60ms;">
        {/*
          The first click no longer asks for an account. It opens the app on today's passage,
          and the offer to keep what you make comes later, from inside — someone deciding
          whether Harvous is for them should be reading Scripture in it, not filling in a form
          about it. Signing up keeps its permanent home in the header.

          Same tab, unlike the signup link it replaces: a transition that continues into the app
          cannot happen in a different one.
        */}
        <a
          class="hero__cta"
          href={buildTryUrl({ source: "hero" })}
          data-try-cta
          data-fathom-track={fathomTry.hero}
        >
          Try it free
        </a>
        <a class="hero__cta-secondary" href="#features" data-fathom-track={fathomCta.featuresAnchor}>
          More about Harvous
        </a>
      </div>

      <div class="hero__shotwrap" data-reveal="scale" style="--reveal-delay: 200ms;">
        <div class="hero__shot-frame">
          <OptimizedImage
            class="hero__shot"
            src="/app-full.png"
            alt="The Harvous app: My Home on the left and an open note on the right — scripture shown as tap-able pills, a highlighted phrase, and today's passage."
            width={2624}
            height={1360}
            loading="eager"
            fetchpriority="high"
          />
          <HeroVideoLightbox src="/touring-harvous-short.mp4" label="Watch the 5 min tour" />
        </div>
      </div>

      {/*
        TEMPORARY — delete this whole block once the 3.0 shot and walkthrough
        replace /app-full.png and /touring-harvous-short.mp4. Both still show
        2.x (the sidebar, "My Home"), which is exactly what the page above them
        now announces is gone, so the note says so before a visitor has to work
        it out. It points at /3/ rather than just apologising, since that page
        does show the new views.
      */}
      <p class="hero__shotnote" data-reveal style="--reveal-delay: 240ms;">
        Heads up — this screenshot and tour still show Harvous 2. The 3.0 walkthrough is
        on its way; <a href="/3/">see what's new in Harvous 3</a> in the meantime.
      </p>

      <p class="hero__platforms" data-reveal style="--reveal-delay: 280ms;">
        Available on Web. Mac, iPad, and iPhone apps coming later.
      </p>
    </div>
  </Container>
</section>

<style>
  .hero {
    background-color: var(--color-paper);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* A small entry point into /3/, styled after that page's own hero: the
     numeral in the app's rounded cut, and the same square-ruled ground
     /release-notes/ and /3/'s hero sit on — scaled down and self-contained
     instead of bleeding to the frame rails. */
  .hero__announce {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
    /* Symmetric. The old 8px left was for the circular numeral badge that used
       to lead the row and carried its own visual inset; the row starts on a
       hard-edged "H" now, which needs the same room as the arrow gets. */
    padding: 0.5rem 1rem;
    border-radius: 1rem;
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    text-decoration: none;
    transition: transform 150ms ease, border-color 150ms ease;
  }
  .hero__announce:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-rule));
  }
  .hero__announce:hover .hero__announce-arrow {
    transform: translateX(2px);
  }
  .hero__announce-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    container-type: inline-size;
    mask-image: radial-gradient(90% 140% at 12% 50%, #000 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(90% 140% at 12% 50%, #000 30%, transparent 100%);
  }
  .hero__announce-grid::before {
    content: "";
    position: absolute;
    inset: 0;
    /* Same ratio /3/'s own grid uses (--color-rule at 38%) — gray ruling, not
       an accent tint. */
    --announce-grid-size: calc(100cqw / round(nearest, 100cqw / 14px, 1));
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--color-rule) 38%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-rule) 38%, transparent) 1px, transparent 1px);
    background-size: var(--announce-grid-size) var(--announce-grid-size);
  }
  .hero__announce-numeral {
    display: inline-block;
    vertical-align: middle;
    margin-top: -0.1em;
  }
  .hero__announce-copy {
    position: relative;
    z-index: 1;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .hero__announce-arrow {
    position: relative;
    z-index: 1;
    width: 0.7rem;
    height: 0.7rem;
    flex-shrink: 0;
    color: var(--color-ink-faint);
    transition: transform 150ms ease;
  }
  /* The hero's own breakpoint: below it the title drops to its stacked
     three-line setting, and the callout comes down with it so it stays a
     footnote above the headline instead of a bar nearly as wide as the screen.
     Only the type is set here — the numeral is em-sized, so it follows. */
  @media (max-width: 639px) {
    .hero__announce {
      gap: 0.5rem;
      padding: 0.4rem 0.8rem;
    }
    .hero__announce-copy {
      font-size: 0.875rem;
    }
  }

  @media (max-width: 479px) {
    .hero__announce-copy {
      white-space: normal;
    }
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: "wdth" 100, "ROND" 0;
    letter-spacing: -0.02em;
    font-size: clamp(2.5rem, 6.5vw, 4rem);
    line-height: 1.05;
    color: var(--color-ink);
    text-align: center;
  }
  .hero__line { display: block; }
  .hero__line--with-pill {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    column-gap: 0.2em;
    vertical-align: baseline;
  }
  .hero__one {
    display: inline-block;
  }
  @media (min-width: 640px) {
    /* Desktop: lines 2 + 3 read as one inline row — "one [pill] at a time". */
    .hero__line--with-pill,
    .hero__line--tail {
      display: inline;
    }
    .hero__line--with-pill {
      display: inline-flex;
    }
    .hero__line--tail {
      margin-inline-start: 0.2em;
    }
  }
  @media (max-width: 639px) {
    /* svw scales with the small viewport so "Make a study Bible" stays one line
       and the three-line mobile stack never grows to four (320–639px). */
    .hero__title {
      font-size: clamp(1.875rem, 9.25svw, 2.5rem);
      line-height: 1;
    }
    .hero__line--with-pill,
    .hero__line--tail {
      display: block;
    }
    .hero__line--with-pill {
      display: flex;
    }
    /* Pill padding inflates line 2's box; pull line 3 up for even gaps. */
    .hero__line--tail {
      display: block;
      margin-inline-start: 0;
      margin-top: -0.12em;
    }
  }

  .hero__actions {
    margin-top: clamp(1.5rem, 3.5vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 27px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1rem;
    color: #fff;
    text-decoration: none;
    background: var(--accent-btn-bg);
    box-shadow: var(--accent-btn-shadow);
    transition: filter 120ms ease;
  }
  .hero__cta:hover { filter: brightness(1.05); }

  .hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .hero__cta-secondary:hover {
    background: var(--color-warm);
    border-color: color-mix(in srgb, var(--color-ink) 16%, var(--color-rule));
  }

  /* Product shot — screenshot includes its own window chrome; shadow only. */
  .hero__shotwrap {
    margin-top: clamp(2.75rem, 6vw, 4.5rem);
    width: 100%;
    max-width: 72rem; /* matches container--xl */
  }
  .hero__shot-frame {
    position: relative;
    border-radius: clamp(20px, 2.6vw, 32px);
    overflow: hidden;
    box-shadow: var(--shadow-float);
  }
  .hero__shot,
  .hero__shot-frame :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 639px) {
    /* Narrow width, but keep the landscape frame height from the sm breakpoint — portrait crop. */
    .hero__shot-frame {
      aspect-ratio: unset;
      width: 100%;
      height: calc((640px - 2 * var(--frame-content-pad)) * 1360 / 2624);
    }
    .hero__shot-frame :global(picture) {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
    .hero__shot,
    .hero__shot-frame :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top left;
    }
  }
  /* Darken bottom-left so the "Watch the tour" callout reads clearly. */
  .hero__shot-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(
        ellipse 90% 75% at 6% 96%,
        color-mix(in srgb, #0d0e12 52%, transparent) 0%,
        color-mix(in srgb, #0d0e12 22%, transparent) 38%,
        transparent 62%
      ),
      linear-gradient(
        28deg,
        color-mix(in srgb, #0d0e12 28%, transparent) 0%,
        transparent 45%
      );
  }

  /*
    TEMPORARY, with the block in the markup — remove both together. Quieter
    than the platforms line below it and set on the warm ground so it reads as
    a note about the image rather than a claim the page is making.
  */
  .hero__shotnote {
    margin-top: 0.9rem;
    max-width: 34rem;
    padding: 0.45rem 0.9rem;
    border-radius: 0.75rem;
    background: var(--color-warm);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }
  .hero__shotnote a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }
  .hero__shotnote a:hover { text-decoration-color: currentColor; }

  /* Platform availability — quiet footnote under the hero shot. */
  .hero__platforms {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    max-width: 34rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    text-wrap: balance;
  }
</style>
