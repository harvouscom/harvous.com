     real one: the head labels the card, the title carries it. */
  .dcard__from-name {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variation-settings: "wdth" 100, "ROND" 0;
    white-space: nowrap;
    text-overflow: ellipsis;
