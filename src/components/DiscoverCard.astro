---
/**
 * One listing, in the catalog grid.
 *
 * The house card — `ProductCard`'s shell: full rule, 24px corner,
 * `--shadow-card`, and a preview panel on `--color-warm` that bleeds under a
 * top rule. The panel shows the kind's own artifact in miniature, the way its
 * listing page draws it: a template and a note are both a sheet of paper on the
 * desk (a template *is* a note template, so it shares the note's dialect rather
 * than inventing a form of its own); a Thread is its spine; a link is where it
 * goes.
 *
 * The head is one pill — the kind's glyph and the kind's name. Earlier cuts
 * tried a separate tile beside a coloured word and the two said different
 * things in different hues; on a card with a plate, the picture carries the
 * colour and the pill is just a label. On a `mini` card there is no room for a
 * plate, so the tile comes back as the whole left column and the pill drops its
 * glyph — the colour and the icon are said once, in one place, either way.
 *
 * Carries `data-kind`, `data-topic` and `data-search` on the root so the hub
 * can filter it without a re-render.
 */
import { Icon } from "astro-icon/components";
import { sanitizeListingHtml } from "../lib/sanitize-listing-html.ts";
import {
  DISCOVER_KIND_NOUN,
  DISCOVER_RESOURCE_TYPE_NOUN,
  discoverArtPosition,
  discoverDocumentArt,
  discoverListingHref,
  discoverListingIcon,
  discoverListingInk,
  discoverSourceSlug,
  discoverTopicArt,
  type DiscoverListing,
} from "../lib/discover-data.ts";

interface Props {
  listing: DiscoverListing;
  /**
   * `compact` drops the preview panel — the "more like this" foot of a listing
   * page, where the panel is browsing furniture nobody came for. `mini` is that
   * again by a step, for the two-up strip on a use-case page: same card, sized
   * to sit under a paragraph rather than to be browsed.
   */
  variant?: "full" | "compact" | "mini";
}

const { listing, variant = "full" } = Astro.props;

const kindNoun = DISCOVER_KIND_NOUN[listing.kind] ?? "Item";
const preview = listing.preview ?? {};
const icon = discoverListingIcon(listing);

/* The topic's colour arrives as artwork rather than as a tint on the chip —
   the same wash its use-case page wears. A pale pill said the same thing in a
   quieter voice and fought the kind glyph for the reader's attention. */
const art = discoverTopicArt(listing.category);
const artPosition = discoverArtPosition(listing.slug);

/* The tile's colour on a mini card — the author's for a template, the topic's
   otherwise. Unused by the other variants, which wear the topic as artwork. */
const ink = discoverListingInk(listing);

/* A resource without a picture of its own — a PDF, or a link whose site
   publishes no OG image — gets one of ours rather than an empty grey box. */
const fileType = (preview.fileType ?? "").trim().toUpperCase();
const documentArt = discoverDocumentArt(listing.slug);

const titles = (preview.titles ?? []).slice(0, 3);
const titlesMore = (preview.noteCount ?? 0) - titles.length;
/* The artifact itself. Sanitized **here** — the API stores it as authored,
   because sanitizing it there meant DOMPurify, which meant jsdom, which could
   not be bundled into the API image and took production down at startup. This
   is the only pass, and this is the only place the bytes become HTML.

   `excerpt` is the same text with every block boundary flattened out, which
   made a template's headings run into their instructions and read as one grey
   paragraph. It stays as the fallback for rows written before bodies were
   carried, and needs no sanitizing — it is text, interpolated, not `set:html`. */
const bodyHtml = sanitizeListingHtml(preview.bodyHtml ?? "");
const excerpt = preview.excerpt ?? "";
const hasBody = Boolean(bodyHtml || excerpt);

/* Whether there is anything to draw down there. An empty warm panel reads as a
   failed image, so a card with no preview simply has no panel.

   `compact` gets one too, laid out as a thumbnail on the left instead of a
   band on top — the "more like this" foot of a listing page read as a wall of
   text next to it, and the same artifact the hub already drew (a template's
   own headings, a video's own poster) is what makes a related card look like
   the thing it links to rather than an entry in a list. `mini` still gets a
   flat tile instead: a 100px-wide document preview is a grey smudge, and the
   thing worth saying at that size is only what kind of thing this is. */
/* A curated reference is somebody's work, and what it is called matters less
   than whose it is and what kind of thing it is — so the publisher and the
   resource type are what the card leads with. */
const source = listing.source ?? null;
const resourceType = listing.resourceType ?? null;
const isVideo = resourceType === "video" && Boolean(listing.video);
const typeLabel = resourceType ? DISCOVER_RESOURCE_TYPE_NOUN[resourceType] : kindNoun;
const durationLabel = listing.video?.durationLabel ?? null;

/* The ground behind the specimen.
   A reference takes it from its own picture (`plateTone`, extracted by
   `npm run discover:sources`); everything else wears its topic's wash. The two
   used to be one rule, and a guide graded green for its *blog* category sat on
   the amber wash of its *Discover* topic — two taxonomies disagreeing on one
   card. A tone falls back to the wash if the mirror has not run. */
const plateTone = listing.plateTone ?? null;
const plateStyle = plateTone
  ? `--plate-tone: ${plateTone};`
  : art
    ? `--art: url("${art}"); --art-pos: ${artPosition};`
    : undefined;

/* A pass-through entry has no page of ours, so the card is the outbound link. */
const href = discoverListingHref(listing);
const leavesSite = /^https?:/.test(href);

const hasPanel =
  variant !== "mini" &&
  (((listing.kind === "template" || listing.kind === "note") && hasBody) ||
  (listing.kind === "pack" && titles.length > 0) ||
  (listing.kind === "resource" && Boolean(source || preview.sourceDomain || preview.sourceImage)));

/* Search covers the publisher too, which is what lets "bibleproject" work
   without the hub's control bar growing a third row it has no room for. */
const searchText = [
  listing.title,
  listing.description,
  listing.authorDisplayName,
  kindNoun,
  source?.name,
  source?.domain,
  typeLabel,
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<li
  class:list={[
    "dcard",
    variant === "compact" && "dcard--compact",
    variant === "mini" && "dcard--mini",
  ]}
  data-kind={listing.kind}
  data-topic={listing.category ?? ""}
  data-source={source ? discoverSourceSlug(source) : ""}
  data-source-name={source?.name ?? ""}
  data-source-logo={source?.logo ?? ""}
  data-search={searchText}
  style={plateStyle}
>
  <a
    class="dcard__link"
    href={href}
    {...leavesSite ? { target: "_blank", rel: "noopener" } : {}}
  >
    {/* The icon block: the kind's glyph on the listing's own colour, filling
        the left column. It is the app's tile — `ProtoSpaceMenuIcon`'s pastel
        ground and saturated glyph — grown to the height of the card, which is
        what turns a short card into a horizontal object instead of a small
        square of text. */}
    {variant === "mini" && (
      <span class="dcard__tile" aria-hidden="true" style={`--tile-ink: ${ink};`}>
        <Icon name={icon} />
      </span>
    )}

    {
      hasPanel && (
        /* The plate leads. A catalog is looked at before it is read, and the
           artifact is the only thing on the card that is not a sentence. */
        <span class="dcard__plate" aria-hidden="true">
          {/* Two faded panels flanking the specimen. They carry no information
              — they are there so the artifact reads as one of a set, sitting on
              a shelf, rather than a lone screenshot pasted on a colour. */}
          <span class="dcard__flank" />
          <span class="dcard__specimen">
            {/* note and template — paper, with the editor's own shape on it. */}
            {(listing.kind === "note" || listing.kind === "template") &&
              (bodyHtml ? (
                <span class="dcard__sheet-body" set:html={bodyHtml} />
              ) : (
                <span class="dcard__sheet-text">{excerpt}</span>
              ))}

            {/* pack — the trail, numbered, because a Thread is an order
                somebody chose and three identical rings say "a list". */}
            {listing.kind === "pack" && (
              /* A stack of note cards, not a bulleted list. A Thread *is*
                 several documents in an order somebody chose, so the preview
                 shows documents: overlapping sheets, the first on top, each
                 numbered. Rows with orbs said "a list", which is the one thing
                 it is not, and a "3 notes, in order" header said in words what
                 the shape should be saying on its own. */
              <span class="dcard__steps">
                {titles.map((line, i) => (
                  <span class="dcard__step" style={`--i: ${i};`}>
                    <span class="dcard__step-n">{i + 1}</span>
                    <span class="dcard__step-title">{line}</span>
                  </span>
                ))}
                {titlesMore > 0 && (
                  <span class="dcard__step dcard__step--more" style={`--i: ${titles.length};`}>
                    <span class="dcard__step-n">+{titlesMore}</span>
                    <span class="dcard__step-title">more</span>
                  </span>
                )}
              </span>
            )}

            {/* resource — a card *about* somewhere else, so it is titled and
                then shows what it points at, rather than being the artifact
                itself. Domain over site name: a name derived from a host
                mangles subdomains ("en.wikipedia.org" → "En Wikipedia"). */}
            {listing.kind === "resource" && source && (
              /* A curated reference leads with a masthead: the publisher's mark,
                 their name, and what kind of thing this is. The block below puts
                 the listing's own title here instead — which the body then says
                 again three rem down, at reading size — and files the publisher
                 in a six-point caption along the bottom edge, which is where a
                 filename goes. Whose it is outranks what it is called. */
              <>
                <span class="dcard__src">
                  {source.logo ? (
                    <span class="dcard__src-mark">
                      <img src={source.logo} alt="" width="36" height="36" loading="lazy" decoding="async" />
                    </span>
                  ) : (
                    <span class="dcard__src-mark dcard__src-mark--letter">
                      {source.name.slice(0, 1)}
                    </span>
                  )}
                  <span class="dcard__src-text">
                    <span class="dcard__src-name">{source.name}</span>
                    <span class="dcard__src-type">{typeLabel}</span>
                  </span>
                </span>
                {preview.sourceImage ? (
                  <span
                    class="dcard__link-image"
                    style={`background-image: url("${preview.sourceImage}")`}
                  >
                    {isVideo && (
                      <>
                        <span class="dcard__play"><Icon name="fa7-solid:play" /></span>
                        {durationLabel && <span class="dcard__time">{durationLabel}</span>}
                      </>
                    )}
                  </span>
                ) : (
                  /* No picture of its own — a study tool, a curriculum index.
                     With a tone it wears its publisher's colour; without one it
                     falls back to `discoverDocumentArt`, which picks a plate by
                     hashing the slug and so put Working Preacher on an orange
                     wash it has nothing to do with. */
                  <span
                    class:list={["dcard__doc-art", plateTone && "dcard__doc-art--tone"]}
                    style={plateTone ? undefined : `background-image: url("${documentArt}")`}
                  >
                    <span class="dcard__doc-tile">
                      {/* `icon` already resolves video/tool/book through
                          `discoverListingIcon` — a hand-rolled `isVideo` ternary
                          here would draw a lexicon or a commentary under the
                          same page-of-text glyph as a source with nothing more
                          specific to say. */}
                      <Icon name={icon} />
                    </span>
                  </span>
                )}
              </>
            )}

            {listing.kind === "resource" && !source && (
              <>
                <span class="dcard__doc-head">
                  <span class="dcard__doc-title">{listing.title}</span>
                  <span class="dcard__doc-source">
                    {fileType || preview.sourceDomain}
                  </span>
                </span>
                {preview.sourceImage ? (
                  <span
                    class="dcard__link-image"
                    style={`background-image: url("${preview.sourceImage}")`}
                  />
                ) : (
                  /* No picture of its own. Our own wash with a document tile on
                     it — the shape a PDF wants, and better than a grey hole for
                     a link whose site never set an og:image. */
                  <span
                    class="dcard__doc-art"
                    style={`background-image: url("${documentArt}")`}
                  >
                    <span class="dcard__doc-tile">
                      <Icon name={fileType === "PDF" ? "fa7-solid:file-pdf" : "fa7-solid:file-lines"} />
                    </span>
                  </span>
                )}
              </>
            )}
          </span>
          <span class="dcard__flank" />
        </span>
      )
    }

    <span class="dcard__body">
      {/* Kind and author on one line. The byline was a third block under the
          description, which gave a two-line card three stacked meta rows —
          it is an attribution, not a section. */}
      <span class="dcard__head">
        {/* For a reference the publisher takes the pill's slot rather than
            sitting beside it: "Template · Derek" is two facts, and
            "BibleProject · Video" is one. This is also the only place a
            `compact` or `mini` card names a publisher at all — both drop the
            plate, and with it the masthead. The name alone does that job; the
            mark stays on the plate, where it is said once. */}
        {source ? (
          /* No mark here. The masthead on the plate above already carries it,
             and twice on one card made the head compete with the title instead
             of labelling it. The name alone is enough this far down. */
          <span class="dcard__from">
            <span class="dcard__from-name">{source.name}</span>
            <span class="dcard__from-type">{typeLabel}</span>
          </span>
        ) : (
        <span class="dcard__pill">
          <span class="dcard__pill-icon"><Icon name={icon} /></span>
          <span>{kindNoun}</span>
        </span>
        )}
        {/* Templates the app ships with are the product's, not a stranger's —
            crediting the account that submitted one names the wrong author.
            "Included" rather than a byline, because that is what it is: not
            somebody's gift, part of what you already have.

            `preview.sourceName` is a third case, neither of those: Harvous
            wrote the content, so it is not a stranger's submission, but the
            shape came from outside, so "Included" would claim more than is
            true. No link here — the card is already one, and the real credit
            with its link lives on the listing page. */}
        {source ? null : preview.official ? (
          <span class="dcard__by">Included</span>
        ) : listing.authorDisplayName ? (
          <span class="dcard__by">{listing.authorDisplayName}</span>
        ) : preview.sourceName ? (
          <span class="dcard__by">{preview.sourceName}</span>
        ) : null}
        {/* One save is not social proof — it is usually the author. The count
            earns its place once it says "other people took this". */}
        {listing.installCount > 1 ? (
          <span class="dcard__count">saved by {listing.installCount}</span>
        ) : null}
      </span>

      <span class="dcard__title">{listing.title}</span>
      {listing.description ? <span class="dcard__desc">{listing.description}</span> : null}
    </span>
  </a>
</li>

<style>
  .dcard {
    list-style: none;
  }

  .dcard__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: 24px;
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .dcard__link:hover {
    border-color: color-mix(in oklab, var(--color-ink) 22%, var(--color-rule));
    box-shadow: var(--shadow-float);
    transform: translateY(-2px);
  }

  /* ── The plate ───────────────────────────────────────────────────────
     The topic's wash at full strength with the artifact floating on it.
     One height for every card: the specimens are different shapes — a sheet
     of paper, a numbered trail, somebody's OG image — and letting each set
     its own made a row of cards read as a broken staircase. */
  .dcard__plate {
    position: relative;
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 0.5rem;
    flex-shrink: 0;
    height: 11.5rem;
    padding: 1rem 1rem 0.875rem;
    background-color: var(--color-warm);
    overflow: hidden;
  }

  /* Inset from the specimen's top and bottom so it reads as the raised one. */
  .dcard__flank {
    flex: 1 1 0;
    min-width: 0;
    margin: 0.625rem 0;
    border-radius: 10px;
    background: color-mix(in oklab, var(--color-paper) 26%, transparent);
  }
  /* Without artwork there is no wash to lighten, so the flanks would be white
     on white. */
  .dcard:not([style*="--art"]) .dcard__flank {
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
  }
  .dcard[style*="--art"] .dcard__plate {
    background-image: var(--art);
    background-size: cover;
    background-position: var(--art-pos, center);
  }

  /* ── The tone ground ──────────────────────────────────────────────────
     A reference's own colour, mixed well down towards paper and raked across
     the plate so it reads as a wash rather than a swatch. Two stops, because a
     flat fill under a picture with soft edges looks like a bug. */
  .dcard[style*="--plate-tone"] .dcard__plate {
    background-image: linear-gradient(
      142deg,
      color-mix(in oklab, var(--plate-tone) 34%, var(--color-paper)),
      color-mix(in oklab, var(--plate-tone) 14%, var(--color-paper))
    );
  }
  /* Flanks lift off the tone the same way they lift off artwork. */
  .dcard[style*="--plate-tone"] .dcard__flank {
    background: color-mix(in oklab, var(--color-paper) 34%, transparent);
  }

  /* The specimen for a link with no picture: the publisher's colour, a shade
     stronger than the plate behind it so the document still reads as sitting
     *on* something. */
  .dcard__doc-art--tone {
    background-image: linear-gradient(
      142deg,
      color-mix(in oklab, var(--plate-tone) 52%, var(--color-paper)),
      color-mix(in oklab, var(--plate-tone) 26%, var(--color-paper))
    );
  }

  /* The specimen sits *into* the bottom edge rather than centred in the plate,
     so the card reads as one object with the body below it instead of a
     picture stacked on a paragraph. */
  .dcard__specimen {
    display: block;
    flex: 0 0 58%;
    min-width: 0;
    padding: 0.75rem 0.875rem;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid color-mix(in oklab, var(--color-paper) 60%, transparent);
    background: var(--color-card);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.07),
      0 14px 30px -16px rgba(15, 23, 42, 0.35);
  }
  /* A resource is a card *about* somewhere else, not the artifact itself, so
     its specimen floats clear of the bottom edge and carries a title — the
     paper kinds slide into the edge because they are the document. */
  .dcard[data-kind="resource"] .dcard__specimen {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.625rem;
  }

  /* Stacked, not a row. Side by side, "DESIRINGGOD.ORG" took most of a 174px
     specimen and clipped the title to "Read the…" — the one line that has to
     survive. */
  .dcard__doc-head {
    display: grid;
    gap: 0.125rem;
    flex-shrink: 0;
  }
  .dcard__doc-title {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-variation-settings: "wdth" 100, "ROND" 0;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .dcard__doc-source {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  /* The document plate — our own wash, with a file tile on it. */
  .dcard__doc-art {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-height: 0;
    border-radius: 8px;
    background-position: center;
    background-size: cover;
  }
  .dcard__doc-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.625rem;
    background: var(--color-card);
    color: var(--color-ink-soft);
    box-shadow: var(--shadow-card);
  }
  .dcard__doc-tile :global(svg) {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .dcard__sheet-text,
  .dcard__sheet-body {
    display: block;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  /* The editor's own shape at specimen scale: headings sit up, paragraphs sit
     back. Enough to tell a filled-in note from a blank form at a glance. */
  .dcard__sheet-body :global(h1),
  .dcard__sheet-body :global(h2),
  .dcard__sheet-body :global(h3) {
    margin: 0.65em 0 0.1em;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .dcard__sheet-body :global(h1:first-child),
  .dcard__sheet-body :global(h2:first-child),
  .dcard__sheet-body :global(h3:first-child) {
    margin-top: 0;
  }
  .dcard__sheet-body :global(p) {
    margin: 0 0 0.45em;
  }
  .dcard__sheet-body :global(ul),
  .dcard__sheet-body :global(ol) {
    margin: 0 0 0.45em;
    padding-left: 1.1em;
  }
  .dcard__sheet-body :global(blockquote) {
    margin: 0 0 0.45em;
    padding-left: 0.6em;
    border-left: 2px solid var(--color-rule);
  }
  .dcard__sheet-body :global(img),
  .dcard__sheet-body :global(figure) {
    display: none;
  }

  /* ── The stack ──────────────────────────────────────────────────────
     Sheets, slightly overlapped, so depth says "there are several of these"
     before a word is read. A Thread specimen carries no padding of its own —
     the sheets run to the specimen's edges. */
  .dcard[data-kind="pack"] .dcard__specimen {
    padding: 0.625rem 0.625rem 0;
  }
  .dcard__steps {
    display: grid;
  }
  /* Depth from shade and shadow, not a border. A uniform 1px outline on every
     sheet read flat — the same edge repeated three times says "three
     rectangles", not "three sheets with one on top". The front sheet gets the
     shadow and the true white; each one behind loses a little of both, so the
     stack recedes the way a shadow actually falls across paper. */
  .dcard__step {
    display: grid;
    grid-template-columns: 1rem 1fr;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid color-mix(in oklab, var(--color-ink) 5%, transparent);
    border-radius: 8px;
    background: var(--color-card);
    box-shadow:
      0 3px 6px -2px rgba(15, 23, 42, 0.14),
      0 1px 2px rgba(15, 23, 42, 0.06);
    /* Later sheets sit behind, and inset, so the stack has a near edge. */
    margin-bottom: -0.25rem;
    margin-inline: calc(var(--i, 0) * 0.3rem) calc(var(--i, 0) * 0.3rem);
    position: relative;
    z-index: calc(10 - var(--i, 0));
  }
  .dcard__step:not(:first-child) {
    border-color: transparent;
    background: color-mix(in oklab, var(--color-warm) 42%, var(--color-card));
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.07);
  }
  .dcard__step:nth-child(n + 3) {
    background: color-mix(in oklab, var(--color-warm) 68%, var(--color-card));
    box-shadow: none;
  }
  .dcard__step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink) 8%, var(--color-paper));
    font-family: var(--font-display);
    font-size: 0.5rem;
    font-weight: 600;
    font-variation-settings: "wdth" 100, "ROND" 0;
    color: var(--color-ink-soft);
  }
  .dcard__step-title {
    font-size: 0.6875rem;
    line-height: 1.3;
    color: var(--color-ink);
