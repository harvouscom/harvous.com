---
/**
 * One listing, in a list. Used by the hub and the topic pages both.
 *
 * There were two of these before, inline and divergent — the hub grew outline
 * pills, the topic page never did — and neither said what kind of thing it was
 * showing beyond a word. A catalog whose rows all look alike is a catalog you
 * have to read rather than scan.
 *
 * Kind colour comes from the site's own content-type hues, the ones ContentPill
 * already uses everywhere else: a Note reads blue and a Thread reads green here
 * for the same reason they do on the homepage. One `--kind-ink` is bound on the
 * root and the stylesheet does the mixing, following `--use-case-ink`.
 */
import {
  DISCOVER_KIND_NOUN,
  discoverKindInk,
  type DiscoverListing,
} from "../lib/discover-data.ts";

interface Props {
  listing: DiscoverListing;
  /** `row` drops the preview body — used where the page is already a long list. */
  variant?: "grid" | "row";
}

const { listing, variant = "grid" } = Astro.props;

const kindNoun = DISCOVER_KIND_NOUN[listing.kind] ?? "Item";
const preview = listing.preview ?? {};

/* What each kind offers as its glance. A template shows its sections, because
   the sections are the thing; a Thread shows how many notes and what they are
   called; a link shows where it goes. */
const sections = (preview.headings ?? []).slice(0, 3);
const sectionsMore = (preview.headings ?? []).length - sections.length;
const titles = (preview.titles ?? []).slice(0, 3);
const titlesMore = (preview.noteCount ?? 0) - titles.length;
---

<li class="dcard" style={`--kind-ink: ${discoverKindInk(listing.kind)};`}>
  <a class="dcard__link" href={`/discover/${listing.slug}/`} data-kind={listing.kind}>
    <span class="dcard__head">
      <span class="dcard__kind">{kindNoun}</span>
      {listing.installCount > 0 ? (
        <span class="dcard__count">saved by {listing.installCount}</span>
      ) : null}
    </span>

    <span class="dcard__title">{listing.title}</span>
    {listing.description ? <span class="dcard__desc">{listing.description}</span> : null}

    {
      variant === "grid" && listing.kind === "template" && sections.length > 0 ? (
        <span class="dcard__sections">
          {sections.map((line) => (
            <span class="dcard__section">{line}</span>
          ))}
          {sectionsMore > 0 ? (
            <span class="dcard__section dcard__section--more">+{sectionsMore}</span>
          ) : null}
        </span>
      ) : null
    }

    {
      variant === "grid" && listing.kind === "pack" && titles.length > 0 ? (
        /* The spine, in miniature — the shape a Thread has in the app. */
        <span class="dcard__spine">
          {titles.map((line) => (
            <span class="dcard__spine-row">{line}</span>
          ))}
          {titlesMore > 0 ? (
            <span class="dcard__spine-row dcard__spine-row--more">
              and {titlesMore} more
            </span>
          ) : null}
        </span>
      ) : null
    }

    {
      variant === "grid" && listing.kind === "resource" && preview.sourceDomain ? (
        /* Where it goes, which is all a link is. Domain over site name — the app
           prefers it too, because site names derived from a host mangle
           subdomains ("en.wikipedia.org" → "En Wikipedia"). */
        <span class="dcard__domain">{preview.sourceDomain}</span>
      ) : null
    }

    {
      variant === "grid" && listing.kind === "note" && preview.excerpt ? (
        <span class="dcard__excerpt">{preview.excerpt}</span>
      ) : null
    }

    {listing.authorDisplayName ? (
      <span class="dcard__by">Shared by {listing.authorDisplayName}</span>
    ) : null}
  </a>
</li>

<style>
  .dcard__link {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--color-rule);
    border-left: 3px solid color-mix(in srgb, var(--kind-ink) 55%, var(--color-rule));
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .dcard__link:hover {
    border-color: color-mix(in oklab, var(--color-ink) 22%, var(--color-rule));
    border-left-color: var(--kind-ink);
    box-shadow: var(--shadow-float);
    transform: translateY(-1px);
  }

  .dcard__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  /* Mixed toward ink: the --pill-* values are highlighter fills, not text
     colours, and global.css says so. */
  .dcard__kind {
    font-weight: 600;
    color: color-mix(in oklab, var(--kind-ink) 55%, var(--color-ink));
  }

  .dcard__title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .dcard__desc {
    color: var(--color-ink-soft);
  }

  /* A template's sections, as pills — the shape you would be writing into. */
  .dcard__sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3125rem;
    margin-top: 0.5rem;
  }
  .dcard__section {
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--kind-ink) 12%, var(--color-paper));
    color: color-mix(in oklab, var(--kind-ink) 60%, var(--color-ink));
  }
  .dcard__section--more {
    background: transparent;
    color: var(--color-ink-faint);
  }

  /* A Thread's spine: a rule down the left, a row per note. */
  .dcard__spine {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.5rem;
    padding-left: 0.75rem;
    border-left: 2px solid color-mix(in oklab, var(--kind-ink) 35%, var(--color-rule));
  }
  .dcard__spine-row {
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
  }
  .dcard__spine-row--more {
    color: var(--color-ink-faint);
  }

  .dcard__domain {
    margin-top: 0.5rem;
    justify-self: start;
    font-size: 0.75rem;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--kind-ink) 12%, var(--color-paper));
    color: color-mix(in oklab, var(--kind-ink) 60%, var(--color-ink));
  }

  .dcard__excerpt {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dcard__by {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }
</style>
