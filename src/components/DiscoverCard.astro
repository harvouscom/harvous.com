      flex-direction: row;
      align-items: stretch;
    }

    .dcard--compact .dcard__plate {
      flex: 0 0 11.875rem;
      /* `aspect-ratio`, not a hard height: it derives a *definite* height from
         the width, which is what the base rule's `overflow: hidden` needs to
         clip against. Plain `height: auto` has no such height, which is how
         the first cut let a template's whole unclamped body set the row. */
      aspect-ratio: 19 / 12;
      height: auto;
      /* Not stretched — stretching would override the ratio the moment the
         text beside it runs taller. */
      align-self: center;
      /* 8px here and 7px on the specimen: the two mats together are what turn
         190 × 120 into a 160 × 90 picture. Changing either changes the poster's
         shape, so they are a pair, not two independent paddings. */
      padding: 0.5rem;
      gap: 0;
    }

    .dcard--compact .dcard__flank {
      display: none;
    }
    .dcard--compact .dcard__src {
      display: none;
    }

    /* Specificity note: `.dcard[data-kind="resource"] .dcard__specimen` sets
       its own padding, and a plain `.dcard--compact .dcard__specimen` loses to
       it on source order alone — the compound selector on the root element is
       what wins the tie-break. */
    li.dcard.dcard--compact .dcard__specimen {
      /* `flex: 0 0 58%` on the base rule leaves the other 42% to the two
         flanks. They are hidden here, so without this the specimen kept its
         58% and the rest of the plate was empty wash — putting the artifact
         back at 0.80:1 portrait inside a 1.33:1 landscape plate, the exact
         squeeze this was meant to fix. */
      flex: 1 1 auto;
      /* Paired with the plate's 8px above — see the note there. */
      padding: 0.4375rem;
      border-radius: 8px;
    }
  }

  /* Mini: the same card one step down again and turned on its side, for the
     two-up strip on a use-case page. The rule, the ground and the shadow are
     still the house card's — the point of the strip is that these are the same
     objects as the ones in the catalog — but the plate is swapped for a tile,
