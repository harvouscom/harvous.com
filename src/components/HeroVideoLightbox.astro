---
import "plyr/dist/plyr.css";
import { fathomCta } from "../lib/fathom-events.ts";

/*
  Two sources, one lightbox. `src` is a self-hosted mp4; `youtubeId` is a
  YouTube video, which Plyr wraps in its own chrome so both look identical
  once open. Nothing YouTube-owned loads until the trigger is clicked —
  Plyr builds the iframe when ensurePlayer() first runs — so the page costs
  no third-party request for a video most visitors never open.
*/
interface Props {
  src?: string;
  youtubeId?: string;
  label?: string;
}

const { src, youtubeId, label = "Watch the 5 min tour" } = Astro.props;

if (!src && !youtubeId) {
  throw new Error("HeroVideoLightbox needs either `src` or `youtubeId`.");
}
---

<div class="hero-video" data-hero-video-root>
  <button
    type="button"
    class="hero-video-callout"
    aria-label={`${label} — opens video in a lightbox`}
    data-hero-video-trigger
    data-fathom-track={fathomCta.videoTour}
  >
    <span class="hero-video-callout__play" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14">
        <path d="M4.5 2.8v10.4c0 .6.7 1 1.2.7l8.2-5.2c.5-.3.5-1 0-1.3L5.7 2.1c-.5-.3-1.2.1-1.2.7z"></path>
      </svg>
    </span>
    <span class="hero-video-callout__label">{label}</span>
  </button>

  <div
    class="hero-video-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label={label}
    hidden
    data-hero-video-lightbox
  >
    <div class="hero-video-lightbox__backdrop" data-hero-video-close aria-hidden="true"></div>
    <div class="hero-video-lightbox__panel">
      <button type="button" class="hero-video-lightbox__close" data-hero-video-close aria-label="Close video">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round"></path>
        </svg>
      </button>
      {
        youtubeId ? (
          <div
            class="hero-video-lightbox__video"
            data-hero-video-player
            data-plyr-provider="youtube"
            data-plyr-embed-id={youtubeId}
          />
        ) : (
          <video
            class="hero-video-lightbox__video"
            playsinline
            preload="metadata"
            data-hero-video-player
          >
            <source src={src} type="video/mp4" />
          </video>
        )
      }
    </div>
  </div>
</div>

<style>
  .hero-video {
    --hero-video-chrome: #0d0e12;

    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero-video-callout {
    position: absolute;
    bottom: clamp(1rem, 3vw, 1.75rem);
    left: clamp(1rem, 3vw, 1.75rem);
    z-index: 2;
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.875rem 0.375rem 0.375rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, #fff 35%, transparent);
    background: color-mix(in srgb, var(--hero-video-chrome) 58%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .hero-video-callout:hover {
    background: color-mix(in srgb, var(--hero-video-chrome) 68%, transparent);
    border-color: color-mix(in srgb, #fff 45%, transparent);
  }
  .hero-video-callout:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .hero-video-callout__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(171deg, #2bb5ff 7%, #006eff 93%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25) inset;
  }
  .hero-video-callout__play svg {
    margin-left: 0.1em;
  }

  .hero-video-lightbox {
    --hero-video-chrome: #0d0e12;

    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: clamp(1rem, 4vw, 2rem);
  }
  .hero-video-lightbox[hidden] {
    display: none;
  }

  .hero-video-lightbox__backdrop {
    position: absolute;
    inset: 0;
    border: none;
    padding: 0;
    margin: 0;
    background: color-mix(in srgb, var(--color-ink) 62%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: pointer;
  }

  .hero-video-lightbox__panel {
    position: relative;
    z-index: 1;
    width: min(960px, 100%);
    max-height: min(85dvh, 720px);
    border-radius: clamp(12px, 2vw, var(--radius-card));
    overflow: hidden;
    border: 1px solid var(--color-rule);
    background: var(--hero-video-chrome);
    box-shadow: var(--shadow-float);
  }

  .hero-video-lightbox__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, #fff 22%, transparent);
    border-radius: 50%;
    padding: 0;
    color: #fff;
    background: color-mix(in srgb, var(--hero-video-chrome) 55%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .hero-video-lightbox__close:hover {
    background: color-mix(in srgb, var(--hero-video-chrome) 75%, transparent);
  }
  .hero-video-lightbox__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .hero-video-lightbox__close svg {
    width: 1rem;
    height: 1rem;
  }

  .hero-video-lightbox__video {
    display: block;
    width: 100%;
    max-width: 100%;
    vertical-align: middle;
    background: #000;
  }

  .hero-video-lightbox__panel :global(.plyr) {
    --plyr-color-main: #006eff;
    --plyr-video-background: #000;
    width: 100%;
    max-height: min(85dvh, 720px);
  }

  .hero-video-lightbox__panel :global(.plyr__video-wrapper),
  .hero-video-lightbox__panel :global(.plyr video) {
    max-height: min(85dvh, 720px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-callout,
    .hero-video-lightbox__close {
      transition: none;
    }
  }
</style>

<script>
  import Plyr from "plyr";

  type PlyrInstance = InstanceType<typeof Plyr>;

  function initHeroVideoLightbox(root: HTMLElement) {
    const trigger = root.querySelector<HTMLButtonElement>("[data-hero-video-trigger]");
    const lightbox = root.querySelector<HTMLElement>("[data-hero-video-lightbox]");
    if (!trigger || !lightbox) return;

    // A <video> for a self-hosted file, a <div> for a YouTube embed — Plyr takes either.
    const video = lightbox.querySelector<HTMLElement>("[data-hero-video-player]");
    const closeEls = lightbox.querySelectorAll<HTMLElement>("[data-hero-video-close]");
    const closeBtn = lightbox.querySelector<HTMLButtonElement>(".hero-video-lightbox__close");

    if (!video || !closeBtn) return;

    // Escape .hero__shot-frame overflow/transform so fixed backdrop covers the viewport.
    if (lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }

    let previousFocus: HTMLElement | null = null;
    let player: PlyrInstance | null = null;

    const ensurePlayer = () => {
      if (player) return player;
      player = new Plyr(video, {
        controls: [
          "play-large",
          "play",
          "progress",
          "current-time",
          "duration",
          "mute",
          "volume",
          "settings",
          "fullscreen",
        ],
        settings: ["speed"],
        speed: { selected: 1, options: [0.75, 1, 1.25, 1.5, 2] },
        hideControls: true,
        keyboard: { focused: true, global: false },
        tooltips: { controls: true, seek: true },
        // youtube-nocookie, and none of YouTube's own chrome competing with Plyr's.
        youtube: { noCookie: true, rel: 0, modestbranding: 1, iv_load_policy: 3 },
      });
      return player;
    };

    const getFocusables = () =>
      Array.from(
        lightbox.querySelectorAll<HTMLElement>(
          'button:not([disabled]):not([hidden]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), video, [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => !el.hasAttribute("hidden") && el.offsetParent !== null);

    const trapFocus = (event: KeyboardEvent) => {
      if (event.key !== "Tab" || lightbox.hidden) return;
      const focusables = getFocusables();
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const open = () => {
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
      closeBtn.focus();
      const plyr = ensurePlayer();
      void plyr.play().catch(() => {});
    };

    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = "";
      player?.pause();
      previousFocus?.focus();
      previousFocus = null;
    };

    trigger.addEventListener("click", open);
    closeEls.forEach((el) => el.addEventListener("click", close));
    lightbox.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        close();
        return;
      }
      trapFocus(event);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-hero-video-root]").forEach(initHeroVideoLightbox);
</script>
