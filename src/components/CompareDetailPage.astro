---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageClosingCTA from "./PageClosingCTA.astro";
import CompareHeroArt from "./CompareHeroArt.astro";
import CompareCarousel from "./CompareCarousel.astro";
import { fathomCompare, fathomSignup } from "../lib/fathom-events.ts";
import type { CompareEntry } from "../lib/compare-data.ts";
import { getGuidesForCompareSlug } from "../lib/compare-seo-pages.ts";
import {
  composeCompareIntro,
  featureLabel,
  getCompareCtaHeading,
  getHarvousPosition,
} from "../lib/compare-harvous-positioning.ts";
import "../styles/compare.css";

interface Props {
  entry: CompareEntry;
  related: CompareEntry[];
  jsonLd: Record<string, unknown>;
}

const { entry, related, jsonLd } = Astro.props;
const relatedGuides = getGuidesForCompareSlug(entry.slug);
const position = getHarvousPosition(entry.competitorType);
const intro = composeCompareIntro(entry.intro, entry.competitorType);
const ctaHeading = getCompareCtaHeading(entry.name, entry.competitorType);
---

<BaseLayout title={entry.seoTitle} description={entry.seoDescription} ogImage={entry.ogImage} jsonLd={jsonLd}>
  <article class="compare-detail">
    <header class="border-b border-[var(--color-rule)]">
      <div class="mx-auto max-w-3xl px-5 py-10 md:py-14">
        <div data-reveal>
        <a href="/compare/" class="btn-pill inline-flex items-center gap-1.5 text-sm">
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M14 8a.75.75 0 0 1-.75.75H3.56l3.22 3.22a.75.75 0 1 1-1.06 1.06l-4.5-4.5a.75.75 0 0 1 0-1.06l4.5-4.5a.75.75 0 0 1 1.06 1.06L3.56 7.25H13.25A.75.75 0 0 1 14 8Z"
              clip-rule="evenodd"></path>
          </svg>
          Compare
        </a>

        <div class="mt-8">
          <CompareHeroArt competitorImage={entry.competitorImage} />
        </div>

        <div class="mt-8 text-center">
          <h1 class="font-display text-4xl leading-[1.05] md:text-5xl">Harvous vs {entry.name}</h1>
          <p class="compare-detail__lead mx-auto mt-5 text-lg leading-relaxed text-[var(--color-ink-soft)]">
            {intro}
          </p>
          {
            entry.competitorLink && (
              <div class="mt-6">
                <a
                  href={entry.competitorLink}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="btn-pill inline-flex items-center gap-1.5"
                >
                  Visit {entry.name}
                </a>
              </div>
            )
          }
        </div>
        </div>
      </div>
    </header>

    <section class="mx-auto max-w-3xl px-5 py-14 md:py-16" data-reveal style="--reveal-delay: 80ms;">
      <div class="prose-letter space-y-8">
        <div>
          <h2 class="text-xl font-semibold text-[var(--color-ink)]">Choose {entry.name} if…</h2>
          <p class="mt-3 text-[var(--color-ink-soft)]">{entry.idealFor}</p>
        </div>
        <div>
          <h2 class="text-xl font-semibold text-[var(--color-ink)]">Choose Harvous if…</h2>
          <p class="mt-3 text-[var(--color-ink-soft)]">{position.chooseIf}</p>
          {
            position.featureIds.length > 0 && (
              <ul class="compare-detail__feature-links" role="list">
                {position.featureIds.map((id) => (
                  <li>
                    <a href={`/features/${id}/`}>{featureLabel(id)}</a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div>
          <h2 class="text-xl font-semibold text-[var(--color-ink)]">Harvous isn’t for…</h2>
          <p class="mt-3 text-[var(--color-ink-soft)]">{position.tradeoff}</p>
        </div>
        <div>
          <h2 class="text-xl font-semibold text-[var(--color-ink)]">Works best alongside</h2>
          <p class="mt-3 text-[var(--color-ink-soft)]">{entry.worksBestAlongside}</p>
        </div>
      </div>
    </section>

    <section class="frame-divider" data-reveal style="--reveal-delay: 120ms;">
      <div class="mx-auto max-w-3xl px-5 py-14 md:py-16">
        <h2 class="font-display text-2xl leading-snug md:text-3xl">Side by side</h2>
        <p class="mt-3 text-[var(--color-ink-soft)]">
          A quick look at what each app is built for — not a feature checklist, but the job each one does best.
        </p>
        <div class="compare-detail__table-wrap mt-8">
          <table class="compare-detail__table">
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col">Harvous</th>
                <th scope="col">{entry.name}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Best at</th>
                <td>{position.bestAt}</td>
                <td>{entry.bestAt}</td>
              </tr>
              <tr>
                <th scope="row">Primary use</th>
                <td>{position.primaryUse}</td>
                <td>{entry.primaryUse}</td>
              </tr>
              {
                position.tableRows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>{row.harvous}</td>
                    <td>{row.competitorHint}</td>
                  </tr>
                ))
              }
              <tr>
                <th scope="row">Ideal for</th>
                <td>{position.idealFor}</td>
                <td>{entry.idealFor}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {
      relatedGuides.length > 0 && (
        <section class="frame-divider" data-reveal style="--reveal-delay: 140ms;" aria-labelledby="compare-detail-guides-title">
          <div class="mx-auto max-w-3xl px-5 py-14 md:py-16">
            <h2 class="font-display text-2xl leading-snug md:text-3xl" id="compare-detail-guides-title">
              Related guides
            </h2>
            <p class="mt-3 text-[var(--color-ink-soft)]">
              Broader shortlists that include {entry.name} — or dig into alternatives in the same lane.
            </p>
            <ul class="compare-detail__guides" role="list">
              {relatedGuides.map((guide) => (
                <li>
                  <a class="compare-detail__guide-card" href={`/compare/${guide.slug}/`} data-fathom-track={fathomCompare.detailRelated}>
                    <span class="compare-detail__guide-title">{guide.label}</span>
                    <span class="compare-detail__guide-desc">{guide.description}</span>
                    <span class="compare-detail__guide-link">Read guide →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section
          class="compare-detail__related compare-slider-band frame-divider"
          aria-labelledby="compare-detail-related-title"
        >
          <CompareCarousel
            entries={related}
            groupTitle={`More in ${entry.competitorType}`}
            groupTitleId="compare-detail-related-title"
            trackLabel={`More in ${entry.competitorType}`}
            fathomTrack={fathomCompare.detailRelated}
          />
        </section>
      )
    }
  </article>

  <PageClosingCTA
    heading={ctaHeading}
    lead={entry.worksBestAlongside}
    fathomTrack={fathomSignup.compareDetail(entry.slug)}
  />
</BaseLayout>

<style>
  .compare-detail__lead {
    max-width: 28rem;
  }
  .compare-detail__feature-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 0.85rem;
    padding: 0;
    list-style: none;
  }
  .compare-detail__feature-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .compare-detail__feature-links a:hover {
    background: var(--color-warm);
    border-color: color-mix(in srgb, var(--color-ink) 16%, var(--color-rule));
  }
</style>
