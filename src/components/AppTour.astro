---
/**
 * AppTour — the homepage's feature story, told as five screenshots in the order
 * study actually happens rather than as one large grid of tiles.
 *
 * This replaces FeatureBento. The twelve-tile grid that used to follow it keeps
 * only the features a screenshot can't usefully show (see FeatureGrid); the rest
 * moved in here, underneath the shot that demonstrates them, so a tile is a
 * caption for something visible instead of a claim on its own.
 *
 * Stacked on desktop; a scroll-snap slider below 720px, the same pattern and the
 * same carousel-fit binding the other homepage carousels use.
 */
import { existsSync } from "node:fs";
import path from "node:path";
import Container from "./layout/Container.astro";
import AppTourChapter from "./AppTourChapter.astro";
import ProductCard from "./ProductCard.astro";
import { APP_TOUR_CHAPTERS } from "../lib/app-tour-chapters.ts";
import { HOME_FEATURE_CARDS } from "../lib/home-feature-cards.ts";
import { getFeatureCategoryBySlug } from "../lib/feature-categories-data.ts";
import { isDraftPageSlug } from "../lib/draft-pages.ts";

/* A card's close-up only renders if the file is on disk; otherwise the card
   shows its pills. Same build-time check TourShotFrame uses. */
const shotExists = (src: string) =>
  existsSync(path.join(process.cwd(), "public", src.replace(/^\//, "")));

interface Props {
  id?: string;
  title?: string;
}

const {
  id,
  title = "A study Bible that remembers.",
} = Astro.props;

/**
 * One destination per card. The items inside used to be links of their own, which
 * made a card that reads as a single idea behave as three — and forced the card's
 * own hit area to be layered underneath them.
 */
const chapterCategories = APP_TOUR_CHAPTERS.map((chapter) =>
  getFeatureCategoryBySlug(chapter.categorySlug)
);
---

<section class="tour frame-divider" id={id}>
  <Container size="xl">
    <div class="tour__head section-head" data-reveal>
      <h2 class="section-title">{title}</h2>
      <!--
        The bridge: the five words are the hero's pills, which head the four
        cards directly below; the second sentence is what the five category
        cards under those do with them.
      -->
      <p class="lead tour__lead">
        You write in <strong>notes</strong>, <strong>scripture</strong>,
        <strong>highlights</strong>, <strong>folders</strong>, and <strong>threads</strong>.
        Harvous keeps them together — and when one fades, brings it back beside
        whatever you're writing next, into <mark>your own study Bible</mark>.
      </p>
      {
        /* The tour shows what 3.0 looks like; /3/ says what moved and why.
           Hidden while that page is still a draft. */
        !isDraftPageSlug("3") && (
          <a class="tour__whatsnew" href="/3/">New in Harvous 3 →</a>
        )
      }
    </div>
  </Container>

  <!--
    The hero cycles through five content pills. These four cards are those
    pills, each with the close-up that shows it — the visual thread from the
    headline down into the tour. A scroll-snap row that bleeds to the frame
    rails, the use-cases preview's pattern, with its own arrows so the
    category slider's controls below stay next to their own track.
  -->
  <Container size="xl">
    <div class="tour__pillcontrols" data-reveal style="--reveal-delay: 100ms;">
      <button type="button" class="tour__arrow" data-dir="prev" aria-label="Previous" disabled>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>
      </button>
      <button type="button" class="tour__arrow" data-dir="next" aria-label="Next">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
      </button>
    </div>
  </Container>

  <div class="tour__pillwrap carousel-track-wrap" data-reveal style="--reveal-delay: 120ms;">
    <ul class="tour__pilltrack" role="list" aria-label="What you write with" tabindex="0" data-reveal="stagger" style="--reveal-delay: 160ms;">
      {
        HOME_FEATURE_CARDS.map((card) => (
          <li class="tour__pillslide carousel-slide">
            <ProductCard
              pills={card.pills}
              title={card.title}
              body={card.body}
              image={card.image && shotExists(card.image) ? card.image : undefined}
              imageAlt={card.imageAlt}
            />
          </li>
        ))
      }
    </ul>
  </div>

  <Container size="xl">
    <div class="tour__controls">
      <button type="button" class="tour__arrow" data-dir="prev" aria-label="Previous chapter" disabled>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>
      </button>
      <button type="button" class="tour__arrow" data-dir="next" aria-label="Next chapter">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
      </button>
    </div>
  </Container>

  <div class="tour__track-wrap">
    <ul class="tour__track" role="list" aria-label="A tour of Harvous" tabindex="0">
      {
        APP_TOUR_CHAPTERS.map((chapter, i) => (
          <li class:list={["tour__slide", `tour__slide--${chapter.size}`]} data-reveal style={`--reveal-delay: ${Math.min(i, 2) * 60}ms;`}>
            <AppTourChapter chapter={chapter} category={chapterCategories[i]} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tour {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    overflow-x: hidden;
  }
  /* Full-bleed top hairline, matching the other homepage bands. */
  .tour::before { left: 0; right: 0; }

  .tour__lead { max-width: 38rem; }
  .tour__whatsnew {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 4px;
  }
  .tour__whatsnew:hover { text-decoration-color: var(--color-ink); }

  /* The four pill cards as a slider. Arrows sit right, over the row; the track
     bleeds past the framed column so the third card peeks in from the edge
     and the first lines up with the head's column. ~2.25 cards show at once,
     ~500px each at 1440 — the old bento's proportion, which the close-ups
     need to stay readable. */
  /* Centered under the centered head, like this section's other controls. */
  .tour__pillcontrols {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }
  .tour__pillwrap {
    --carousel-peek-slides: 2.25;
    --carousel-peek-gap-count: 2;
    position: relative;
    overflow: hidden;
    margin-inline: var(--frame-inset);
    margin-top: 0.9rem;
  }
  .tour__pilltrack {
    display: flex;
    align-items: stretch;
    gap: var(--carousel-slide-gap);
    margin: 0;
    padding-block: 0.25rem;
    padding-left: max(
      var(--frame-inset),
      calc((100vw - 72rem) / 2 + var(--frame-content-pad) - var(--frame-inset))
    );
    padding-right: var(--frame-inset);
    scroll-padding-left: max(
      var(--frame-inset),
      calc((100vw - 72rem) / 2 + var(--frame-content-pad) - var(--frame-inset))
    );
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .tour__pilltrack::-webkit-scrollbar { display: none; }
  .tour__pilltrack:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .tour__pillslide { min-width: 0; }
  .tour__pillslide :global(.pcard) { height: 100%; }

  .tour__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .tour__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease, opacity 150ms ease;
  }
  .tour__arrow svg { width: 0.8rem; height: 0.8rem; }
  .tour__arrow:hover:not(:disabled) { color: var(--color-ink); background: var(--color-warm); }
  .tour__arrow:disabled { opacity: 0.4; cursor: not-allowed; }

  .tour__track-wrap {
    position: relative;
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    overflow: hidden;
    margin-inline: var(--frame-inset);
  }
  .tour__track {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding-block: 0.25rem;
    padding-inline: var(--frame-inset);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .tour__track::-webkit-scrollbar { display: none; }
  .tour__track:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .tour__slide {
    flex: none;
    width: min(88vw, 30rem);
    scroll-snap-align: start;
  }

  /*
    Desktop: a bento rather than a uniform stack. Activity spans both columns
    because it is the change the release is actually about, and a tour where the
    headline feature looks exactly like the fifth one has no argument in its
    layout. The rest pair off.
  */
  @media (min-width: 720px) {
    .tour { overflow-x: visible; }
    .tour__controls { display: none; }
    .tour__track-wrap {
      max-width: 72rem;
      margin-inline: auto;
      padding-inline: var(--frame-content-pad);
      overflow: visible;
    }
    .tour__track {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
      gap: clamp(1rem, 1.6vw, 1.5rem);
      overflow: visible;
      padding: 0;
      scroll-snap-type: none;
    }
    .tour__slide { width: auto; scroll-snap-align: unset; }
    .tour__slide--wide { grid-column: 1 / -1; }
  }
</style>

<script>
  import { bindCarouselFit } from "../lib/carousel-fit.ts";

  const SLIDER_MQ = window.matchMedia("(max-width: 719px)");

  document.querySelectorAll<HTMLElement>(".tour").forEach((tour) => {
    // Two sliders share the .tour__arrow style; each binds only its own controls.
    const track = tour.querySelector<HTMLElement>(".tour__track");
    if (track) {
      bindCarouselFit({
        track,
        slideSelector: ".tour__slide",
        prevBtn: tour.querySelector<HTMLButtonElement>('.tour__controls .tour__arrow[data-dir="prev"]'),
        nextBtn: tour.querySelector<HTMLButtonElement>('.tour__controls .tour__arrow[data-dir="next"]'),
        enabled: () => SLIDER_MQ.matches,
      });
    }

    const pillTrack = tour.querySelector<HTMLElement>(".tour__pilltrack");
    if (pillTrack) {
      bindCarouselFit({
        track: pillTrack,
        slideSelector: ".tour__pillslide",
        prevBtn: tour.querySelector<HTMLButtonElement>('.tour__pillcontrols .tour__arrow[data-dir="prev"]'),
        nextBtn: tour.querySelector<HTMLButtonElement>('.tour__pillcontrols .tour__arrow[data-dir="next"]'),
      });
    }
  });
</script>
