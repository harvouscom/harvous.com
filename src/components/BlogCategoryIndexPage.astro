---
/**
 * BlogCategoryIndexPage — one Bright Enough topic (/blog/<topic>/, then
 * /blog/<topic>/page/N/). The hub's cards, a topic's worth at a time, with
 * the topic's colour and glyph up top, the other topics to hop to, and a
 * search box scoped to this topic.
 */
import NextLayout from "../layouts/NextLayout.astro";
import ClosingCall from "./next/ClosingCall.astro";
import BlogNextCard from "./next/BlogNextCard.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import {
  BLOG_CATEGORY_LABELS,
  blogBreadcrumbJsonLd,
  blogCategoriesInUse,
  blogCategoryColor,
  blogCategoryHref,
  blogCategoryIcon,
  blogCategoryLabel,
  blogCategoryLead,
  blogProductBridgeCopy,
  getBlogCategoryPage,
  includeBlogDrafts,
  isBlogPostListed,
  type BlogCategory,
} from "../lib/blog";

interface Props {
  category: BlogCategory;
  currentPage: number;
}
const { category, currentPage } = Astro.props;

const allPosts = (await getCollection("blog")).filter((p) => isBlogPostListed(p, includeBlogDrafts()));
const page = getBlogCategoryPage(category, currentPage, allPosts);
const label = blogCategoryLabel(category);
const lead = blogCategoryLead(category);
const icon = blogCategoryIcon(category);
const color = blogCategoryColor(category);
const bridge = blogProductBridgeCopy(category);
const others = blogCategoriesInUse(allPosts).filter((c) => c !== category);

const title = page.currentPage === 1 ? `${label} — Bright Enough` : `${label} (Page ${page.currentPage}) — Bright Enough`;
const leadSentence = /[.!?]$/.test(lead.trim()) ? lead.trim() : `${lead.trim()}.`;
const description = `${leadSentence} From Bright Enough, the Harvous blog.`;

const siteOrigin = Astro.site ?? "https://harvous.com";
const pageUrl = new URL(blogCategoryHref(category, page.currentPage), siteOrigin).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: page.currentPage === 1 ? label : `${label} — Page ${page.currentPage}`,
    description,
    url: pageUrl,
    isPartOf: { "@type": "Blog", name: "Bright Enough", url: new URL("/blog/", siteOrigin).toString() },
  },
  blogBreadcrumbJsonLd(
    [
      { name: "Harvous", path: "/" },
      { name: "Bright Enough", path: "/blog/" },
      { name: label, path: blogCategoryHref(category) },
    ],
    siteOrigin,
  ),
];
---

<NextLayout title={title} description={description} jsonLd={jsonLd} noindex={page.currentPage > 1}>
  <header class="nx-wrap bc-intro" style={`--tone: ${color.bg}; --tone-ink: ${color.ink};`}>
    <a class="bc-back" href="/blog/">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
      Bright Enough
    </a>
    <span class="bc-tile" aria-hidden="true"><Icon name={icon} /></span>
    <h1 class="nx-display bc-title">{label}</h1>
    <p class="nx-lead bc-lead">{leadSentence}</p>
    <form class="bc-search" action="/blog/search/" method="get" role="search">
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" /><path d="m10.5 10.5 3 3" /></svg>
      <label class="bc-sr" for={`bc-q-${category}`}>Search {label}</label>
      <input id={`bc-q-${category}`} name="q" type="search" placeholder={`Search ${label}…`} autocomplete="off" />
      <input type="hidden" name="category" value={category} />
    </form>
    <p class="bc-count">
      {page.totalCount} {page.totalCount === 1 ? "post" : "posts"}
      {page.totalPages > 1 && <> · page {page.currentPage} of {page.totalPages}</>}
    </p>
  </header>

  <section class="nx-wrap bc-posts" aria-label={label}>
    {page.posts.length > 0 ? (
      <ul class="bc-grid" role="list">
        {page.posts.map((p) => <li><BlogNextCard post={p} /></li>)}
      </ul>
    ) : (
      <p class="bc-empty">Nothing in this topic yet.</p>
    )}

    {page.totalPages > 1 && (
      <nav class="bc-pager" aria-label="Pages">
        {page.currentPage > 1 ? (
          <a class="nx-btn nx-btn--ghost" href={blogCategoryHref(category, page.currentPage - 1)}>← Newer</a>
        ) : <span />}
        <span class="bc-pager__of">Page {page.currentPage} of {page.totalPages}</span>
        {page.currentPage < page.totalPages ? (
          <a class="nx-btn nx-btn--ghost" href={blogCategoryHref(category, page.currentPage + 1)}>Older →</a>
        ) : <span />}
      </nav>
    )}
  </section>

  {others.length > 0 && (
    <section class="nx-wrap bc-others" aria-labelledby="bc-others-title">
      <h2 id="bc-others-title" class="bc-h2">Other topics</h2>
      <ul class="bc-chips" role="list">
        {others.map((c) => {
          const col = blogCategoryColor(c);
          return (
            <li>
              <a class="bc-chip" href={blogCategoryHref(c)} style={`--tone: ${col.bg}; --tone-ink: ${col.ink};`}>
                <Icon name={blogCategoryIcon(c)} aria-hidden="true" />
                {BLOG_CATEGORY_LABELS[c]}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <ClosingCall title={bridge.heading} lead={bridge.lead} />
</NextLayout>

<style>
  .bc-intro { padding-top: clamp(7.5rem, 15vw, 10rem); text-align: center; }
  .bc-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem 0.4rem 0.6rem;
    border-radius: 999px;
    background: var(--color-warm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
  }
  .bc-back:hover { background: color-mix(in srgb, var(--color-ink) 8%, transparent); }
  .bc-back svg { width: 0.9rem; height: 0.9rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .bc-tile {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    margin: 1.75rem auto 0;
    border-radius: 28%;
    color: var(--tone-ink);
    background: color-mix(in oklab, var(--tone) 60%, #fff);
  }
  .bc-tile :global(svg) { width: 1.5rem; height: 1.5rem; }
  .bc-title { margin: 1rem auto 0; font-size: clamp(2.5rem, 6vw, 4.5rem); }
  .bc-lead { margin: 1.25rem auto 0; }

  .bc-search {
    position: relative;
    max-width: 26rem;
    margin: 1.75rem auto 0;
  }
  .bc-search svg {
    position: absolute;
    left: 1rem;
    top: 50%;
    width: 1rem;
    height: 1rem;
    translate: 0 -50%;
    fill: none;
    stroke: var(--color-ink-faint);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .bc-search input[type="search"] {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 2.6rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--color-ink);
    background: var(--color-warm);
  }
  .bc-search input[type="search"]:focus { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .bc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .bc-count { margin: 1rem 0 0; font-size: 0.875rem; color: var(--color-ink-faint); font-variant-numeric: tabular-nums; }

  .bc-posts { padding-top: clamp(2.5rem, 6vw, 3.5rem); }
  .bc-grid { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 44rem) { .bc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; } }
  @media (min-width: 68rem) { .bc-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .bc-empty { text-align: center; color: var(--color-ink-soft); }
  .bc-pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin-top: 2.5rem; }
  .bc-pager > :last-child { justify-self: end; }
  .bc-pager__of { font-size: 0.9375rem; color: var(--color-ink-faint); }

  .bc-others { padding-top: clamp(3.5rem, 8vw, 5rem); text-align: center; }
  .bc-h2 { font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 1.65rem); font-weight: 500; letter-spacing: -0.02em; }
  .bc-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin: 1.25rem 0 0; padding: 0; list-style: none; }
  .bc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    background: color-mix(in oklab, var(--tone) 35%, var(--color-paper));
    text-decoration: none;
  }
  .bc-chip :global(svg) { width: 0.9rem; height: 0.9rem; color: var(--tone-ink); }
  .bc-chip:hover { background: color-mix(in oklab, var(--tone) 55%, var(--color-paper)); }
</style>
