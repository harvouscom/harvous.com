---
/**
 * /blog/<topic>/ — one Bright Enough topic: the new-style intro with its
 * icon and a search scoped to the topic, then its posts as cards, paged.
 */
import NextLayout from "../layouts/NextLayout.astro";
import { ogCard } from "../lib/og-card.ts";
import BlogNextCard from "./next/BlogNextCard.astro";
import BlogCategoryPagination from "./BlogCategoryPagination.astro";
import BlogSearchBar from "./BlogSearchBar.astro";
import BlogTopicBlocks from "./BlogTopicBlocks.astro";
import ClosingCall from "./next/ClosingCall.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import {
  blogBreadcrumbJsonLd,
  blogCategoryColor,
  blogCategoryHref,
  blogCategoryIcon,
  blogCategoryLabel,
  blogCategoryLead,
  getBlogCategoryPage,
  includeBlogDrafts,
  isBlogPostListed,
  type BlogCategory,
} from "../lib/blog";

interface Props {
  category: BlogCategory;
  currentPage: number;
}

const { category, currentPage } = Astro.props;

const showDrafts = includeBlogDrafts();
const allPosts = (await getCollection("blog")).filter((p) => isBlogPostListed(p, showDrafts));
const page = getBlogCategoryPage(category, currentPage, allPosts);

const label = blogCategoryLabel(category);
const lead = blogCategoryLead(category);
const icon = blogCategoryIcon(category);
const color = blogCategoryColor(category);
const title =
  page.currentPage === 1
    ? `${label} — Bright Enough`
    : `${label} (Page ${page.currentPage}) — Bright Enough`;

const leadSentence = /[.!?]$/.test(lead.trim()) ? lead.trim() : `${lead.trim()}.`;
const description = `${leadSentence} From Bright Enough, the Harvous blog.`;

const siteOrigin = Astro.site ?? "https://harvous.com";
const pagePath = blogCategoryHref(category, page.currentPage);
const pageUrl = new URL(pagePath, siteOrigin).toString();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: page.currentPage === 1 ? label : `${label} — Page ${page.currentPage}`,
    description,
    url: pageUrl,
    isPartOf: {
      "@type": "Blog",
      name: "Bright Enough",
      url: new URL("/blog/", siteOrigin).toString(),
    },
  },
  blogBreadcrumbJsonLd(
    [
      { name: "Harvous", path: "/" },
      { name: "Bright Enough", path: "/blog/" },
      { name: label, path: blogCategoryHref(category) },
    ],
    siteOrigin,
  ),
];
---

<NextLayout
  ogImage={ogCard(`blog-${category}`)}
  title={title}
  description={description}
  jsonLd={jsonLd}
  noindex={page.currentPage > 1}
>
  <header class="nx-wrap bc-intro">
    <a class="bc-back" href="/blog/">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
      Bright Enough
    </a>
    <span
      class="bc-tile"
      style={`background: color-mix(in oklab, ${color.bg} 55%, var(--color-paper)); color: ${color.ink};`}
      aria-hidden="true"
    >
      <Icon name={icon} />
    </span>
    <h1 class="nx-display bc-title">{label}</h1>
    <p class="nx-lead bc-lead">{leadSentence}</p>
    <div class="bc-search">
      <BlogSearchBar
        variant="page"
        category={category}
        inputId={`blog-search-${category}`}
        placeholder={`Search ${label}…`}
      />
    </div>
  </header>

  <section class="nx-wrap bc-sec" aria-label={label}>
    {page.posts.length > 0 ? (
      <>
        <ul class="bc-grid" role="list" data-reveal="stagger">
          {page.posts.map((post) => (
            <li><BlogNextCard post={post} headingLevel="h2" /></li>
          ))}
        </ul>
        <BlogCategoryPagination page={page} />
      </>
    ) : (
      <p class="bc-empty">Nothing in this topic yet.</p>
    )}
  </section>

  <section class="nx-wrap bc-more" aria-labelledby="bc-more-title">
    <BlogTopicBlocks current={category} />
    <h2 id="bc-more-title" class="bc-more__h">More from Bright Enough</h2>
    <p class="bc-more__p">Notes, habits, and teaching that show up after Sunday.</p>
    <a class="nx-btn nx-btn--ghost" href="/blog/" data-blog-topic-blocks-trigger>Back to Bright Enough</a>
  </section>

  <ClosingCall />
</NextLayout>

<style>
  .bc-intro { padding-top: clamp(7.5rem, 15vw, 10rem); text-align: center; }
  .bc-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.8rem 0.35rem 0.6rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
    text-decoration: none;
  }
  .bc-back:hover { background: color-mix(in srgb, var(--color-ink) 9%, transparent); }
  .bc-back svg { width: 0.85rem; height: 0.85rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .bc-tile { display: grid; place-items: center; width: 3rem; height: 3rem; margin: 1.5rem auto 0; border-radius: 0.9rem; }
  .bc-tile :global(svg) { width: 1.35rem; height: 1.35rem; }
  .bc-title { margin: 1rem 0 0; }
  .bc-lead { max-width: 32rem; margin: 1rem auto 0; }
  .bc-search { max-width: 28rem; margin: 2rem auto 0; }

  .bc-sec { padding-top: clamp(3rem, 7vw, 4.5rem); }
  .bc-grid { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 40rem) { .bc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .bc-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .bc-empty { text-align: center; color: var(--color-ink-soft); }

  .bc-more { padding-block: clamp(4rem, 9vw, 6rem) 0; text-align: center; }
  .bc-more__h { margin: 2rem 0 0; font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 500; letter-spacing: -0.025em; }
  .bc-more__p { max-width: 28rem; margin: 0.6rem auto 1.5rem; color: var(--color-ink-soft); }
</style>
