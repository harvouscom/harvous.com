---
/**
 * AboutResearchGap — dedicated About band, built as one argument rather than a
 * pair of statistics: where most people are, then the thing research says moves
 * that number, then an invitation to go look at the product. The two figures are
 * unlike (a population share and a behavioral threshold), so each carries a role
 * eyebrow naming its job in the sequence — that keeps the logic legible when the
 * grid stacks below 720px and nothing sits side by side.
 *
 * Copy deliberately avoids the source taxonomies (“Bible Disengaged”,
 * “Scripture Engaged”) and describes the behavior instead; the citations carry
 * the provenance.
 *
 * The closing CTA points at /features rather than signup on purpose: the page
 * already ends with PageClosingCTA for signup, so a second signup button here
 * would compete with it. This one picks the argument back up — the fourth day —
 * so it reads as a next step rather than a pitch.
 */
import Container from "./layout/Container.astro";
import CTAButton from "./CTAButton.astro";
import { fathomCta } from "../lib/fathom-events.ts";

/**
 * `href` points at the section of the Bright Enough essay that works through
 * each finding — not at the study itself — so the citation is prefixed with
 * “via” and the link carries an aria-label naming where it actually goes. A
 * bare org name linking to a Harvous page would read as the source.
 */
const ESSAY = "/blog/why-scripture-engagement-stalls";

const stats = [
  {
    role: "The situation",
    figure: "57%",
    unit: "of U.S. adults",
    body: "They open a Bible rarely, and say it shapes little of how they live. About 18% sit at the other end — reading often, and shaped by it.",
    source: "American Bible Society, 2024",
    href: `${ESSAY}#bible-disengaged`,
  },
  {
    role: "What moves it",
    figure: "4+",
    unit: "days a week",
    body: "One to three days looks about like none. Four or more is where researchers start to see real change.",
    source: "Center for Bible Engagement",
    href: `${ESSAY}#the-four-day-wall`,
  },
];
---

<section class="about-gap frame-divider" aria-labelledby="about-gap-title">
  <Container size="xl">
    <div class="about-gap__head" data-reveal>
      <span class="eyebrow-pill">The gap</span>
      <h2 class="section-title about-gap__title" id="about-gap-title">
        Most people have a Bible. Few have a rhythm.
      </h2>
      <p class="lead about-gap__lead">
        Owning one was never the hard part. What research keeps finding is that
        coming back is.
      </p>
    </div>

    <ul class="about-gap__stats" role="list" data-reveal style="--reveal-delay: 50ms;">
      {
        stats.map((s) => (
          <li class="about-gap__stat">
            <p class="about-gap__role">{s.role}</p>
            <p class="about-gap__figure">
              <span class="about-gap__num">{s.figure}</span>
              <span class="about-gap__unit">{s.unit}</span>
            </p>
            <p class="about-gap__body">{s.body}</p>
            <p class="about-gap__source">
              via{" "}
              <a
                class="about-gap__source-link"
                href={s.href}
                aria-label={`${s.source} — read how this finding is used, in Why scripture engagement stalls`}
              >
                {s.source}
              </a>
            </p>
          </li>
        ))
      }
    </ul>

    <div class="about-gap__cta" data-reveal style="--reveal-delay: 80ms;">
      <div class="about-gap__cta-copy">
        <p class="about-gap__cta-title">Built for the coming back.</p>
        <p class="about-gap__cta-body">
          A fourth day is easier when last week’s study is still where you left
          it — and still makes sense when you get there.
        </p>
      </div>
      <CTAButton
        href="/#features"
        variant="primary"
        size="lg"
        class="about-gap__cta-btn"
        fathomTrack={fathomCta.featuresAnchor}
      >
        Explore Harvous
      </CTAButton>
    </div>
  </Container>
</section>

<style>
  .about-gap {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .about-gap__head {
    max-width: 38rem;
  }

  .about-gap__title {
    margin-top: 0.75rem;
  }

  .about-gap__lead {
    margin-top: 1rem;
    max-width: 34rem;
  }

  .about-gap__stats {
    list-style: none;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 720px) {
    .about-gap__stats {
      grid-template-columns: 1fr 1fr;
      gap: 0 3rem;
    }

    .about-gap__stat + .about-gap__stat {
      padding-left: 3rem;
      border-left: 1px solid var(--color-rule);
    }
  }

  .about-gap__figure {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.55rem;
  }

  .about-gap__num {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.5vw, 3.5rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
    /* The app's display cut, like the hero "3" on /3/ and its own index
       numbers — a number reads as a headline figure, not body text. */
    font-variation-settings: "ROND" 100, "wdth" 100;
  }

  .about-gap__unit {
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--color-ink-faint);
  }

  /* Names each figure's job in the argument, so "the situation → what moves it"
     survives the grid stacking on narrow screens. */
  .about-gap__role {
    margin: 0 0 0.6rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-faint);
  }

  .about-gap__body {
    margin: 0.85rem 0 0;
    max-width: 24rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  /* Uneven body copy would otherwise leave the two citations at different
     heights; stretch the item and drop them to a shared baseline. */
  .about-gap__stat {
    display: flex;
    flex-direction: column;
  }

  .about-gap__source {
    margin: auto 0 0;
    padding-top: 0.6rem;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-faint);
  }

  /* Hairline underline at rest so it reads as a link at 11px without shouting;
     the citation is a footnote, not a call to action. */
  .about-gap__source-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 0.25em;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .about-gap__source-link:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  /* What the two figures add up to, plus the way out. Sits on a full-bleed rule
     so it reads as the band's conclusion rather than a stray sentence. */
  .about-gap__cta {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  @media (min-width: 720px) {
    .about-gap__cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
    }
  }

  .about-gap__cta-copy {
    max-width: 32rem;
  }

  .about-gap__cta-title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .about-gap__cta-body {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  /* Keep the pill on one line when the copy beside it wants the space. */
  .about-gap__cta-btn {
    flex-shrink: 0;
  }
</style>
