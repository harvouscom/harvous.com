---
/**
 * AboutResearchGap — dedicated About band: two research punches, then the
 * Bright Enough essay that argues them at length. Conversion stays with the
 * page’s closing CTA.
 */
import Container from "./layout/Container.astro";
import BlogCard from "./BlogCard.astro";
import { blogReadingMinutes } from "../lib/blog";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const stats = [
  {
    figure: "57%",
    unit: "of U.S. adults",
    label: "Bible Disengaged",
    body: "Only about 18% are Scripture Engaged. Friendly toward Scripture isn’t the same as shaped by it.",
    source: "American Bible Society, 2024",
  },
  {
    figure: "4+",
    unit: "days a week",
    label: "The four-day wall",
    body: "One to three days looks about like none. Four or more is where the research sees real change.",
    source: "Center for Bible Engagement",
  },
];
---

<section class="about-gap frame-divider" aria-labelledby="about-gap-title">
  <Container size="xl">
    <div class="about-gap__head" data-reveal>
      <span class="eyebrow-pill">The gap</span>
      <h2 class="section-title about-gap__title" id="about-gap-title">
        Access went up. Return didn’t.
      </h2>
      <p class="lead about-gap__lead">
        More people carry a Bible than any generation before. Research keeps
        finding that access isn’t the variable — coming back is.
      </p>
    </div>

    <ul class="about-gap__stats" role="list" data-reveal style="--reveal-delay: 50ms;">
      {
        stats.map((s) => (
          <li class="about-gap__stat">
            <p class="about-gap__figure">
              <span class="about-gap__num">{s.figure}</span>
              <span class="about-gap__unit">{s.unit}</span>
            </p>
            <p class="about-gap__label">{s.label}</p>
            <p class="about-gap__body">{s.body}</p>
            <p class="about-gap__source">{s.source}</p>
          </li>
        ))
      }
    </ul>

    <div class="about-gap__essay" data-reveal style="--reveal-delay: 80ms;">
      <p class="about-gap__essay-kicker">From Bright Enough, the Harvous blog</p>
      <BlogCard
        variant="story"
        title={post.data.title}
        description={post.data.description}
        publishDate={post.data.publishDate}
        category={post.data.category}
        slug={post.id}
        readingTime={blogReadingMinutes(post.body)}
        draft={post.data.draft}
      />
    </div>
  </Container>
</section>

<style>
  .about-gap {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .about-gap__head {
    max-width: 38rem;
  }

  .about-gap__title {
    margin-top: 0.75rem;
  }

  .about-gap__lead {
    margin-top: 1rem;
    max-width: 34rem;
  }

  .about-gap__stats {
    list-style: none;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 720px) {
    .about-gap__stats {
      grid-template-columns: 1fr 1fr;
      gap: 0 3rem;
    }

    .about-gap__stat + .about-gap__stat {
      padding-left: 3rem;
      border-left: 1px solid var(--color-rule);
    }
  }

  .about-gap__figure {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.55rem;
  }

  .about-gap__num {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.5vw, 3.5rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
  }

  .about-gap__unit {
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--color-ink-faint);
  }

  .about-gap__label {
    margin: 0.85rem 0 0;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .about-gap__body {
    margin: 0.4rem 0 0;
    max-width: 24rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .about-gap__source {
    margin: 0.6rem 0 0;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-faint);
  }

  .about-gap__essay {
    margin-top: clamp(2.25rem, 4.5vw, 3rem);
  }

  .about-gap__essay-kicker {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-faint);
  }

  /* The story card carries its own list padding; this band already spaces it. */
  .about-gap__essay :global(.blog-story) {
    padding-block: 0;
  }
</style>
