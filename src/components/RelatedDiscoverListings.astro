---
/**
 * "Start from one of these" — the Discover listings filed under this use case.
 *
 * Sits beside `RelatedBlogPosts` at the foot of a use-case page and takes the
 * same band shape, but shows the actual thing rather than an illustration of
 * it: the reader has just finished a page about studying this way, and the
 * catalog has scaffolds for exactly that. Category ids *are* use-case slugs —
 * that correspondence is why `discover-categories.ts` refuses to rename one —
 * so the filter is the slug and needs no mapping table.
 *
 * Renders nothing at all when the catalog has nothing for this use case, or
 * while Discover is still a draft. A section headed "start from one of these"
 * over an empty row is worse than no section, and this is the kind of surface
 * that quietly empties itself when a listing is delisted.
 */
import DiscoverCard from "./DiscoverCard.astro";
import {
  discoverCategoryLabel,
  getDiscoverListings,
  type DiscoverListing,
} from "../lib/discover-data.ts";
import { draftPageIsReachable } from "../lib/draft-pages.ts";

interface Props {
  /** A use-case slug, which is also a Discover category id. */
  useCaseSlug: string;
  /** Three keeps the row one line on desktop and honest on a small catalog. */
  limit?: number;
}

const { useCaseSlug, limit = 3 } = Astro.props;

const listings: DiscoverListing[] = draftPageIsReachable("discover")
  ? getDiscoverListings()
      .filter((listing) => listing.category === useCaseSlug)
      .slice(0, limit)
  : [];

const label = discoverCategoryLabel(useCaseSlug);
---

{
  listings.length > 0 && (
    <section class="related-discover frame-divider" aria-labelledby="related-discover-title">
      <div class="related-discover__inner">
        <div class="related-discover__intro">
          <p class="eyebrow">From Discover</p>
          <h2
            id="related-discover-title"
            class="mt-2 font-display text-3xl leading-[1.05] tracking-tight md:text-4xl"
          >
            Start from one of these
          </h2>
          <p class="related-discover__lead mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)] md:text-[0.95rem]">
            Free templates and studies filed under {label.toLowerCase()} — take a copy and it is
            yours to change.
          </p>
          <a
            href={`/discover/?use=${useCaseSlug}`}
            class="related-discover__more mt-5 inline-flex items-center justify-center gap-2 rounded-full border border-[var(--color-rule)] bg-[var(--color-card)] px-5 py-3 text-base font-medium text-[var(--color-ink)] transition-all hover:bg-[var(--color-warm)]"
          >
            See everything in {label}
          </a>
        </div>

        <ul class="related-discover__grid" data-reveal="stagger">
          {listings.map((listing) => (
            <DiscoverCard listing={listing} variant="compact" />
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .related-discover__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--frame-content-pad);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  /* Copy left, cards right once there is room for both — the same two-column
     band `RelatedBlogPosts` uses, so the two sections read as siblings. */
  @media (min-width: 900px) {
    .related-discover__inner {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      align-items: start;
      gap: 3rem;
    }
  }
  .related-discover__lead {
    max-width: 32rem;
  }
  .related-discover__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
