---
import NextLayout from "../layouts/NextLayout.astro";
import { ogCard } from "../lib/og-card.ts";
import BlogLibraryNav from "./BlogLibraryNav.astro";
import BlogTopicBlocks from "./BlogTopicBlocks.astro";
import { getCollection } from "astro:content";
import {
  BLOG_CATEGORY_LABELS,
  blogCategoriesInUse,
  blogCategoryColor,
  blogCategoryIcon,
  includeBlogDrafts,
  isBlogPostListed,
  postsInBlogCategory,
  type BlogCategory,
} from "../lib/blog";

const showDrafts = includeBlogDrafts();
const listed = (await getCollection("blog")).filter((p) => isBlogPostListed(p, showDrafts));
const topics = blogCategoriesInUse(listed).map((cat: BlogCategory) => ({
  category: cat,
  label: BLOG_CATEGORY_LABELS[cat],
  icon: blogCategoryIcon(cat),
  color: blogCategoryColor(cat),
  count: postsInBlogCategory(listed, cat).length,
}));
---

<NextLayout
  ogImage={ogCard("blog")}
  title="Search — Bright Enough"
  description="Search Bright Enough — notes, habits, and teaching from the Harvous blog."
  noindex
>
  <header class="nx-wrap bs-intro">
    <BlogTopicBlocks />
    <p class="nx-kicker">Bright Enough</p>
    <h1 class="nx-display">Search</h1>
    <p class="nx-lead">Find posts by title or topic across Bright Enough.</p>
  </header>

  <div data-blog-search-page>
    <BlogLibraryNav mode="filter" topics={topics} />

    <section
      class="mx-auto max-w-3xl px-[var(--frame-content-pad)] py-10 md:py-14"
      aria-label="Search results"
    >
      <p class="text-center text-sm text-[var(--color-ink-faint)]" data-blog-search-status>
        Loading search…
      </p>

      <div class="mt-4" data-blog-search-results hidden></div>
      <p
        class="mt-8 text-center text-[var(--color-ink-soft)]"
        data-blog-search-empty
        hidden
      ></p>

      <div class="mt-12 flex justify-center">
        <a href="/blog/" class="nx-btn nx-btn--ghost">Back to Bright Enough</a>
      </div>
    </section>
  </div>
</NextLayout>

<script>
  import "../scripts/blog-search.ts";
</script>

<style>
  .bs-intro { padding-top: clamp(7.5rem, 15vw, 10rem); padding-bottom: 2.5rem; text-align: center; }
  .bs-intro .nx-kicker { margin-top: 1.5rem; }
  .bs-intro .nx-display { margin: 0.75rem 0 0; }
  .bs-intro .nx-lead { max-width: 32rem; margin: 1.25rem auto 2rem; }
</style>
