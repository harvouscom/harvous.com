---
/**
 * NextLayout — the site's marketing chrome around BaseLayout's head.
 *
 * BaseLayout renders `bare` here, so its head, analytics, and the reveal / hash
 * / try-CTA scripts are shared, while the site Header, Footer, and page-frame
 * rails give way to a floating pill nav, a sticky "Try Harvous free" pill, and
 * a quieter footer.
 *
 * `noindex` defaults off — this is the live site now — but a page can still
 * opt in (release notes keeps individual changelog entries out of the index,
 * same as before the redesign).
 *
 * next.css is imported from this file, not BaseLayout, so none of it reaches a
 * page still on the old chrome; it is scoped under `.nx` besides. (Some
 * component and directory names still carry a "next" prefix from when this
 * was built beside the live site — cosmetic, harmless to rename later.)
 */
import BaseLayout from "./BaseLayout.astro";
import NextHeader from "../components/next/NextHeader.astro";
import NextFooter from "../components/next/NextFooter.astro";
import StickyTryPill from "../components/next/StickyTryPill.astro";
import "../styles/next.css";
import "../styles/next-app-ui.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
}

const { title, description, ogImage, noindex = false, jsonLd, ogImageWidth, ogImageHeight, ogType, articlePublishedTime } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} ogType={ogType} articlePublishedTime={articlePublishedTime} noindex={noindex} jsonLd={jsonLd} bare>
  <Fragment slot="head">
    {/* Margin notes only. Self-host before cutover, like Google Sans Flex. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap"
    />
  </Fragment>

  <div class="nx">
    <NextHeader />
    <main class="nx-main">
      <slot />
    </main>
    <NextFooter />
    <StickyTryPill />
  </div>
</BaseLayout>
