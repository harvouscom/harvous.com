---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Open Graph type — use "article" for blog posts and similar. */
  ogType?: "website" | "article";
  /** ISO 8601 publish time when ogType is "article". */
  articlePublishedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Preload LCP image (WebP path under public/). */
  preloadImage?: string;
  /** When true, adds noindex to keep error pages out of search results. */
  noindex?: boolean;
  /** Full content for meta robots (e.g. "noindex, nofollow"). Overrides noindex when set. */
  robots?: string;
}

const {
  title = "Harvous — Bible notes app alternative",
  description = "Harvous is a Bible study notes app — not sermon transcription. Read Scripture, write what you notice, and keep notes, highlights, and threads linked to the verse.",
  ogImage = "/og.png",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = "website",
  articlePublishedTime,
  jsonLd,
  preloadImage,
  noindex = false,
  robots,
} = Astro.props;

const robotsContent = robots ?? (noindex ? "noindex" : undefined);

const siteOrigin = Astro.site ?? "https://harvous.com";
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = new URL(ogImage, siteOrigin).toString();
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en" data-color-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link
      rel="preload"
      href="/fonts/google-sans-flex/GoogleSansFlex-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline>
      @font-face {
        font-family: "Google Sans Flex";
        src: url("/fonts/google-sans-flex/GoogleSansFlex-Variable.woff2") format("woff2-variations");
        font-weight: 1 1000;
        font-style: normal;
        font-display: swap;
      }
      html {
        font-family: "Google Sans Flex", ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    </style>
    <meta name="generator" content={Astro.generator} />

    {/*
      The app is a different origin, so "Try it free" pays for a DNS lookup and a TLS handshake
      before it can even ask for the page. Doing both up front is most of the difference between
      a handoff that reads as one continuous surface and one with a visible gap in the middle.
    */}
    <link rel="preconnect" href="https://app.harvous.com" />
    <link rel="dns-prefetch" href="https://app.harvous.com" />

    <script is:inline>
      document.documentElement.classList.add("js");
      // TEMP: dark mode disabled — always light until night theme is ready to ship.
      document.documentElement.dataset.colorScheme = "light";
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Bright Enough — Harvous Blog"
      href="/blog/rss.xml"
    />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />
    )}
    <link rel="icon" type="image/png" href="/images/harvous-2-icon.png" />
    <link rel="apple-touch-icon" href="/images/harvous-2-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:site_name" content="Harvous" />
    <meta property="og:locale" content="en_US" />
    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }

    <script src="https://cdn.usefathom.com/script.js" data-site="UOIPAZGI" defer></script>
  </head>
  <body>
    <Header />
    <div class="page-frame">
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      const stacks = document.querySelectorAll(".paper-stack");
      const reveals = document.querySelectorAll("[data-reveal]");

      const revealEl = (el: Element) => el.classList.add("revealed");
      const revealStack = (el: Element) => el.classList.add("in-view");

      /** True when any part of the element is in the viewport and layout has size. */
      const isInViewport = (el: Element) => {
        const rect = el.getBoundingClientRect();
        if (rect.width === 0 && rect.height === 0) return false;
        return rect.top < window.innerHeight && rect.bottom > 0;
      };

      const revealVisibleNow = () => {
        reveals.forEach((el) => {
          if (!el.classList.contains("revealed") && isInViewport(el)) revealEl(el);
        });
        stacks.forEach((el) => {
          if (!el.classList.contains("in-view") && isInViewport(el)) revealStack(el);
        });
      };

      if ("IntersectionObserver" in window) {
        const stackObserver = new IntersectionObserver(
          (entries, ob) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              revealStack(e.target);
              ob.unobserve(e.target);
            });
          },
          { threshold: 0, rootMargin: "0px 0px -10% 0px" }
        );

        const revealObserver = new IntersectionObserver(
          (entries, ob) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              revealEl(e.target);
              ob.unobserve(e.target);
            });
          },
          { threshold: 0, rootMargin: "0px 0px -8% 0px" }
        );

        reveals.forEach((el) => {
          if (isInViewport(el)) {
            revealEl(el);
          } else {
            revealObserver.observe(el);
          }
        });

        stacks.forEach((el) => {
          if (isInViewport(el)) {
            revealStack(el);
          } else {
            stackObserver.observe(el);
          }
        });

        // Layout/fonts/images can settle after the module runs — re-check so above-the-fold
        // content is not left at opacity: 0 until the user scrolls.
        requestAnimationFrame(() => {
          requestAnimationFrame(revealVisibleNow);
        });
        window.addEventListener("load", revealVisibleNow, { once: true });
        document.fonts?.ready.then(revealVisibleNow);
      } else {
        stacks.forEach((el) => revealStack(el));
        reveals.forEach((el) => revealEl(el));
      }

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const revealHashTarget = (hash: string) => {
        const id = hash.replace(/^#/, "");
        if (!id) return false;
        const target = document.getElementById(id);
        if (!target) return false;
        target.querySelectorAll("[data-reveal]").forEach(revealEl);
        target.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
        return true;
      };

      document.addEventListener("click", (event) => {
        const link = (event.target as Element).closest('a[href*="#"]');
        if (!link) return;
        const href = link.getAttribute("href");
        if (!href || href === "#") return;
        const hash = href.includes("#") ? href.slice(href.indexOf("#")) : "";
        if (!hash || hash === "#") return;
        if (!document.getElementById(hash.slice(1))) return;
        if (link instanceof HTMLAnchorElement && link.origin !== window.location.origin) return;
        event.preventDefault();
        history.pushState(null, "", hash);
        revealHashTarget(hash);
      });

      if (window.location.hash) {
        requestAnimationFrame(() => revealHashTarget(window.location.hash));
      }
      window.addEventListener("hashchange", () => revealHashTarget(window.location.hash));
    </script>

    {/*
      `is:global` because the overlay below is built in JS at click time, so it never carries
      the scoping attribute Astro stamps on elements written in this template — scoped, these
      rules match nothing and the handoff silently degrades to a plain navigation.
    */}
    <style is:global>
      /*
        The handoff to the app.

        harvous.com and app.harvous.com are separate origins, so there is no shared-element
        transition to be had here: cross-document view transitions are same-origin only, and the
        app's CSP forbids framing it. What is possible is a matched seam — end this page on
        exactly the frame the app begins on, and the document swap in the middle has nothing to
        show. Those two values are the app's real first paint, painted before its bundle loads
        by public/scripts/prototype-route-boot.js: the canvas underneath, and a rounded card
        inset 14px. Keep them in sync with prototype-tokens.css.

        clip-path rather than a transform, for the same reason the app's own morphs use it: a
        transform scaling a pill up to a viewport would stretch the card inside it back out.
      */
      .try-morph {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: oklch(98.7% 0.005 92);
        clip-path: inset(var(--t) var(--r) var(--b) var(--l) round 999px);
        transition:
          clip-path 420ms cubic-bezier(0.32, 0.72, 0.24, 1);
        pointer-events: none;
      }
      .try-morph[data-open="true"] {
        clip-path: inset(0 0 0 0 round 0);
      }
      /* No believable rect to grow from — cross into the app's colour without travelling. */
      .try-morph[data-fade] {
        clip-path: none;
        opacity: 0;
        transition: opacity 260ms linear;
      }
      .try-morph[data-fade][data-open="true"] {
        opacity: 1;
      }
      .try-morph__card {
        position: absolute;
        inset: 14px;
        border-radius: 18px;
        background: oklch(100% 0 0);
        box-shadow:
          0 2px 12px oklch(0% 0 0 / 0.02),
          0 1px 3px oklch(0% 0 0 / 0.01);
        opacity: 0;
        /* A beat behind the box, so the card arrives into a shape rather than growing as one. */
        transition: opacity 220ms linear 140ms;
      }
      .try-morph[data-open="true"] .try-morph__card {
        opacity: 1;
      }
      /*
        Fewer and gentler, not none — the house rule. The ground still changes to the app's
        colour so the navigation is not a cut from white to warm; it simply does not travel.
      */
      @media (prefers-reduced-motion: reduce) {
        .try-morph {
          clip-path: none;
          transition: none;
        }
        .try-morph__card {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      (function tryMorph() {
        var links = document.querySelectorAll("a[data-try-morph]");
        if (!links.length) return;

        var warmed = false;
        function warm(event) {
          if (warmed) return;
          warmed = true;
          var link = document.createElement("link");
          link.rel = "prefetch";
          // The anchor's own href, so this follows the origin the build was made against
          // rather than hard-coding production into a warm-up that would then warm the wrong
          // host in every other environment.
          link.href = event.currentTarget.href;
          document.head.appendChild(link);
        }

        /*
         * A rect worth growing out of: on screen, and no larger than the screen.
         *
         * The hero's entrance animation transforms this button, and `getBoundingClientRect`
         * reports the *visual* box — so a click landing mid-reveal measured a pill 1392px wide
         * starting 32px off the left edge, and the app would have grown out of a rectangle
         * nobody pressed. Same lesson the app's own panel morph records about re-measuring
         * mid-flight. When the number is not believable, fall back to a plain fade rather than
         * animating a lie.
         */
        function usableRect(rect) {
          return (
            rect.width > 0 &&
            rect.height > 0 &&
            rect.top >= 0 &&
            rect.left >= 0 &&
            rect.right <= window.innerWidth &&
            rect.bottom <= window.innerHeight
          );
        }

        function run(anchor, href) {
          var rect = anchor.getBoundingClientRect();
          var overlay = document.createElement("div");
          overlay.className = "try-morph";
          overlay.setAttribute("aria-hidden", "true");
          if (usableRect(rect)) {
            // The starting shape is the button the person actually pressed, so the app grows
            // out of the thing they touched rather than out of the middle of the screen.
            overlay.style.setProperty("--t", rect.top + "px");
            overlay.style.setProperty("--l", rect.left + "px");
            overlay.style.setProperty("--r", window.innerWidth - rect.right + "px");
            overlay.style.setProperty("--b", window.innerHeight - rect.bottom + "px");
          } else {
            overlay.setAttribute("data-fade", "true");
          }
          overlay.appendChild(document.createElement("div")).className = "try-morph__card";
          document.body.appendChild(overlay);

          // Commit the collapsed frame before opening, or the browser coalesces both into one
          // style recalc and there is nothing to transition from.
          void overlay.offsetWidth;
          requestAnimationFrame(function () {
            overlay.setAttribute("data-open", "true");
          });

          /*
           * Navigate now, not when the animation ends. The browser keeps painting this document
           * until the next one is ready, so the animation is cover for the network time rather
           * than something added in front of it. Waiting for `transitionend` would turn a 420ms
           * animation and a 400ms load into 820ms of waiting.
           */
          window.location.href = href;
        }

        links.forEach(function (anchor) {
          anchor.addEventListener("pointerenter", warm);
          anchor.addEventListener("focus", warm);
          anchor.addEventListener("click", function (event) {
            // Leave modified clicks alone — a new tab should get a plain navigation, and
            // animating this one shut while the page stays put would be a lie.
            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }
            event.preventDefault();
            run(anchor, anchor.href);
          });
        });
      })();
    </script>

    <script is:inline>
      document.querySelectorAll("[data-fathom-track]").forEach(function (el) {
        el.addEventListener("click", function () {
          if (window.fathom) {
            window.fathom.trackEvent(el.getAttribute("data-fathom-track"));
          }
        });
      });
    </script>
  </body>
</html>
