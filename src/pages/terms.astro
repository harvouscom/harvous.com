---
/** /terms/ — the live terms of service, word for word, in the /next chrome. */
import LegalPage from "../components/next/LegalPage.astro";
import TermsBody from "../components/legal/TermsBody.astro";
import { TERMS_UPDATED } from "../lib/legal.ts";
---

<LegalPage
  doc="terms"
  title="Terms of Service — Harvous"
  description="Terms for using Harvous, a Bible study notes app."
  heading="Terms of Service"
  updated={TERMS_UPDATED}
  summary="The short version: what you write is yours, use Harvous lawfully and kindly, and it's a tool for your study, not a substitute for your church or your own judgment."
>
  <TermsBody />
</LegalPage>
