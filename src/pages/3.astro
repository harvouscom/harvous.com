    color: var(--color-ink-faint);
  }
  .v3-ledger__label--now {
    color: var(--color-ink-soft);
  }
  /* --color-warm isn't remapped on the band; the chip uses the 10%-white card token. */
  .v3-ledger__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
