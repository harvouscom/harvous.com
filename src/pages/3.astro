    box-shadow: var(--accent-btn-shadow-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .v3-card__arrow::before { transform: none; transition: opacity 120ms ease; }
    .v3-card:hover .v3-card__arrow::before { transform: none; }
  }
  .v3-card__steps {
    list-style: none;
