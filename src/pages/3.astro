    border-top: 1px solid var(--color-rule);
    max-width: 44rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  /* ---------- Why: letter + essays ---------- */
  .v3-why__head {
    max-width: 38rem;
  }
  .v3-why__lead {
    margin-top: 1rem;
    max-width: 32rem;
  }
  .v3-why__letter {
