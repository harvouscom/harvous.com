  .v3-map__icon :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .v3-map__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }
  /* The strike used --color-rule, which is invisible against ink at 18%. */
  .v3-map__before {
    font-size: 0.9rem;
    color: var(--color-ink-faint);
    text-decoration: line-through;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
