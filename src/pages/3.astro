  }

  /* --color-accent isn't remapped on the band and is ~3.8:1 on ink. Links
     take the white-with-rule-underline recipe instead. */
  .v3-changed__more a,
  .v3-map__links a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 4px;
  }
  .v3-changed__more a:hover,
  .v3-map__links a:hover {
    text-decoration-color: currentColor;
