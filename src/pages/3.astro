    .v3-map__item {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.4rem 1.25rem;
      padding-block: 1.75rem;
    }
    .v3-map__body {
      grid-column: 2;
    }
  }
  @media (min-width: 1100px) {
    /* Room for three: icon | head | body. */
    .v3-map__item {
      grid-template-columns: 2rem minmax(0, 1.05fr) minmax(0, 1.4fr);
      gap: 1rem 1.5rem;
      align-items: start;
    }
    .v3-map__body {
      grid-column: auto;
    }
