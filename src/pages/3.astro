  /* ---------- Arrival ----------
     A release page should feel like it's being presented, so everything on it
     arrives with more deliberation than the site default: longer, further,
     headings sharpening from a blur, surfaces settling from a hair larger. All
     of it rides the site's own IntersectionObserver reveal and native scroll —
     nothing here pins, snaps, or drives the scroll position. Gated on the user
     not asking for reduced motion; under that preference the global rules
     make every reveal instant and these never apply. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-reveal] {
      transform: translateY(28px);
      transition-duration: 1000ms;
    }
    :global(html.js) [data-reveal="scale"] {
      transform: translateY(24px) scale(0.985);
      transition-duration: 1100ms;
    }
    :global(html.js) [data-reveal].revealed {
      transform: none;
    }
    :global(html.js) [data-reveal="stagger"] > * {
      transform: translateY(24px);
      transition-duration: 900ms;
    }
    :global(html.js) [data-reveal="stagger"].revealed > * {
      transform: none;
    }
    /* Headings: soft, then sharp. */
    :global(html.js) .v3-arrive[data-reveal] {
      filter: blur(10px);
      transition:
        opacity 1000ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 1000ms cubic-bezier(0.22, 1, 0.36, 1),
        filter 1000ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: var(--reveal-delay, 0ms);
    }
    :global(html.js) .v3-arrive[data-reveal].revealed {
      filter: blur(0);
    }
    /* The ruled paper emerges after the page opens on clean white. */
    .v3-hero__grid {
      animation: v3-grid-in 1800ms ease-out 200ms both;
    }
  }
</style>

<script>
  import { bindCarouselFit } from "../lib/carousel-fit.ts";

  document.querySelectorAll<HTMLElement>(".v3-new").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".v3-new__track");
    if (!track) return;
    bindCarouselFit({
      track,
      slideSelector: ".v3-new__slide",
      prevBtn: root.querySelector<HTMLButtonElement>('.v3-new__arrow[data-dir="prev"]'),
      nextBtn: root.querySelector<HTMLButtonElement>('.v3-new__arrow[data-dir="next"]'),
    });
  });
</script>
