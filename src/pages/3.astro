  .v3-map {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .v3-map__item {
    display: grid;
    gap: 0.7rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }
