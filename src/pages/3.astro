---
/**
 * /3/ — the Harvous 3 release page.
 *
 * Written for people who already use Harvous 2, in three bands: what's new,
 * what changed, and why. Each band takes a different shape on purpose — a
 * gradient-numeral hero with a three-line TL;DR, a bleeding scroll-snap slider
 * of the new things (the use-cases preview's pattern), an inverted ink band
 * with a sticky intro beside the migration rows, and a left-stacked head over
 * the founder letter — so the page reads as a sequence, not a template.
 *
 * Section / SectionHeader / Row are the site's layout primitives; this is the
 * first page to render them.
 *
 * Draft-gated via src/lib/draft-pages.ts until launch — that one array controls
 * noindex, the banner, the sitemap, the production strip, and the two links
 * pointing here (footer + homepage tour).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import Row from "../components/layout/Row.astro";
import AppTourChapter from "../components/AppTourChapter.astro";
import CTAButton from "../components/CTAButton.astro";
import FounderLetter from "../components/FounderLetter.astro";
import BlogCard from "../components/BlogCard.astro";
import PageClosingCTA from "../components/PageClosingCTA.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { getTourChapter } from "../lib/app-tour-chapters.ts";
import { getFeatureCategoryBySlug } from "../lib/feature-categories-data.ts";
import { getAddonBySlug, getAddonDetailHref } from "../lib/addons-data.ts";
import { blogReadingMinutes, isBlogPostListed } from "../lib/blog.ts";
import { isDraftPageSlug } from "../lib/draft-pages.ts";
import { fathomSignup } from "../lib/fathom-events.ts";

const PAGE_SLUG = "3";
const isDraft = isDraftPageSlug(PAGE_SLUG);
const site = "https://harvous.com";
const APP_URL = "https://app.harvous.com/";

/*
  The slider reuses the homepage's cards. Activity is the release's headline;
  the Library rides last because search existed in 2.0 — what's new is that it
  is a spotlight summoned over the note, not a column. Both are rendered at
  the half size: the wide variant's four-column tiles and larger title are
  sized for a card spanning the page, not a slide.
*/
const activity = getTourChapter("activity");
const find = getTourChapter("find");
const activityCategory = getFeatureCategoryBySlug("activity");
const findCategory = getFeatureCategoryBySlug("find");
const activitySlide = activity ? { ...activity, size: "half" as const } : undefined;

const review = getAddonBySlug("review");
const reviewHref = getAddonDetailHref("review") ?? "/add-ons/review/";
const reviewSteps = [
  "A short question comes from a note, highlight, or verse you already saved — never one invented about the text.",
  "You write what you remember first. The source appears after.",
  "You say how it went — held it, mostly had it, or needed the reminder. That decides when it comes back.",
];

/*
  Hand-picked rather than scored: these three are the release's argument, in the
  order it should be read. In production the drafts are excluded, so this is
  empty until they publish — the essays block hides itself, and the rest-days
  link below falls back to the category page instead of a 404.
*/
const SERIES = [
  "study-you-can-follow-and-return-to",
  "the-sidebar-did-too-much",
  "a-rest-day-belongs-in-the-record",
];
const listedPosts = (await getCollection("blog")).filter((p) => isBlogPostListed(p));
const byId = new Map(listedPosts.map((p) => [p.id, p]));
const series = SERIES.map((id) => byId.get(id)).filter(
  (p): p is NonNullable<typeof p> => p !== undefined
);
const [featuredEssay, ...restEssays] = series;

const restDayEssay = byId.get("a-rest-day-belongs-in-the-record");
const restHref = restDayEssay ? `/blog/${restDayEssay.id}` : "/features/activity/";
const restLabel = restDayEssay ? "Read why" : "More about Activity";

/*
  Where each of the sidebar's jobs went, plus the rename. Links point at the
  category pages rather than /features/sidebar-modes/, whose slug predates this
  release. Review is an addition, not a move, so it lives in What's new.
*/
const movedRows = [
  {
    icon: "fa7-solid:layer-group",
    before: "The sidebar",
    after: "Activity and the Library",
    body: "Its four jobs got homes that fit them. Your study history became Activity, a view with room to show a week. Finding things became the Library — a spotlight you summon over the note you're already in.",
    links: [
      { label: "Activity", href: "/features/activity/" },
      { label: "Find", href: "/features/find/" },
    ],
  },
  {
    icon: "fa7-solid:lightbulb",
    before: "Recall",
    after: "Suggestions",
    body: "The same job under a truer name: some of these bring back a fading note, and some propose something new to make from what you already saved. Links to the old name still land in the right place.",
    links: [{ label: "Suggestions", href: "/features/suggestions/" }],
  },
  {
    icon: "fa7-solid:calendar-day",
    before: "Streaks",
    after: "Rest days in the record",
    body: "A day you rested still gets its sheet, and the sheet says so plainly. Keeping the quiet stretches next to the heavy ones is what lets a few months show you the real shape of your study.",
    links: [{ label: restLabel, href: restHref }],
  },
];

const pageUrl = `${site}/3/`;
const pageDescription =
  "What changed in Harvous 3, for people who already use it: Activity, the Library, Suggestions, Review — and why the sidebar went.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Harvous 3",
      description: pageDescription,
      url: pageUrl,
      isPartOf: { "@type": "WebSite", name: "Harvous", url: site },
      about: {
        "@type": "SoftwareApplication",
        name: "Harvous",
        softwareVersion: "3.0",
        applicationCategory: "ProductivityApplication",
        operatingSystem: "Web",
        url: site,
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Harvous", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Harvous 3", item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title="Harvous 3 — study you can follow and return to"
  description={pageDescription}
  ogImage="/images/3/og.webp"
  noindex={isDraft}
  jsonLd={jsonLd}
>
  {
    isDraft && (
      <div class="draft-page-banner" role="status">
        Draft — not indexed or deployed. Remove <code>"3"</code> from DRAFT_PAGE_SLUGS to publish.
      </div>
    )
  }

  <!--
    Hero. The numeral is set in the app's rounded display cut (ROND 100) and
    filled with the site's accent gradient — the same one the primary button
    wears — so it reads as Harvous without a wordmark above it. It's decorative;
    the h1 is the line beneath it. The square grid behind is the ground
    /release-notes/ sits on, masked so it fades before the frame rails.
  -->
  <section class="v3-hero">
    <div class="release-notes-frame__grid v3-hero__grid" aria-hidden="true"></div>
    <Container size="xl">
      <div class="v3-hero__inner">
        <span class="v3-hero__numeral" aria-hidden="true">3</span>
        <h1 class="v3-hero__lead" data-reveal style="--reveal-delay: 160ms;">
          Harvous 3 is here.
        </h1>
        <!--
          Names only what 3.0 added. Suggestions and the Library were both in
          2.0 (as Recall and the sidebar's search), so they don't get billed as new here.
        -->
        <p class="v3-hero__sub lead" data-reveal style="--reveal-delay: 220ms;">
          The sidebar is gone. <strong>Activity</strong> opens on what you've already
          studied, rest days stay in the record, and <strong>Review</strong> turns your notes
          into practice — <mark>all of it right where you left it</mark>.
        </p>
        <div class="v3-hero__cta" data-reveal style="--reveal-delay: 300ms;">
          <CTAButton href="#whats-new" size="lg">
            See what's new
            <svg class="v3-hero__cta-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6l5 5 5-5" /></svg>
          </CTAButton>
        </div>
      </div>
    </Container>
  </section>

  <!--
    What's new, as the use-cases preview's slider: a left-aligned head with the
    arrows pushed right, then a scroll-snap row that bleeds past the framed
    column so the next card peeks in. The head lives inside the Container; the
    track sits beside it so it can run to the frame rails.
  -->
  <Section id="whats-new" tone="paper" space="md" class="frame-divider v3-new">
    <Container size="xl">
      <div class="v3-new__head" data-reveal>
        <div class="v3-new__head-text">
          <h2 class="section-title">What's new</h2>
          <p class="lead">
            Activity is a view now, with room to show a week. Review is here for Harvous Plus.
            A rest day keeps its place in the record. And finding things is a spotlight you
            summon, not a column that never leaves.
          </p>
        </div>
        <div class="v3-new__controls">
          <button type="button" class="v3-new__arrow" data-dir="prev" aria-label="Previous" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
          </button>
          <button type="button" class="v3-new__arrow" data-dir="next" aria-label="Next">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
          </button>
        </div>
      </div>
    </Container>

    <div class="v3-new__track-wrap carousel-track-wrap" data-reveal style="--reveal-delay: 80ms;">
      <ul class="v3-new__track" role="list" aria-label="New in Harvous 3" tabindex="0">
        {
          activitySlide && activityCategory && (
            <li class="v3-new__slide carousel-slide">
              <AppTourChapter chapter={activitySlide} category={activityCategory} loading="eager" />
            </li>
          )
        }
        {
          review && (
            <li class="v3-new__slide carousel-slide">
              <article class="v3-card" style={`--cat-ink: ${review.ink};`}>
                <a class="v3-card__link" href={reviewHref} aria-label="More about Review"></a>
                <div class="v3-card__head">
                  <div>
                    <p class="v3-card__eyebrow">
                      <span class="v3-card__eyebrow-icon"><Icon name={review.icon} /></span>
                      Review <span class="v3-card__plan">· Harvous Plus</span>
                    </p>
                    <h3 class="v3-card__title">{review.heroTitle}</h3>
                  </div>
                  <span class="v3-card__arrow" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                  </span>
                </div>
                <ol class="v3-card__steps">
                  {reviewSteps.map((step, i) => (
                    <li>
                      <span class="v3-card__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                      <p>{step}</p>
                    </li>
                  ))}
                </ol>
              </article>
            </li>
          )
        }
        <li class="v3-new__slide carousel-slide">
          <article class="v3-card" style="--cat-ink: var(--pill-note);">
            <a class="v3-card__link" href={restHref} aria-label={restLabel}></a>
            <div class="v3-card__head">
              <div>
                <p class="v3-card__eyebrow">
                  <span class="v3-card__eyebrow-icon"><Icon name="fa7-solid:calendar-day" /></span>
                  Activity
                </p>
                <h3 class="v3-card__title">A rest day belongs in the record.</h3>
              </div>
              <span class="v3-card__arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
              </span>
            </div>
            <p class="v3-card__body">
              A day you rested still gets its sheet, and the sheet says so plainly. Keeping the
              quiet stretches next to the heavy ones is what lets a few months show you the real
              shape of your study — where the weight actually was.
            </p>
          </article>
        </li>
        {
          find && findCategory && (
            <li class="v3-new__slide carousel-slide">
              <AppTourChapter chapter={find} category={findCategory} />
            </li>
          )
        }
      </ul>
    </div>
  </Section>

  <!--
    The one inverted band. Section's .section--invert remaps the ink tokens so
    the title, lead, row headings and hairlines adapt on their own; the handful
    of things it doesn't remap (icon chips, links, the strike) are restyled in
    the page CSS. No frame-divider here — the band's own edge is the seam, and
    .color-band suppresses the next section's hairline.
  -->
  <Section id="what-changed" tone="ink" space="lg">
    <Container size="xl">
      <Row ratio="5-7" align="start" gap="lg">
        <div class="v3-changed__intro">
          <h2 class="section-title">What changed</h2>
          <p class="lead v3-changed__lead">
            Everything you wrote is where you left it. These are the parts that moved, and where
            each one went.
          </p>
          <p class="v3-changed__foot">
            Notes, highlights, threads, and folders are exactly where they were — nothing to move
            or re-file.
          </p>
          <p class="v3-changed__more">
            <a href="/release-notes/">Every fix and improvement in the release notes →</a>
          </p>
        </div>

        <ul class="v3-map" role="list" data-reveal="stagger">
          {
            movedRows.map((row) => (
              <li class="v3-map__item">
                <span class="v3-map__icon" aria-hidden="true">
                  <Icon name={row.icon} />
                </span>
                <div class="v3-map__head">
                  <span class="v3-map__before">{row.before}</span>
                  <span class="v3-map__arrow" aria-hidden="true">→</span>
                  <h3 class="v3-map__after">{row.after}</h3>
                </div>
                <div class="v3-map__body">
                  <p>{row.body}</p>
                  <p class="v3-map__links">
                    {row.links.map((l) => (
                      <a href={l.href}>{l.label}</a>
                    ))}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </Row>
    </Container>
  </Section>

  <Section id="why" tone="paper" space="md" class="frame-divider">
    <Container size="xl">
      <div class="v3-why__head" data-reveal>
        <h2 class="section-title">Why the change</h2>
        <p class="lead v3-why__lead">
          From Derek, on what the sidebar was costing and what a record owes you.
        </p>
      </div>

      <div class="v3-why__letter">
        <FounderLetter variant="full">
          <Fragment slot="left">
            <p>Hey there,</p>
            <p>
              You know how the sidebar was always there? It gave your recent study, the things
              worth revisiting, every organised view, and search the same narrow column —
              about 260 pixels, holding a quarter of your window open all day.
            </p>
            <p>
              Each of those is a fair thing to want. Together they meant everything got a
              glimpse, whether a glimpse was the right amount or not. So I asked a different
              question: what is each of these worth in screen? Seeing what you have studied
              wanted the whole thing, so it became Activity. Finding a note from months ago
              wanted none of it until the moment you ask, so it became the Library you summon.
            </p>
            <p>
              While I was in there I settled something else. The days you rest stay in the
              record. A month that hides them would look better and tell you less.
            </p>
          </Fragment>
          <Fragment slot="right">
            <p>
              Recall became Suggestions, because the name only covered half of what it does —
              some bring a fading note back, and some propose something to make from what you
              already have. And Review is here for the people who wrote to me asking how to
              hold on to what they found. You answer from memory and say how it went yourself.
              I left the scoring out on purpose.
            </p>
            <p>
              What this means for you is smaller than it sounds: your notes, highlights,
              threads, and folders are exactly where they were. Nothing to move or re-file.
              Harvous simply opens on your study now instead of a blank page.
            </p>
            <p>
              If something is off, write me at{" "}
              <a
                class="underline decoration-[var(--color-rule)] underline-offset-4 hover:decoration-[var(--color-ink)]"
                href="mailto:derek@harvous.com"
              >
                derek@harvous.com
              </a>{" "}
              and tell me what you were trying to do.
            </p>
          </Fragment>
        </FounderLetter>
      </div>

      {
        featuredEssay && (
          <div class="v3-why__essays" data-reveal style="--reveal-delay: 40ms;">
            <p class="eyebrow v3-why__label">The long version — three essays, in the order to read them</p>
            <BlogCard
              title={featuredEssay.data.title}
              description={featuredEssay.data.description}
              publishDate={featuredEssay.data.publishDate}
              category={featuredEssay.data.category}
              slug={featuredEssay.id}
              readingTime={blogReadingMinutes(featuredEssay.body)}
              draft={featuredEssay.data.draft}
              variant="featured"
            />
            {restEssays.length > 0 && (
              <div class="v3-why__pair">
                <Row cols={2} align="start" gap="lg">
                  {restEssays.map((p) => (
                    <div>
                      <BlogCard
                        title={p.data.title}
                        description={p.data.description}
                        publishDate={p.data.publishDate}
                        category={p.data.category}
                        slug={p.id}
                        readingTime={blogReadingMinutes(p.body)}
                        draft={p.data.draft}
                        variant="story"
                      />
                    </div>
                  ))}
                </Row>
              </div>
            )}
            <p class="v3-why__more">
              <a href="/blog/how-we-think" class="btn-pill inline-flex items-center gap-1.5">
                More from How we think
              </a>
            </p>
          </div>
        )
      }
    </Container>
  </Section>

  <PageClosingCTA
    heading="Open Harvous 3."
    lead="Your notes, highlights, and threads are already there — filed, and waiting in Activity."
    href={APP_URL}
    label="Open Harvous"
    fathomTrack={fathomSignup.v3}
    secondaryHref="/"
    secondaryLabel="New here? See what Harvous is"
  />
</BaseLayout>

<style>
  /*
    Section / Row / SectionHeader don't spread ...rest, so page-scope attributes
    never reach their root elements. Root-level rules on them go through :global.
  */
  :global(#whats-new),
  :global(#what-changed),
  :global(#why) {
    /* The header is sticky (~57px, a floating pill when scrolled) and the site
       sets no scroll-margin, so hash targets would land underneath it. */
    scroll-margin-top: 5rem;
  }
  :global(#why) {
    /* The founder letter's paper fan is clipped at the band, not the 64rem wrapper. */
    overflow-x: clip;
  }
  :global(#whats-new) {
    /* The slider bleeds to the frame rails; nothing past them may widen the page. */
    overflow-x: hidden;
  }

  /* ---------- Hero ---------- */
  .v3-hero {
    position: relative;
  }
  .v3-hero__grid {
    /* Dissolve toward the edges so it reads as ruled paper under the numeral,
       not wallpaper. The ::before inside paints the squares (global.css). */
    mask-image: radial-gradient(70% 80% at 50% 42%, #000 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(70% 80% at 50% 42%, #000 20%, transparent 100%);
  }
  .v3-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .v3-hero__numeral {
    /* inline-block so the gradient box hugs the glyph instead of spanning the row. */
    display: inline-block;
    font-family: var(--font-display);
    /* 160px at 375, 30vw between, 336px from 1120 up. The largest type on the
       site today is /blog's 72px; .display-xl caps at 4.5rem. */
    font-size: clamp(10rem, 30vw, 21rem);
    font-weight: 700;
    /* The app's display cut (prototype-tokens.css: --pds-font-display-variation). */
    font-variation-settings: "ROND" 100, "wdth" 100;
    font-optical-sizing: auto;
    line-height: 0.82; /* a digit has no descender; crop the line box */
    letter-spacing: 0; /* one glyph — trailing tracking would skew centering */
    /* The primary button's gradient, as a text fill. Cropped to the glyph via
       background-clip; the transparent fill lets the gradient show through. */
    background: var(--accent-btn-bg);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: v3-numeral-in 1100ms cubic-bezier(0.22, 1, 0.36, 1) 80ms both;
  }
  /* Entrance: fades and settles in, and rounds from the site cut into the app's.
     font-variation-settings interpolates when both keyframes list the same axes
     in the same order. */
  @keyframes v3-numeral-in {
    from {
      opacity: 0;
      transform: translateY(0.05em) scale(0.94);
      font-variation-settings: "ROND" 0, "wdth" 100;
    }
    55% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
      font-variation-settings: "ROND" 100, "wdth" 100;
    }
  }
  .v3-hero__lead {
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  /* The TL;DR — the homepage tour lead's shape: bolded names, a highlight to close,
     three lines at most (verified with the Range API, not scrollHeight). */
  .v3-hero__sub {
    margin: 0.9rem auto 0;
    max-width: 36rem;
  }
  .v3-hero__sub strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* The cue is the primary button — the same gradient the numeral wears. */
  .v3-hero__cta {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }
  .v3-hero__cta-icon {
    width: 0.85rem;
    height: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .v3-hero__numeral { animation: none; }
  }

  /* ---------- What's new: the slider ---------- */
  /* Head: text left, arrows right, bottom-aligned — the use-cases preview's recipe. */
  .v3-new__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }
  .v3-new__head-text {
    max-width: 34rem;
  }
  .v3-new__head-text > * + * {
    margin-top: 0.85rem;
  }
  .v3-new__controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }
  .v3-new__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease, opacity 150ms ease;
  }
  .v3-new__arrow svg {
    width: 0.8rem;
    height: 0.8rem;
  }
  .v3-new__arrow:hover:not(:disabled) {
    color: var(--color-ink);
    background: var(--color-warm);
  }
  .v3-new__arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Track: bleeds past the framed column to the frame rails; the first slide
     lines up with the contained head. These cards are the homepage tour's, whose
     mobile slider gives them up to 30rem, so this row shows ~2.5 at a time rather
     than the site default of 3.5 — four columns of tiles need the width. */
  .v3-new__track-wrap {
