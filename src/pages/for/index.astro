---
/**
 * /for/ — who Harvous is for, in the /next chrome. The same groups as the
 * live /for/ hub (each use case, then the people it fits), as one compact
 * column: a group heading, then a light row per audience (its sky as a small
 * tile, its name and line), groups separated by a rule, with the sticky
 * section nav to jump
 * between them. Cards open /for/<slug>/. All copy is from
 * lib/for-audiences-data.ts and lib/use-cases-data.ts.
 */
import NextLayout from "../../layouts/NextLayout.astro";
import { Icon } from "astro-icon/components";
import SectionNav from "../../components/next/SectionNav.astro";
import ClosingCall from "../../components/next/ClosingCall.astro";
import { getAudiencesGroupedByUseCase } from "../../lib/for-audiences-data.ts";
import { getUseCaseDisplayTitle } from "../../lib/use-cases-data.ts";

const groups = getAudiencesGroupedByUseCase();
const nextHref = (slug: string) => `/for/${slug}/`;

---

<NextLayout
  title="Who Harvous is for — Harvous"
  description="Harvous is for daily readers, Bible app users, Sunday note-takers, seminary students, pastors, teachers, people going through a book, theme-chasers, group leaders, churches, and anyone still finding their footing in Scripture."
>
  <header class="nx-wrap for-intro">
    <p class="nx-kicker">Who it's for</p>
    <h1 class="nx-display">For people who want to remember their study.</h1>
    <p class="nx-lead">
      Different rhythms, same problem: the thoughts fade, and there's nowhere for them to live.
      Find the one that sounds like you.
    </p>
  </header>

  {/* Narrow screens: one small pill that opens the list. Wide screens use
      the table of contents beside the list instead (below). */}
  <SectionNav
    compact
    class="for-snav"
    items={groups.map((g) => ({ href: `#${g.useCase.slug}` as `#${string}`, label: getUseCaseDisplayTitle(g.useCase) }))}
  />

  <div class="nx-wrap for-layout">
    <nav class="for-toc" aria-label="Kinds of study" data-for-toc>
      <p class="for-toc__label">Jump to</p>
      <ul role="list">
        {groups.map((g) => (
          <li>
            <a href={`#${g.useCase.slug}`} data-for-toc-link>{getUseCaseDisplayTitle(g.useCase)}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="for-col">

  {
    groups.map((group) => (
      <section id={group.useCase.slug} class="for-group" aria-labelledby={`${group.useCase.slug}-title`}>
        <div class="for-group__head">
          <h2 id={`${group.useCase.slug}-title`} class="for-group__title">
            {getUseCaseDisplayTitle(group.useCase)}
          </h2>
          <a class="for-group__more" href={group.useCase.href}>How it works →</a>
        </div>
        <p class="for-group__line">{group.useCase.tagline}</p>
        <ul class="for-list" role="list">
          {group.audiences.map((a) => (
            <li>
              <a class="for-row" href={nextHref(a.slug)} style={`--ink: ${a.ink};`}>
                <span class="for-row__tile" aria-hidden="true">
                  <img src={a.image} alt="" width="96" height="96" loading="lazy" decoding="async" />
                  <span class="for-row__icon"><Icon name={a.icon} /></span>
                </span>
                <span class="for-row__text">
                  <span class="for-row__name">
                    {a.title}
                    {(a.statusLine || a.comingSoon) && (
                      <span class="for-row__status">{a.statusLine ?? a.comingSoonLine ?? "Coming soon"}</span>
                    )}
                  </span>
                  <span class="for-row__line">{a.tagline}</span>
                </span>
                <svg class="for-row__chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
    </div>
  </div>

  <p class="nx-wrap for-also">
    Looking for a kind of study instead? <a class="nx-link" href="/use-cases/">See the use cases →</a>
  </p>

  <ClosingCall title="Start with the way you already study." />
</NextLayout>

<style>
  .for-intro {
    padding-top: clamp(8rem, 16vw, 11rem);
    text-align: center;
  }
  .for-intro .nx-display { margin: 1rem auto 0; }
  .for-intro .nx-lead { margin: 1.5rem auto 0; }

  /* One continuous column: groups one after another, split by a rule. */
  /* Wide: a sticky table of contents beside the one column of groups. */
  .for-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    max-width: calc(62rem + 2 * var(--nx-gutter));
    margin-top: clamp(1rem, 3vw, 2rem);
  }
  .for-toc { display: none; }
  @media (min-width: 60rem) {
    .for-layout { grid-template-columns: 11rem minmax(0, 1fr); margin-top: clamp(3rem, 6vw, 4.5rem); }
    .for-toc { display: block; align-self: start; position: sticky; top: 6.5rem; }
    .for-layout :global(.snav) { display: none; }
    :global(.for-snav) { display: none !important; }
  }
  .for-toc__label {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .for-toc ul { display: grid; gap: 0.1rem; margin: 0; padding: 0; list-style: none; }
  .for-toc a {
    display: block;
    padding: 0.4rem 0.7rem;
    margin-left: -0.7rem;
    border-radius: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .for-toc a:hover { color: var(--color-ink); background: var(--color-warm); }
  /* The group you're in: ink, like every selected state in /next. */
  .for-toc a[aria-current="true"] { color: #fff; background: var(--color-ink); }

  .for-group { scroll-margin-top: 7.5rem; }
  .for-group + .for-group { margin-top: 2.75rem; }
  .for-group + .for-group .for-group__head {
    padding-top: 2.75rem;
    border-top: 1px solid var(--color-rule);
  }
  .for-group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .for-group__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .for-group__more {
    flex-shrink: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
  }
  .for-group__more:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .for-group__line { margin: 0.35rem 0 0; color: var(--color-ink-soft); text-wrap: pretty; }

  .for-list { margin: 1rem 0 0; padding: 0; list-style: none; }
  .for-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-inline: -0.75rem;
    padding: 0.7rem 0.75rem;
    border-radius: 1rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .for-row:hover { background: var(--color-warm); }
  .for-row:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }

  /* The audience's sky, as a small tile with its mark on it. */
  .for-row__tile {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    border-radius: 0.85rem;
    box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.06);
  }
  .for-row__tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .for-row__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.5rem;
    background: var(--color-paper);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.1);
  }
  .for-row__icon :global(svg) { width: 0.8rem; height: 0.8rem; }

  .for-row__text { display: flex; flex: 1; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .for-row__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .for-row__status {
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    background: var(--color-warm);
  }
  .for-row__line { font-size: 0.9375rem; line-height: 1.45; color: var(--color-ink-soft); text-wrap: pretty; }
  .for-row__chev {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: var(--color-ink-faint);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms ease, stroke 200ms ease;
  }
  .for-row:hover .for-row__chev { transform: translateX(2px); stroke: var(--color-ink); }

  .for-also {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    text-align: center;
    color: var(--color-ink-soft);
  }
</style>

<script>
  /* The table of contents marks the group you're in: the last one whose top
     has passed a line a third of the way down the screen. */
  const toc = document.querySelector<HTMLElement>("[data-for-toc]");
  if (toc) {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("[data-for-toc-link]"));
    const sections = links
      .map((a) => document.getElementById(a.hash.slice(1)))
      .filter((el): el is HTMLElement => Boolean(el));
    const update = () => {
      const line = window.innerHeight / 3;
      let current = sections[0]?.id ?? null;
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
      links.forEach((a) => a.setAttribute("aria-current", a.hash.slice(1) === current ? "true" : "false"));
    };
    let queued = false;
    window.addEventListener("scroll", () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    }, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>
