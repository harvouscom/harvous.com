---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import PageIntro from "../components/PageIntro.astro";
import PricingPlanCard from "../components/PricingPlanCard.astro";
import { FREE_PLAN, PLUS_PLAN } from "../lib/pricing-data.ts";
import "../styles/pricing.css";

const pricingHeroImage = "/images/auth-hero/ai_bg_072.webp";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Harvous Pricing",
      description:
        "Harvous is free for personal Bible study. Harvous Plus unlocks Shared Spaces hosting — Founding $45/yr for the first 99, then $8/mo or $64/yr.",
      url: "https://harvous.com/pricing/",
      isPartOf: { "@type": "WebSite", name: "Harvous", url: "https://harvous.com" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Harvous", item: "https://harvous.com/" },
        { "@type": "ListItem", position: 2, name: "Pricing", item: "https://harvous.com/pricing/" },
      ],
    },
    {
      "@type": "SoftwareApplication",
      name: "Harvous",
      applicationCategory: "ProductivityApplication",
      operatingSystem: "Web",
      offers: [
        {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
          description: "Free tier — unlimited notes and core Bible study features",
        },
        {
          "@type": "Offer",
          name: "Harvous Plus",
          price: "45",
          priceCurrency: "USD",
          description:
            "Harvous Plus founding price ($45/yr for the first 99) — unlimited shared spaces, up to 100 people per space. Then $8/mo or $64/yr. Joining is always free.",
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Pricing — Harvous"
  description="Harvous is free for personal Bible study. Harvous Plus unlocks Shared Spaces hosting — Founding $45/yr for the first 99, then $8/mo or $64/yr. Joining a space is always free."
  ogImage="/images/pricing/og.webp"
  jsonLd={jsonLd}
>
  <section class="pricing-hero" style={`--pricing-hero-image: url('${pricingHeroImage}');`}>
    <div class="pricing-hero__backdrop" aria-hidden="true"></div>
    <div class="pricing-hero__inner">
      <PageIntro>
        <h1 class="section-title text-pretty">Pricing on your terms</h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--color-ink-soft)]">
          Free for personal study. Harvous Plus when you're ready to host a shared space.
        </p>
      </PageIntro>
    </div>
  </section>

  <section class="pricing-page">
    <Container>
      <div class="pricing-page__inner" data-reveal style="--reveal-delay: 80ms;">
        <div class="pricing-grid">
          <PricingPlanCard plan={FREE_PLAN} />
          <PricingPlanCard plan={PLUS_PLAN} />
        </div>

        <div class="pricing-page__note">
          <p>
            Questions about billing?
            <a href="mailto:derek@harvous.com">Email derek@harvous.com</a>.
          </p>
          <p>
            Interested in church plans?
            <a href="/for/churches/#interest">Tell us about your church</a>.
          </p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
