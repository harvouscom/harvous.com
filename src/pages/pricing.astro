---
/**
 * /pricing/ — two plans and the FAQ, in the new chrome. Plans come from
 * lib/pricing-data.ts, the same source as the live /pricing/, so a price
 * change lands on both. The FAQ moved here from the home page.
 */
import { Icon } from "astro-icon/components";
import NextLayout from "../layouts/NextLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import ComparePreview from "../components/next/ComparePreview.astro";
import { FREE_PLAN, PLUS_PLAN, PRICING_ROADMAP, type PricingPlan } from "../lib/pricing-data.ts";
import { backdropSrc } from "../lib/next/content.ts";

const plans: (PricingPlan & { sky?: string })[] = [FREE_PLAN, { ...PLUS_PLAN, sky: backdropSrc("077") }];
---

<NextLayout
  title="Pricing — Harvous"
  description="Harvous is free for personal Bible study. Harvous Plus adds unlimited history, Review exercises, and hosting Shared Spaces — $6/mo or $36/yr."
>
  <header class="nx-wrap price-intro">
    <p class="nx-kicker">Pricing</p>
    <h1 class="nx-display">Free to study.<br />Plus to keep going.</h1>
    <p class="nx-lead">
      Free for personal study. Plus is for study you keep coming back to, or share with a group.
    </p>
  </header>

  <section class="nx-wrap price-plans" aria-label="Plans">
    {plans.map((plan) => (
      <article class:list={["plan", plan.id === "plus" && "plan--plus"]} data-reveal>
        {plan.sky && <img class="plan__sky" src={plan.sky} alt="" loading="lazy" />}
        <header class="plan__head">
          <p class="plan__name">
            <span class="plan__icon" aria-hidden="true"><Icon name={plan.icon} /></span>
            {plan.name}
          </p>
          <p class="plan__price">
            {plan.priceDisplay}
            {plan.priceDisplaySecondary && <span> or {plan.priceDisplaySecondary}</span>}
          </p>
          <p class="plan__tag">{plan.tagline}</p>
        </header>
        <ul class="plan__list">
          {plan.features.map((f) => (
            <li><Icon name="fa7-solid:check" aria-hidden="true" /> {f}</li>
          ))}
        </ul>
        <a
          class:list={["nx-btn", plan.id === "plus" ? "nx-btn--accent" : "nx-btn--ghost", "plan__cta"]}
          href={plan.cta.href}
          data-fathom-track={plan.cta.fathomTrack}
        >
          {plan.cta.label}
        </a>
        {plan.finePrint && <p class="plan__fine">{plan.finePrint}</p>}
      </article>
    ))}
  </section>

  {/* What's beyond the two plans: churches (live, by invitation) and the roadmap. */}
  <section class="nx-wrap price-extra" aria-label="Beyond the plans">
    <ul class="extra">
      <li class="extra__item">
        <span class="extra__icon" aria-hidden="true"><Icon name="fa7-solid:church" /></span>
        <div>
          <p class="extra__name">Churches <span class="extra__chip">Invite-only</span></p>
          <p class="extra__body">Plans for a whole congregation. <a class="nx-link" href="/for/churches/">Read the plan →</a></p>
        </div>
      </li>
      {PRICING_ROADMAP.map((item) => (
        <li class="extra__item">
          <span class="extra__icon" aria-hidden="true"><Icon name={item.icon} /></span>
          <div>
            <p class="extra__name">{item.name} <span class="extra__chip">{item.soonLabel ?? "Coming later"}</span></p>
            <p class="extra__body">{item.tagline}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <div class="nx-wrap price-compare"><ComparePreview /></div>

  <FaqSection />
</NextLayout>

<style>
  .price-intro {
    padding-top: clamp(8rem, 16vw, 11rem);
    text-align: center;
  }
  .price-intro .nx-display { margin: 1rem auto 0; }
  .price-intro .nx-lead { max-width: 32rem; margin: 1.5rem auto 0; }

  .price-plans {
    display: grid;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 4.5rem);
    max-width: calc(58rem + 2 * var(--nx-gutter));
  }
  @media (min-width: 48rem) {
    .price-plans { grid-template-columns: 1fr 1fr; }
  }

  .plan {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--nx-radius-scene);
    background: var(--color-warm);
    overflow: hidden;
  }
  .plan__sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .plan--plus::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0.88) 45%);
  }
  .plan__name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-weight: 600;
    font-size: 1.0625rem;
  }
  .plan__icon {
    display: inline-flex;
    padding: 0.45rem;
    border-radius: 0.6rem;
    color: #fff;
    background: var(--color-ink);
  }
  .plan--plus .plan__icon { background: var(--accent-btn-bg); }
  .plan__icon :global(svg) { width: 0.9rem; height: 0.9rem; }
  .plan__price {
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .plan__price span { font-size: 0.4em; letter-spacing: -0.01em; color: var(--color-ink-soft); }
  .plan__tag { margin: 0.6rem 0 0; color: var(--color-ink-soft); }
  .plan__list {
    display: grid;
    gap: 0.6rem;
    margin: 1.75rem 0 2rem;
    padding: 0;
    list-style: none;
    flex: 1;
    align-content: start;
  }
  .plan__list li { display: flex; gap: 0.6rem; align-items: baseline; line-height: 1.45; }
  .plan__list :global(svg) { width: 0.8rem; height: 0.8rem; flex-shrink: 0; color: var(--color-accent); transform: translateY(0.1rem); }
  .plan__cta { width: 100%; }
  .plan__fine { margin: 0.75rem 0 0; font-size: 0.8125rem; color: var(--color-ink-faint); }

  .price-extra {
    margin-top: 1.25rem;
    margin-bottom: clamp(3rem, 8vw, 5rem);
    max-width: calc(58rem + 2 * var(--nx-gutter));
  }
  .extra {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .extra { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .extra__item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1.25rem 1.25rem 1.25rem 0;
  }
  @media (min-width: 48rem) {
    .extra__item + .extra__item { padding-left: 1.5rem; }
  }
  /* Hairlines between items: below on a phone, beside from tablet up. */
  .extra__item + .extra__item { border-top: 1px solid var(--color-rule); }
  @media (min-width: 48rem) {
    .extra__item + .extra__item { border-top: 0; border-left: 1px solid var(--color-rule); }
  }
  .extra__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.65rem;
    color: var(--color-ink-soft);
    background: var(--color-warm);
  }
  .extra__icon :global(svg) { width: 0.9rem; height: 0.9rem; }
  .extra__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin: 0.15rem 0 0;
    font-weight: 600;
    color: var(--color-ink);
  }
  .extra__chip {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    background: var(--color-warm);
  }
  .extra__body {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
</style>
