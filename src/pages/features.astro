---
/**
 * /features/ — the five categories Harvous is organised around.
 *
 * Was a draft listing all 13 feature MDX files as rows, stripped from the
 * production build. It is the hub now: five categories, each of which houses its
 * own feature pages. Un-drafting it also fixes a live bug — DownloadCTA on the
 * homepage links here, and the link 404'd for as long as the page was stripped.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import PageClosingCTA from "../components/PageClosingCTA.astro";
import ComparePreview from "../components/ComparePreview.astro";
import Container from "../components/layout/Container.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { fathomSignup } from "../lib/fathom-events.ts";
import { hasDetailContent } from "../lib/product-page-data.ts";
import { getFeatureCategories } from "../lib/feature-categories-data.ts";
import { getComingSoonGridItem } from "../lib/coming-soon-grid.ts";
import "../styles/use-cases.css";

const categories = getFeatureCategories();

const allFeatures = await getCollection("features");
const publishedSlugs = new Set(
  allFeatures.filter((f) => !f.data.draft && hasDetailContent(f.data)).map((f) => f.id)
);

/** Each category with the short names of what it houses, for the card's pill rail. */
type CategoryMember = { id: string; label: string; href?: string };

const cards = categories.map((category) => ({
  category,
  members: category.featureIds
    .map((id): CategoryMember | undefined => {
      const soon = getComingSoonGridItem(id);
      if (soon) return { id, label: soon.title, href: soon.href };
      const feature = allFeatures.find((f) => f.id === id);
      if (!feature) return undefined;
      return {
        id,
        label: feature.data.tagline,
        href: publishedSlugs.has(id) ? `/features/${id}/` : undefined,
      };
    })
    .filter((m): m is CategoryMember => m !== undefined),
}));

const site = "https://harvous.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Harvous Features",
      description:
        "The five things Harvous is for — seeing your study accumulate, reading, writing, finding what you saved, and sharing it with a group.",
      url: `${site}/features/`,
      isPartOf: { "@type": "WebSite", name: "Harvous", url: site },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Harvous", item: site },
        { "@type": "ListItem", position: 2, name: "Features", item: `${site}/features/` },
      ],
    },
    {
      "@type": "ItemList",
      itemListElement: categories.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.title,
        item: `${site}${c.href}`,
      })),
    },
  ],
};
---

<BaseLayout
  title="Features — everything Harvous does | Harvous"
  description="The five things Harvous is for: seeing your study accumulate, reading Scripture, writing what you find, getting back to it later, and sharing it with a group."
  jsonLd={jsonLd}
>
  <PageIntro>
    <span class="eyebrow-pill">Features</span>
    <h1 class="section-title mt-4">Everything Harvous does to keep your study.</h1>
    <p class="lead page-intro-lead mt-4 max-w-2xl mx-auto">
      Read Scripture, write what you find, get back to it months later, share it with your
      group — and open to the study you already did. <mark>Nothing you write goes missing.</mark>
    </p>
  </PageIntro>

  <section class="frame-divider">
    <Container size="lg">
      <ul class="cat-grid" data-reveal="stagger" role="list">
        {
          cards.map(({ category, members }) => (
            <li class="cat-card" style={`--cat-ink: ${category.ink};`}>
              {/*
                The card is not one stretched link: the member pills below are
                links of their own, and nesting anchors is invalid. Same split the
                use-cases hub uses — an anchor around the art and body, the pills
                outside it.
              */}
              <a class="cat-card__main" href={category.href}>
                <div class="cat-card__art" style={`--cat-art: url('${category.image}');`}>
                  <span class="cat-card__badge"><Icon name={category.icon} /></span>
                </div>
                <div class="cat-card__body">
                  <h2 class="cat-card__title">{category.title}</h2>
                  <p class="cat-card__tagline">{category.tagline}</p>
                  <span class="cat-card__cta">
                    Explore {category.title}
                    <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd"/>
                    </svg>
                  </span>
                </div>
              </a>

              {members.length > 0 && (
                <div class="cat-card__inside">
                  <p class="cat-card__inside-label">What's inside</p>
                  <ul class="cat-card__pills" role="list">
                    {members.map((m) => (
                      <li>
                        {m.href ? (
                          <a href={m.href} class="cat-card__pill">{m.label}</a>
                        ) : (
                          <span class="cat-card__pill cat-card__pill--flat">{m.label}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <ComparePreview
    eyebrow="Compare"
    title="See how Harvous compares"
    lead="Harvous is notes-first — built to remember what you saved, not replace your Bible reader."
    showAllLink
  />

  <PageClosingCTA
    heading="Start your study Bible today."
    lead="Everything here is on the free plan unless it says otherwise."
    fathomTrack={fathomSignup.features}
  />
</BaseLayout>

<style>
  /* A highlight split across a line break stops reading as one phrase. It is
     short enough that holding it together cannot overflow the measure. */
  .page-intro-lead mark { white-space: nowrap; }

  .cat-grid {
    list-style: none;
    margin: 0;
    /* Symmetric block padding — the grid had none at the bottom, so the last
       row of cards sat against the section's closing hairline. */
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    padding-inline: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  /* Two equal columns. Every card occupies one; the fifth simply starts a row. */
  @media (min-width: 720px) {
    .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /*
    The site's hub-card treatment, as used by /use-cases/: a white card with a
    hairline and a lifting shadow, art bleeding to its edges with the icon badge
    on it, and a tinted footer band behind a labelled pill rail. The previous
    version invented its own flat tinted card, which matched nothing else here.
  */
  .cat-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .cat-card:hover {
    box-shadow: var(--shadow-float);
    transform: translateY(-2px);
  }

  .cat-card__main {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .cat-card__main:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .cat-card__art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    min-height: 11rem;
    background-color: var(--color-warm);
    background-image: var(--cat-art);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .cat-card__art::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-paper) 10%, transparent) 0%,
      color-mix(in oklab, var(--color-ink) 6%, transparent) 100%
    );
  }
  .cat-card__badge {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    /*
      70% is as saturated as one ratio can go and still clear the 3:1 floor for
      meaningful graphics on all five: --pill-highlight lands at 3.11 there and
      2.75 at 75%. Raw, it is 1.53 — visible as a shape, not as a colour.
    */
    color: color-mix(in oklab, var(--cat-ink) 70%, var(--color-ink));
  }
  .cat-card__badge :global(svg) { width: 1.35rem; height: 1.35rem; }

  .cat-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem 1.5rem 1.25rem;
  }
  .cat-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .cat-card__main:hover .cat-card__title { color: var(--color-accent); }
  .cat-card__tagline {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }
  .cat-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .cat-card__inside {
    /* Fills whatever height a taller card in the row leaves over, so the tinted
       band runs to the bottom instead of stopping at its pills. */
    flex: 1 1 auto;
    padding: 1.1rem 1.35rem 1.35rem;
    border-top: 1px solid var(--color-rule);
    background: color-mix(in oklab, var(--color-warm) 55%, var(--color-card));
  }
  .cat-card__inside-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .cat-card__pills {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cat-card__pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }
  a.cat-card__pill:hover {
    border-color: color-mix(in srgb, var(--cat-ink) 35%, var(--color-rule));
    background: color-mix(in oklab, var(--cat-ink) 10%, var(--color-paper));
    color: color-mix(in oklab, var(--cat-ink) 70%, var(--color-ink));
  }
  .cat-card__pill--flat { color: var(--color-ink-soft); }
</style>
