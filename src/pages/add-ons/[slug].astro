---
import ProductDetailPage from "../../components/ProductDetailPage.astro";
import FamilyPage from "../../components/next/FamilyPage.astro";
import { getAddonPages } from "../../lib/addons-data.ts";

export function getStaticPaths() {
  return getAddonPages()
    .filter((a) => !a.draft)
    .map((a) => ({
      params: { slug: a.slug },
      props: { page: a },
    }));
}

const { page } = Astro.props;
---

{/* Family has its own layout, like child notebooks beside it. */}
{page.slug === "family" ? <FamilyPage page={page} /> : <ProductDetailPage page={page} />}
