---
/**
 * /blog/ — Bright Enough. The new-style intro, the library bar (topics +
 * search), the latest posts as cards (the newest one wide), then a short row
 * per topic with a way into its archive.
 */
import NextLayout from "../../layouts/NextLayout.astro";
import { ogCard } from "../../lib/og-card.ts";
import BlogNextCard from "../../components/next/BlogNextCard.astro";
import BlogLibraryNav from "../../components/BlogLibraryNav.astro";
import BlogTopicBlocks from "../../components/BlogTopicBlocks.astro";
import ClosingCall from "../../components/next/ClosingCall.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import {
  BLOG_CATEGORY_HUB_PREVIEW,
  BLOG_CATEGORY_LABELS,
  blogBreadcrumbJsonLd,
  blogCategoriesInUse,
  blogCategoryColor,
  blogCategoryHref,
  blogCategoryIcon,
  brightEnoughBlogJsonLd,
  includeBlogDrafts,
  isBlogPostListed,
  postsInBlogCategory,
} from "../../lib/blog";

const showDrafts = includeBlogDrafts();
const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => isBlogPostListed(p, showDrafts))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const latest = posts.slice(0, 5);

const topicSections = blogCategoriesInUse(posts).map((cat) => {
  const categoryPosts = postsInBlogCategory(posts, cat);
  return {
    id: `topic-${cat}`,
    category: cat,
    label: BLOG_CATEGORY_LABELS[cat],
    icon: blogCategoryIcon(cat),
    color: blogCategoryColor(cat),
    posts: categoryPosts,
    previewPosts: categoryPosts.slice(0, BLOG_CATEGORY_HUB_PREVIEW),
    href: blogCategoryHref(cat),
  };
});

const libraryTopics = topicSections.map((section) => ({
  category: section.category,
  label: section.label,
  href: section.href,
  icon: section.icon,
  color: section.color,
  count: section.posts.length,
}));

const siteOrigin = Astro.site ?? "https://harvous.com";
const hubDescription =
  "Bright Enough — notes, habits, and teaching that show up after Sunday. For teachers, group leaders, and anyone who keeps what they learn.";
const hubJsonLd = [
  brightEnoughBlogJsonLd(siteOrigin, {
    blogPost: posts.slice(0, 10).map((p) => ({
      "@type": "BlogPosting",
      headline: p.data.title,
      url: new URL(`/blog/${p.id}/`, siteOrigin).toString(),
      datePublished: p.data.publishDate.toISOString(),
      description: p.data.description,
    })),
  }),
  blogBreadcrumbJsonLd(
    [
      { name: "Harvous", path: "/" },
      { name: "Bright Enough", path: "/blog/" },
    ],
    siteOrigin,
  ),
];
---

<NextLayout
  ogImage={ogCard("blog")}
  title="Bright Enough — Harvous Blog"
  description={hubDescription}
  jsonLd={hubJsonLd}
>
  <header class="nx-wrap bl-intro">
    <BlogTopicBlocks />
    <p class="nx-kicker">The Harvous blog</p>
    <h1 class="nx-display">Bright Enough</h1>
    <p class="nx-lead">Notes, habits, and teaching that show up after Sunday.</p>
  </header>

  {posts.length === 0 ? (
    <section class="nx-wrap bl-empty">
      <p>Nothing here yet. Check back soon.</p>
    </section>
  ) : (
    <div class="blog-library-main" data-blog-library-main>
      <BlogLibraryNav topics={libraryTopics} />

      <section id="library-featured" class="nx-wrap bl-sec" aria-labelledby="library-featured-title">
        <h2 id="library-featured-title" class="bl-h2">Latest</h2>
        <ul class="bl-grid" role="list" data-reveal="stagger">
          {latest.map((post, i) => (
            <li class:list={[i === 0 && "is-wide"]}>
              <BlogNextCard post={post} />
            </li>
          ))}
        </ul>
      </section>

      {topicSections.map((section) => (
        <section id={section.id} class="nx-wrap bl-sec" aria-labelledby={`${section.id}-title`}>
          <div class="bl-head">
            <h2 id={`${section.id}-title`} class="bl-h2">
              <span
                class="bl-tile"
                style={`background: color-mix(in oklab, ${section.color.bg} 55%, var(--color-paper)); color: ${section.color.ink};`}
                aria-hidden="true"
              >
                <Icon name={section.icon} />
              </span>
              {section.label}
            </h2>
            {section.posts.length > BLOG_CATEGORY_HUB_PREVIEW && (
              <a class="nx-link" href={section.href}>All {section.posts.length} in {section.label} →</a>
            )}
          </div>
          <ul class="bl-grid" role="list" data-reveal="stagger">
            {section.previewPosts.map((post) => (
              <li><BlogNextCard post={post} /></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}

  <ClosingCall
    title="Keep it after Sunday."
    lead="Bright Enough is the writing. Harvous is where the trail lives — notes beside Scripture, so next week's prep doesn't start from scratch."
  />
</NextLayout>

<style>
  .bl-intro { padding-top: clamp(7.5rem, 15vw, 10rem); padding-bottom: 4.5rem; text-align: center; }
  .bl-intro .nx-kicker { margin-top: 1.5rem; }
  .bl-intro .nx-display { margin: 0.75rem 0 0; }
  .bl-intro .nx-lead { max-width: 32rem; margin: 1.25rem auto 0; }
  .bl-empty { padding-block: 4rem; text-align: center; color: var(--color-ink-soft); }

  .bl-sec { padding-top: clamp(3rem, 7vw, 4.5rem); }
  .bl-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; }
  .bl-h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .bl-tile { display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 0.75rem; }
  .bl-tile :global(svg) { width: 1.15rem; height: 1.15rem; }

  .bl-grid {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) { .bl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .bl-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .bl-grid > .is-wide { grid-column: span 2; } }
</style>
