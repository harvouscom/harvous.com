---
/**
 * /blog/<slug>/ — a Bright Enough post, or page one of a topic archive
 * (/blog/<topic>/). Both live at the same depth, so one route serves both and
 * refuses to build if a post id ever collides with a topic slug. Topic pages
 * two and up are blog/[category]/page/[page].astro.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import BlogPostPage from "../../components/next/BlogPostPage.astro";
import BlogCategoryIndexPage from "../../components/BlogCategoryIndexPage.astro";
import { blogCategoriesInUse, includeBlogDrafts, isBlogCategory, isBlogPostListed, type BlogCategory } from "../../lib/blog";

export async function getStaticPaths() {
  const listed = (await getCollection("blog")).filter((p) => isBlogPostListed(p, includeBlogDrafts()));
  for (const p of listed) {
    if (isBlogCategory(p.id)) throw new Error(`Blog post id "${p.id}" collides with a category archive slug`);
  }
  return [
    ...listed.map((post) => ({ params: { slug: post.id }, props: { kind: "post" as const, post } })),
    ...blogCategoriesInUse(listed).map((category) => ({ params: { slug: category }, props: { kind: "category" as const, category } })),
  ];
}

type Props = { kind: "post"; post: CollectionEntry<"blog"> } | { kind: "category"; category: BlogCategory };
const props = Astro.props as Props;
---

{props.kind === "post" ? <BlogPostPage post={props.post} /> : <BlogCategoryIndexPage category={props.category} currentPage={1} />}
