---
/**
 * /blog/<slug>/ — one Bright Enough post.
 *
 * A ~40rem reading column, the post's art, and quiet prose styling. The `a`
 * override (BlogNextLink) is now a plain passthrough; links render as
 * authored.
 */
import { getCollection, render, type CollectionEntry } from "astro:content";
import NextLayout from "../../layouts/NextLayout.astro";
import ClosingCall from "../../components/next/ClosingCall.astro";
import BlogNextCard from "../../components/next/BlogNextCard.astro";
import BlogNextLink from "../../components/next/BlogNextLink.astro";
import {
  BLOG_CATEGORIES,
  blogCategoryColor,
  blogCategoryLabel,
  blogHeadingsFromBody,
  blogProductBridgeCopy,
  blogReadingMinutes,
  blogThumbUrl,
  formatBlogDate,
  includeBlogDrafts,
  isBlogPostListed,
  resolveBlogAuthor,
  sortBlogPostsByDate,
} from "../../lib/blog";
import { blogPostJsonLd } from "../../lib/page-jsonld.ts";

export async function getStaticPaths() {
  const showDrafts = includeBlogDrafts();
  const listed = (await getCollection("blog")).filter((p) => isBlogPostListed(p, showDrafts));
  return listed.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const isEssayHeading = (h: { slug: string; text: string }) =>
  h.slug !== "footnote-label" && h.text.trim().toLowerCase() !== "footnotes";
const renderedToc = headings.filter((h) => h.depth === 2 && isEssayHeading(h));
const toc =
  renderedToc.length >= 2
    ? renderedToc
    : blogHeadingsFromBody(post.body ?? "", 2).filter(isEssayHeading);

const label = blogCategoryLabel(post.data.category);
const color = blogCategoryColor(post.data.category);
const featThumb = blogThumbUrl(post.id, "feat");
const author = resolveBlogAuthor(post.data);
const bridge = blogProductBridgeCopy(post.data.category);

/* Same "keep reading" rule as the live post: two from the same topic, newest
   first, topped up from the rest of the blog if the topic runs short. */
const showDrafts = includeBlogDrafts();
const allPosts = sortBlogPostsByDate(
  (await getCollection("blog")).filter((p) => isBlogPostListed(p, showDrafts)),
);
let related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2);
if (related.length < 2) {
  const taken = new Set([post.id, ...related.map((p) => p.id)]);
  related = [...related, ...allPosts.filter((p) => !taken.has(p.id)).slice(0, 2 - related.length)];
}

const pageTitle = post.data.seoTitle ?? `${post.data.title} — Bright Enough`;
const pageDescription = post.data.seoDescription ?? post.data.description;
---

<NextLayout title={pageTitle} description={pageDescription} ogImage={featThumb} jsonLd={blogPostJsonLd(post, { description: pageDescription, featThumb, author })}>
  <article class="bp">
    <header class="nx-wrap bp-head">
      <a class="bp-back" href="/blog/">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M14 8a.75.75 0 0 1-.75.75H3.56l3.22 3.22a.75.75 0 1 1-1.06 1.06l-4.5-4.5a.75.75 0 0 1 0-1.06l4.5-4.5a.75.75 0 0 1 1.06 1.06L3.56 7.25H13.25A.75.75 0 0 1 14 8Z"
            clip-rule="evenodd"></path>
        </svg>
        Bright Enough
      </a>
      <div class="bp-col">
        <p class="bp-meta">
          <a href={`/blog/?c=${post.data.category}`}>{label}</a>
          {post.data.draft && <span class="bp-draft">Draft</span>}
          {author.kind !== "house" && (
            <>
              <span aria-hidden="true">·</span>
              <span>By {author.name}</span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <time datetime={post.data.publishDate.toISOString()}>
            {formatBlogDate(post.data.publishDate)}
          </time>
          <span aria-hidden="true">·</span>
          <span>{blogReadingMinutes(post.body)} min read</span>
        </p>
        <h1 class="bp-title">{post.data.title}</h1>
        <p class="bp-stand">{post.data.description}</p>
      </div>
      <div class="bp-art" style={`--tone: ${color.bg};`}>
        <img src={featThumb} alt="" width="1400" height="780" loading="eager" decoding="async" />
      </div>
    </header>

    <div class="nx-wrap bp-body">
      <div class="bp-col">
        {toc.length >= 3 && (
          <nav class="bp-toc" aria-label="In this post">
            <p class="bp-toc__h">In this post</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="bp-prose" data-bp-prose data-categories={BLOG_CATEGORIES.join(" ")}>
          <Content components={{ a: BlogNextLink }} />
        </div>

        {author.kind !== "house" && (
          <footer class="bp-author">
            {author.avatar && (
              <img src={author.avatar} alt="" width="44" height="44" loading="lazy" decoding="async" />
            )}
            <div>
              {author.href ? <a href={author.href}>{author.name}</a> : <span>{author.name}</span>}
              <p>{author.role}</p>
            </div>
          </footer>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="nx-wrap bp-more" aria-labelledby="bp-more-h">
      <h2 id="bp-more-h" class="bp-more__h">Keep reading</h2>
      <ul class="bp-more__grid" role="list">
        {related.map((p) => (
          <li>
            <BlogNextCard post={p} />
          </li>
        ))}
      </ul>
      <p class="bp-more__all">
        <a class="nx-btn nx-btn--ghost" href="/blog/">Every post in Bright Enough</a>
      </p>
    </section>
  )}

  <ClosingCall title={bridge.heading} lead={bridge.lead} />
</NextLayout>

<style>
  .bp-head { padding-top: clamp(7.5rem, 14vw, 10rem); }
  .bp-col {
    max-width: 40rem;
    margin-inline: auto;
  }

  .bp-back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    margin: 0 auto 2.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .bp-back:hover { background: color-mix(in srgb, var(--color-ink) 9%, transparent); color: var(--color-ink); }
  .bp-back svg { width: 0.8rem; height: 0.8rem; }

  .bp-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    align-items: center;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-faint);
  }
  .bp-meta a {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    text-decoration: none;
  }
  .bp-meta a:hover { color: var(--color-ink); }
  .bp-draft {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bp-title {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .bp-stand {
    max-width: 36rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    line-height: 1.55;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  .bp-art {
    position: relative;
    max-width: 56rem;
    aspect-ratio: 1400 / 780;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    overflow: hidden;
    border-radius: var(--nx-radius-scene);
    background: color-mix(in oklab, var(--tone) 45%, var(--color-warm));
  }
  .bp-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bp-body { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3rem, 7vw, 5rem); }

  /* ── Contents: a quiet list, not a widget ────────────────────────────── */
  .bp-toc {
    margin: 0 0 2.75rem;
    padding: 1.25rem 1.4rem;
    border-radius: 1.25rem;
    background: var(--color-warm);
  }
  .bp-toc__h {
    margin: 0 0 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .bp-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }
  .bp-toc a {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .bp-toc a:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 0.2em; }

  /* ── Prose ───────────────────────────────────────────────────────────── */
  .bp-prose {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-ink-soft);
  }
  .bp-prose > :global(:first-child) { margin-top: 0; }
  .bp-prose :global(p) { margin: 0 0 1.4em; text-wrap: pretty; }
  .bp-prose :global(p:last-child) { margin-bottom: 0; }

  .bp-prose :global(h2),
  .bp-prose :global(h3),
  .bp-prose :global(h4) {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ink);
    text-wrap: balance;
    scroll-margin-top: 7rem;
  }
  .bp-prose :global(h2) {
    margin: 2.4em 0 0.6em;
    font-size: clamp(1.6rem, 2.6vw, 1.95rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .bp-prose :global(h3) {
    margin: 2em 0 0.5em;
    font-size: 1.35rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .bp-prose :global(h4) {
    margin: 1.75em 0 0.4em;
    font-size: 1.15rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .bp-prose :global(strong) { font-weight: 600; color: var(--color-ink); }

  /* The site's marker highlight. */
  .bp-prose :global(mark) {
    background: linear-gradient(180deg, transparent 55%, var(--color-highlight) 55%);
    color: inherit;
    padding: 0 0.1em;
    border-radius: 2px;
  }

  .bp-prose :global(hr) {
    margin: 2.5em auto;
    width: 4rem;
    border: 0;
    border-top: 1px solid var(--color-rule);
  }

  .bp-prose :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 150ms ease;
  }
  .bp-prose :global(a:hover) { text-decoration-color: var(--color-accent); }

  /* Bare markdown lists only — component lists (BlogRoleCards etc.) keep their own look. */
  .bp-prose :global(ul:not([class])),
  .bp-prose :global(ol:not([class])) {
    margin: 0 0 1.5em;
    padding-left: 1.35em;
  }
  .bp-prose :global(ul:not([class])) { list-style: disc; }
  .bp-prose :global(ol:not([class])) { list-style: decimal; }
  .bp-prose :global(ul:not([class]) > li),
  .bp-prose :global(ol:not([class]) > li) {
    margin: 0 0 0.55em;
    padding-left: 0.3em;
  }
  .bp-prose :global(ul:not([class]) > li::marker) { color: var(--color-ink-faint); }
  .bp-prose :global(ol:not([class]) > li::marker) {
    color: var(--color-ink-faint);
    font-size: 0.9em;
    font-variant-numeric: tabular-nums;
  }
  .bp-prose :global(li > ul),
  .bp-prose :global(li > ol) { margin: 0.5em 0 0; }
  .bp-prose :global(li > p) { margin-bottom: 0.5em; }

  .bp-prose :global(blockquote) {
    margin: 2em 0;
    padding: 0.1em 0 0.1em 1.25em;
    border-left: 2px solid var(--color-rule);
    color: var(--color-ink);
  }
  .bp-prose :global(blockquote p) { margin-bottom: 0.75em; }
  .bp-prose :global(blockquote p:last-child) { margin-bottom: 0; }

  .bp-prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2em 0;
    border-radius: 1rem;
  }

  .bp-prose :global(code) {
    font-size: 0.875em;
    padding: 0.12em 0.4em;
    border-radius: 0.35rem;
    background: var(--color-warm);
    color: var(--color-ink);
  }
  .bp-prose :global(pre),
  .bp-prose :global(pre.astro-code) {
    margin: 2em 0;
    padding: 1.15rem 1.25rem;
    overflow-x: auto;
    border-radius: 1rem;
    background: var(--color-warm) !important;
    color: var(--color-ink) !important;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .bp-prose :global(pre code),
  .bp-prose :global(pre.astro-code span) {
    padding: 0;
    background: transparent !important;
    color: inherit !important;
    font-style: inherit !important;
  }

  .bp-prose :global(table) {
    width: 100%;
    margin: 2em 0;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .bp-prose :global(th),
  .bp-prose :global(td) {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
    vertical-align: top;
  }
  .bp-prose :global(th) { font-weight: 600; color: var(--color-ink); }

  /* GFM footnotes — a quiet trail at the end. */
  .bp-prose :global(a[data-footnote-ref]),
  .bp-prose :global(sup a) {
    font-size: 0.75em;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-accent);
    margin-inline: 0.1em;
  }
  .bp-prose :global([id^="user-content-fn"]),
  .bp-prose :global(#footnote-label) { scroll-margin-top: 7rem; }
  .bp-prose :global(section[data-footnotes]),
  .bp-prose :global(.footnotes) {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .bp-prose :global(section[data-footnotes] > h2:not(.sr-only)) {
    margin: 0 0 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .bp-prose :global(section[data-footnotes] ol) { margin: 0; padding-left: 1.25em; }
  .bp-prose :global(section[data-footnotes] li) { margin: 0 0 0.5em; }
  .bp-prose :global(section[data-footnotes] li p) { margin: 0; }
  .bp-prose :global(a[data-footnote-backref]) { text-decoration: none; margin-left: 0.25rem; }

  /* ── Author ─────────────────────────────────────────────────────────── */
  .bp-author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }
  .bp-author img { width: 2.75rem; height: 2.75rem; border-radius: 999px; object-fit: cover; }
  .bp-author a,
  .bp-author span {
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }
  .bp-author a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .bp-author p { margin: 0.1rem 0 0; font-size: 0.875rem; color: var(--color-ink-faint); }

  /* ── Keep reading ───────────────────────────────────────────────────── */
  .bp-more {
    max-width: calc(52rem + 2 * var(--nx-gutter));
    padding-block: clamp(2rem, 5vw, 3rem) clamp(1rem, 3vw, 2rem);
  }
  .bp-more__h {
    margin: 0 0 1.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .bp-more__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .bp-more__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  }
  .bp-more__all { margin: 2rem 0 0; text-align: center; }
</style>
