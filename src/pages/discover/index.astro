---
/**
 * /discover/ — the Discover catalog in the /next chrome.
 *
 * Same catalog, same order, same filters as the live `/discover/`: every card
 * comes from `sortedDiscoverListings()` and links to the existing
 * `/discover/<slug>/` detail page, and the grid filters in place from
 * `?kind=`, `?use=` and `?from=` (plus the search field, which is not written
 * to the URL). Without JS every card is simply shown.
 *
 * What changes is the look: a centred intro, calm pill controls, and cards in
 * the Bento's shape — a tinted stage with the artifact on it (a template's own
 * page; for a resource, the live card's plate: the publisher's masthead over
 * its picture), then the words underneath.
 *
 * The grid is six tracks wide on desktop with each card spanning two, so the
 * last row can be rebalanced rather than left with one lonely card: a
 * remainder of two becomes two half-width cards, a remainder of one turns the
 * last four into two rows of two. The script re-marks this after every filter;
 * the server marks it for the full, unfiltered set.
 */
import AppIcon from "../../components/next/app/AppIcon.astro";
import { Icon } from "astro-icon/components";
import NextLayout from "../../layouts/NextLayout.astro";
import ClosingCall from "../../components/next/ClosingCall.astro";
import ResourcePlate from "../../components/next/ResourcePlate.astro";
import { sanitizeListingHtml } from "../../lib/sanitize-listing-html.ts";
import {
  DISCOVER_KIND_ICON,
  DISCOVER_KIND_NOUN,
  DISCOVER_RESOURCE_TYPE_NOUN,
  discoverListingCta,
  discoverListingHref,
  discoverListingIcon,
  discoverListingInk,
  discoverArtPosition,
  discoverDocumentArt,
  discoverSourceSlug,
  discoverTopicArt,
  getDiscoverTopics,
  sortedDiscoverListings,
  type DiscoverKind,
  type DiscoverListing,
} from "../../lib/discover-data.ts";

const listings = sortedDiscoverListings();
const topics = getDiscoverTopics();
const total = listings.length;

const KINDS: DiscoverKind[] = ["template", "note", "pack", "resource"];
const presentKinds = KINDS.filter((kind) => listings.some((l) => l.kind === kind));
/* Same rule as the live page: a control that can't change what you see isn't shown. */
const showKinds = presentKinds.length > 1;
const showTopics = topics.length > 1;
const KIND_TAB: Record<DiscoverKind, string> = {
  template: "Templates",
  note: "Notes",
  pack: "Threads",
  resource: "Resources",
};

/* Tail marks for the unfiltered grid — the script recomputes these after it
   filters, using the same function body. */
function tailMarks(n: number): string[][] {
  const marks: string[][] = Array.from({ length: n }, () => []);
  if (n % 2 === 1) marks[n - 1].push("is-t2-odd");
  if (n === 1) marks[0].push("is-t3-solo");
  else if (n % 3 === 2) for (let i = n - 2; i < n; i++) marks[i].push("is-t3-wide");
  else if (n % 3 === 1) for (let i = n - 4; i < n; i++) marks[i].push("is-t3-wide");
  return marks;
}
const initialMarks = tailMarks(total);

type Card = {
  listing: DiscoverListing;
  href: string;
  tone: string;
  label: string;
  by: string | null;
  logo: string | null;
  stage: "paper" | "stack" | "plate";
  typeLabel: string;
  plateTone: string | null;
  art: string | null;
  artPos: string;
  docArt: string | null;
  bodyHtml: string;
  excerpt: string;
  titles: string[];
  titlesMore: number;
  image: string | null;
  isVideo: boolean;
  duration: string | null;
  icon: string;
  cta: string;
  search: string;
};

const cards: Card[] = listings.map((listing) => {
  const preview = listing.preview ?? {};
  const source = listing.source ?? null;
  const kindNoun = DISCOVER_KIND_NOUN[listing.kind] ?? "Item";
  const resourceType = listing.resourceType ?? null;
  const typeLabel = resourceType ? DISCOVER_RESOURCE_TYPE_NOUN[resourceType] : kindNoun;
  const fileType = (preview.fileType ?? "").trim().toUpperCase();

  /* The byline, exactly as the live card decides it. */
  const by = source
    ? typeLabel
    : preview.official
      ? "Included"
      : listing.authorDisplayName || preview.sourceName || null;

  const bodyHtml = sanitizeListingHtml(preview.bodyHtml ?? "");
  const titles = (preview.titles ?? []).slice(0, 3);
  const image = preview.sourceImage ?? null;

  const stage: Card["stage"] =
    listing.kind === "template" || listing.kind === "note"
      ? "paper"
      : listing.kind === "pack"
        ? "stack"
        : "plate";

  /* The plate's ground, as the live card decides it: the publisher's own
     colour when it has one, otherwise the topic's wash. */
  const plateTone = listing.plateTone ?? null;

  return {
    listing,
    href: discoverListingHref(listing),
    tone: listing.plateTone ?? discoverListingInk(listing),
    label: source ? source.name : kindNoun,
    by: source ? by : (by ?? (listing.kind === "resource" ? fileType || preview.sourceDomain || null : null)),
    logo: source?.logo ?? null,
    stage,
    typeLabel: source ? typeLabel : fileType || preview.sourceDomain || typeLabel,
    plateTone,
    art: plateTone ? null : discoverTopicArt(listing.category),
    artPos: discoverArtPosition(listing.slug),
    docArt: source && plateTone ? null : discoverDocumentArt(listing.slug),
    bodyHtml,
    excerpt: preview.excerpt ?? "",
    titles,
    titlesMore: (preview.noteCount ?? 0) - titles.length,
    image,
    isVideo: resourceType === "video" && Boolean(listing.video),
    duration: listing.video?.durationLabel ?? null,
    icon: discoverListingIcon(listing),
    cta: discoverListingCta(listing).primary.label,
    /* Same fields the live card searches. */
    search: [
      listing.title,
      listing.description,
      listing.authorDisplayName,
      kindNoun,
      source?.name,
      source?.domain,
      typeLabel,
    ]
      .filter(Boolean)
      .join(" ")
      .toLowerCase(),
  };
});
---

<NextLayout
  title="Discover — Bible study templates and resources — Harvous"
  description="Free Bible study templates shared by people who use Harvous, plus videos and guides from BibleProject and others. Take a copy into your own account."
>
  <header class="nx-wrap dx-intro">
    <p class="nx-kicker">Discover</p>
    <h1 class="nx-display">A good place to start.</h1>
    <p class="nx-lead">
      Templates to write into, and things worth watching or reading from people I trust. All
      free, and once you take a copy, it's yours.
    </p>
  </header>

  {
    total === 0 ? (
      <section class="nx-wrap nx-wrap--narrow dx-none">
        <p>
          Nothing has been shared yet. When someone offers a template or a study and it has been
          looked over, it turns up here.
        </p>
      </section>
    ) : (
      <section class="nx-wrap dx" data-dx aria-label="Catalog">
        <div class="dx-bar">
          {showKinds && (
            <div class="dx-kinds" role="group" aria-label="Kind">
              <button type="button" class="dx-chip is-on" data-dx-kind="" aria-pressed="true">
                All
              </button>
              {presentKinds.map((kind) => (
                <button type="button" class="dx-chip" data-dx-kind={kind} aria-pressed="false">
                  <Icon name={DISCOVER_KIND_ICON[kind]} aria-hidden="true" />
                  {KIND_TAB[kind]}
                </button>
              ))}
            </div>
          )}
          <div class="dx-tools">
            {showTopics && (
              <label class="dx-select" data-dx-topic-wrap>
                <span class="sr-only">Use case</span>
                <select data-dx-topic>
                  <option value="">All use cases</option>
                  {topics.map((topic) => (
                    <option value={topic.id}>{topic.label}</option>
                  ))}
                </select>
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </label>
            )}
            <label class="dx-search">
              <span class="sr-only">Search the catalog</span>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <circle cx="7" cy="7" r="4.25"></circle>
                <path d="M10.25 10.25 13.5 13.5"></path>
              </svg>
              <input type="search" placeholder="Search" autocomplete="off" data-dx-search />
            </label>
          </div>
        </div>

        {/* The publisher filter has no control of its own — only a listing
            page's "More from …" link sets `?from=` — so this token is what says
            the grid is narrowed, and carries the way out. */}
        <div class="dx-from" data-dx-from hidden>
          <span class="dx-from__chip">
            <img data-dx-from-mark alt="" width="18" height="18" decoding="async" hidden />
            <span data-dx-from-name></span>
            <button type="button" class="dx-from__x" data-dx-reset aria-label="Show everything, not just this source">
              <svg viewBox="0 0 12 12" aria-hidden="true">
                <path d="M3.2 3.2 8.8 8.8M8.8 3.2 3.2 8.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
            </button>
          </span>
          <span class="dx-from__count" data-dx-from-count></span>
        </div>

        <ul class="dx-grid" role="list" data-dx-grid>
          {cards.map((card, i) => {
            const { listing } = card;
            const source = listing.source ?? null;
            const leaves = /^https?:/.test(card.href);
            return (
              <li
                class:list={["dc", `dc--${card.stage}`, ...initialMarks[i]]}
                style={`--tone: ${card.tone};`}
                data-kind={listing.kind}
                data-topic={listing.category ?? ""}
                data-source={source ? discoverSourceSlug(source) : ""}
                data-source-name={source?.name ?? ""}
                data-source-logo={source?.logo ?? ""}
                data-search={card.search}
              >
                <a class="dc__link" href={card.href} {...(leaves ? { target: "_blank", rel: "noopener" } : {})}>
                  <div class="dc__stage" aria-hidden="true">
                    {card.stage === "paper" && (
                      <div class="aui aui-paper dc__paper">
                        <p class="aui-h">{listing.title}</p>
                        {card.bodyHtml ? (
                          <div class="dc__body" set:html={card.bodyHtml} />
                        ) : (
                          <p class="dc__body">{card.excerpt}</p>
                        )}
                      </div>
                    )}

                    {card.stage === "stack" && (
                      <div class="aui aui-card aui-card--float dc__rows">
                        {card.titles.map((t) => (
                          <div class="aui-row">
                            <span class="aui-tile"><AppIcon name={DISCOVER_KIND_ICON.note} /></span>
                            <span><span class="aui-title">{t}</span></span>
                            <span />
                          </div>
                        ))}
                        {card.titlesMore > 0 && (
                          <div class="aui-row">
                            <span class="aui-tile"><AppIcon name={DISCOVER_KIND_ICON.pack} /></span>
                            <span><span class="aui-sub">+{card.titlesMore} more</span></span>
                            <span />
                          </div>
                        )}
                      </div>
                    )}

                    {card.stage === "plate" && (
                      <ResourcePlate
                        tone={card.plateTone}
                        art={card.art}
                        artPos={card.artPos}
                        logo={card.logo}
                        name={source ? source.name : listing.title}
                        type={card.typeLabel}
                        image={card.image}
                        video={card.isVideo}
                        duration={card.duration}
                        icon={card.icon}
                        docArt={card.docArt}
                      />
                    )}
                  </div>

                  <div class="dc__text">
                    <p class="dc__label">
                      {!source && <Icon class="dc__kind-icon" name={card.icon} aria-hidden="true" />}
                      <span>{card.label}</span>
                      {card.by && <span class="dc__by">{card.by}</span>}
                    </p>
                    <h2 class="dc__title">{listing.title}</h2>
                    {listing.description && <p class="dc__desc">{listing.description}</p>}
                    <p class="dc__foot">
                      <span class="dc__cta">{card.cta}</span>
                      {listing.installCount > 1 && <span class="dc__count">saved by {listing.installCount}</span>}
                    </p>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>

        <div class="dx-empty" data-dx-empty hidden>
          <p>Nothing matches that yet.</p>
          <button type="button" class="nx-btn nx-btn--ghost" data-dx-reset>Show everything</button>
        </div>

        <nav class="dx-pager" data-dx-pager aria-label="Pages" hidden>
          <button type="button" class="nx-btn nx-btn--ghost" data-dx-prev>Previous</button>
          <span data-dx-page-of aria-live="polite"></span>
          <button type="button" class="nx-btn nx-btn--ghost" data-dx-next>Next</button>
        </nav>
      </section>
    )
  }

  <ClosingCall
    title={total > 0 ? "Take one, and make it yours." : "Somewhere for your study to live."}
  />
</NextLayout>

<script>
  /*
   * Filter in place — the live /discover/ script's behaviour, re-pointed at
   * this page's markup. State is (topic, kind, from, query, page). The URL
   * carries `use`, `kind` and `from`; the query changes on every keystroke and
   * is nobody's address, so it stays out.
   */
  const root = document.querySelector<HTMLElement>("[data-dx]");
  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>(".dc"));
    const kindButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dx-kind]"));
    const topicSelect = root.querySelector<HTMLSelectElement>("[data-dx-topic]");
    const topicWrap = root.querySelector<HTMLElement>("[data-dx-topic-wrap]");
    const search = root.querySelector<HTMLInputElement>("[data-dx-search]");
    const grid = root.querySelector<HTMLElement>("[data-dx-grid]");
    const empty = root.querySelector<HTMLElement>("[data-dx-empty]");
    const pager = root.querySelector<HTMLElement>("[data-dx-pager]");
    const pageOf = root.querySelector<HTMLElement>("[data-dx-page-of]");
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-dx-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-dx-next]");
    const fromStrip = root.querySelector<HTMLElement>("[data-dx-from]");
    const fromName = root.querySelector<HTMLElement>("[data-dx-from-name]");
    const fromMark = root.querySelector<HTMLImageElement>("[data-dx-from-mark]");
    const fromCount = root.querySelector<HTMLElement>("[data-dx-from-count]");

    /* Same page size as the live hub. */
    const PAGE_SIZE = 24;
    let page = 0;

    const topicValues = topicSelect ? Array.from(topicSelect.options).map((o) => o.value) : [];
    const params = new URLSearchParams(location.search);
    let topic = params.get("use") ?? "";
    let kind = params.get("kind") ?? "";
    let from = params.get("from") ?? "";
    let query = "";

    /* An unknown value is nobody's filter — fall back to everything. */
    if (topic && !topicValues.includes(topic)) topic = "";
    if (kind && !kindButtons.some((b) => b.dataset.dxKind === kind)) kind = "";
    if (from && !cards.some((c) => c.dataset.source === from)) from = "";

    const TAIL = ["is-t2-odd", "is-t3-solo", "is-t3-wide"];
    const markTail = (shown: HTMLElement[]) => {
      for (const c of cards) c.classList.remove(...TAIL);
      const n = shown.length;
      if (n % 2 === 1) shown[n - 1].classList.add("is-t2-odd");
      if (n === 1) shown[0].classList.add("is-t3-solo");
      else if (n % 3 === 2) shown.slice(-2).forEach((c) => c.classList.add("is-t3-wide"));
      else if (n % 3 === 1) shown.slice(-4).forEach((c) => c.classList.add("is-t3-wide"));
    };

    const apply = (resetPage = true) => {
      if (resetPage) page = 0;
      const matched = cards.filter(
        (card) =>
          (!topic || card.dataset.topic === topic) &&
          (!kind || card.dataset.kind === kind) &&
          (!from || card.dataset.source === from) &&
          (!query || (card.dataset.search ?? "").includes(query)),
      );
      const pages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
      page = Math.min(page, pages - 1);
      const offset = page * PAGE_SIZE;
      const onPage = matched.slice(offset, offset + PAGE_SIZE);
      const visible = new Set(onPage);
      for (const card of cards) card.hidden = !visible.has(card);
      markTail(onPage);

      for (const b of kindButtons) {
        const on = (b.dataset.dxKind ?? "") === kind;
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-pressed", on ? "true" : "false");
      }
      if (topicSelect) topicSelect.value = topic;
      topicWrap?.classList.toggle("is-set", Boolean(topic));

      const shown = matched.length;
      if (empty) empty.hidden = shown > 0;
      if (grid) grid.hidden = shown === 0;
      if (pager) pager.hidden = pages < 2;
      if (pageOf) pageOf.textContent = `Page ${page + 1} of ${pages}`;
      if (prevBtn) prevBtn.disabled = page === 0;
      if (nextBtn) nextBtn.disabled = page >= pages - 1;

      if (fromStrip) fromStrip.hidden = !from;
      if (from) {
        const card = cards.find((c) => c.dataset.source === from);
        if (fromName) fromName.textContent = card?.dataset.sourceName ?? from;
        if (fromMark) {
          const logo = card?.dataset.sourceLogo ?? "";
          fromMark.hidden = !logo;
          if (logo) fromMark.src = logo;
        }
        if (fromCount) fromCount.textContent = shown === 1 ? "1 thing" : `${shown} things`;
      }

      const next = new URLSearchParams();
      if (topic) next.set("use", topic);
      if (kind) next.set("kind", kind);
      if (from) next.set("from", from);
      const qs = next.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    };

    for (const b of kindButtons) {
      b.addEventListener("click", () => {
        const value = b.dataset.dxKind ?? "";
        kind = kind === value ? "" : value;
        apply();
      });
    }
    topicSelect?.addEventListener("change", () => {
      topic = topicSelect.value;
      apply();
    });
    search?.addEventListener("input", () => {
      query = search.value.trim().toLowerCase();
      apply();
    });
    const turn = (delta: number) => {
      page += delta;
      apply(false);
      grid?.scrollIntoView({ block: "start", behavior: "smooth" });
    };
    prevBtn?.addEventListener("click", () => turn(-1));
    nextBtn?.addEventListener("click", () => turn(1));
    for (const button of root.querySelectorAll("[data-dx-reset]")) {
      button.addEventListener("click", () => {
        topic = "";
        kind = "";
        from = "";
        query = "";
        if (search) search.value = "";
        apply();
      });
    }

    apply();
  }
</script>

<style>
  .dx-intro {
    padding-top: clamp(8rem, 16vw, 11rem);
    text-align: center;
  }
  .dx-intro .nx-display { margin: 1rem auto 0; }
  .dx-intro .nx-lead { margin: 1.5rem auto 0; }

  .dx-none {
    padding-block: 3rem;
    text-align: center;
    color: var(--color-ink-soft);
  }

  .dx { margin-top: clamp(3rem, 7vw, 4.5rem); }

  /* ── Controls: one calm row, wrapping when it has to ─────────────────── */
  .dx-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
  }
  .dx-kinds,
  .dx-tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
  }

  .dx-chip,
  .dx-select,
  .dx-search {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.5rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    transition: background-color 150ms ease, color 150ms ease;
  }
  .dx-chip { cursor: pointer; }
  .dx-chip :global(svg) { width: 0.8rem; height: 0.8rem; opacity: 0.8; }
  .dx-chip:hover { background: color-mix(in srgb, var(--color-ink) 9%, transparent); color: var(--color-ink); }
  /* Selected is ink, never the accent blue. */
  .dx-chip.is-on,
  .dx-chip.is-on:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .dx-chip:focus-visible,
  .dx-select:focus-within,
  .dx-search:focus-within {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .dx-select {
    position: relative;
    padding: 0;
  }
  .dx-select select {
    appearance: none;
    height: 100%;
    padding: 0 2.25rem 0 1rem;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    cursor: pointer;
    outline: none;
  }
  .dx-select svg {
    position: absolute;
    right: 0.9rem;
    width: 0.7rem;
    height: 0.7rem;
    opacity: 0.6;
    pointer-events: none;
  }
  .dx-select:hover { background: color-mix(in srgb, var(--color-ink) 9%, transparent); color: var(--color-ink); }
  .dx-select.is-set { background: var(--color-ink); color: var(--color-paper); }

  .dx-search { width: 11rem; }
  .dx-search svg { flex-shrink: 0; width: 0.9rem; height: 0.9rem; opacity: 0.6; }
  .dx-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--color-ink);
    outline: none;
  }
  .dx-search input::placeholder { color: var(--color-ink-faint); }
  .dx-search input::-webkit-search-cancel-button { -webkit-appearance: none; }

  /* ── Publisher token ─────────────────────────────────────────────────── */
  .dx-from {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }
  .dx-from[hidden] { display: none; }
  .dx-from__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.3rem 0.3rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
    font-weight: 500;
  }
  .dx-from__chip img { width: 1.125rem; height: 1.125rem; border-radius: 5px; object-fit: contain; }
  .dx-from__x {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink-soft);
    cursor: pointer;
  }
  .dx-from__x svg { width: 0.75rem; height: 0.75rem; }
  .dx-from__count { font-size: 0.875rem; color: var(--color-ink-faint); }

  /* ── The grid ────────────────────────────────────────────────────────────
     Six tracks, cards span two; the tail marks rebalance the last row. */
  .dx-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
    scroll-margin-top: 7rem;
  }
  .dx-grid[hidden] { display: none; }
  @media (min-width: 44rem) {
    .dx-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .dc { grid-column: span 2; }
    .dc.is-t2-odd { grid-column: 2 / span 2; }
  }
  @media (min-width: 68rem) {
    .dx-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1.25rem; }
    .dc,
