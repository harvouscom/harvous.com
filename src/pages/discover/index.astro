---
/**
 * `/discover` — the whole catalog on one page.
 *
 * One grid, filtered in place, rather than a page per topic. The topic pages
 * only ever regrouped the same handful of cards, and a reader who wants Sermon
 * notes wants them *here*, beside everything else — so the topics became
 * filters, and `/discover/?use=sermon-notes` is the address a use-case page
 * links to.
 *
 * **One bar, not two.** The first cut stacked a row of topic chips above a row
 * of kind chips, which is two full-width bands of controls over a catalog of
 * nine things — the controls outweighed the content. Topics moved into a
 * dropdown beside the kinds, which is the shape `BlogLibraryNav` already uses
 * for exactly this job (a topics menu and a search field on one line). Kinds
 * stay visible because there are only five and they are the coarser cut;
 * topics fold away because there are nine and most readers want one.
 *
 * Topics borrow their glyph from the use-case page of the same slug
 * (`discoverTopicIcon`), so Sermon notes wears the same church here as on
 * `/for/`. Their colour is the same one their listings' pills wear.
 *
 * Filtering is a few lines of `hidden` toggling, not a search library: every
 * card is in the HTML already, and the catalog is scanned, not queried.
 */
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import PageClosingCTA from "../../components/PageClosingCTA.astro";
import DiscoverCard from "../../components/DiscoverCard.astro";
import { breadcrumbJsonLd } from "../../lib/breadcrumb-jsonld.ts";
import { isDraftPageSlug } from "../../lib/draft-pages.ts";
import {
  DISCOVER_KIND_ICON,
  discoverListingHref,
  getDiscoverTopics,
  sortedDiscoverListings,
  type DiscoverKind,
} from "../../lib/discover-data.ts";

const listings = sortedDiscoverListings();
const topics = getDiscoverTopics();
const total = listings.length;

const KINDS: DiscoverKind[] = ["template", "note", "pack", "resource"];
const kindCounts = Object.fromEntries(
  KINDS.map((kind) => [kind, listings.filter((l) => l.kind === kind).length]),
) as Record<DiscoverKind, number>;
const presentKinds = KINDS.filter((kind) => kindCounts[kind] > 0);

/*
 * A control that cannot change what you see is not a control.
 *
 * While the catalog holds one kind, "All" and "Templates" select the same
 * cards, and the row reads as a promise that there is something else in here.
 * Same for the use-case menu with one topic in it. Each comes back on its own
 * the day a second one is approved — the same rule the header's Resources menu
 * follows, so the two never disagree about what the catalog contains.
 */
const showKinds = presentKinds.length > 1;
const showTopics = topics.length > 1;
/* Plural, the way the app's own tabs say it. */
const KIND_TAB: Record<DiscoverKind, string> = {
  template: "Templates",
  note: "Notes",
  pack: "Threads",
  resource: "Resources",
};

/* noindex whenever `discover` is a draft slug — including staging, which is the
   one environment that actually builds and serves these pages. `draftPageIsReachable`
   is the wrong question here: it asks whether *links* should render, and is true on
   staging, which would leave the built page indexable. */
const isDraft = isDraftPageSlug("discover");

const siteOrigin = Astro.site ?? "https://harvous.com";
const pageUrl = new URL("/discover/", siteOrigin).toString();

/**
 * The catalog, to a crawler.
 *
 * An `ItemList` of what is actually on the page, in the order it is drawn, so
 * the hub is legible as a collection rather than as one more marketing page
 * with cards on it. `url` per item points where the card points — which for a
 * pass-through entry is the publisher, not a page of ours, because that is
 * genuinely where the thing lives.
 */
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Discover",
    description:
      "Free Bible study templates, notes and Threads shared by people who use Harvous, " +
      "plus videos and guides from BibleProject and others.",
    url: pageUrl,
    isAccessibleForFree: true,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: listings.length,
      itemListElement: listings.map((listing, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: listing.title,
        /* Via the shared helper, so the list and the cards can never disagree
           about where a listing lives. */
        url: new URL(discoverListingHref(listing), siteOrigin).toString(),
      })),
    },
  },
  breadcrumbJsonLd(
    [
      { name: "Harvous", path: "/" },
      { name: "Discover", path: "/discover/" },
    ],
    siteOrigin,
  ),
];
---

<BaseLayout
  title="Discover — Bible study templates and notes people have shared — Harvous"
  description="Free Bible study templates, notes and Threads shared by people who use Harvous, plus videos and guides from BibleProject and others. Take a copy into your own account."
  ogImage="/images/discover/og.webp"
  jsonLd={jsonLd}
  noindex={isDraft}
>
  {
    isDraft && (
      <div class="draft-page-banner" role="status">
        Draft — not indexed or deployed. Remove <code>"discover"</code> from DRAFT_PAGE_SLUGS to publish.
      </div>
    )
  }

  <section>
    <PageIntro flushBottom>
      <h1 class="section-title display-xl text-balance">A good place to start.</h1>
      <p class="lead mx-auto mt-6 max-w-xl text-pretty">
        Templates to write into, notes to read, Threads to work through — and a few things
        worth watching or reading, from people we trust. All of it free, and the moment you
        take a copy, <mark>it's yours to change</mark>.
      </p>
    </PageIntro>
  </section>

  {
    total === 0 ? (
      <section class="dhub__empty-catalog">
        <p class="text-[var(--color-ink-soft)]">
          Nothing has been shared yet. When someone offers a template or a study and it has been
          looked over, it turns up here.
        </p>
      </section>
    ) : (
      <div class="dhub" data-dhub>
        {/* ── One bar: kinds, a use-case menu, and search ──────────── */}
        <div
          class:list={["dhub__bar", !showKinds && "dhub__bar--tools-only"]}
          data-reveal
        >
          {showKinds && (
            <div class="dhub__kinds" role="group" aria-label="Kind">
              <button type="button" class="dhub__kind is-active" data-dhub-kind="" aria-pressed="true">
                All
              </button>
              {presentKinds.map((kind) => (
                <button type="button" class="dhub__kind" data-dhub-kind={kind} aria-pressed="false">
                  <span class="dhub__kind-icon">
                    <Icon name={DISCOVER_KIND_ICON[kind]} />
                  </span>
                  {KIND_TAB[kind]}
                </button>
              ))}
            </div>
          )}

          <div class="dhub__tools">
            {showTopics && (
            <div class="dhub__topics" data-dhub-topics>
              <button
                type="button"
                class="dhub__topics-trigger"
                data-dhub-topics-trigger
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="dhub-topics-menu"
              >
                <span class="dhub__topics-dot" aria-hidden="true">
                  <svg viewBox="0 0 640 640"><path fill="currentColor" d="M296.5 69.2c14.9-6.9 32.1-6.9 47 0l218.6 101c8.5 3.9 13.9 12.4 13.9 21.8s-5.4 17.9-13.9 21.8l-218.6 101c-14.9 6.9-32.1 6.9-47 0l-218.6-101c-8.5-4-13.9-12.5-13.9-21.8s5.4-17.9 13.9-21.8zM112.1 282.4l164.3 75.9c27.7 12.8 59.6 12.8 87.3 0L528 282.4l34.1 15.8c8.5 3.9 13.9 12.4 13.9 21.8s-5.4 17.9-13.9 21.8l-218.6 101c-14.9 6.9-32.1 6.9-47 0l-218.6-101c-8.5-4-13.9-12.5-13.9-21.8s5.4-17.9 13.9-21.8l34.1-15.8zM77.9 426.2l34.1-15.8l164.3 75.9c27.7 12.8 59.6 12.8 87.3 0l164.3-75.9l34.1 15.8c8.5 3.9 13.9 12.4 13.9 21.8s-5.4 17.9-13.9 21.8l-218.6 101c-14.9 6.9-32.1 6.9-47 0l-218.5-101c-8.5-4-13.9-12.5-13.9-21.8s5.4-17.9 13.9-21.8"></path></svg>
                </span>
                <span data-dhub-topics-label>Use cases</span>
                <svg class="dhub__chevron" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
              <div class="dhub__menu" id="dhub-topics-menu" role="menu" data-dhub-topics-menu hidden>
                <button type="button" class="dhub__menu-item is-active" role="menuitemradio" aria-checked="true" data-dhub-topic="">
                  <span class="dhub__menu-icon">
                    <Icon name="fa7-solid:layer-group" />
                  </span>
                  <span class="dhub__menu-label">All use cases</span>
                </button>
                {topics.map((topic) => (
                  <button
                    type="button"
                    class="dhub__menu-item"
                    role="menuitemradio"
                    aria-checked="false"
                    data-dhub-topic={topic.id}
                    data-dhub-topic-icon={topic.icon}
                    style={`--ink: ${topic.ink};`}
                  >
                    <span class="dhub__menu-icon">
                      <Icon name={topic.icon} />
                    </span>
                    <span class="dhub__menu-label">
                      {topic.label}
                      <span class="dhub__menu-blurb">{topic.blurb}</span>
                    </span>
                  </button>
                ))}
              </div>
            </div>
            )}

            <label class="dhub__search">
              <span class="sr-only">Search the catalog</span>
              <span class="dhub__search-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                  <circle cx="7" cy="7" r="4.25"></circle>
                  <path d="M10.25 10.25 13.5 13.5"></path>
                </svg>
              </span>
              <input
                type="search"
                class="dhub__search-input"
                placeholder="Search…"
                autocomplete="off"
                data-dhub-search
              />
            </label>
          </div>
        </div>

        {/* ── The grid ──────────────────────────────────────────────── */}
        {/* Named by the script from a matching card, because the publisher's
            name exists on this page only on the cards themselves. Hidden until
            a `?from=` is in play — which only a listing page's "More from …"
            link puts there. */}
        {/* A filter token, not a sentence. It says the same thing in the
            language the rest of this bar already speaks — a pill wearing the
            publisher's own mark — and carries its own dismiss, so the way out
            is on the thing that narrowed the grid rather than a link beside it.

            Named by the script from a matching card, because the publisher's
            name and mark exist on this page only on the cards themselves. */}
        <div class="dhub__from" data-dhub-from hidden>
          <span class="dhub__from-chip">
            <img
              class="dhub__from-mark"
              data-dhub-from-mark
              alt=""
              width="18"
              height="18"
              decoding="async"
              hidden
            />
            <span class="dhub__from-name" data-dhub-from-name></span>
            <button
              type="button"
              class="dhub__from-x"
              data-dhub-reset
              aria-label="Show everything, not just this source"
            >
              <svg viewBox="0 0 12 12" aria-hidden="true">
                <path
                  d="M3.2 3.2 8.8 8.8M8.8 3.2 3.2 8.8"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                ></path>
              </svg>
            </button>
          </span>
          <span class="dhub__from-count" data-dhub-from-count></span>
        </div>

        <ul class="dhub__grid" data-dhub-grid data-reveal="stagger">
          {listings.map((listing) => (
            <DiscoverCard listing={listing} />
          ))}
        </ul>
        <div class="dhub__empty" data-dhub-empty hidden>
          <p>Nothing matches that yet.</p>
          <button type="button" class="dhub__reset" data-dhub-reset>Show everything</button>
        </div>
        {/* Only rendered into once there is more than a page to walk — a
            catalog of nine never shows it. */}
        <nav class="dhub__pager" data-dhub-pager aria-label="Pages" hidden>
          <button type="button" class="dhub__page-btn" data-dhub-prev>Previous</button>
          <span class="dhub__page-of" data-dhub-page-of aria-live="polite"></span>
          <button type="button" class="dhub__page-btn" data-dhub-next>Next</button>
        </nav>
      </div>
    )
  }

  <PageClosingCTA
    heading={total > 0 ? "Take one, and make it yours" : "Somewhere for your study to live"}
    lead="Harvous keeps what you write where you can find it again — and lets you pass it on."
  />
</BaseLayout>

<script>
  /*
   * Filter in place. State is (topic, kind, query); the URL carries topic and
   * kind so a use-case page can link straight to `?use=sermon-notes` and a
   * reader can share what they were looking at. The query is not written to
   * the URL — it changes on every keystroke and is nobody's address.
   */
  const root = document.querySelector<HTMLElement>("[data-dhub]");
  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>(".dcard"));
    const kindButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dhub-kind]"));
    const topicItems = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dhub-topic]"));
    const topicsWrap = root.querySelector<HTMLElement>("[data-dhub-topics]");
    const trigger = root.querySelector<HTMLButtonElement>("[data-dhub-topics-trigger]");
    const menu = root.querySelector<HTMLElement>("[data-dhub-topics-menu]");
    const triggerLabel = root.querySelector<HTMLElement>("[data-dhub-topics-label]");
    const search = root.querySelector<HTMLInputElement>("[data-dhub-search]");
    const pager = root.querySelector<HTMLElement>("[data-dhub-pager]");
    const pageOf = root.querySelector<HTMLElement>("[data-dhub-page-of]");
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-dhub-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-dhub-next]");
    /* Enough that the catalog has to grow a long way before anyone meets a
       pager; small enough that it exists before the page gets unscrollable. */
    const PAGE_SIZE = 24;
    let page = 0;
    const empty = root.querySelector<HTMLElement>("[data-dhub-empty]");
    const grid = root.querySelector<HTMLElement>("[data-dhub-grid]");

    const params = new URLSearchParams(location.search);
    let topic = params.get("use") ?? "";
    let kind = params.get("kind") ?? "";
    /* Publisher, and URL-only on purpose. The bar already carries two rows of
       controls and this file learned once that a third outweighed the cards
       under it — so "More from BibleProject" is a link into this filter rather
       than a chip nobody would use twice. */
    let from = params.get("from") ?? "";
    let query = "";

    /* An unknown value in the URL is nobody's filter — fall back to everything
       rather than showing an empty grid for a typo. */
    if (topic && !topicItems.some((b) => b.dataset.dhubTopic === topic)) topic = "";
    if (kind && !kindButtons.some((b) => b.dataset.dhubKind === kind)) kind = "";
    if (from && !cards.some((c) => c.dataset.source === from)) from = "";

    const fromStrip = root.querySelector<HTMLElement>("[data-dhub-from]");
    const fromName = root.querySelector<HTMLElement>("[data-dhub-from-name]");
    const fromMark = root.querySelector<HTMLImageElement>("[data-dhub-from-mark]");
    const fromCount = root.querySelector<HTMLElement>("[data-dhub-from-count]");

    const closeMenu = () => {
      if (!menu || !trigger) return;
      menu.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
    };
    const openMenu = () => {
      if (!menu || !trigger) return;
      menu.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
    };

    const apply = (resetPage = true) => {
      if (resetPage) page = 0;
      /* Two passes: which cards match, then which of those this page shows.
         Doing it in one would page over the unfiltered list. */
      const matched = cards.filter(
        (card) =>
          (!topic || card.dataset.topic === topic) &&
          (!kind || card.dataset.kind === kind) &&
          (!from || card.dataset.source === from) &&
          (!query || (card.dataset.search ?? "").includes(query)),
      );
      const pages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
      page = Math.min(page, pages - 1);
      /* `offset`, not `from` — `from` is the publisher filter in the closure
         above, and a `const from` here shadowed it inside the very filter that
         reads it, which is a temporal-dead-zone throw rather than a wrong
         answer. */
      const offset = page * PAGE_SIZE;
      const visible = new Set(matched.slice(offset, offset + PAGE_SIZE));
      for (const card of cards) card.hidden = !visible.has(card);
      const shown = matched.length;

      for (const b of kindButtons) {
        const on = (b.dataset.dhubKind ?? "") === kind;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", on ? "true" : "false");
      }

      let current: HTMLButtonElement | undefined;
      for (const b of topicItems) {
        const on = (b.dataset.dhubTopic ?? "") === topic;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-checked", on ? "true" : "false");
        if (on) current = b;
      }
      /* The trigger names the axis at rest and wears the choice once there is
         one, so a folded-away filter is still visible at a glance. Reading the
         "All use cases" row's own text would put that whole phrase in a control
         that has to fit beside a search field. */
      if (triggerLabel) {
        triggerLabel.textContent = topic
          ? (current?.querySelector<HTMLElement>(".dhub__menu-label")?.childNodes[0]?.textContent?.trim() ??
            "Use cases")
          : "Use cases";
      }
      if (topicsWrap) {
        topicsWrap.style.cssText = topic && current ? current.style.cssText : "";
        topicsWrap.classList.toggle("is-set", Boolean(topic));
      }
      /* The stack glyph stays put; only the fill and the label change. Swapping
         in the topic's own glyph meant cloning an <svg> whose <use> points at a
         <symbol> defined inside the original — the clone left the symbol behind
         and rendered an empty circle. */

      if (empty) empty.hidden = shown > 0;
      if (grid) grid.hidden = shown === 0;
      if (pager) pager.hidden = pages < 2;
      if (pageOf) pageOf.textContent = `Page ${page + 1} of ${pages}`;
      if (prevBtn) prevBtn.disabled = page === 0;
      if (nextBtn) nextBtn.disabled = page >= pages - 1;
      /* The token names the publisher from a card rather than from a lookup —
         the cards are the only place that name and mark exist on this page. */
      if (fromStrip) fromStrip.hidden = !from;
      if (from) {
        const card = cards.find((c) => c.dataset.source === from);
        if (fromName) fromName.textContent = card?.dataset.sourceName ?? from;
        if (fromMark) {
          const logo = card?.dataset.sourceLogo ?? "";
          /* Hidden rather than left with an empty src, which browsers render
             as a broken-image glyph inside the pill. */
          fromMark.hidden = !logo;
          if (logo) fromMark.src = logo;
        }
        if (fromCount) {
          fromCount.textContent = shown === 1 ? "1 thing" : `${shown} things`;
        }
      }

      const next = new URLSearchParams();
      if (topic) next.set("use", topic);
      if (kind) next.set("kind", kind);
      if (from) next.set("from", from);
      const qs = next.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    };

    for (const b of kindButtons) {
      b.addEventListener("click", () => {
        const value = b.dataset.dhubKind ?? "";
        kind = kind === value ? "" : value;
        apply();
      });
    }
    for (const b of topicItems) {
      b.addEventListener("click", () => {
        topic = b.dataset.dhubTopic ?? "";
        closeMenu();
        apply();
      });
    }
    trigger?.addEventListener("click", () => {
      if (menu?.hidden) openMenu();
      else closeMenu();
    });
    document.addEventListener("click", (event) => {
      if (!topicsWrap?.contains(event.target as Node)) closeMenu();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
    search?.addEventListener("input", () => {
      query = search.value.trim().toLowerCase();
      apply();
    });
    prevBtn?.addEventListener("click", () => {
      page -= 1;
      apply(false);
      grid?.scrollIntoView({ block: "start", behavior: "smooth" });
    });
    nextBtn?.addEventListener("click", () => {
      page += 1;
      apply(false);
      grid?.scrollIntoView({ block: "start", behavior: "smooth" });
    });
    for (const button of root.querySelectorAll("[data-dhub-reset]")) {
      button.addEventListener("click", () => {
        topic = "";
        kind = "";
        from = "";
        query = "";
        if (search) search.value = "";
        apply();
      });
    }

    apply();
  }
</script>

<style>
  .dhub__empty-catalog {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 var(--frame-content-pad) 3rem;
  }

  /*
    Inside the frame rails. `.page-frame`'s hairlines sit at `--frame-inset`
    from the viewport edge; a 72rem box with its own padding put the bar's
    border a few pixels *past* them at ~1200px. `--frame-content-pad` is the
    gap the rest of the site leaves between hairline and content.
  */
  .dhub {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(1.75rem, 4vw, 2.5rem) var(--frame-content-pad) 3rem;
  }

  /* ── The bar ── kinds on the left, topic menu and search on the right. */
  /*
    Capped and centred rather than spanning the grid. It is a floating pill
    directly under another floating pill, and at the grid's full 72rem it read
    as a different kind of object from the header — a page-width toolbar under
    a content-width nav. 52rem sits with the header's own measured
    `--pill-width` (~778px at 1280) without tying a static stylesheet to a
    value the header's script computes at runtime.
  */
  .dhub__bar {
    position: sticky;
    top: 5.25rem;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
    box-sizing: border-box;
    padding: 0.375rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-card) 92%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-card);
  }

  .dhub__kinds {
    display: flex;
    flex: 1 1 auto;
    gap: 0.125rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .dhub__kinds::-webkit-scrollbar {
    display: none;
  }
  .dhub__kind {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    padding: 0.45rem 0.85rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variation-settings: "wdth" 100, "ROND" 0;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dhub__kind:hover {
    color: var(--color-ink);
  }
  /* The accent gradient every other primary control on this site uses — a
     solid black chip was a shape borrowed from nowhere. */
  .dhub__kind.is-active {
    background: var(--accent-btn-bg);
    box-shadow: var(--accent-btn-shadow-sm);
    color: #fff;
  }
  .dhub__kind-icon {
    display: inline-flex;
  }
  .dhub__kind-icon :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
    fill: currentColor;
  }

  /* Nothing left but the tools, so they get the bar. 52rem of pill around one
     menu and a search field is a lot of empty; the bar comes in to fit them. */
  .dhub__bar--tools-only {
    max-width: 34rem;
