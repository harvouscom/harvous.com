---
/**
 * `/discover` — the catalog hub.
 *
 * Grouped by category rather than one flat grid, following `for/index.astro`:
 * a catalog people arrive at from search wants a shape they can scan, and the
 * jump nav gives one without asking for a search box the catalog is too small
 * to need. Client-side search is deliberately deferred — a Fuse.js index over a
 * dozen listings is a UI that costs more than it finds.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import PageClosingCTA from "../../components/PageClosingCTA.astro";
import HubSectionNav from "../../components/HubSectionNav.astro";
import { isDraftPageSlug } from "../../lib/draft-pages.ts";
import {
  DISCOVER_KIND_NOUN,
  getDiscoverListings,
  getPopulatedDiscoverCategories,
} from "../../lib/discover-data.ts";

const groups = getPopulatedDiscoverCategories();
const total = getDiscoverListings().length;
const navItems = groups.map((group) => ({ id: group.id, label: group.label }));
/* noindex whenever `discover` is a draft slug — including staging, which is the
   one environment that actually builds and serves these pages. `draftPageIsReachable`
   is the wrong question here: it asks whether *links* should render, and is true on
   staging, which would leave the built page indexable. */
const isDraft = isDraftPageSlug("discover");
---

<BaseLayout
  title="Discover — Bible study templates and notes people have shared — Harvous"
  description="Free Bible study templates, notes and Threads shared by people who use Harvous. Take a copy of any of them into your own account."
  noindex={isDraft}
>
  {
    isDraft && (
      <div class="draft-page-banner" role="status">
        Draft — not indexed or deployed. Remove <code>"discover"</code> from DRAFT_PAGE_SLUGS to publish.
      </div>
    )
  }

  <section>
    <PageIntro flushBottom>
      <h1 class="section-title text-pretty">Study people have offered to share.</h1>
      <p class="mt-5 text-lg text-[var(--color-ink-soft)] text-pretty">
        Templates to write into, notes to read, and Threads to work through — all of it free,
        and all of it yours to change once you take a copy.
      </p>
    </PageIntro>
  </section>

  {
    groups.length === 0 ? (
      <section class="discover-hub__empty">
        <p class="text-[var(--color-ink-soft)]">
          Nothing has been shared yet. When someone offers a starter or a study and it has been
          looked over, it turns up here.
        </p>
      </section>
    ) : (
      <div class="discover-hub" data-hub-section-nav-main>
        <HubSectionNav
          items={navItems}
          ariaLabel="Topics"
          selectLabel="Jump to topic"
          selectId="discover-category-select"
        />

        {groups.map((group, groupIndex) => (
          <section
            id={group.id}
            class:list={[
              "discover-hub__group",
              groupIndex > 0 && "border-t border-[var(--color-rule)]",
            ]}
            aria-labelledby={`${group.id}-title`}
          >
            <div class="discover-hub__group-inner">
              <div class="discover-hub__group-head">
                <h2 id={`${group.id}-title`} class="discover-hub__group-title">
                  <a href={`/discover/topic/${group.id}/`}>{group.label}</a>
                </h2>
                <p class="discover-hub__group-blurb">{group.blurb}</p>
              </div>

              <ul class="discover-hub__list">
                {group.listings.map((listing) => {
                  /* The shape of the thing, which is the thing: a template's
                     headings and a Thread's note titles are what someone is
                     deciding about. Three is enough to recognise it and few
                     enough that the card stays a card. */
                  const outline = (listing.preview?.headings ?? listing.preview?.titles ?? []).slice(0, 3);
                  const more = (listing.preview?.headings ?? listing.preview?.titles ?? []).length - outline.length;
                  return (
                    <li class="discover-hub__item">
                      <a class="discover-hub__item-link" href={`/discover/${listing.slug}/`}>
                        <span class="discover-hub__item-head">
                          <span class="discover-hub__item-kind">
                            {DISCOVER_KIND_NOUN[listing.kind] ?? "Item"}
                          </span>
                          {listing.installCount > 0 ? (
                            <span class="discover-hub__item-count">
                              saved by {listing.installCount}
                            </span>
                          ) : null}
                        </span>

                        <span class="discover-hub__item-title">{listing.title}</span>
                        {listing.description ? (
                          <span class="discover-hub__item-desc">{listing.description}</span>
                        ) : null}

                        {outline.length > 0 ? (
                          <span class="discover-hub__item-outline">
                            {outline.map((line) => (
                              <span class="discover-hub__item-step">{line}</span>
                            ))}
                            {more > 0 ? (
                              <span class="discover-hub__item-step discover-hub__item-step--more">
                                +{more} more
                              </span>
                            ) : null}
                          </span>
                        ) : null}

                        {listing.authorDisplayName ? (
                          <span class="discover-hub__item-by">
                            Shared by {listing.authorDisplayName}
                          </span>
                        ) : null}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </section>
        ))}
      </div>
    )
  }

  <PageClosingCTA
    heading={total > 0 ? "Take one, and make it yours" : "Somewhere for your study to live"}
    lead="Harvous keeps what you write where you can find it again — and lets you pass it on."
  />
</BaseLayout>

<style>
  .discover-hub__empty {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
  }
  .discover-hub__group-inner {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.25rem 1.25rem;
  }
  .discover-hub__group-title {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .discover-hub__group-title a {
    color: inherit;
    text-decoration: none;
  }
  .discover-hub__group-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .discover-hub__group-blurb {
    margin-top: 0.25rem;
    color: var(--color-ink-faint);
  }
  .discover-hub__list {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .discover-hub__item-link {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .discover-hub__item-link:hover {
    border-color: color-mix(in oklab, var(--color-ink) 22%, var(--color-rule));
    box-shadow: var(--shadow-float);
    transform: translateY(-1px);
  }

  /* Kind on the left, uptake on the right — what it is, and whether anyone has
     found it useful. */
  .discover-hub__item-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .discover-hub__item-kind {
    font-weight: 600;
    color: var(--color-accent);
  }

  .discover-hub__item-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .discover-hub__item-desc {
    color: var(--color-ink-soft);
  }

  /* The outline as pills: a card that shows its shape is one you can judge
     without opening it. */
  .discover-hub__item-outline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3125rem;
    margin-top: 0.5rem;
  }
  .discover-hub__item-step {
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
    color: var(--color-ink-soft);
  }
  .discover-hub__item-step--more {
    background: transparent;
    color: var(--color-ink-faint);
  }

  .discover-hub__item-by {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }
</style>
