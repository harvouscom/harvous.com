---
/**
 * /next/ — the redesigned home. Seven beats instead of twelve: the hero, what
 * people say (straight after it, as proof), how it works (01–03), however you
 * study (the use cases), what else it does (bento), privacy, who makes it, and
 * one closing line. FAQ moved to pricing;
 * the code being public gets one card (OpenSource) after the maker note, and
 * the blog gets a small way in (BlogPreview) after that.
 */
import NextLayout from "../layouts/NextLayout.astro";
import { ogCard } from "../lib/og-card.ts";
import NextHero from "../components/next/NextHero.astro";
import StoryScroller from "../components/next/StoryScroller.astro";
import Bento from "../components/next/Bento.astro";
import ToggleWall from "../components/next/ToggleWall.astro";
import MakerNote from "../components/next/MakerNote.astro";
import OpenSource from "../components/next/OpenSource.astro";
import ProofStrip from "../components/next/ProofStrip.astro";
import UseCaseRow from "../components/next/UseCaseRow.astro";
import ClosingCall from "../components/next/ClosingCall.astro";
import ComparePreview from "../components/next/ComparePreview.astro";
import BlogPreview from "../components/next/BlogPreview.astro";
import { buildHomeJsonLd } from "../lib/home-jsonld.ts";
import { fathomHome } from "../lib/fathom-events.ts";
const homeJsonLd = await buildHomeJsonLd();
---

<NextLayout
  ogImage={ogCard("home")}
  jsonLd={homeJsonLd}
  title="Harvous — a study Bible that remembers"
  description="A quiet notes app for studying the Bible, made by one person. Write what you notice; Harvous keeps it with the verse and brings it back before it fades."
>
  <NextHero />

  <ProofStrip />

  <section class="nx-section" id="story" aria-labelledby="story-title">
    <div class="nx-wrap">
      <div class="home__head" data-reveal>
        <p class="nx-kicker">How it works</p>
        <h2 id="story-title" class="nx-title">A study Bible that remembers.</h2>
      </div>
      <StoryScroller />
    </div>
  </section>

  <UseCaseRow />

  <section class="nx-section home__bento" aria-labelledby="bento-title">
    <div class="nx-wrap">
      <div class="home__head" data-reveal>
        <p class="nx-kicker">Everything else</p>
        <h2 id="bento-title" class="nx-title">Built for how you actually study.</h2>
        <p class="nx-lead">
          The pieces you notice most when they're missing. All free, apart from the two marked Plus.
        </p>
      </div>
      <Bento />
      <p class="home__more">
        <a class="nx-link" href="/tour/" data-fathom-track={fathomHome.tour}>Take the full tour →</a>
      </p>
    </div>
  </section>

  <ToggleWall />

  <MakerNote />

  <OpenSource />

  <BlogPreview />

  <div class="nx-wrap"><ComparePreview /></div>

  <ClosingCall />
</NextLayout>

<style>
  .home__head {
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .home__head .nx-title { margin: 0.75rem 0 0; }
  .home__head .nx-lead { margin: 1rem 0 0; }
  .home__more { margin: 2rem 0 0; text-align: center; }
  .home__bento { padding-top: 0; }
</style>
