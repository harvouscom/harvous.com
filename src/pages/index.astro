---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCentered from "../components/HeroCentered.astro";
import AppTour from "../components/AppTour.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import PageClosingCTA from "../components/PageClosingCTA.astro";
import UseCasesPreview from "../components/UseCasesPreview.astro";
import ComparePreview from "../components/ComparePreview.astro";
import RelatedBlogPosts from "../components/RelatedBlogPosts.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import FaqSection from "../components/FaqSection.astro";
import FounderLetterSection from "../components/FounderLetterSection.astro";
import DownloadCTA from "../components/DownloadCTA.astro";
import { getCollection } from "astro:content";
import { buildHomeJsonLd } from "../lib/home-jsonld.ts";
import { fathomTry, fathomCta } from "../lib/fathom-events.ts";
import { includeBlogDrafts, isBlogPostListed } from "../lib/blog";

const homeJsonLd = await buildHomeJsonLd();
const showDrafts = includeBlogDrafts();
const homeBlogPosts = (await getCollection("blog"))
  .filter((p) => isBlogPostListed(p, showDrafts))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 2);
---

<BaseLayout
  title="Harvous — Bible study notes app"
  description="Harvous is a Bible study notes app — not sermon transcription. Read a chapter or type a reference and your notes, highlights, and threads are right there with it, so you remember what you saved."
  jsonLd={homeJsonLd}
  preloadImage="/app-full.webp"
>
  <HeroCentered />

  <AppTour id="features" />

  <FeatureGrid />

  <PageClosingCTA
    heading="Ready to try it?"
    lead="Everything above is free — unlimited notes, scripture pills, highlights, and offline sync. No credit card."
    fathomTrack={fathomTry.included}
    secondaryHref="/#faq"
    secondaryLabel="Read the FAQs"
    secondaryFathomTrack={fathomCta.faqAnchor}
  />

  <UseCasesPreview />

  <TestimonialsSection />

  <ComparePreview />

  <RelatedBlogPosts
    posts={homeBlogPosts}
    lead="Notes, habits, and teaching that show up after Sunday."
  />

  <!-- Founder letter — a contrast "card" that breaks the grid frame on purpose. -->
  <FounderLetterSection />

  <FaqSection />

  <DownloadCTA />
</BaseLayout>
